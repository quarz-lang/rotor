# What a model's table is, for the statements made from its values and
# the repository that sets its timestamps: its name, its primary key's
# columns (none, one, or several for a composite key), and the schema
# that qualifies it (nil: the connection's `search_path` finds it).
data TableInfo(name: String, columns: Array[Column], primary_keys: Array[Symbol], created_at: Symbol?, updated_at: Symbol?, associations: Array[Association] = [], schema: String? = nil)
  # The primary key's one column; nil for none, and for a composite key
  # ([primary_keys] has its columns).
  def primary_key -> Symbol? = primary_keys.size == 1 ? primary_keys[0] : nil

  # The primary key's one column, for `what` (an association, a
  # preload), which needs one: [Rotor::SchemaError] for none and for a
  # composite key, naming the table as `table` (its model's name, or
  # its own quoted).
  def single_key(table: String, what: String) -> Symbol
    case primary_keys
    in [k] then k
    in [] then raise SchemaError.new("#{table} has no primary key, which #{what} needs")
    else raise SchemaError.new("#{table} has a composite primary key (#{primary_keys.join(", ")}), and #{what} needs a single one")
    end
  end

  # The primary key's columns, for a statement by the key: [ArgumentError]
  # for none.
  def keys! -> Array[Symbol]
    raise ArgumentError.new("`#{name}` has no primary key") if primary_keys.empty?
    primary_keys
  end
end

# A table a query reads: the first, or one joined to it, with the
# conditions of its JOIN (`INNER JOIN ... ON` them, `CROSS JOIN` for
# none), the columns it fetches (nil for all of them), those it
# fetches whatever a `select` reads (the key an association's join
# needs), and whether its JOIN is a LEFT one ([Rotor::Query#left_join]:
# its row may be missing, its key then NULL).
data Source = (table: TableInfo, model: Type[Object], on: Array[Sql], fetch: Array[Column]?, keep: Array[Symbol] = [], left: Bool = false)

# The values of a row's columns from one of a query's tables, and
# whether those are all of the table's columns.
data Fetched = (values: Hash[Symbol, Object?], all: Bool)

# How a query's rows become `T`s: from the values each of its tables
# gave, row by row.
type Loader[T] = shareable (Array[Array[Fetched]]) -> Array[T]

# What a query of models does with them for a preload
# ([Rotor::Query#preload]): a row as a model, and a row with the
# associations preloaded for it.
data ModelOps[T] = (as_model: shareable (T) -> Model, attach: shareable (T, Hash[Symbol, Array[Model]]) -> T)

# :nodoc:
# What a query is as a subquery, whatever its rows' type (`Rotor::Query`
# includes it): what the translator and `Rotor::Binds` reach a captured
# query by.
module Subquery
  # The column it gives as a subquery.
  abstract def subquery_column -> Column
  # Its SQL and parameters as a subquery.
  abstract def subquery -> Array[Piece]
  # Whether the column it gives as a subquery can be NULL (false for a
  # query that cannot be one).
  abstract def subquery_nullable? -> Bool
end

# A query over a model's table, as a value: what [Rotor::Model.where]
# and the others build, and a repository runs. Each method gives a new
# query; none changes the one it is called on. Its blocks are not run:
# they are translated to SQL when the query is built, so that a block
# SQL cannot express raises [Rotor::UntranslatableError] there, and
# [to_sql] gives the statement and its parameters.
#
# ```
# class QUser < Rotor::Model
#   table "users" do
#     column :id, Int, primary: true
#     column :name, String
#     column :age, Int
#   end
# end
#
# min = 18
# q = QUser.where { age >= min }.order { name }.limit(10)
# q.to_sql  # => ["SELECT \"id\", \"name\", \"age\" FROM \"users\" WHERE \"age\" >= $1 ORDER BY \"name\" LIMIT 10", [18]]
# ```
#
# `T` is what a row gives: the model, or what [select] projects.
#
# A query is [Shareable]: a constant (`ACTIVE = User.where { active }`),
# a value a task's block captures or a channel carries. Its blocks'
# translations are kept for the process ([Rotor::Cache]), so building a
# query again where it was built before costs no translation.
class Query[T]
  include Shareable
  include Subquery
  # What a query gives: its rows, their number, or whether there is one.
  enum Shape = Rows | Count | Exists

  # Its tables: the model's, then those joined to it.
  @sources: Array[Source]
  @wheres: Array[Sql]
  @orders: Array[[Sql, Bool]]
  # Whether `select` made it (or a `flat_map`, whose rows the block's
  # queries give).
  @projected: Bool
  @loader: Loader[T]
  @limit: Int?
  @offset: Int?
  @shape: Shape
  # The associations to preload for its rows, and how (a query of
  # models: nil after `select`).
  @preloads: Array[Preload]
  # How its rows are models, for a preload (nil after `select`).
  @ops: ModelOps[T]?
  # Its locking clause (` FOR UPDATE SKIP LOCKED`), or nil.
  @lock: String?
  # The column a `select` of one column as it is (`select { id }`)
  # gives, or nil: what makes it a subquery (`include?`).
  @single: Column?

  # (Made by [Rotor::Model.query] and the methods of this class.)
  def initialize(@sources: Array[Source], @wheres: Array[Sql], @orders: Array[[Sql, Bool]], @projected: Bool, @limit: Int?, @offset: Int?, @shape: Shape, @loader: Loader[T], @preloads: Array[Preload] = [], @ops: ModelOps[T]? = nil, @lock: String? = nil, @single: Column? = nil)
  end

  # The table (the first, in a join).
  def table -> TableInfo = @sources[0].table

  # Its tables: the first, then those joined to it.
  def sources -> Array[Source] = @sources

  # The columns its rows have, in order (each table's in turn, in a
  # join): what [to_sql] selects.
  def fetched -> Array[Column] = @sources.flat_map { |s| s.fetch || s.table.columns }

  # What it gives: its rows, their number, or whether there is one.
  def shape -> Shape = @shape

  # Its limit, if any.
  def limit_value -> Int? = @limit

  # The rows whose column `name` is `value` (the repository's `get`).
  def where_key(name: Symbol, value: Object?) -> Query[T]
    rows!("where_key")
    single!("where_key")
    c = table.columns.find { |x| x.name == name } || raise ArgumentError.new("`#{table.name}` has no column `#{name}`")
    if value.is_a?(Array[Object?]) && c.element.nil?
      raise ArgumentError.new("an array for `#{name}`, which is not an array column")
    end
    col = Piece::Column.new(0, c.name)
    s = if value.nil?
          Sql.new([col, Piece::Text.new(" IS NULL")], Translator::IS, nil, nil, false)
        else
          Sql.new([col, Piece::Text.new(" = "), Piece::Param.new(Binds.parameter(value))], Translator::CMP, nil, nil, false)
        end
    copy(wheres: @wheres + [s])
  end

  # The rows whose column `name` is one of `values`: `"name" =
  # ANY($1)`, the values one array parameter, whatever their number (a
  # preload's query).
  def where_in(name: Symbol, values: Array[Value]) -> Query[T]
    rows!("where_in")
    single!("where_in")
    c = table.columns.find { |x| x.name == name } || raise ArgumentError.new("`#{table.name}` has no column `#{name}`")
    xs: Array[Object?] = values.map { |v| v.as(Object) }
    pieces: Array[Piece] = [Piece::Column.new(0, c.name), Piece::Text.new(" = ANY("), Piece::Param.new(Binds.items(xs)), Piece::Text.new(")")]
    copy(wheres: @wheres + [Sql.new(pieces, Translator::CMP, nil, nil, false)])
  end

  # The rows a join model's rows pair with the owner of key `value`
  # ([Rotor::HasMany#query] through it): `"id" IN (SELECT "tag_id" FROM
  # "post_tags" WHERE "post_id" = $1)`.
  def where_through(k: ThroughKeys, value: Value) -> Query[T]
    rows!("where_through")
    single!("where_through")
    jt = k.join.table_info
    sub = " IN (SELECT #{Dialect.quote(k.target_key.to_s)} FROM #{Dialect.table(jt.name, jt.schema)} WHERE #{Dialect.quote(k.owner_key.to_s)} = "
    pieces: Array[Piece] = [Piece::Column.new(0, k.target_pk), Piece::Text.new(sub), Piece::Param.new(Binds.parameter(value)), Piece::Text.new(")")]
    copy(wheres: @wheres + [Sql.new(pieces, Translator::LIKE, nil, nil, false)])
  end

  # Its rows paired with the owner key of the join model's rows that pair
  # them with the owners of `keys` (a preload through it): `INNER JOIN
  # "post_tags" AS "p1" ON "p1"."tag_id" = "t0"."id" WHERE "p1"."post_id"
  # = ANY($1)`, in the order of the target's primary key.
  def through_owners(k: ThroughKeys, keys: Array[Value]) -> Query[[T, Value?]]
    single!("through_owners")
    rows!("through_owners")
    jt = k.join.table_info
    oc = jt.columns.find { |c| c.name == k.owner_key } || raise SchemaError.new("#{k.join.name} has no column `#{k.owner_key}`")
    on = Joins.key_condition(1, k.target_key, 0, k.target_pk)
    xs: Array[Object?] = keys.map { |v| v.as(Object) }
    within = Sql.new([Piece::Column.new(1, k.owner_key), Piece::Text.new(" = ANY("), Piece::Param.new(Binds.items(xs)), Piece::Text.new(")")], Translator::CMP, nil, nil, false)
    order = Sql.new([Piece::Column.new(0, k.target_pk)], Translator::ATOM, nil, nil, false)
    base = @loader
    owner_key = k.owner_key
    Query[[T, Value?]].new(@sources + [Source.new(jt, k.join, [on], [oc])], @wheres + [within], @orders + [[order, false]], false, nil, nil, Shape::Rows,
                           ->(rows: Array[Array[Fetched]]) {
                             ts = base.call(rows.map { |r| [r[0]] })
                             out: Array[[T, Value?]] = []
                             ts.each_with_index { |x, i| out = out + [[x, Model.value(rows[i][1].values[owner_key]?)]] }
                             out
                           })
  end

  # Ordered by the column `name` too (nil: unchanged): a preload's query.
  def order_by_key(name: Symbol?) -> Query[T]
    return self unless name
    single!("order_by_key")
    copy(orders: @orders + [[Sql.new([Piece::Column.new(0, name)], Translator::ATOM, nil, nil, false), false]])
  end

  # A row's `T` from the values of its table's columns (those of
  # [fetched]), for a query of one table.
  def load(values: Hash[Symbol, Object?]) -> T
    single!("load")
    @loader.call([[Fetched.new(values, @sources[0].fetch.nil?)]])[0]
  end

  # A row's `T` from the values of each of its tables.
  def load_row(values: Array[Fetched]) -> T = @loader.call([values])[0]

  # The `T`s of the rows a database gave for [to_sql].
  def load_rows(rows: Array[Row]) -> Array[T]
    case @shape
    in Shape::Count
      @loader.call(rows.map { |r| [Fetched.new({value: r.int(0)}, true)] })
    in Shape::Exists
      @loader.call(rows.map { |r| [Fetched.new({value: r.bool(0)}, true)] })
    in Shape::Rows
      lists = @sources.map { |s| s.fetch || s.table.columns }
      @loader.call(rows.map do |r|
        at = 0
        lists.each_with_index.map do |cols, i|
          values: Hash[Symbol, Object?] = {}
          cols.each do |c|
            values = values.put(c.name, r.column_value(at, c))
            at += 1
          end
          Fetched.new(values, @sources[i].fetch.nil?)
        end
      end)
    end
  end

  # The rows for which the block is true. The row is the block's
  # receiver (`where { age > 18 }`) or its parameter (`where { |u|
  # u.age > 18 }`, which `for` comprehensions use); a block that names
  # nothing of the row (`where { true }`) is ambiguous between the two:
  # write `where { |u| true }`.
  def where(&cond: Quoted[shareable T.() -> Bool] using Compare) -> Query[T] = add_where(cond.expr, cond.captures, cond.file, cond.site)

  # :ditto:
  def where(&cond: Quoted[shareable (T) -> Bool] using Compare) -> Query[T] = add_where(cond.expr, cond.captures, cond.file, cond.site)

  # [where], by the name `for` comprehensions call.
  def filter(&cond: Quoted[shareable (T) -> Bool] using Compare) -> Query[T] = add_where(cond.expr, cond.captures, cond.file, cond.site)

  # Ordered by the block's value, ascending, after the orders given before.
  def order(&key: Quoted[shareable T.() -> Object] using Compare) -> Query[T] = add_order(key.expr, key.captures, key.file, key.site)

  # :ditto:
  def order(&key: Quoted[shareable (T) -> Object] using Compare) -> Query[T] = add_order(key.expr, key.captures, key.file, key.site)

  # The last order descending.
  def desc -> Query[T]
    last = @orders.last? || raise ArgumentError.new("`desc` without an `order` before it")
    copy(orders: @orders[0...(@orders.size - 1)] + [[last[0], true]])
  end

  # The last order ascending, as [order] gives it: written to say so
  # before [nulls_first] or [nulls_last] (`order { seen_at }.asc.nulls_first`).
  def asc -> Query[T]
    last = @orders.last? || raise ArgumentError.new("`asc` without an `order` before it")
    copy(orders: @orders[0...(@orders.size - 1)] + [[last[0], false]])
  end

  # The last order with its NULLs first (`NULLS FIRST`). Without it the
  # order is PostgreSQL's: NULLs last ascending, first descending ([desc]).
  #
  # ```
  # class NSensor < Rotor::Model
  #   table "sensors" do
  #     column :id, Int, primary: true
  #     column :seen_at, Time, null: true
  #   end
  # end
  #
  # NSensor.query.order { |s| s.seen_at }.desc.nulls_last.to_sql[0]
  # # => "SELECT \"id\", \"seen_at\" FROM \"sensors\" ORDER BY \"seen_at\" DESC NULLS LAST"
  # ```
  def nulls_first -> Query[T] = nulls("nulls_first", "FIRST")

  # The last order with its NULLs last (`NULLS LAST`): as [nulls_first].
  def nulls_last -> Query[T] = nulls("nulls_last", "LAST")

  # At most `n` rows.
  def limit(n: Int) -> Query[T]
    unshaped!("limit")
    raise ArgumentError.new("a negative limit: #{n}") if n < 0
    copy(limit: n)
  end

  # The rows after the first `n`.
  def offset(n: Int) -> Query[T]
    unshaped!("offset")
    raise ArgumentError.new("a negative offset: #{n}") if n < 0
    copy(offset: n)
  end

  # Whether `x` is one of its rows: only in another query's block, as a
  # subquery (`x IN (SELECT ...)`), the query a [select] of one column as
  # it is, captured by the block:
  #
  # ```
  # class SOrder < Rotor::Model
  #   table "orders" do
  #     column :id, Int, primary: true
  #     column :status, String
  #   end
  # end
  #
  # class SLine < Rotor::Model
  #   table "line_items" do
  #     column :id, Int, primary: true
  #     column :order_id, Int
  #   end
  # end
  #
  # paid = SOrder.where { status == "paid" }.select { id }
  # SLine.where { paid.include?(order_id) }.to_sql
  # # => ["SELECT \"id\", \"order_id\" FROM \"line_items\" WHERE \"order_id\" IN (SELECT \"id\" FROM \"orders\" WHERE \"status\" = $1)", ["paid"]]
  # ```
  #
  # Called outside a query's block, it raises [ArgumentError]: a query
  # is not a collection (run it: [Rotor::Repo#all]).
  def include?(x: T) -> Bool
    raise ArgumentError.new("`include?` of a query outside a query's block: a query is not a collection; run it (`repo.all(query)`), or test a column against it in a block (`where { q.include?(col) }`)")
  end

  # Whether it has a row: only in another query's block, the query
  # built there, as `EXISTS (SELECT 1 ...)`, its block reading the outer
  # row (a correlated subquery):
  #
  # ```
  # class EPost < Rotor::Model
  #   table "posts" do
  #     column :id, Int, primary: true
  #     column :title, String
  #   end
  # end
  #
  # class EEvent < Rotor::Model
  #   table "events" do
  #     column :id, Int, primary: true
  #     column :post_id, Int
  #     column :kind, String
  #   end
  # end
  #
  # EPost.where { |p| !EEvent.where { |e| e.post_id == p.id && e.kind == "removed" }.exists? }.to_sql
  # # => ["SELECT \"id\", \"title\" FROM \"posts\" WHERE NOT EXISTS (SELECT 1 FROM \"events\" AS \"e1\" WHERE \"e1\".\"post_id\" = \"posts\".\"id\" AND \"e1\".\"kind\" = $1)", ["removed"]]
  # ```
  #
  # The query is a model's (`Event.where { ... }`, or its `query`) or an
  # association's of the outer row (`p.events.query`), with [where] and
  # [filter] only. Called outside a query's block, it raises
  # [ArgumentError]: run the query ([Rotor::Repo#exists?]).
  def exists? -> Bool
    raise ArgumentError.new("`exists?` of a query outside a query's block: run it, `repo.exists?(query)`, or test it in a block (`where { |p| Event.where { |e| e.post_id == p.id }.exists? }`)")
  end

  # :nodoc:
  # The column it gives as a subquery; `Rotor::UntranslatableError` for
  # a query that cannot be one.
  def subquery_column -> Column
    if @sources.size != 1 || @shape != Shape::Rows || !@projected
      raise UntranslatableError.new("`include?` of a query that is not a `select` of one column of one table (`select { id }`)")
    end
    @single || raise UntranslatableError.new("`include?` of a query whose `select` is not one column as it is (`select { id }`): its block is computed in Quarz, not SQL")
  end

  # :nodoc:
  # Whether the column it gives as a subquery can be NULL.
  def subquery_nullable? -> Bool
    c = @single
    !c.nil? && c.null
  end

  # :nodoc:
  # Its SQL and parameters as a subquery (`Rotor::Bind::Subquery`).
  def subquery -> Array[Piece]
    subquery_column
    unlocked!("include?")
    outer_named(pieces).map do |p|
      case p
      in Piece::Column(_, n) then Piece::Text.new(Dialect.quote(n.to_s)).as(Piece)
      else p
      end
    end
  end

  # Its rows locked for update, `FOR UPDATE`, until the transaction
  # ends: another transaction's [for_update] of one of them waits, or
  # with `skip_locked: true` leaves the locked rows out (`SKIP LOCKED`:
  # a queue's workers each claim a row), or with `nowait: true` raises
  # (NOWAIT, a [PG::ServerError], SQLSTATE 55P03). Not both. Refused
  # after [select], [count] and [exists] (SQL locks rows, not a
  # projection or an aggregate). Outside a transaction the lock ends
  # with the statement: run it in [Rotor::Repo#transaction].
  #
  # ```
  # class LJob < Rotor::Model
  #   table "jobs" do
  #     column :id, Int, primary: true
  #     column :done, Bool
  #   end
  # end
  #
  # LJob.where { !done }.order { id }.limit(1).for_update(skip_locked: true).to_sql[0]
  # # => "SELECT \"id\", \"done\" FROM \"jobs\" WHERE NOT \"done\" ORDER BY \"id\" LIMIT 1 FOR UPDATE SKIP LOCKED"
  # ```
  def for_update(*, skip_locked: Bool = false, nowait: Bool = false) -> Query[T] = lock("for_update", "UPDATE", skip_locked, nowait)

  # Its rows locked as [for_update] does, `FOR NO KEY UPDATE`: the lock
  # an UPDATE that changes no key column takes, which a row's `FOR
  # KEY SHARE` (a foreign key's check) does not wait for.
  def for_no_key_update(*, skip_locked: Bool = false, nowait: Bool = false) -> Query[T] = lock("for_no_key_update", "NO KEY UPDATE", skip_locked, nowait)

  # Its rows locked for share, `FOR SHARE`, as [for_update] does: other
  # transactions may share the lock, not update or delete the rows.
  def for_share(*, skip_locked: Bool = false, nowait: Bool = false) -> Query[T] = lock("for_share", "SHARE", skip_locked, nowait)

  # Its rows locked as [for_share] does, `FOR KEY SHARE`: only a change
  # of a key column, or a delete, waits for it.
  def for_key_share(*, skip_locked: Bool = false, nowait: Bool = false) -> Query[T] = lock("for_key_share", "KEY SHARE", skip_locked, nowait)

  # Its rows with the associations the block names preloaded, as
  # [Rotor::Repo#preload] does after they are loaded (`repo.all(User.query.preload
  # { posts })`): Ecto's `preload:`.
  def preload(&spec: Quoted[shareable T.() -> Object] using Compare) -> Query[T]
    rows!("preload")
    ops || raise ArgumentError.new("`preload` of a query that does not give models")
    added = Cache.fetch(Cache::PRELOADS, Cache.key(spec.site, @sources), Array[Object].new) do
      [Preloads.parse(table, @sources[0].model.name, spec.expr, spec.file), Array[Guard].new]
    end
    Query[T].new(@sources, @wheres, @orders, @projected, @limit, @offset, @shape, @loader, Preloads.merge(@preloads + added), ops, @lock)
  end

  # The rows `repo` loaded with the preloads done ([preload]).
  def preloaded(rows: Array[T], repo: Repo) -> Array[T]
    ops = self.ops
    return rows if @preloads.empty? || ops.nil?
    found = Preloads.run(repo, rows.map { |r| ops.as_model.call(r) }, table, @preloads)
    rows.each_with_index.map { |r, i| ops.attach.call(r, found[i]) }
  end

  # The first row: `limit(1)`.
  def first -> Query[T] = limit(1)

  # The block's value for each row: a column (`select { name }`), an
  # expression, or a `data` value made of them (`select { Summary.new(id,
  # name) }`). The block is evaluated in Quarz, not in SQL: the query
  # fetches the columns it reads (all of them when it calls another
  # method of the row or passes the row on), and the repository runs it
  # on each row, loaded with those columns only (reading another raises
  # [Rotor::NotLoadedError]). Counting is [count], a query's shape, not
  # a projection.
  def select[R](&f: Quoted[shareable T.() -> R] using Compare) -> Query[R]
    proc = f.proc
    project(f.expr, f.file, f.site, ->(row: T) { row.instance_exec(&proc) })
  end

  # :ditto:
  def select[R](&f: Quoted[shareable (T) -> R] using Compare) -> Query[R]
    proc = f.proc
    project(f.expr, f.file, f.site, ->(row: T) { proc.call(row) })
  end

  # [select], by the name `for` comprehensions call.
  def map[R](&f: Quoted[shareable (T) -> R] using Compare) -> Query[R]
    proc = f.proc
    project(f.expr, f.file, f.site, ->(row: T) { proc.call(row) })
  end

  # The rows of the queries the block gives for each row, in one query
  # with a JOIN: what a `for` comprehension over several queries calls
  # (Quarz's docs/01 §11). The block's query is a model's (`Post.where
  # { ... }`, or its `query`), with [where], [filter], [order] and [desc],
  # and a last [map], [select] or [flat_map], or an association's
  # (`u.posts.query`, joined by its key); its conditions, those on the row
  # (`u`) included, are the JOIN's, its orders come after this query's.
  # Its rows are made by the block, run for each distinct row of this
  # query (with the columns the block reads of it): building the inner
  # query again costs some microseconds per row, so a large result reads
  # better through [join], which makes pairs.
  #
  # ```
  # class FUser < Rotor::Model
  #   table "users" do
  #     column :id, Int, primary: true
  #     column :name, String
  #     has_many FPost, name: :posts, foreign_key: :user_id
  #   end
  # end
  #
  # class FPost < Rotor::Model
  #   table "posts" do
  #     column :id, Int, primary: true
  #     column :user_id, Int
  #     column :title, String
  #     column :published, Bool, default: false
  #   end
  # end
  #
  # q = for u in FUser.query, p in FPost.where { published } when p.user_id == u.id do [u.name, p.title] end
  # q.to_sql[0]  # => "SELECT \"u0\".\"id\", \"u0\".\"name\", \"p1\".\"title\" FROM \"users\" AS \"u0\" INNER JOIN \"posts\" AS \"p1\" ON \"p1\".\"published\" AND \"p1\".\"user_id\" = \"u0\".\"id\""
  # pairs = for u in FUser.query, p in u.posts.query do [u, p] end
  # pairs.to_sql[0]  # => "SELECT \"u0\".\"id\", \"u0\".\"name\", \"p1\".\"id\", \"p1\".\"user_id\", \"p1\".\"title\", \"p1\".\"published\" FROM \"users\" AS \"u0\" INNER JOIN \"posts\" AS \"p1\" ON \"p1\".\"user_id\" = \"u0\".\"id\""
  # ```
  def flat_map[R](&f: Quoted[shareable (T) -> Query[R]] using Compare) -> Query[R]
    rows!("flat_map")
    unlocked!("flat_map")
    joinable!("flat_map")
    plan = Joins.plan(@sources, f.expr, f.captures, f.file, f.site)
    k = @sources.size
    base = @loader
    proc = f.proc
    Query[R].new(plan.sources, @wheres, @orders + plan.orders, true, nil, nil, Shape::Rows,
                 ->(rows: Array[Array[Fetched]]) {
                   # (The inner query of each distinct outer row, built once.)
                   memo: Hash[Array[Hash[Symbol, Object?]], Query[R]] = {}
                   rows.map do |r|
                     outer = r.take(k)
                     key = outer.map { |x| x.values }
                     q = if found = memo[key]?
                           found
                         else
                           built = proc.call(base.call([outer])[0])
                           memo = memo.put(key, built)
                           built
                         end
                     q.load_row(r.drop(k))
                   end
                 })
  end

  # Its rows paired with those of the association the block names
  # (`User.query.join { posts }`), joined by its key: Ecto's `assoc`,
  # Rails' `joins`. Conditions, orders and projections of the pairs
  # follow, with a parameter for each (`where { |u, p| p.published }`).
  #
  # ```
  # class JUser < Rotor::Model
  #   table "users" do
  #     column :id, Int, primary: true
  #     column :name, String
  #     has_many JPost, name: :posts, foreign_key: :user_id
  #   end
  # end
  #
  # class JPost < Rotor::Model
  #   table "posts" do
  #     column :id, Int, primary: true
  #     column :user_id, Int
  #     column :title, String
  #   end
  # end
  #
  # q = JUser.query.join { posts }.where { |u, p| p.title.start_with?("Q") }.select { |u, p| "#{u.name}: #{p.title}" }
  # q.to_sql  # => ["SELECT \"u0\".\"id\", \"u0\".\"name\", \"p1\".\"title\" FROM \"users\" AS \"u0\" INNER JOIN \"posts\" AS \"p1\" ON \"p1\".\"user_id\" = \"u0\".\"id\" WHERE \"p1\".\"title\" LIKE $1", ["Q%"]]
  # ```
  def join[R <: Model](&assoc: Quoted[shareable T.() -> HasMany[R]] using Compare) -> Query[[T, R]]
    proc = assoc.proc
    join_association(assoc.expr, assoc.file, assoc.site, ->(t: T) { t.instance_exec(&proc) })
  end

  # :ditto:
  def join[R <: Model](&assoc: Quoted[shareable (T) -> HasMany[R]] using Compare) -> Query[[T, R]]
    proc = assoc.proc
    join_association(assoc.expr, assoc.file, assoc.site, ->(t: T) { proc.call(t) })
  end

  # Its rows paired with the rows of `other` for which the block is true
  # (`User.query.join(Post) { |u, p| p.user_id == u.id }`): an INNER JOIN
  # on the condition, for models without an association or with several.
  def join[R <: Model](other: Type[R], &cond: Quoted[shareable (T, R) -> Bool] using Compare) -> Query[[T, R]]
    joining!
    joined = @sources + [Source.new(other.table_info, other, [], nil)]
    captures = cond.captures
    on = Binds.fill_sql(Cache.fetch(Cache::CONDITIONS, Cache.key(cond.site, joined), captures) do
      t, e = Translator.of(joined, cond.expr, captures, cond.file)
      [t.sql(e), t.guards]
    end, captures)
    base = @loader
    Query[[T, R]].new(@sources + [Source.new(other.table_info, other, [on], nil)], @wheres, @orders, false, nil, nil, Shape::Rows,
                      ->(rows: Array[Array[Fetched]]) {
                        ts = base.call(rows.map { |r| [r[0]] })
                        out: Array[[T, R]] = []
                        ts.each_with_index { |x, i| out = out + [[x, Joins.load(other, rows[i][1])]] }
                        out
                      })
  end

  # Its rows paired with the rows of an association of theirs (as
  # [join]), or with nil where a row has none: a LEFT JOIN. The blocks
  # after it take the right row as `R?`: `c.nil?` is the missing row
  # (its primary key NULL), and its columns are read where a condition
  # says it is there (`!c.nil? && c.code == "x"`, `c.nil? ? nil :
  # c.code`, `if c then c.code end`; `&.` cannot be quoted). [preload]
  # stays the way to load an association's models; a `has_many`'s LEFT
  # JOIN repeats the row for each of its models.
  #
  # ```
  # class LCustomer < Rotor::Model
  #   table "customers" do
  #     column :id, Int, primary: true
  #     column :name, String
  #     has_many LOrder, foreign_key: :customer_id
  #   end
  # end
  #
  # class LOrder < Rotor::Model
  #   table "orders" do
  #     column :id, Int, primary: true
  #     column :customer_id, Int
  #   end
  # end
  #
  # LCustomer.query.left_join { l_orders }.where { |c, o| o.nil? }.to_sql[0]
  # # => "SELECT \"c0\".\"id\", \"c0\".\"name\", \"o1\".\"id\", \"o1\".\"customer_id\" FROM \"customers\" AS \"c0\" LEFT JOIN \"orders\" AS \"o1\" ON \"o1\".\"customer_id\" = \"c0\".\"id\" WHERE \"o1\".\"id\" IS NULL"
  # ```
  def left_join[R <: Model](&assoc: Quoted[shareable T.() -> HasMany[R]] using Compare) -> Query[[T, R?]]
    proc = assoc.proc
    left_association(assoc.expr, assoc.file, assoc.site, ->(t: T) { t.instance_exec(&proc) })
  end

  # :ditto:
  def left_join[R <: Model](&assoc: Quoted[shareable (T) -> HasMany[R]] using Compare) -> Query[[T, R?]]
    proc = assoc.proc
    left_association(assoc.expr, assoc.file, assoc.site, ->(t: T) { proc.call(t) })
  end

  # Its rows paired with the rows of `other` for which the block is true,
  # or with nil where none is: a LEFT JOIN on the condition (as [join]'s),
  # the right row an `R?` in the blocks after it ([left_join] of an
  # association says how to read it).
  def left_join[R <: Model](other: Type[R], &cond: Quoted[shareable (T, R) -> Bool] using Compare) -> Query[[T, R?]]
    joining!
    keys = Query.left_keys(other.table_info, other.name)
    joined = @sources + [Source.new(other.table_info, other, [], nil)]
    captures = cond.captures
    on = Binds.fill_sql(Cache.fetch(Cache::CONDITIONS, Cache.key(cond.site, joined), captures) do
      t, e = Translator.of(joined, cond.expr, captures, cond.file)
      [t.sql(e), t.guards]
    end, captures)
    base = @loader
    Query[[T, R?]].new(@sources + [Source.new(other.table_info, other, [on], nil, keys, true)], @wheres, @orders, false, nil, nil, Shape::Rows,
                       ->(rows: Array[Array[Fetched]]) {
                         ts = base.call(rows.map { |r| [r[0]] })
                         out: Array[[T, R?]] = []
                         ts.each_with_index { |x, i| out = out + [[x, Query.left_row(other, keys, rows[i][1])]] }
                         out
                       })
  end

  # :nodoc:
  # The key of a LEFT JOIN's right table, which says whether its row is
  # there: `ArgumentError` for a table without one.
  def self.left_keys(t: TableInfo, name: String) -> Array[Symbol]
    keys = t.primary_keys
    raise ArgumentError.new("`left_join` of #{name}, which has no primary key: a missing row is told by it") if keys.empty?
    keys
  end

  # :nodoc:
  # The right model of a LEFT JOIN's row, or nil where it has none (its
  # key NULL).
  def self.left_row[R <: Model](target: Type[R], keys: Array[Symbol], f: Fetched) -> R?
    keys.all? { |k| f.values[k]?.nil? } ? nil : Joins.load(target, f)
  end

  # The number of rows: `SELECT count(*)`.
  def count -> Query[Int]
    unshaped!("count")
    unlocked!("count")
    Query[Int].new(@sources, @wheres, @orders, @projected, @limit, @offset, Shape::Count, ->(rows: Array[Array[Fetched]]) { rows.map { |r| r[0].values[:value]?.as(Int) } })
  end

  # Whether there is a row: `SELECT EXISTS (...)`.
  def exists -> Query[Bool]
    unshaped!("exists")
    unlocked!("exists")
    Query[Bool].new(@sources, @wheres, @orders, @projected, @limit, @offset, Shape::Exists, ->(rows: Array[Array[Fetched]]) { rows.map { |r| r[0].values[:value]?.as(Bool) } })
  end

  # The rows' deletion: `DELETE ... WHERE` with the query's conditions
  # (a query with an order, a limit, an offset or a projection cannot
  # say which rows).
  def delete -> Changes[T]
    plain!("delete")
    Changes[T].new(table, [Piece::Text.new("DELETE FROM #{Dialect.table(table.name, table.schema)}")] + outer_named(where_pieces), nil, @loader)
  end

  # The rows' update: the block gives a hash literal of columns and their
  # new values, expressions of the row as in [where] (`update { {age:
  # age + 1, name: "x"} }`).
  def update(&set: Quoted[shareable T.() -> Hash[Symbol, Object]] using Compare) -> Changes[T] = update_set(set.expr, set.captures, set.file, set.site)

  # :ditto:
  def update(&set: Quoted[shareable (T) -> Hash[Symbol, Object]] using Compare) -> Changes[T] = update_set(set.expr, set.captures, set.file, set.site)

  # The SQL statement and its parameters.
  def to_sql -> [String, Array[Object?]] = Statement.render(pieces)

  def inspect -> String = "#<Rotor::Query #{to_sql[0]}>"

  def to_s -> String = inspect

  # The statement's pieces.
  def pieces -> Array[Piece]
    from = from_pieces
    out = case @shape
          in Shape::Count
            if @limit || @offset
              [Piece::Text.new("SELECT count(*) FROM (SELECT 1")] + from + where_pieces + window + [Piece::Text.new(") AS \"q\"")]
            else
              [Piece::Text.new("SELECT count(*)")] + from + where_pieces
            end
          in Shape::Exists
            [Piece::Text.new("SELECT EXISTS (SELECT 1")] + from + where_pieces + window + [Piece::Text.new(")")]
          in Shape::Rows
            locking: Array[Piece] = []
            if l = @lock
              locking = [Piece::Text.new(l)]
            end
            [Piece::Text.new("SELECT ")] + select_list + from + where_pieces + order_pieces + window + locking
          end
    qualified(out)
  end

  private def left_association[R <: Model](expr: Meta::Expr, file: String, site: Int, get: shareable (T) -> HasMany[R]) -> Query[[T, R?]]
    joining!
    first = @sources[0]
    a, key = Cache.fetch(Cache::ASSOCIATIONS, Cache.key(site, @sources), Array[Object].new) do
      t, e = translator(expr, Array[Object].new, file)
      [Joins.association(t, e, 0, first), Array[Guard].new]
    end
    keys = Query.left_keys(a.target.table_info, a.target.name)
    target = Source.new(a.target.table_info, a.target, [Joins.key_condition(1, a.foreign_key, 0, key)], nil, keys, true)
    base = @loader
    Query[[T, R?]].new([Source.new(first.table, first.model, first.on, first.fetch, first.keep + [key]), target], @wheres, @orders, false, nil, nil, Shape::Rows,
                       ->(rows: Array[Array[Fetched]]) {
                         ts = base.call(rows.map { |r| [r[0]] })
                         out: Array[[T, R?]] = []
                         if one = ts.first?
                           model = get.call(one).target
                           ts.each_with_index { |x, i| out = out + [[x, Query.left_row(model, keys, rows[i][1])]] }
                         end
                         out
                       })
  end

  private def join_association[R <: Model](expr: Meta::Expr, file: String, site: Int, get: shareable (T) -> HasMany[R]) -> Query[[T, R]]
    joining!
    first = @sources[0]
    a, key = Cache.fetch(Cache::ASSOCIATIONS, Cache.key(site, @sources), Array[Object].new) do
      t, e = translator(expr, Array[Object].new, file)
      [Joins.association(t, e, 0, first), Array[Guard].new]
    end
    target = Source.new(a.target.table_info, a.target, [Joins.key_condition(1, a.foreign_key, 0, key)], nil)
    base = @loader
    # (The association's class, from the getter of a row: kept with its
    # key, whatever a `select` reads.)
    Query[[T, R]].new([Source.new(first.table, first.model, first.on, first.fetch, first.keep + [key]), target], @wheres, @orders, false, nil, nil, Shape::Rows,
                      ->(rows: Array[Array[Fetched]]) {
                        ts = base.call(rows.map { |r| [r[0]] })
                        out: Array[[T, R]] = []
                        if one = ts.first?
                          model = get.call(one).target
                          ts.each_with_index { |x, i| out = out + [[x, Joins.load(model, rows[i][1])]] }
                        end
                        out
                      })
  end

  # What the query does with its models for a preload, if it gives
  # models.
  private def ops -> ModelOps[T]? = @ops

  # (A join of a query of one table's models.)
  private def joining! -> Void
    rows!("join")
    single!("join")
    joinable!("join")
  end

  private def copy(*, wheres: Array[Sql] = @wheres, orders: Array[[Sql, Bool]] = @orders, limit: Int? = @limit, offset: Int? = @offset) -> Query[T]
    Query[T].new(@sources, wheres, orders, @projected, limit, offset, @shape, @loader, @preloads, ops, @lock, @single)
  end

  private def translator(expr: Meta::Expr, captures: Array[Object], file: String) -> [Translator, Meta::Expr]
    Translator.of(@sources, expr, captures, file)
  end

  # The translation of a condition's block, kept by its site
  # (`Rotor::Cache`), with this build's parameters.
  private def condition(expr: Meta::Expr, captures: Array[Object], file: String, site: Int, what: String) -> Sql
    # (An order key is a value, a condition is not: `email || name` is
    # one of them as a key, a `Bool` as a condition. Kept apart.)
    cache = what == "order" ? Cache::ORDERS : Cache::CONDITIONS
    kept = Cache.fetch(cache, Cache.key(site, @sources), captures) do
      t, e = translator(expr, captures, file)
      if what == "order"
        t.valued_check(e)
      end
      [what == "order" ? t.value(e) : t.sql(e), t.guards]
    end
    # (`ORDER BY 1` would be the first column. Checked on what the cache
    # gives too: one block may be given to `where` and to `order`.)
    if what == "order" && kept.known
      _, e = Translator.body(expr, file)
      raise UntranslatableError.new("an order by a constant cannot be translated to SQL (#{file}:#{Translator.line_of(e)})")
    end
    # (A key that can be NULL where Quarz has false would sort with the
    # true ones, after them.)
    if what == "order" && (null = kept.tri)
      _, e = Translator.body(expr, file)
      raise UntranslatableError.new(Translator.value_error(e, null, file))
    end
    if what == "order" && (tested = kept.test)
      _, e = Translator.body(expr, file)
      raise UntranslatableError.new(Translator.test_error(e, tested, file))
    end
    Binds.fill_sql(what == "order" ? Translator.order_key(kept) : kept, captures)
  end

  private def add_where(expr: Meta::Expr, captures: Array[Object], file: String, site: Int) -> Query[T]
    rows!("where")
    copy(wheres: @wheres + [condition(expr, captures, file, site, "where")])
  end

  private def add_order(expr: Meta::Expr, captures: Array[Object], file: String, site: Int) -> Query[T]
    rows!("order")
    copy(orders: @orders + [[condition(expr, captures, file, site, "order"), false]])
  end

  private def project[R](expr: Meta::Expr, file: String, site: Int, f: shareable (T) -> R) -> Query[R]
    rows!("select")
    unlocked!("select")
    raise ArgumentError.new("`select` after `preload`: a projection has no models to preload for") unless @preloads.empty?
    projection = Cache.fetch(Cache::READS, Cache.key(site, @sources), Array[Object].new) do
      t, e = translator(expr, Array[Object].new, file)
      # (A block that is one column of the one table, as it is: a
      # subquery can give it.)
      found = @sources.size == 1 ? t.column_of(e) : nil
      [Projection.new(t.reads(e), found ? found[1] : nil), Array[Guard].new]
    end
    reads = projection.reads
    single = projection.single
    base = @loader
    # (The row loaded with the columns fetched, then the block on it.)
    Query[R].new(@sources.each_with_index.map { |s, i| Joins.fetching(s, reads[i]) }, @wheres, @orders, true, @limit, @offset, @shape,
                 ->(rows: Array[Array[Fetched]]) { base.call(rows).map { |x| f.call(x) } }, [], nil, nil, single)
  end

  private def update_set(expr: Meta::Expr, captures: Array[Object], file: String, site: Int) -> Changes[T]
    plain!("update")
    sets = Cache.fetch(Cache::SETS, Cache.key(site, @sources), captures) do
      t, e = translator(expr, captures, file)
      [set_pieces(t, e, file), t.guards]
    end
    # (A value may read the row in a subquery too: `{flagged: Event.where
    # { |e| e.post_id == p.id }.exists?}`.)
    Changes[T].new(table, outer_named(Binds.fill(sets, captures) + where_pieces), nil, @loader)
  end

  # The `UPDATE ... SET` of `update`'s block `e`.
  private def set_pieces(t: Translator, e: Meta::Expr, file: String) -> Array[Piece]
    [Piece::Text.new("UPDATE #{Dialect.table(table.name, table.schema)} SET ").as(Piece)] + Statement.set_list(t, e, file, table, model_name, "update")
  end

  private def model_name -> String = @sources[0].model.name

  # (Conditions and orders are of the model's rows: before a projection,
  # a count or an exists.)
  # (A lock is of the rows a query gives as they are: not of a count, an
  # exists, a projection, or the rows a statement changes.)
  private def unlocked!(what: String) -> Void
    if @lock
      raise ArgumentError.new("`#{what}` of a query that locks its rows (`for_update`...): write the lock last, on the rows themselves")
    end
  end

  private def lock(what: String, mode: String, skip_locked: Bool, nowait: Bool) -> Query[T]
    rows!(what)
    raise ArgumentError.new("`#{what}` with both `skip_locked` and `nowait`: one or the other") if skip_locked && nowait
    raise ArgumentError.new("`#{what}` of a query that already locks its rows") if @lock
    wait = skip_locked ? " SKIP LOCKED" : (nowait ? " NOWAIT" : "")
    Query[T].new(@sources, @wheres, @orders, @projected, @limit, @offset, @shape, @loader, @preloads, ops, " FOR #{mode}#{wait}")
  end

  private def rows!(what: String) -> Void
    if @projected || @shape != Shape::Rows
      raise ArgumentError.new("`#{what}` after `select`, `count` or `exists`: write it before")
    end
  end

  # (A count or an exists is one row: nothing to window.)
  private def unshaped!(what: String) -> Void
    if @shape != Shape::Rows
      raise ArgumentError.new("`#{what}` after `count` or `exists`: write it before")
    end
  end

  # (A query of one table: what a key, a statement or a preload is of.)
  private def single!(what: String) -> Void
    raise ArgumentError.new("`#{what}` of a join: it is of one table's query") if @sources.size > 1
  end

  # (A join of every row: a limit or an offset is of the joined rows,
  # and a preload of the models alone, so both come after it.)
  private def joinable!(what: String) -> Void
    unlocked!(what)
    if @limit || @offset
      raise ArgumentError.new("`#{what}` of a query with a limit or an offset: write them after it")
    end
    raise ArgumentError.new("`#{what}` after `preload`: preload the models of one table's query") unless @preloads.empty?
  end

  private def plain!(what: String) -> Void
    single!(what)
    unlocked!(what)
    if !@orders.empty? || @limit || @offset || @projected || @shape != Shape::Rows
      raise ArgumentError.new("`#{what}` of a query with an order, a limit, an offset or a projection: only its conditions say which rows")
    end
  end

  # (A select of no column selects 1: a row is still one.)
  private def select_list -> Array[Piece]
    out: Array[Piece] = []
    @sources.each_with_index do |s, i|
      (s.fetch || s.table.columns).each do |c|
        out = out + [Piece::Text.new(", ")] unless out.empty?
        out = out + [Piece::Column.new(i, c.name)]
      end
    end
    out.empty? ? [Piece::Text.new("1").as(Piece)] : out
  end

  # ` FROM` its tables: in a join, each with its alias, joined by its
  # conditions.
  private def from_pieces -> Array[Piece]
    first = Dialect.table(table.name, table.schema)
    return [Piece::Text.new(" FROM #{first}").as(Piece)] if @sources.size == 1
    out: Array[Piece] = [Piece::Text.new(" FROM #{first} AS #{alias_of(0)}")]
    @sources.each_with_index do |s, i|
      next if i == 0
      name = "#{Dialect.table(s.table.name, s.table.schema)} AS #{alias_of(i)}"
      out = if s.on.empty?
              out + [Piece::Text.new(" CROSS JOIN #{name}")]
            else
              out + [Piece::Text.new(" #{s.left ? "LEFT" : "INNER"} JOIN #{name} ON ")] + conjunction(s.on)
            end
    end
    out
  end

  # The alias of table `i` in a join: its name's first letter and `i`
  # (`"u0"`, `"p1"`).
  private def alias_of(i: Int) -> String = Dialect.quote("#{@sources[i].table.name[0, 1].downcase}#{i}")

  # `pieces` with each column qualified by its table's alias in a join.
  private def qualified(pieces: Array[Piece]) -> Array[Piece]
    return outer_named(pieces) if @sources.size == 1
    pieces.map do |p|
      case p
      in Piece::Column(i, n) then Piece::Text.new("#{alias_of(i)}.#{Dialect.quote(n.to_s)}")
      in Piece::Outer(i, n) then Piece::Text.new("#{alias_of(i)}.#{Dialect.quote(n.to_s)}")
      else p
      end
    end
  end

  # `pieces` of a query of one table (not aliased), with the columns a
  # subquery reads of its row (`exists?`) qualified by the table.
  private def outer_named(pieces: Array[Piece]) -> Array[Piece]
    return pieces unless pieces.any? { |p| p.is_a?(Piece::Outer) }
    t = table
    pieces.map do |p|
      case p
      in Piece::Outer(_, n) then Piece::Text.new("#{Dialect.table(t.name, t.schema)}.#{Dialect.quote(n.to_s)}").as(Piece)
      else p
      end
    end
  end

  # `sqls` joined by AND.
  private def conjunction(sqls: Array[Sql]) -> Array[Piece]
    out: Array[Piece] = []
    sqls.each_with_index do |w, i|
      out = out + [Piece::Text.new(" AND ")] if i > 0
      out = out + (sqls.size > 1 && w.prec < Translator::AND + 1 ? [Piece::Text.new("(")] + w.pieces + [Piece::Text.new(")")] : w.pieces)
    end
    out
  end

  private def where_pieces -> Array[Piece]
    out: Array[Piece] = []
    return out if @wheres.empty?
    [Piece::Text.new(" WHERE ").as(Piece)] + conjunction(@wheres)
  end

  private def order_pieces -> Array[Piece]
    out: Array[Piece] = []
    return out if @orders.empty?
    out = [Piece::Text.new(" ORDER BY ")]
    @orders.each_with_index do |o, i|
      out = out + [Piece::Text.new(", ")] if i > 0
      # (A key's `NULLS FIRST`/`LAST` comes after its `DESC`.)
      key = o[0].pieces
      tail: Array[Piece] = []
      if Query.nulls_of(o[0])
        tail = [key[key.size - 1]]
        key = key[0...(key.size - 1)]
      end
      out = out + key
      out = out + [Piece::Text.new(" DESC")] if o[1]
      out = out + tail
    end
    out
  end

  # `nulls_first`, `nulls_last`: the last order's key with `NULLS ...`
  # after it.
  private def nulls(what: String, where: String) -> Query[T]
    last = @orders.last? || raise ArgumentError.new("`#{what}` without an `order` before it")
    key = last[0]
    raise ArgumentError.new("`#{what}` of an order that says where its NULLs go already") if Query.nulls_of(key)
    copy(orders: @orders[0...(@orders.size - 1)] + [[key.with(pieces: key.pieces + [Piece::Text.new(" NULLS #{where}").as(Piece)]), last[1]]])
  end

  # :nodoc:
  # Whether an order's key says where its NULLs go (its last piece).
  def self.nulls_of(key: Sql) -> Bool
    case key.pieces.last?
    in Piece::Text(t) then t.start_with?(" NULLS ")
    else false
    end
  end

  private def window -> Array[Piece]
    out: Array[Piece] = []
    if n = @limit
      out = out + [Piece::Text.new(" LIMIT #{n}")]
    end
    if n = @offset
      out = out + [Piece::Text.new(" OFFSET #{n}")]
    end
    out
  end
end
