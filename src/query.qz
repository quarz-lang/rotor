# What a model's table is, for the statements made from its values and
# the repository that sets its timestamps.
data TableInfo = (name: String, columns: Array[Column], primary_key: Symbol?, created_at: Symbol?, updated_at: Symbol?, associations: Array[Association] = [])

# A table a query reads: the first, or one joined to it, with the
# conditions of its JOIN (`INNER JOIN ... ON` them, `CROSS JOIN` for
# none), the columns it fetches (nil for all of them), and those it
# fetches whatever a `select` reads (the key an association's join
# needs).
data Source = (table: TableInfo, model: Type[Object], on: Array[Sql], fetch: Array[Column]?, keep: Array[Symbol] = [])

# The values of a row's columns from one of a query's tables, and
# whether those are all of the table's columns.
data Fetched = (values: Hash[Symbol, Object?], all: Bool)

# How a query's rows become `T`s: from the values each of its tables
# gave, row by row.
type Loader[T] = shareable (Array[Array[Fetched]]) -> Array[T]

# What a query of models does with them for a preload
# (`Rotor::Query#preload`): a row as a model, and a row with the
# associations preloaded for it.
data ModelOps[T] = (as_model: shareable (T) -> Model, attach: shareable (T, Hash[Symbol, Array[Model]]) -> T)

# A query over a model's table, as a value: what `Rotor::Model.where`
# and the others build, and a repository runs. Each method gives a new
# query; none changes the one it is called on. Its blocks are not run:
# they are translated to SQL when the query is built, so that a block
# SQL cannot express raises `Rotor::UntranslatableError` there, and
# `to_sql` gives the statement and its parameters.
#
# ```
# class QUser < Rotor::Model
#   table "users" do
#     column :id, Int, primary: true
#     column :name, String
#     column :age, Int
#   end
# end
#
# min = 18
# q = QUser.where { age >= min }.order { name }.limit(10)
# q.to_sql  # => ["SELECT \"id\", \"name\", \"age\" FROM \"users\" WHERE \"age\" >= $1 ORDER BY \"name\" LIMIT 10", [18]]
# ```
#
# `T` is what a row gives: the model, or what `select` projects.
#
# A query is `Shareable`: a constant (`ACTIVE = User.where { active }`),
# a value a task's block captures or a channel carries. Its blocks'
# translations are kept for the process (`Rotor::Cache`), so building a
# query again where it was built before costs no translation.
class Query[T]
  include Shareable
  # What a query gives: its rows, their number, or whether there is one.
  enum Shape = Rows | Count | Exists

  # Its tables: the model's, then those joined to it.
  @sources: Array[Source]
  @wheres: Array[Sql]
  @orders: Array[[Sql, Bool]]
  # Whether `select` made it (or a `flat_map`, whose rows the block's
  # queries give).
  @projected: Bool
  @loader: Loader[T]
  @limit: Int?
  @offset: Int?
  @shape: Shape
  # The associations to preload for its rows, and how (a query of
  # models: nil after `select`).
  @preloads: Array[Preload]
  # (Its `ModelOps`, as procedures: a `ModelOps[T]` is Shareable only
  # by its argument.)
  @as_model: (shareable (T) -> Model)?
  @attach: (shareable (T, Hash[Symbol, Array[Model]]) -> T)?

  # (Made by `Rotor::Model.query` and the methods of this class.)
  def initialize(@sources: Array[Source], @wheres: Array[Sql], @orders: Array[[Sql, Bool]], @projected: Bool, @limit: Int?, @offset: Int?, @shape: Shape, @loader: Loader[T], @preloads: Array[Preload] = [], ops: ModelOps[T]? = nil)
    @as_model = ops&.as_model
    @attach = ops&.attach
  end

  # The table (the first, in a join).
  def table -> TableInfo = @sources[0].table

  # Its tables: the first, then those joined to it.
  def sources -> Array[Source] = @sources

  # The columns its rows have, in order (each table's in turn, in a
  # join): what `to_sql` selects.
  def fetched -> Array[Column] = @sources.flat_map { |s| s.fetch || s.table.columns }

  # What it gives: its rows, their number, or whether there is one.
  def shape -> Shape = @shape

  # Its limit, if any.
  def limit_value -> Int? = @limit

  # The rows whose column `name` is `value` (the repository's `get`).
  def where_key(name: Symbol, value: Object?) -> Query[T]
    rows!("where_key")
    single!("where_key")
    c = table.columns.find { |x| x.name == name } || raise ArgumentError.new("`#{table.name}` has no column `#{name}`")
    col = Piece::Column.new(0, c.name)
    s = if value.nil?
          Sql.new([col, Piece::Text.new(" IS NULL")], Translator::IS, nil, nil, false)
        else
          Sql.new([col, Piece::Text.new(" = "), Piece::Param.new(Binds.parameter(value))], Translator::CMP, nil, nil, false)
        end
    copy(wheres: @wheres + [s])
  end

  # The rows whose column `name` is one of `values`: `"name" IN ($1,
  # ...)`, FALSE for none (a preload's query).
  def where_in(name: Symbol, values: Array[Value]) -> Query[T]
    rows!("where_in")
    single!("where_in")
    c = table.columns.find { |x| x.name == name } || raise ArgumentError.new("`#{table.name}` has no column `#{name}`")
    if values.empty?
      return copy(wheres: @wheres + [Sql.new([Piece::Text.new("FALSE")], Translator::ATOM, nil, false, true)])
    end
    pieces: Array[Piece] = [Piece::Column.new(0, c.name), Piece::Text.new(" IN (")]
    values.each_with_index do |v, i|
      pieces = pieces + [Piece::Text.new(", ")] if i > 0
      pieces = pieces + [Piece::Param.new(v)]
    end
    copy(wheres: @wheres + [Sql.new(pieces + [Piece::Text.new(")")], Translator::LIKE, nil, nil, false)])
  end

  # Ordered by the column `name` too (nil: unchanged): a preload's query.
  def order_by_key(name: Symbol?) -> Query[T]
    return self unless name
    single!("order_by_key")
    copy(orders: @orders + [[Sql.new([Piece::Column.new(0, name)], Translator::ATOM, nil, nil, false), false]])
  end

  # A row's `T` from the values of its table's columns (those of
  # `fetched`), for a query of one table.
  def load(values: Hash[Symbol, Object?]) -> T
    single!("load")
    @loader.call([[Fetched.new(values, @sources[0].fetch.nil?)]])[0]
  end

  # A row's `T` from the values of each of its tables.
  def load_row(values: Array[Fetched]) -> T = @loader.call([values])[0]

  # The `T`s of the rows a database gave for `to_sql`.
  def load_rows(rows: Array[Row]) -> Array[T]
    case @shape
    in Shape::Count
      @loader.call(rows.map { |r| [Fetched.new({value: r.int(0)}, true)] })
    in Shape::Exists
      @loader.call(rows.map { |r| [Fetched.new({value: r.bool(0)}, true)] })
    in Shape::Rows
      lists = @sources.map { |s| s.fetch || s.table.columns }
      @loader.call(rows.map do |r|
        at = 0
        lists.each_with_index.map do |cols, i|
          values: Hash[Symbol, Object?] = {}
          cols.each do |c|
            values = values.put(c.name, r.value(at, c.type))
            at += 1
          end
          Fetched.new(values, @sources[i].fetch.nil?)
        end
      end)
    end
  end

  # The rows for which the block is true. The row is the block's
  # receiver (`where { age > 18 }`) or its parameter (`where { |u|
  # u.age > 18 }`, which `for` comprehensions use); a block that names
  # nothing of the row (`where { true }`) is ambiguous between the two:
  # write `where { |u| true }`.
  def where(&cond: Quoted[shareable T.() -> Bool] using Compare) -> Query[T] = add_where(cond.expr, cond.captures, cond.file, cond.site)

  # :ditto:
  def where(&cond: Quoted[shareable (T) -> Bool] using Compare) -> Query[T] = add_where(cond.expr, cond.captures, cond.file, cond.site)

  # `where`, by the name `for` comprehensions call.
  def filter(&cond: Quoted[shareable (T) -> Bool] using Compare) -> Query[T] = add_where(cond.expr, cond.captures, cond.file, cond.site)

  # Ordered by the block's value, ascending, after the orders given before.
  def order(&key: Quoted[shareable T.() -> Object] using Compare) -> Query[T] = add_order(key.expr, key.captures, key.file, key.site)

  # :ditto:
  def order(&key: Quoted[shareable (T) -> Object] using Compare) -> Query[T] = add_order(key.expr, key.captures, key.file, key.site)

  # The last order descending.
  def desc -> Query[T]
    last = @orders.last? || raise ArgumentError.new("`desc` without an `order` before it")
    copy(orders: @orders[0...(@orders.size - 1)] + [[last[0], true]])
  end

  # At most `n` rows.
  def limit(n: Int) -> Query[T]
    unshaped!("limit")
    raise ArgumentError.new("a negative limit: #{n}") if n < 0
    copy(limit: n)
  end

  # The rows after the first `n`.
  def offset(n: Int) -> Query[T]
    unshaped!("offset")
    raise ArgumentError.new("a negative offset: #{n}") if n < 0
    copy(offset: n)
  end

  # Its rows with the associations the block names preloaded, as
  # `Rotor::Repo#preload` does after they are loaded (`repo.all(User.query.preload
  # { posts })`): Ecto's `preload:`.
  def preload(&spec: Quoted[shareable T.() -> Object] using Compare) -> Query[T]
    rows!("preload")
    ops || raise ArgumentError.new("`preload` of a query that does not give models")
    added = Cache.fetch(Cache::PRELOADS, Cache.key(spec.site, @sources), Array[Object].new) do
      [Preloads.parse(table, @sources[0].model.name, spec.expr, spec.file), Array[Guard].new]
    end
    Query[T].new(@sources, @wheres, @orders, @projected, @limit, @offset, @shape, @loader, Preloads.merge(@preloads + added), ops)
  end

  # The rows `repo` loaded with the preloads done (`preload`).
  def preloaded(rows: Array[T], repo: Repo) -> Array[T]
    ops = self.ops
    return rows if @preloads.empty? || ops.nil?
    found = Preloads.run(repo, rows.map { |r| ops.as_model.call(r) }, table, @preloads)
    rows.each_with_index.map { |r, i| ops.attach.call(r, found[i]) }
  end

  # The first row: `limit(1)`.
  def first -> Query[T] = limit(1)

  # The block's value for each row: a column (`select { name }`), an
  # expression, or a `data` value made of them (`select { Summary.new(id,
  # name) }`). The block is evaluated in Quarz, not in SQL: the query
  # fetches the columns it reads (all of them when it calls another
  # method of the row or passes the row on), and the repository runs it
  # on each row, loaded with those columns only (reading another raises
  # `Rotor::NotLoadedError`). Counting is `count`, a query's shape, not
  # a projection.
  def select[R](&f: Quoted[shareable T.() -> R] using Compare) -> Query[R]
    proc = f.proc
    project(f.expr, f.file, f.site, ->(row: T) { row.instance_exec(&proc) })
  end

  # :ditto:
  def select[R](&f: Quoted[shareable (T) -> R] using Compare) -> Query[R]
    proc = f.proc
    project(f.expr, f.file, f.site, ->(row: T) { proc.call(row) })
  end

  # `select`, by the name `for` comprehensions call.
  def map[R](&f: Quoted[shareable (T) -> R] using Compare) -> Query[R]
    proc = f.proc
    project(f.expr, f.file, f.site, ->(row: T) { proc.call(row) })
  end

  # The rows of the queries the block gives for each row, in one query
  # with a JOIN: what a `for` comprehension over several queries calls
  # (Quarz's docs/01 §11). The block's query is a model's (`Post.where
  # { ... }`, or its `query`), with `where`, `filter`, `order` and `desc`,
  # and a last `map`, `select` or `flat_map`, or an association's
  # (`u.posts.query`, joined by its key); its conditions, those on the row
  # (`u`) included, are the JOIN's, its orders come after this query's.
  # Its rows are made by the block, run for each distinct row of this
  # query (with the columns the block reads of it): building the inner
  # query again costs some microseconds per row, so a large result reads
  # better through `join`, which makes pairs.
  #
  # ```
  # class FUser < Rotor::Model
  #   table "users" do
  #     column :id, Int, primary: true
  #     column :name, String
  #     has_many FPost, name: :posts, foreign_key: :user_id
  #   end
  # end
  #
  # class FPost < Rotor::Model
  #   table "posts" do
  #     column :id, Int, primary: true
  #     column :user_id, Int
  #     column :title, String
  #     column :published, Bool, default: false
  #   end
  # end
  #
  # q = for u in FUser.query, p in FPost.where { published } when p.user_id == u.id do [u.name, p.title] end
  # q.to_sql[0]  # => "SELECT \"u0\".\"id\", \"u0\".\"name\", \"p1\".\"title\" FROM \"users\" AS \"u0\" INNER JOIN \"posts\" AS \"p1\" ON \"p1\".\"published\" AND \"p1\".\"user_id\" = \"u0\".\"id\""
  # pairs = for u in FUser.query, p in u.posts.query do [u, p] end
  # pairs.to_sql[0]  # => "SELECT \"u0\".\"id\", \"u0\".\"name\", \"p1\".\"id\", \"p1\".\"user_id\", \"p1\".\"title\", \"p1\".\"published\" FROM \"users\" AS \"u0\" INNER JOIN \"posts\" AS \"p1\" ON \"p1\".\"user_id\" = \"u0\".\"id\""
  # ```
  def flat_map[R](&f: Quoted[shareable (T) -> Query[R]] using Compare) -> Query[R]
    rows!("flat_map")
    joinable!("flat_map")
    plan = Joins.plan(@sources, f.expr, f.captures, f.file, f.site)
    k = @sources.size
    base = @loader
    proc = f.proc
    Query[R].new(plan.sources, @wheres, @orders + plan.orders, true, nil, nil, Shape::Rows,
                 ->(rows: Array[Array[Fetched]]) {
                   # (The inner query of each distinct outer row, built once.)
                   memo: Hash[Array[Hash[Symbol, Object?]], Query[R]] = {}
                   rows.map do |r|
                     outer = r.take(k)
                     key = outer.map { |x| x.values }
                     q = if found = memo[key]?
                           found
                         else
                           built = proc.call(base.call([outer])[0])
                           memo = memo.put(key, built)
                           built
                         end
                     q.load_row(r.drop(k))
                   end
                 })
  end

  # Its rows paired with those of the association the block names
  # (`User.query.join { posts }`), joined by its key: Ecto's `assoc`,
  # Rails' `joins`. Conditions, orders and projections of the pairs
  # follow, with a parameter for each (`where { |u, p| p.published }`).
  #
  # ```
  # class JUser < Rotor::Model
  #   table "users" do
  #     column :id, Int, primary: true
  #     column :name, String
  #     has_many JPost, name: :posts, foreign_key: :user_id
  #   end
  # end
  #
  # class JPost < Rotor::Model
  #   table "posts" do
  #     column :id, Int, primary: true
  #     column :user_id, Int
  #     column :title, String
  #   end
  # end
  #
  # q = JUser.query.join { posts }.where { |u, p| p.title.start_with?("Q") }.select { |u, p| "#{u.name}: #{p.title}" }
  # q.to_sql  # => ["SELECT \"u0\".\"id\", \"u0\".\"name\", \"p1\".\"title\" FROM \"users\" AS \"u0\" INNER JOIN \"posts\" AS \"p1\" ON \"p1\".\"user_id\" = \"u0\".\"id\" WHERE \"p1\".\"title\" LIKE $1", ["Q%"]]
  # ```
  def join[R <: Model](&assoc: Quoted[shareable T.() -> HasMany[R]] using Compare) -> Query[[T, R]]
    proc = assoc.proc
    join_association(assoc.expr, assoc.file, assoc.site, ->(t: T) { t.instance_exec(&proc) })
  end

  # :ditto:
  def join[R <: Model](&assoc: Quoted[shareable (T) -> HasMany[R]] using Compare) -> Query[[T, R]]
    proc = assoc.proc
    join_association(assoc.expr, assoc.file, assoc.site, ->(t: T) { proc.call(t) })
  end

  # Its rows paired with the rows of `other` for which the block is true
  # (`User.query.join(Post) { |u, p| p.user_id == u.id }`): an INNER JOIN
  # on the condition, for models without an association or with several.
  def join[R <: Model](other: Type[R], &cond: Quoted[shareable (T, R) -> Bool] using Compare) -> Query[[T, R]]
    joining!
    joined = @sources + [Source.new(other.table_info, other, [], nil)]
    captures = cond.captures
    on = Binds.fill_sql(Cache.fetch(Cache::CONDITIONS, Cache.key(cond.site, joined), captures) do
      t, e = Translator.of(joined, cond.expr, captures, cond.file)
      [t.sql(e), t.guards]
    end, captures)
    base = @loader
    Query[[T, R]].new(@sources + [Source.new(other.table_info, other, [on], nil)], @wheres, @orders, false, nil, nil, Shape::Rows,
                      ->(rows: Array[Array[Fetched]]) {
                        ts = base.call(rows.map { |r| [r[0]] })
                        out: Array[[T, R]] = []
                        ts.each_with_index { |x, i| out = out + [[x, Joins.load(other, rows[i][1])]] }
                        out
                      })
  end

  # The number of rows: `SELECT count(*)`.
  def count -> Query[Int]
    unshaped!("count")
    Query[Int].new(@sources, @wheres, @orders, @projected, @limit, @offset, Shape::Count, ->(rows: Array[Array[Fetched]]) { rows.map { |r| r[0].values[:value]?.as(Int) } })
  end

  # Whether there is a row: `SELECT EXISTS (...)`.
  def exists -> Query[Bool]
    unshaped!("exists")
    Query[Bool].new(@sources, @wheres, @orders, @projected, @limit, @offset, Shape::Exists, ->(rows: Array[Array[Fetched]]) { rows.map { |r| r[0].values[:value]?.as(Bool) } })
  end

  # The rows' deletion: `DELETE ... WHERE` with the query's conditions
  # (a query with an order, a limit, an offset or a projection cannot
  # say which rows).
  def delete -> Statement
    plain!("delete")
    Statement.new(table, [Piece::Text.new("DELETE FROM #{Dialect.quote(table.name)}")] + where_pieces, nil)
  end

  # The rows' update: the block gives a hash literal of columns and their
  # new values, expressions of the row as in `where` (`update { {age:
  # age + 1, name: "x"} }`).
  def update(&set: Quoted[shareable T.() -> Hash[Symbol, Object]] using Compare) -> Statement = update_set(set.expr, set.captures, set.file, set.site)

  # :ditto:
  def update(&set: Quoted[shareable (T) -> Hash[Symbol, Object]] using Compare) -> Statement = update_set(set.expr, set.captures, set.file, set.site)

  # The SQL statement and its parameters.
  def to_sql -> [String, Array[Object?]] = Statement.render(pieces)

  def inspect -> String = "#<Rotor::Query #{to_sql[0]}>"

  def to_s -> String = inspect

  # The statement's pieces.
  def pieces -> Array[Piece]
    from = from_pieces
    out = case @shape
          in Shape::Count
            if @limit || @offset
              [Piece::Text.new("SELECT count(*) FROM (SELECT 1")] + from + where_pieces + window + [Piece::Text.new(") AS \"q\"")]
            else
              [Piece::Text.new("SELECT count(*)")] + from + where_pieces
            end
          in Shape::Exists
            [Piece::Text.new("SELECT EXISTS (SELECT 1")] + from + where_pieces + window + [Piece::Text.new(")")]
          in Shape::Rows
            [Piece::Text.new("SELECT ")] + select_list + from + where_pieces + order_pieces + window
          end
    qualified(out)
  end

  private def join_association[R <: Model](expr: Meta::Expr, file: String, site: Int, get: shareable (T) -> HasMany[R]) -> Query[[T, R]]
    joining!
    first = @sources[0]
    a, key = Cache.fetch(Cache::ASSOCIATIONS, Cache.key(site, @sources), Array[Object].new) do
      t, e = translator(expr, Array[Object].new, file)
      [Joins.association(t, e, 0, first), Array[Guard].new]
    end
    target = Source.new(a.target.table_info, a.target, [Joins.key_condition(1, a.foreign_key, 0, key)], nil)
    base = @loader
    # (The association's class, from the getter of a row: kept with its
    # key, whatever a `select` reads.)
    Query[[T, R]].new([Source.new(first.table, first.model, first.on, first.fetch, first.keep + [key]), target], @wheres, @orders, false, nil, nil, Shape::Rows,
                      ->(rows: Array[Array[Fetched]]) {
                        ts = base.call(rows.map { |r| [r[0]] })
                        out: Array[[T, R]] = []
                        if one = ts.first?
                          model = get.call(one).target
                          ts.each_with_index { |x, i| out = out + [[x, Joins.load(model, rows[i][1])]] }
                        end
                        out
                      })
  end

  # What the query does with its models for a preload, if it gives
  # models.
  private def ops -> ModelOps[T]?
    a = @as_model
    b = @attach
    a && b ? ModelOps[T].new(a, b) : nil
  end

  # (A join of a query of one table's models.)
  private def joining! -> Void
    rows!("join")
    single!("join")
    joinable!("join")
  end

  private def copy(*, wheres: Array[Sql] = @wheres, orders: Array[[Sql, Bool]] = @orders, limit: Int? = @limit, offset: Int? = @offset) -> Query[T]
    Query[T].new(@sources, wheres, orders, @projected, limit, offset, @shape, @loader, @preloads, ops)
  end

  private def translator(expr: Meta::Expr, captures: Array[Object], file: String) -> [Translator, Meta::Expr]
    Translator.of(@sources, expr, captures, file)
  end

  # The translation of a condition's block, kept by its site
  # (`Rotor::Cache`), with this build's parameters.
  private def condition(expr: Meta::Expr, captures: Array[Object], file: String, site: Int, what: String) -> Sql
    kept = Cache.fetch(Cache::CONDITIONS, Cache.key(site, @sources), captures) do
      t, e = translator(expr, captures, file)
      [t.sql(e), t.guards]
    end
    # (`ORDER BY 1` would be the first column. Checked on what the cache
    # gives too: one block may be given to `where` and to `order`.)
    if what == "order" && kept.known
      _, e = Translator.body(expr, file)
      raise UntranslatableError.new("an order by a constant cannot be translated to SQL (#{file}:#{Translator.line_of(e)})")
    end
    # (A key that can be NULL where Quarz has false would sort with the
    # true ones, after them.)
    if what == "order" && (null = kept.tri)
      _, e = Translator.body(expr, file)
      raise UntranslatableError.new(Translator.value_error(e, null, file))
    end
    Binds.fill_sql(kept, captures)
  end

  private def add_where(expr: Meta::Expr, captures: Array[Object], file: String, site: Int) -> Query[T]
    rows!("where")
    copy(wheres: @wheres + [condition(expr, captures, file, site, "where")])
  end

  private def add_order(expr: Meta::Expr, captures: Array[Object], file: String, site: Int) -> Query[T]
    rows!("order")
    copy(orders: @orders + [[condition(expr, captures, file, site, "order"), false]])
  end

  private def project[R](expr: Meta::Expr, file: String, site: Int, f: shareable (T) -> R) -> Query[R]
    rows!("select")
    raise ArgumentError.new("`select` after `preload`: a projection has no models to preload for") unless @preloads.empty?
    reads = Cache.fetch(Cache::READS, Cache.key(site, @sources), Array[Object].new) do
      t, e = translator(expr, Array[Object].new, file)
      [t.reads(e), Array[Guard].new]
    end
    base = @loader
    # (The row loaded with the columns fetched, then the block on it.)
    Query[R].new(@sources.each_with_index.map { |s, i| Joins.fetching(s, reads[i]) }, @wheres, @orders, true, @limit, @offset, @shape,
                 ->(rows: Array[Array[Fetched]]) { base.call(rows).map { |x| f.call(x) } })
  end

  private def update_set(expr: Meta::Expr, captures: Array[Object], file: String, site: Int) -> Statement
    plain!("update")
    sets = Cache.fetch(Cache::SETS, Cache.key(site, @sources), captures) do
      t, e = translator(expr, captures, file)
      [set_pieces(t, e, file), t.guards]
    end
    Statement.new(table, Binds.fill(sets, captures) + where_pieces, nil)
  end

  # The `UPDATE ... SET` of `update`'s block `e`.
  private def set_pieces(t: Translator, e: Meta::Expr, file: String) -> Array[Piece]
    pairs = case e
            in Meta::Expr::HashLit(ps, _) then ps
            in _ then t.untranslatable("an `update` block that is not a hash literal", Translator.line_of(e))
            end
    t.untranslatable("an `update` of no column", Translator.line_of(e)) if pairs.empty?
    sets: Array[Piece] = [Piece::Text.new("UPDATE #{Dialect.quote(table.name)} SET ")]
    seen: Array[Symbol] = []
    pairs.each_with_index do |pair, i|
      key, value = pair
      name = case key
             in Meta::Expr::Lit(Symbol => s, _) then s
             else t.untranslatable("an `update` key that is not a symbol", Translator.line_of(key))
             end
      c = table.columns.find { |x| x.name == name } ||
        raise ArgumentError.new("#{model_name} has no column `#{name}` (#{file}:#{Translator.line_of(key)})")
      if seen.include?(name)
        raise ArgumentError.new("an `update` of `#{name}` twice (#{file}:#{Translator.line_of(key)})")
      end
      seen = seen + [name]
      v = t.operand(value)
      if v.known
        x = v.value
        if x.nil?
          raise ArgumentError.new("#{model_name}##{name} cannot be nil (#{file}:#{Translator.line_of(value)})") unless c.null
        elsif c.type == Float && x.is_a?(Int)
          v = Binds.to_float(v, x.as(Int))
        elsif !x.is_a?(c.type)
          raise ArgumentError.new("#{model_name}##{name} takes #{c.type.name}, not #{x.class.name} (#{file}:#{Translator.line_of(value)})")
        end
      end
      sets = sets + [Piece::Text.new(", ")] if i > 0
      sets = sets + [Piece::Text.new("#{Dialect.quote(name.to_s)} = ")] + v.pieces
    end
    sets
  end

  private def model_name -> String = @sources[0].model.name

  # (Conditions and orders are of the model's rows: before a projection,
  # a count or an exists.)
  private def rows!(what: String) -> Void
    if @projected || @shape != Shape::Rows
      raise ArgumentError.new("`#{what}` after `select`, `count` or `exists`: write it before")
    end
  end

  # (A count or an exists is one row: nothing to window.)
  private def unshaped!(what: String) -> Void
    if @shape != Shape::Rows
      raise ArgumentError.new("`#{what}` after `count` or `exists`: write it before")
    end
  end

  # (A query of one table: what a key, a statement or a preload is of.)
  private def single!(what: String) -> Void
    raise ArgumentError.new("`#{what}` of a join: it is of one table's query") if @sources.size > 1
  end

  # (A join of every row: a limit or an offset is of the joined rows,
  # and a preload of the models alone, so both come after it.)
  private def joinable!(what: String) -> Void
    if @limit || @offset
      raise ArgumentError.new("`#{what}` of a query with a limit or an offset: write them after it")
    end
    raise ArgumentError.new("`#{what}` after `preload`: preload the models of one table's query") unless @preloads.empty?
  end

  private def plain!(what: String) -> Void
    single!(what)
    if !@orders.empty? || @limit || @offset || @projected || @shape != Shape::Rows
      raise ArgumentError.new("`#{what}` of a query with an order, a limit, an offset or a projection: only its conditions say which rows")
    end
  end

  # (A select of no column selects 1: a row is still one.)
  private def select_list -> Array[Piece]
    out: Array[Piece] = []
    @sources.each_with_index do |s, i|
      (s.fetch || s.table.columns).each do |c|
        out = out + [Piece::Text.new(", ")] unless out.empty?
        out = out + [Piece::Column.new(i, c.name)]
      end
    end
    out.empty? ? [Piece::Text.new("1").as(Piece)] : out
  end

  # ` FROM` its tables: in a join, each with its alias, joined by its
  # conditions.
  private def from_pieces -> Array[Piece]
    first = Dialect.quote(table.name)
    return [Piece::Text.new(" FROM #{first}").as(Piece)] if @sources.size == 1
    out: Array[Piece] = [Piece::Text.new(" FROM #{first} AS #{alias_of(0)}")]
    @sources.each_with_index do |s, i|
      next if i == 0
      name = "#{Dialect.quote(s.table.name)} AS #{alias_of(i)}"
      out = if s.on.empty?
              out + [Piece::Text.new(" CROSS JOIN #{name}")]
            else
              out + [Piece::Text.new(" INNER JOIN #{name} ON ")] + conjunction(s.on)
            end
    end
    out
  end

  # The alias of table `i` in a join: its name's first letter and `i`
  # (`"u0"`, `"p1"`).
  private def alias_of(i: Int) -> String = Dialect.quote("#{@sources[i].table.name[0, 1].downcase}#{i}")

  # `pieces` with each column qualified by its table's alias in a join.
  private def qualified(pieces: Array[Piece]) -> Array[Piece]
    return pieces if @sources.size == 1
    pieces.map do |p|
      case p
      in Piece::Column(i, n) then Piece::Text.new("#{alias_of(i)}.#{Dialect.quote(n.to_s)}")
      else p
      end
    end
  end

  # `sqls` joined by AND.
  private def conjunction(sqls: Array[Sql]) -> Array[Piece]
    out: Array[Piece] = []
    sqls.each_with_index do |w, i|
      out = out + [Piece::Text.new(" AND ")] if i > 0
      out = out + (sqls.size > 1 && w.prec < Translator::AND + 1 ? [Piece::Text.new("(")] + w.pieces + [Piece::Text.new(")")] : w.pieces)
    end
    out
  end

  private def where_pieces -> Array[Piece]
    out: Array[Piece] = []
    return out if @wheres.empty?
    [Piece::Text.new(" WHERE ").as(Piece)] + conjunction(@wheres)
  end

  private def order_pieces -> Array[Piece]
    out: Array[Piece] = []
    return out if @orders.empty?
    out = [Piece::Text.new(" ORDER BY ")]
    @orders.each_with_index do |o, i|
      out = out + [Piece::Text.new(", ")] if i > 0
      out = out + o[0].pieces
      out = out + [Piece::Text.new(" DESC")] if o[1]
    end
    out
  end

  private def window -> Array[Piece]
    out: Array[Piece] = []
    if n = @limit
      out = out + [Piece::Text.new(" LIMIT #{n}")]
    end
    if n = @offset
      out = out + [Piece::Text.new(" OFFSET #{n}")]
    end
    out
  end
end
