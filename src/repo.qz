# Runs queries and statements ([Rotor::Query], [Rotor::Statement])
# against a database, through an adapter, and loads what they give.
#
# ```quarz no_run
# class RUser < Rotor::Model
#   table "users" do
#     column :id, Int, primary: true
#     column :name, String
#     column :age, Int, default: 0
#     timestamps
#   end
# end
#
# PG::Pool.open("postgres://app@localhost/shop") do |pool|
#   repo = Rotor::Repo.new(pool: pool)
#   u = repo.insert(RUser.new(name: "Ann"))   # its id and timestamps set
#   repo.all(RUser.where { age >= 18 })     # Array[RUser]
#   repo.transaction { |tx| tx.update(u.with(age: 41)) }
# end
# ```
#
# Models are immutable: [insert], [update] and [touch] give the model as
# saved, the one given unchanged. Timestamps (`timestamps` in a `table`
# block) are set here, never by SQL: [insert] sets both to now (in UTC, to the microsecond, as the
# database keeps them), keeping a creation time the model has; [update]
# sets the update time when a column changed, and issues no UPDATE when
# none did; [touch] sets it alone. [update], [touch] and [delete] of a
# model whose row no longer exists raise [Rotor::StaleError].
class Repo
  @adapter: Adapter

  # Over a pg pool: each statement takes a connection.
  def initialize(*, pool: ::PG::Pool)
    @adapter = Adapters::PG.new(pool: pool)
  end

  # Over one pg connection.
  def initialize(*, connection: ::PG::Connection)
    @adapter = Adapters::PG.new(connection: connection)
  end

  # Over any adapter.
  def initialize(@adapter: Adapter)
  end

  # The adapter.
  def adapter -> Adapter = @adapter

  # Runs a statement: how many rows it changed.
  def run(statement: Statement) -> Int
    sql, params = statement.to_sql
    @adapter.query(sql, params).affected || 0
  end

  # Runs a query: its rows.
  def run[T](query: Query[T]) -> Array[T]
    sql, params = query.to_sql
    query.preloaded(query.load_rows(@adapter.query(sql, params).rows), self)
  end

  # The query's rows: `run(query)`.
  def all[T](query: Query[T]) -> Array[T] = run(query)

  # The rows a statement changed, as it gives them back (`returning`):
  # models of the columns returned, as `select` loads them (reading
  # another raises [Rotor::NotLoadedError]), in the order the server
  # gives them (`repo.all(q.update { ... }.returning(:id))`).
  # [ArgumentError] for a statement without `returning`.
  def all[T](statement: Changes[T]) -> Array[T]
    names = statement.returned || raise ArgumentError.new("`all` of a statement without `returning`: name the columns it gives back (`returning(:id)`), or all of them (`returning`); `run` gives the count")
    columns = statement.table.columns
    cols = names.map { |n| columns.find { |c| c.name == n }.as(Column) }
    whole = columns.all? { |c| names.include?(c.name) }
    sql, params = statement.to_sql
    found = @adapter.query(sql, params).rows.map { |row| [Fetched.new(Repo.values(row, cols), whole)] }
    statement.rows(found)
  end

  # The query's one row, or nil; raises [Rotor::MultipleResultsError]
  # when there are more.
  def one[T](query: Query[T]) -> T?
    q = query.limit_value ? query : query.limit(2)
    rows = run(q)
    raise MultipleResultsError.new("#{rows.size} rows where one was expected: #{query.to_sql[0]}") if rows.size > 1
    rows.first?
  end

  # The query's one row; raises [Rotor::NoResultsError] when there is
  # none, [Rotor::MultipleResultsError] when there are more.
  def one![T](query: Query[T]) -> T
    found = one(query)
    found.nil? ? raise NoResultsError.new("no row: #{query.to_sql[0]}") : found
  end

  # The query's first row, or nil.
  def first[T](query: Query[T]) -> T? = run(query.first).first?

  # The `model` whose primary key is `id`, or nil. For a composite key
  # `id` is a Hash of every key column's value (`{sensor_id: "a",
  # taken_at: t}`), which a single key may take too; [ArgumentError]
  # for a Hash that names a column not in the key or leaves one out,
  # and for a value that is not a Hash with a composite key.
  #
  # A key's value is cast to its column's type as [Rotor::Query#where_key]
  # casts it, so an id from a URL may be given as it came: a [String]
  # that does not cast (`"abc"`, or a blank one, for an integer key)
  # names no record and gives nil, while a value of a class the column
  # never takes (a [Float] for an integer key) raises [ArgumentError].
  # Several strings name the same row: surrounding blanks, a sign and
  # leading zeros are accepted, so `"7"`, `" 7"`, `"+7"` and `"007"` all
  # find id 7. Code that authorizes or caches by id does it by the key of
  # the model found (`user.id`), not by the string it was given.
  def get[M <: Model](model: Type[M], id: Object) -> M?
    q = model.query
    t = q.table
    keys = t.keys!
    case id
    in Hash => given
      named = given.keys.map { |k| k.as?(Symbol) || raise ArgumentError.new("`get` of #{model.name}: a key's column is named by a Symbol, not #{k.inspect}") }
      if (extra = named.find { |k| !keys.include?(k) })
        raise ArgumentError.new("`get` of #{model.name}: `#{extra}` is not a column of its primary key (#{keys.join(", ")})")
      end
      if (missing = keys.find { |k| !named.include?(k) })
        raise ArgumentError.new("`get` of #{model.name}: no value for `#{missing}` of its primary key (#{keys.join(", ")})")
      end
      keys.each do |k|
        return nil if Repo.uncast?(t, k, given[k]?)
        q = q.where_key(k, given[k]?)
      end
      one(q)
    else
      if keys.size > 1
        raise ArgumentError.new("`get` of #{model.name}, whose primary key is composite: give a Hash of #{keys.join(", ")}")
      end
      return nil if Repo.uncast?(t, keys[0], id)
      one(q.where_key(keys[0], id))
    end
  end

  # :nodoc:
  # Whether `value` is a [String] that key column `name` of `t` cannot
  # cast ([Rotor::Query.key_value]): `get` finds no row for it.
  def self.uncast?(t: TableInfo, name: Symbol, value: Object?) -> Bool
    if (s = value.as?(String)) && (c = t.columns.find { |x| x.name == name })
      Query.key_value(c, s).nil?
    else
      false
    end
  end

  # The models with the associations the block names preloaded: one
  # query per association and level, `WHERE key = ANY($1)`, for all the
  # models at once. The block names them as the getters `table`
  # generates, so that a misspelling does not compile: `{ posts }`,
  # `{ [posts, account] }`, and those of their models with `nest`
  # (`{ nest(posts) { comments } }`). An association a model has
  # preloaded already is not loaded again. Models are values: the ones
  # given are left as they were.
  def preload[M <: Model](models: Array[M], &spec: Quoted[shareable M.() -> Object] using Compare) -> Array[M] = preload_all(models, spec.expr, spec.file)

  # :ditto:
  def preload[M <: Model](model: M, &spec: Quoted[shareable M.() -> Object] using Compare) -> M = preload_all([model], spec.expr, spec.file)[0]

  # The number of the query's rows.
  def count[T](query: Query[T]) -> Int = run(query.count).first? || 0

  # Whether the query has a row.
  def exists?[T](query: Query[T]) -> Bool = run(query.exists).first? || false

  # Inserts `model`'s row, its timestamps set first, and gives the model
  # the row reads back (its key, the database's defaults), unchanged.
  def insert[M <: Model](model: M) -> M
    t = model.table_info
    stamped = Repo.stamped(model)
    sql, params = Statement.insert(stamped).returning.to_sql
    rows = @adapter.query(sql, params)
    row = rows.rows.first? || return stamped
    stamped.loaded(Repo.values(row, t.columns))
  end

  # Runs an insert that says what to do on a conflict
  # (`Rotor::Statement.insert(m).on_conflict(...)`), its model's
  # timestamps set first as [insert] sets them, and its `do_update` the
  # update time too (`"updated_at" = EXCLUDED."updated_at"`) when the
  # table has one and the block does not set it: the row as it is after
  # it (inserted, or updated by `do_update`), read back, unchanged; nil
  # when the conflict left the row as it was (`do_nothing`, or a
  # `do_update` whose `where` was false). [ArgumentError] for an insert
  # without a conflict clause: [insert] runs those.
  def upsert[M <: Model](insert: Insert[M]) -> M?
    raise ArgumentError.new("`upsert` of an insert that says nothing on a conflict: `on_conflict` first, or `insert` the model") unless insert.conflict?
    raise ArgumentError.new("`upsert` of the rows of several models: `insert_all` runs those") if insert.models.size > 1
    stamped = Repo.stamped(insert.model)
    sql, params = insert.with_models([stamped]).with_update_time.returning.to_sql
    row = @adapter.query(sql, params).rows.first? || return nil
    stamped.loaded(Repo.values(row, stamped.table_info.columns))
  end

  # Inserts the rows of `models` (of one class), their timestamps set
  # first as [insert] sets them (one time for all), as
  # `insert_all(Rotor::Statement.insert_all(models))` does (below: its
  # statements, and their transaction): the rows as they read back
  # (their keys, the database's defaults), as models. Nothing is run
  # for no models.
  def insert_all[M <: Model](models: Array[M]) -> Array[M]
    return Array[M].new if models.empty?
    insert_all(Statement.insert_all(models))
  end

  # Runs an insert of many rows (`Rotor::Statement.insert_all(models)`,
  # and what it does on a conflict, `on_conflict`, its `do_update`
  # setting the update time as [upsert]'s does): the rows the
  # statement gave back, as models. Those are all of them for an insert
  # without a conflict clause, those inserted or updated for one with
  # it (a row `do_nothing` or a false `where` skipped gives none).
  # PostgreSQL does not promise that RETURNING follows the order of
  # the VALUES rows: match the rows to the models by a key when the
  # order matters.
  #
  # The statements. Each statement's text is prepared and kept by the
  # connection (pg's statement cache), one per row count, and a cached
  # insert of many rows holds much memory on the server (about 850 KiB
  # for 1000 rows of 5 columns), so a plain insert and one with
  # `do_nothing` of more than `SPLIT_ABOVE` (16) rows go in statements
  # whose row counts are powers of two, the largest first (1000 rows:
  # 512, 256, 128, 64, 32 and 8): at most one text per power for a
  # table's columns, whatever the batches' sizes (rotor#137). A batch
  # of 16 rows or fewer is one statement, as on its own: small texts
  # cost little, and a split would cost round trips.
  #
  # A `do_update` is never split: PostgreSQL refuses a statement in
  # which two rows conflict with each other (21000, "cannot affect row a
  # second time"), while rows in two statements update in turn, and
  # rotor cannot know from the model whether two different values are
  # one key on the server (a citext or case-insensitive column, a `real`
  # column, a column's precision). So a bulk `do_update` keeps one
  # statement, and one cached text, per row count. Two rows whose target
  # columns of `on_conflict(*columns)` hold the same values, as sent,
  # none of them NULL, are refused before anything is sent, at every
  # size ([ArgumentError] naming the columns), as PostgreSQL would refuse
  # them in one statement whatever the columns' types (rotor#145); not
  # with `where` (PostgreSQL accepts two rows of one key there when the
  # condition leaves the existing row alone) nor with
  # `on_conflict(constraint: ...)`, whose columns rotor does not know.
  # Past PostgreSQL's 65535 parameters any insert is split, a
  # `do_update` into as few statements as hold it: there, two rows that
  # differ here but are one key on the server (`"A"` and `"a"` under
  # citext) are refused when they share a statement and update in turn
  # when they do not.
  #
  # Several statements run in one transaction: the one open (inside
  # it, nothing of their own; a failure aborts that transaction, as any
  # failed statement does), or else one of their own (BEGIN ... COMMIT,
  # rolled back on a failure), so a failure in a later statement leaves
  # nothing of the earlier ones. One statement runs as it is.
  def insert_all[M <: Model](insert: Insert[M]) -> Array[M] = insert_chunked(insert, MAX_PARAMS)

  # The most parameters PostgreSQL takes in one statement.
  MAX_PARAMS = 65535

  # :nodoc:
  # The most rows of a plain or `do_nothing` insert that go in one
  # statement whatever their number ([insert_all]); a larger batch is
  # split into statements of powers of two rows.
  SPLIT_ABOVE = 16

  # :nodoc:
  # `insert_all` with statements of at most `max_params` parameters.
  def insert_chunked[M <: Model](insert: Insert[M], max_params: Int) -> Array[M]
    now = Repo.now
    stamped = insert.models.map { |m| Repo.stamped(m, now) }
    template = stamped[0]
    columns = template.table_info.columns
    per_row = Statement.insert_columns(stamped.map { |m| m.as(Model) }).size
    room = max_params - insert.conflict_params
    size = per_row == 0 ? stamped.size : room / per_row
    raise ArgumentError.new("`insert_all`: a row of #{per_row} parameters and a conflict clause of #{insert.conflict_params} pass #{max_params}") if size < 1
    keys = insert.update_keys
    Repo.refuse_same_keys(stamped.map { |m| m.as(Model) }, keys) unless keys.empty?
    chunks = if insert.updates? || stamped.size <= SPLIT_ABOVE
               stamped.each_slice(size).to_a
             else
               out: Array[Array[M]] = []
               at = 0
               Repo.chunk_sizes(stamped.size, size).each do |n|
                 out = out.push(stamped[at...(at + n)])
                 at += n
               end
               out
             end
    run_chunk = ->(r: Repo, ms: Array[M]) {
      sql, params = insert.with_models(ms).with_update_time.returning.to_sql
      r.adapter.query(sql, params).rows.map { |row| template.restore(Checkpoint.new(Hash[Symbol, Value?].new, [], nil)).loaded(Repo.values(row, columns)) }
    }
    return run_chunk.call(self, chunks[0]) if chunks.size == 1
    if @adapter.in_transaction?
      chunks.flat_map { |ms| run_chunk.call(self, ms) }
    else
      transaction { |tx| chunks.flat_map { |ms| run_chunk.call(tx, ms) } }
    end
  end

  # :nodoc:
  # Raises [ArgumentError] when two of `models` have, in every column of
  # `keys`, the same value as sent (pg's parameter text), none of them
  # NULL nor a float's NaN: the rows of one `do_update` that PostgreSQL
  # refuses to update twice in one statement, whatever the column's
  # type (rotor#145). Names the columns, not the values.
  def self.refuse_same_keys(models: Array[Model], keys: Array[Symbol]) -> Void
    seen: Hash[Array[Bytes], Bool] = {}
    models.each do |m|
      sent = Repo.sent_key(m, keys)
      next if sent.nil?
      if seen.key?(sent)
        names = keys.map { |k| "`#{k}`" }
        listed = names.size == 1 ? names[0] : "#{names.take(names.size - 1).join(", ")} and #{names.last? || ""}"
        raise ArgumentError.new("`insert_all` with `do_update`: two rows of the batch have the same #{listed} " +
                                "(PostgreSQL refuses to update a row twice in one statement)")
      end
      seen = seen.put(sent, true)
    end
  end

  # :nodoc:
  # The values of `m`'s columns `keys` as pg sends them, or nil when one
  # is NULL (no key) or a float's NaN (as Quarz's `==` says, not the
  # same as another).
  def self.sent_key(m: Model, keys: Array[Symbol]) -> Array[Bytes]?
    values = m.to_h
    out: Array[Bytes] = []
    keys.each do |k|
      v = values[k]?
      return nil if v.nil?
      if (f = v.as?(Float)) && f.nan?
        return nil
      end
      out = out.push(PG::Connection.encode(v) || Bytes.new)
    end
    out
  end

  # :nodoc:
  # The row counts of the statements of an insert of `n` rows, at most
  # `cap` each: powers of two, the largest first, each the largest that
  # fits what is left and `cap` (`n`'s binary digits when `cap` is
  # larger).
  #
  # ```
  # Rotor::Repo.chunk_sizes(1000, 13107)   # => [512, 256, 128, 64, 32, 8]
  # Rotor::Repo.chunk_sizes(5, 4)          # => [4, 1]
  # Rotor::Repo.chunk_sizes(12, 3)         # => [2, 2, 2, 2, 2, 2]
  # ```
  def self.chunk_sizes(n: Int, cap: Int) -> Array[Int]
    out: Array[Int] = []
    left = n
    while left > 0
      c = 1
      c = c * 2 while c * 2 <= left && c * 2 <= cap
      out = out.push(c)
      left -= c
    end
    out
  end

  # :nodoc:
  # `model` with the timestamps an insert sets: its creation time unless
  # given, its update time, `now`.
  def self.stamped[M <: Model](model: M, now: Time = Repo.now) -> M
    t = model.table_info
    stamps: Hash[Symbol, Object?] = {}
    if c = t.created_at
      stamps = stamps.put(c, now) unless model.to_h[c]?
    end
    if u = t.updated_at
      stamps = stamps.put(u, now)
    end
    model.with_values(stamps)
  end

  # Inserts the changeset's model ([Rotor::Changeset#apply], with its
  # timestamps as [insert] sets them) and its `put_assoc` sets: [Rotor::Outcome::Ok]
  # with the model as saved, or [Rotor::Outcome::Invalid] with the changeset when it has
  # errors or the database refused the row by a constraint it declares
  # (`unique_constraint`...), which becomes an error on its field. Any
  # other error raises. Inside a transaction the save runs under a
  # savepoint, so that an [Rotor::Outcome::Invalid] leaves the transaction usable.
  def insert[M <: Model](changeset: Changeset[M]) -> Outcome[M] = save(changeset, :insert)

  # As [insert], with [Rotor::Outcome::Invalid] raised as [Rotor::InvalidChangeset].
  def insert![M <: Model](changeset: Changeset[M]) -> M = Repo.unwrap(insert(changeset))

  # Updates the row of the changeset's model with its changes (no
  # statement when there are none) and replaces its `put_assoc` sets, as
  # [insert] does.
  def update[M <: Model](changeset: Changeset[M]) -> Outcome[M] = save(changeset, :update)

  # As [update], with [Rotor::Outcome::Invalid] raised as [Rotor::InvalidChangeset].
  def update![M <: Model](changeset: Changeset[M]) -> M = Repo.unwrap(update(changeset))

  # Deletes the row of the changeset's model, as `delete(model)`: [Rotor::Outcome::Ok]
  # with it, or [Rotor::Outcome::Invalid] for errors or a declared constraint
  # (`no_assoc_constraint`: rows of another table still refer to it).
  def delete[M <: Model](changeset: Changeset[M]) -> Outcome[M] = save(changeset, :delete)

  private def save[M <: Model](changeset: Changeset[M], action: Symbol) -> Outcome[M]
    cs = changeset.with_action(action)
    return Outcome::Invalid.new(cs) unless cs.valid?
    model = cs.applied
    begin
      saved = guarded do |r|
        done = case action
               in :insert then r.insert(model)
               in :update then r.update(model)
               else r.delete(cs.data)
               end
        unless action == :delete
          cs.assocs.each_pair { |name, targets| r.replace_through(done, name, targets) }
          done = done.with_preloaded(cs.assocs) unless cs.assocs.empty?
        end
        done
      end
      Outcome::Ok.new(saved)
    rescue ::PG::ServerError => e
      found = cs.constraint_error(e) || raise e
      Outcome::Invalid.new(cs.with(errors: cs.errors + [found]))
    end
  end

  # The block's value, run in a transaction, or under a savepoint when
  # the repository is in one already.
  private def guarded[R](&: (Repo) -> R) -> R
    unless @adapter.in_transaction?
      return transaction { |tx| yield tx }
    end
    exec("SAVEPOINT rotor_save")
    settled = false
    begin
      result = yield self
      exec("RELEASE SAVEPOINT rotor_save")
      settled = true
      result
    ensure
      # (Whatever stopped the block, a cancellation too; a failure here
      # leaves the block's error to propagate.)
      unless settled
        begin
          exec("ROLLBACK TO SAVEPOINT rotor_save")
          exec("RELEASE SAVEPOINT rotor_save")
        rescue StandardError
          nil
        end
      end
    end
  end

  # :nodoc:
  # Makes the `has_many ..., through:` association `name` of the saved
  # `owner` exactly `targets`: the join rows pairing it with others
  # deleted, the missing ones inserted.
  def replace_through(owner: Model, name: Symbol, targets: Array[Model]) -> Void
    info = owner.table_info
    a = info.associations.find { |x| x.name == name } || raise SchemaError.new("#{owner.class.name} has no association `#{name}`")
    k = Through.keys(owner.class, a)
    pk = info.single_key("`#{info.name}`", "`#{name}`")
    # (`nil?`, not `||`: a `Bool` key may be false.)
    id = owner.to_h[pk]?
    raise MissingAttributeError.new("#{owner.class.name}##{pk} is not set") if id.nil?
    ids: Array[Value] = targets.map do |t|
      tk = t.to_h[k.target_pk]?
      raise ArgumentError.new("`put_assoc` of a #{t.class.name} without its #{k.target_pk}: save it first") if tk.nil?
      tk.as(Value)
    end
    ji = k.join.table_info
    join = Dialect.table(ji.name, ji.schema)
    q = ->(n: Symbol) { Dialect.quote(n.to_s) }
    key_type = k.join.table_info.columns.find { |c| c.name == k.target_key }.as(Column).type
    have = query("SELECT #{q.call(k.target_key)} FROM #{join} WHERE #{q.call(k.owner_key)} = $1", [id]) { |r| r.value(0, key_type) }
    have.uniq.each do |t|
      next if ids.include?(t.as(Value))
      exec("DELETE FROM #{join} WHERE #{q.call(k.owner_key)} = $1 AND #{q.call(k.target_key)} = $2", [id, t])
    end
    ids.uniq.each do |t|
      next if have.include?(t)
      values: Hash[Symbol, Object?] = {k.owner_key => id, k.target_key => t}
      insert(k.join.load(values))
    end
  end

  # The value of [Rotor::Outcome::Ok]; [Rotor::Outcome::Invalid] raised as [Rotor::InvalidChangeset].
  def self.unwrap[M <: Model](outcome: Outcome[M]) -> M
    case outcome
    in Outcome::Ok(value) then value
    in Outcome::Invalid(cs) then raise InvalidChangeset.new(cs, cs.errors, cs.summary)
    end
  end

  # Updates `model`'s row with the columns assigned since it was loaded
  # (and its update time), and gives the model as saved, unchanged; does
  # nothing when none were.
  def update[M <: Model](model: M) -> M
    return model unless model.changed?
    stamped = if u = model.table_info.updated_at
                model.with_values({u => Repo.now})
              else
                model
              end
    stale!(stamped) if changed(Statement.update(stamped).as(Statement)) == 0
    stamped.clear_changes
  end

  # Sets `model`'s update time, and the [Time] columns named, to now, and
  # writes those alone: the model with them, its other assignments still
  # pending.
  def touch[M <: Model](model: M, *columns: Symbol) -> M
    t = model.table_info
    names = columns.uniq
    if u = t.updated_at
      names = names + [u] unless names.include?(u)
    end
    raise ArgumentError.new("`#{t.name}` has no update time, and no column was named") if names.empty?
    by_key = Statement.by_key(model)
    pending = model.changed - names
    now = Repo.now
    values: Hash[Symbol, Object?] = {}
    names.each { |n| values = values.put(n, now) }
    touched = model.with_values(values)
    pieces: Array[Piece] = [Piece::Text.new("UPDATE #{Dialect.table(t.name, t.schema)} SET ")]
    names.each_with_index do |n, i|
      pieces = pieces + [Piece::Text.new(", ")] if i > 0
      pieces = pieces + [Piece::Text.new("#{Dialect.quote(n.to_s)} = "), Piece::Param.new(now)]
    end
    pieces = pieces + by_key
    stale!(model) if changed(Statement.new(t, pieces, nil)) == 0
    touched.keep_changes(pending)
  end

  # Deletes `model`'s row, and gives the model; raises
  # [Rotor::StaleError] when there was none.
  def delete[M <: Model](model: M) -> M
    stale!(model) if changed(Statement.delete(model)) == 0
    model
  end

  # Deletes the query's rows: how many.
  def delete_all[T](query: Query[T]) -> Int = run(query.delete)

  # Updates the query's rows as the block says ([Rotor::Query#update];
  # no timestamps are set): how many.
  def update_all[T](query: Query[T], &set: Quoted[shareable T.() -> Hash[Symbol, Object]] using Compare) -> Int = run(query.update(&set))

  # :ditto:
  def update_all[T](query: Query[T], &set: Quoted[shareable (T) -> Hash[Symbol, Object]] using Compare) -> Int = run(query.update(&set))

  # Runs the block in a transaction, with a repository bound to it:
  # committed when the block returns, rolled back when it raises.
  # Transactions do not nest (pg raises [PG::TransactionError] for one
  # inside another).
  def transaction[R](&: (Repo) -> R) -> R
    results: Array[R] = []
    @adapter.transaction do |a|
      results = results + [yield Repo.new(a)]
      nil
    end
    results[0]
  end

  # Runs raw SQL: the count the server reported (the rows changed, or a
  # SELECT's rows; 0 for none).
  def exec(sql: String, params: Array[Object?] = []) -> Int = @adapter.query(sql, params).affected || 0

  # Runs raw SQL and loads its rows as `model`s, by the result's column
  # names (columns it does not give are left unloaded).
  def query[M <: Model](model: Type[M], sql: String, params: Array[Object?] = []) -> Array[M]
    rows = @adapter.query(sql, params)
    q = model.query
    names = rows.columns
    cols = q.table.columns
    found = names.map { |n| cols.find { |c| c.name.to_s == n } }
    all = cols.all? { |c| names.include?(c.name.to_s) }
    rows.rows.map do |r|
      values: Hash[Symbol, Object?] = {}
      found.each_with_index do |c, i|
        values = values.put(c.name, r.column_value(i, c)) if c
      end
      all ? model.load(values) : model.load_partial(values)
    end
  end

  # Runs raw SQL and gives the block's value for each row, read with
  # [Rotor::Row]'s typed readers.
  def query[R](sql: String, params: Array[Object?] = [], &: (Row) -> R) -> Array[R]
    @adapter.query(sql, params).rows.map { |r| yield r }
  end

  # How many rows a statement changed, as the server reported it (nil
  # for an adapter that does not say).
  private def changed(statement: Statement) -> Int?
    sql, params = statement.to_sql
    @adapter.query(sql, params).affected
  end

  # (A statement by the model's key changed no row.)
  private def stale!(model: Model) -> Nothing
    values = model.to_h
    info = model.table_info
    hidden = info.columns.select { |c| c.redact }.map { |c| c.name }
    named = info.primary_keys.map { |k| " #{k}: #{show_attr(hidden, k, values[k]?)}" }.join(",")
    raise StaleError.new("#{model.class.name}#{named}: its row no longer exists")
  end

  private def preload_all[M <: Model](models: Array[M], expr: Meta::Expr, file: String) -> Array[M]
    first = models.first? || return models
    if other = models.find { |m| m.class != first.class }
      raise ArgumentError.new("`preload` of models of one class: #{first.class.name} and #{other.class.name}")
    end
    info = first.table_info
    found = Preloads.run(self, models.map { |m| m.as(Model) }, info, Preloads.parse(info, first.class.name, expr, file))
    models.each_with_index.map { |m, i| m.with_preloaded(found[i]) }
  end

  # Now, in UTC, to the microsecond: what a timestamp column keeps.
  def self.now -> Time
    t = Time.now.utc
    Time.at(t.to_i).utc + MICROSECOND * t.usec
  end

  MICROSECOND = 1.ms * 0.001

  # A row's values by column, read with each column's type.
  def self.values(row: Row, columns: Array[Column]) -> Hash[Symbol, Object?]
    values: Hash[Symbol, Object?] = {}
    columns.each_with_index { |c, i| values = values.put(c.name, row.column_value(i, c)) }
    values
  end
end
