# Runs queries and statements (`Rotor::Query`, `Rotor::Statement`)
# against a database, through an adapter, and loads what they give.
#
# ```quarz no_run
# class RUser < Rotor::Model
#   table "users" do
#     column :id, Int, primary: true
#     column :name, String
#     column :age, Int, default: 0
#     timestamps
#   end
# end
#
# PG::Pool.open("postgres://app@localhost/shop") do |pool|
#   repo = Rotor::Repo.new(pool: pool)
#   u = repo.insert(RUser.new(name: "Ann"))   # its id and timestamps set
#   repo.all(RUser.where { age >= 18 })     # Array[RUser]
#   repo.transaction { |tx| tx.update(u.with(age: 41)) }
# end
# ```
#
# Models are immutable: `insert`, `update` and `touch` give the model as
# saved, the one given unchanged. Timestamps (`timestamps` in a `table`
# block) are set here, never by SQL: `insert` sets both to now (in UTC, to the microsecond, as the
# database keeps them), keeping a creation time the model has; `update`
# sets the update time when a column changed, and issues no UPDATE when
# none did; `touch` sets it alone. `update`, `touch` and `delete` of a
# model whose row no longer exists raise `Rotor::StaleError`.
class Repo
  @adapter: Adapter

  # Over a pg pool: each statement takes a connection.
  def initialize(*, pool: ::PG::Pool)
    @adapter = Adapters::PG.new(pool: pool)
  end

  # Over one pg connection.
  def initialize(*, connection: ::PG::Connection)
    @adapter = Adapters::PG.new(connection: connection)
  end

  # Over any adapter.
  def initialize(@adapter: Adapter)
  end

  # The adapter.
  def adapter -> Adapter = @adapter

  # Runs a statement: how many rows it changed.
  def run(statement: Statement) -> Int
    sql, params = statement.to_sql
    @adapter.query(sql, params).affected || 0
  end

  # Runs a query: its rows.
  def run[T](query: Query[T]) -> Array[T]
    sql, params = query.to_sql
    query.preloaded(query.load_rows(@adapter.query(sql, params).rows), self)
  end

  # The query's rows: `run(query)`.
  def all[T](query: Query[T]) -> Array[T] = run(query)

  # The query's one row, or nil; raises `Rotor::MultipleResultsError`
  # when there are more.
  def one[T](query: Query[T]) -> T?
    q = query.limit_value ? query : query.limit(2)
    rows = run(q)
    raise MultipleResultsError.new("#{rows.size} rows where one was expected: #{query.to_sql[0]}") if rows.size > 1
    rows.first?
  end

  # The query's one row; raises `Rotor::NoResultsError` when there is
  # none, `Rotor::MultipleResultsError` when there are more.
  def one![T](query: Query[T]) -> T
    found = one(query)
    found.nil? ? raise NoResultsError.new("no row: #{query.to_sql[0]}") : found
  end

  # The query's first row, or nil.
  def first[T](query: Query[T]) -> T? = run(query.first).first?

  # The `model` whose primary key is `id`, or nil.
  def get[M <: Model](model: Type[M], id: Object) -> M?
    q = model.query
    key = q.table.primary_key || raise ArgumentError.new("`#{q.table.name}` has no primary key")
    one(q.where_key(key, id))
  end

  # The models with the associations the block names preloaded: one
  # query per association and level, `WHERE key = ANY($1)`, for all the
  # models at once. The block names them as the getters `table`
  # generates, so that a misspelling does not compile: `{ posts }`,
  # `{ [posts, account] }`, and those of their models with `nest`
  # (`{ nest(posts) { comments } }`). An association a model has
  # preloaded already is not loaded again. Models are values: the ones
  # given are left as they were.
  def preload[M <: Model](models: Array[M], &spec: Quoted[shareable M.() -> Object] using Compare) -> Array[M] = preload_all(models, spec.expr, spec.file)

  # :ditto:
  def preload[M <: Model](model: M, &spec: Quoted[shareable M.() -> Object] using Compare) -> M = preload_all([model], spec.expr, spec.file)[0]

  # The number of the query's rows.
  def count[T](query: Query[T]) -> Int = run(query.count).first? || 0

  # Whether the query has a row.
  def exists?[T](query: Query[T]) -> Bool = run(query.exists).first? || false

  # Inserts `model`'s row, its timestamps set first, and gives the model
  # the row reads back (its key, the database's defaults), unchanged.
  def insert[M <: Model](model: M) -> M
    t = model.table_info
    now = Repo.now
    stamps: Hash[Symbol, Object?] = {}
    if c = t.created_at
      stamps = stamps.put(c, now) unless model.to_h[c]?
    end
    if u = t.updated_at
      stamps = stamps.put(u, now)
    end
    stamped = model.with_values(stamps)
    sql, params = Statement.insert(stamped).returning.to_sql
    rows = @adapter.query(sql, params)
    row = rows.rows.first? || return stamped
    stamped.loaded(Repo.values(row, t.columns))
  end

  # Inserts the changeset's model (`Rotor::Changeset#apply`, with its
  # timestamps as `insert` sets them) and its `put_assoc` sets: `Rotor::Outcome::Ok`
  # with the model as saved, or `Rotor::Outcome::Invalid` with the changeset when it has
  # errors or the database refused the row by a constraint it declares
  # (`unique_constraint`...), which becomes an error on its field. Any
  # other error raises. Inside a transaction the save runs under a
  # savepoint, so that an `Rotor::Outcome::Invalid` leaves the transaction usable.
  def insert[M <: Model](changeset: Changeset[M]) -> Outcome[M] = save(changeset, :insert)

  # As `insert`, with `Rotor::Outcome::Invalid` raised as `Rotor::InvalidChangeset`.
  def insert![M <: Model](changeset: Changeset[M]) -> M = Repo.unwrap(insert(changeset))

  # Updates the row of the changeset's model with its changes (no
  # statement when there are none) and replaces its `put_assoc` sets, as
  # `insert` does.
  def update[M <: Model](changeset: Changeset[M]) -> Outcome[M] = save(changeset, :update)

  # As `update`, with `Rotor::Outcome::Invalid` raised as `Rotor::InvalidChangeset`.
  def update![M <: Model](changeset: Changeset[M]) -> M = Repo.unwrap(update(changeset))

  # Deletes the row of the changeset's model, as `delete(model)`: `Rotor::Outcome::Ok`
  # with it, or `Rotor::Outcome::Invalid` for errors or a declared constraint
  # (`no_assoc_constraint`: rows of another table still refer to it).
  def delete[M <: Model](changeset: Changeset[M]) -> Outcome[M] = save(changeset, :delete)

  private def save[M <: Model](changeset: Changeset[M], action: Symbol) -> Outcome[M]
    cs = changeset.with_action(action)
    return Outcome::Invalid.new(cs) unless cs.valid?
    model = cs.applied
    begin
      saved = guarded do |r|
        done = case action
               in :insert then r.insert(model)
               in :update then r.update(model)
               else r.delete(cs.data)
               end
        unless action == :delete
          cs.assocs.each_pair { |name, targets| r.replace_through(done, name, targets) }
          done = done.with_preloaded(cs.assocs) unless cs.assocs.empty?
        end
        done
      end
      Outcome::Ok.new(saved)
    rescue ::PG::ServerError => e
      found = cs.constraint_error(e) || raise e
      Outcome::Invalid.new(cs.with(errors: cs.errors + [found]))
    end
  end

  # The block's value, run in a transaction, or under a savepoint when
  # the repository is in one already.
  private def guarded[R](&: (Repo) -> R) -> R
    unless @adapter.in_transaction?
      return transaction { |tx| yield tx }
    end
    exec("SAVEPOINT rotor_save")
    settled = false
    begin
      result = yield self
      exec("RELEASE SAVEPOINT rotor_save")
      settled = true
      result
    ensure
      # (Whatever stopped the block, a cancellation too; a failure here
      # leaves the block's error to propagate.)
      unless settled
        begin
          exec("ROLLBACK TO SAVEPOINT rotor_save")
          exec("RELEASE SAVEPOINT rotor_save")
        rescue StandardError
          nil
        end
      end
    end
  end

  # :nodoc:
  # Makes the `has_many ..., through:` association `name` of the saved
  # `owner` exactly `targets`: the join rows pairing it with others
  # deleted, the missing ones inserted.
  def replace_through(owner: Model, name: Symbol, targets: Array[Model]) -> Void
    info = owner.table_info
    a = info.associations.find { |x| x.name == name } || raise SchemaError.new("#{owner.class.name} has no association `#{name}`")
    k = Through.keys(owner.class, a)
    pk = info.primary_key || raise SchemaError.new("`#{info.name}` has no primary key, which `#{name}` needs")
    id = owner.to_h[pk]? || raise MissingAttributeError.new("#{owner.class.name}##{pk} is not set")
    ids: Array[Value] = targets.map do |t|
      t.to_h[k.target_pk]? || raise ArgumentError.new("`put_assoc` of a #{t.class.name} without its #{k.target_pk}: save it first")
    end
    join = k.join.table_name
    q = ->(n: Symbol) { Dialect.quote(n.to_s) }
    key_type = k.join.table_info.columns.find { |c| c.name == k.target_key }.as(Column).type
    have = query("SELECT #{q.call(k.target_key)} FROM #{Dialect.quote(join)} WHERE #{q.call(k.owner_key)} = $1", [id]) { |r| r.value(0, key_type) }
    have.uniq.each do |t|
      next if ids.include?(t.as(Value))
      exec("DELETE FROM #{Dialect.quote(join)} WHERE #{q.call(k.owner_key)} = $1 AND #{q.call(k.target_key)} = $2", [id, t])
    end
    ids.uniq.each do |t|
      next if have.include?(t)
      values: Hash[Symbol, Object?] = {k.owner_key => id, k.target_key => t}
      insert(k.join.load(values))
    end
  end

  # The value of `Rotor::Outcome::Ok`; `Rotor::Outcome::Invalid` raised as `Rotor::InvalidChangeset`.
  def self.unwrap[M <: Model](outcome: Outcome[M]) -> M
    case outcome
    in Outcome::Ok(value) then value
    in Outcome::Invalid(cs) then raise InvalidChangeset.new(cs, cs.errors, cs.summary)
    end
  end

  # Updates `model`'s row with the columns assigned since it was loaded
  # (and its update time), and gives the model as saved, unchanged; does
  # nothing when none were.
  def update[M <: Model](model: M) -> M
    return model unless model.changed?
    stamped = if u = model.table_info.updated_at
                model.with_values({u => Repo.now})
              else
                model
              end
    stale!(stamped) if changed(Statement.update(stamped).as(Statement)) == 0
    stamped.clear_changes
  end

  # Sets `model`'s update time, and the `Time` columns named, to now, and
  # writes those alone: the model with them, its other assignments still
  # pending.
  def touch[M <: Model](model: M, *columns: Symbol) -> M
    t = model.table_info
    names = columns.uniq
    if u = t.updated_at
      names = names + [u] unless names.include?(u)
    end
    raise ArgumentError.new("`#{t.name}` has no update time, and no column was named") if names.empty?
    key = t.primary_key || raise ArgumentError.new("`#{t.name}` has no primary key")
    if model.changed.include?(key)
      raise ArgumentError.new("#{model.class.name}##{key}, the primary key, was assigned: the row it named is not known")
    end
    id = model.to_h[key]? || raise MissingAttributeError.new("#{model.class.name}##{key} is not set")
    pending = model.changed - names
    now = Repo.now
    values: Hash[Symbol, Object?] = {}
    names.each { |n| values = values.put(n, now) }
    touched = model.with_values(values)
    pieces: Array[Piece] = [Piece::Text.new("UPDATE #{Dialect.quote(t.name)} SET ")]
    names.each_with_index do |n, i|
      pieces = pieces + [Piece::Text.new(", ")] if i > 0
      pieces = pieces + [Piece::Text.new("#{Dialect.quote(n.to_s)} = "), Piece::Param.new(now)]
    end
    pieces = pieces + [Piece::Text.new(" WHERE #{Dialect.quote(key.to_s)} = "), Piece::Param.new(id)]
    stale!(model) if changed(Statement.new(t, pieces, nil)) == 0
    touched.keep_changes(pending)
  end

  # Deletes `model`'s row, and gives the model; raises
  # `Rotor::StaleError` when there was none.
  def delete[M <: Model](model: M) -> M
    stale!(model) if changed(Statement.delete(model)) == 0
    model
  end

  # Deletes the query's rows: how many.
  def delete_all[T](query: Query[T]) -> Int = run(query.delete)

  # Updates the query's rows as the block says (`Rotor::Query#update`;
  # no timestamps are set): how many.
  def update_all[T](query: Query[T], &set: Quoted[shareable T.() -> Hash[Symbol, Object]] using Compare) -> Int = run(query.update(&set))

  # :ditto:
  def update_all[T](query: Query[T], &set: Quoted[shareable (T) -> Hash[Symbol, Object]] using Compare) -> Int = run(query.update(&set))

  # Runs the block in a transaction, with a repository bound to it:
  # committed when the block returns, rolled back when it raises.
  # Transactions do not nest (pg raises `PG::TransactionError` for one
  # inside another).
  def transaction[R](&: (Repo) -> R) -> R
    results: Array[R] = []
    @adapter.transaction do |a|
      results = results + [yield Repo.new(a)]
      nil
    end
    results[0]
  end

  # Runs raw SQL: the count the server reported (the rows changed, or a
  # SELECT's rows; 0 for none).
  def exec(sql: String, params: Array[Object?] = []) -> Int = @adapter.query(sql, params).affected || 0

  # Runs raw SQL and loads its rows as `model`s, by the result's column
  # names (columns it does not give are left unloaded).
  def query[M <: Model](model: Type[M], sql: String, params: Array[Object?] = []) -> Array[M]
    rows = @adapter.query(sql, params)
    q = model.query
    names = rows.columns
    cols = q.table.columns
    found = names.map { |n| cols.find { |c| c.name.to_s == n } }
    all = cols.all? { |c| names.include?(c.name.to_s) }
    rows.rows.map do |r|
      values: Hash[Symbol, Object?] = {}
      found.each_with_index do |c, i|
        values = values.put(c.name, r.value(i, c.type)) if c
      end
      all ? model.load(values) : model.load_partial(values)
    end
  end

  # Runs raw SQL and gives the block's value for each row, read with
  # `Rotor::Row`'s typed readers.
  def query[R](sql: String, params: Array[Object?] = [], &: (Row) -> R) -> Array[R]
    @adapter.query(sql, params).rows.map { |r| yield r }
  end

  # How many rows a statement changed, as the server reported it (nil
  # for an adapter that does not say).
  private def changed(statement: Statement) -> Int?
    sql, params = statement.to_sql
    @adapter.query(sql, params).affected
  end

  # (A statement by the model's key changed no row.)
  private def stale!(model: Model) -> Nothing
    t = model.table_info
    key = t.primary_key
    named = key ? " #{key}: #{model.to_h[key]?.inspect}" : ""
    raise StaleError.new("#{model.class.name}#{named}: its row no longer exists")
  end

  private def preload_all[M <: Model](models: Array[M], expr: Meta::Expr, file: String) -> Array[M]
    first = models.first? || return models
    if other = models.find { |m| m.class != first.class }
      raise ArgumentError.new("`preload` of models of one class: #{first.class.name} and #{other.class.name}")
    end
    info = first.table_info
    found = Preloads.run(self, models.map { |m| m.as(Model) }, info, Preloads.parse(info, first.class.name, expr, file))
    models.each_with_index.map { |m, i| m.with_preloaded(found[i]) }
  end

  # Now, in UTC, to the microsecond: what a timestamp column keeps.
  def self.now -> Time
    t = Time.now.utc
    Time.at(t.to_i).utc + MICROSECOND * t.usec
  end

  MICROSECOND = 1.ms * 0.001

  # A row's values by column, read with each column's type.
  def self.values(row: Row, columns: Array[Column]) -> Hash[Symbol, Object?]
    values: Hash[Symbol, Object?] = {}
    columns.each_with_index { |c, i| values = values.put(c.name, row.value(i, c.type)) }
    values
  end
end
