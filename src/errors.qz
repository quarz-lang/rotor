# The root of every error this cog raises: `rescue Rotor::Error` catches
# them all. (An argument a method cannot take is an `ArgumentError`, as
# anywhere.)
class Error < StandardError
end

# A model used without a schema: its class body has no `table` block.
class SchemaError < Error
end

# A read of a column that is not set: one without a default that admits
# no `nil`, on a model made with `new`, or loaded without it.
class MissingAttributeError < Error
end

# A read of a column a query did not fetch: a model loaded for a
# `select`, with the columns its block reads only.
class NotLoadedError < Error
end

# `Rotor::Repo#one` found more than one row.
class MultipleResultsError < Error
end

# `Rotor::Repo#one!` found no row.
class NoResultsError < Error
end

# A block of a query that SQL cannot express: a call of a method the
# translator does not know, or a construct it does not take. Raised when
# the query is built (`where`, `order`, `select`, `update`), not when it
# runs, naming what it met and where.
class UntranslatableError < Error
end

# `Rotor::Repo#update`, `Rotor::Repo#touch` or `Rotor::Repo#delete` of a model whose row no
# longer exists: the statement changed no row.
class StaleError < Error
end
