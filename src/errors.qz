# The root of every error this cog raises: `rescue Rotor::Error` catches
# them all. (An argument a method cannot take is an `ArgumentError`, as
# anywhere.)
class Error < StandardError
end

# A model used without a schema: its class body has no `table` block.
class SchemaError < Error
end

# A read of a column that is not set: one without a default that admits
# no `nil`, on a model made with `new`, or loaded without it.
class MissingAttributeError < Error
end

# A read of a column a query did not fetch: a model loaded for a
# `select`, with the columns its block reads only.
class NotLoadedError < Error
end

# `Rotor::Repo#one` found more than one row.
class MultipleResultsError < Error
end

# `Rotor::Repo#one!` found no row.
class NoResultsError < Error
end

# A block of a query that SQL cannot express: a call of a method the
# translator does not know, or a construct it does not take. Raised when
# the query is built (`where`, `order`, `select`, `update`), not when it
# runs, naming what it met and where.
class UntranslatableError < Error
end

# `Rotor::Repo#update`, `Rotor::Repo#touch` or `Rotor::Repo#delete` of a model whose row no
# longer exists: the statement changed no row.
class StaleError < Error
end

# A migration step that cannot be undone: rolling back a `change` that
# drops a table without its columns, removes a column without its type,
# runs `execute` without `down:`, and the like (`Rotor::Migration`), or
# that uses `repo`. Raised before any of the rollback runs.
class IrreversibleMigration < Error
end

# A migration failed (`Rotor::Migrator`): its version and class name;
# `cause` is the error it raised (a `PG::ServerError`, a
# `Rotor::IrreversibleMigration`...), nil when the migrator refused to
# run it (a version older than one applied). Its transaction was rolled
# back; the migrations before it stay applied.
class MigrationError < Error
  @version: Int
  @name: String

  # The failure of migration `version` (class `name`): `message`. Raised
  # while a `rescue` handles the error it wraps, which is its `cause`.
  def initialize(version: Int, name: String, message: String)
    @version = version
    @name = name
    super("#{version} #{name}: #{message}")
  end

  # The migration's version.
  def version -> Int = @version

  # The migration's class name.
  def name -> String = @name
end

# `Rotor::Changeset#apply!`, `Rotor::Repo#insert!` or `Rotor::Repo#update!` of a
# changeset with errors: its `errors`, and the changeset itself as a
# `Shareable` (its model's type is not known where it is rescued: for
# the typed changeset, use `insert` and its `Rotor::Outcome`). The
# message lists the errors.
class InvalidChangeset < Error
  @changeset: Shareable
  @errors: Array[FieldError]

  # The error of `changeset`, with its `errors`, `summary` listing them.
  def initialize(changeset: Shareable, errors: Array[FieldError], summary: String)
    @changeset = changeset
    @errors = errors
    super(summary)
  end

  # The changeset.
  def changeset -> Shareable = @changeset

  # Its errors.
  def errors -> Array[FieldError] = @errors
end
