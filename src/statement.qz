# A statement that changes rows, as a value: what a repository runs.
# `to_sql` gives its SQL and parameters; `returning` asks for columns
# of the rows it changed.
#
# ```
# class SUser < Rotor::Model
#   table "users" do
#     column :id, Int, primary: true
#     column :name, String
#   end
# end
#
# u = SUser.load({id: 7, name: "Ann"}).with(name: "Bob")
# Rotor::Statement.update(u)&.to_sql  # => ["UPDATE \"users\" SET \"name\" = $1 WHERE \"id\" = $2", ["Bob", 7]]
# Rotor::Statement.delete(u).to_sql  # => ["DELETE FROM \"users\" WHERE \"id\" = $1", [7]]
# ```
class Statement
  # (Its parameters' values are `Shareable`: a statement can be a
  # constant or go to another task.)
  include Shareable
  @table: TableInfo
  @pieces: Array[Piece]
  @returning: Array[Symbol]?

  # (Made by the methods below and by `Rotor::Query`.)
  def initialize(@table: TableInfo, @pieces: Array[Piece], @returning: Array[Symbol]?)
  end

  # The insertion of `model`'s row, with the columns it has values for
  # (`DEFAULT VALUES` when none): a `Rotor::Insert`, which may say what
  # to do on a conflict (`on_conflict`).
  def self.insert[M <: Model](model: M) -> Insert[M] = Insert[M].new(model, [], false, false)

  # :nodoc:
  # The INSERT of `model`'s row, without a conflict clause.
  def self.insert_pieces(model: Model) -> Array[Piece]
    t = model.table_info
    values = model.to_h
    cols = t.columns.select { |c| values.key?(c.name) }
    if cols.empty?
      return [Piece::Text.new("INSERT INTO #{Dialect.table(t.name, t.schema)} DEFAULT VALUES").as(Piece)]
    end
    pieces: Array[Piece] = [Piece::Text.new("INSERT INTO #{Dialect.table(t.name, t.schema)} (#{cols.map { |c| Dialect.quote(c.name.to_s) }.join(", ")}) VALUES (")]
    cols.each_with_index do |c, i|
      pieces = pieces + [Piece::Text.new(", ")] if i > 0
      pieces = pieces + [Piece::Param.new(values[c.name])]
    end
    pieces + [Piece::Text.new(")")]
  end

  # :nodoc:
  # The two rows of a conflict's blocks, the table's and the one
  # proposed: both of `model`'s table.
  def self.conflict_rows(model: Model) -> Array[Source]
    t = model.table_info
    [Source.new(t, model.class, [], nil), Source.new(t, model.class, [], nil)]
  end

  # :nodoc:
  # `pieces` with the columns of a conflict's rows named: the table's
  # (`"orders"."total"`), the proposed one's (`EXCLUDED."total"`).
  def self.conflict_columns(t: TableInfo, pieces: Array[Piece]) -> Array[Piece]
    table = Dialect.table(t.name, t.schema)
    pieces.map do |p|
      case p
      in Piece::Column(0, n) then Piece::Text.new("#{table}.#{Dialect.quote(n.to_s)}").as(Piece)
      in Piece::Column(_, n) then Piece::Text.new("EXCLUDED.#{Dialect.quote(n.to_s)}").as(Piece)
      else p
      end
    end
  end

  # :nodoc:
  # The `"col" = value, ...` an update's block gives (a hash literal of
  # columns of `table`, of the model named `model_name`), translated by
  # `t`; `what` names the call in the messages (`update`, `do_update`).
  # `Rotor::Query#update` and `Rotor::Conflict#do_update` both write
  # their SET through it.
  def self.set_list(t: Translator, e: Meta::Expr, file: String, table: TableInfo, model_name: String, what: String) -> Array[Piece]
    pairs = case e
            in Meta::Expr::HashLit(ps, _) then ps
            in _ then t.untranslatable("an `#{what}` block that is not a hash literal", Translator.line_of(e))
            end
    t.untranslatable("an `#{what}` of no column", Translator.line_of(e)) if pairs.empty?
    sets: Array[Piece] = []
    seen: Array[Symbol] = []
    pairs.each_with_index do |pair, i|
      key, value = pair
      name = case key
             in Meta::Expr::Lit(Symbol => s, _) then s
             else t.untranslatable("an `#{what}` key that is not a symbol", Translator.line_of(key))
             end
      c = table.columns.find { |x| x.name == name } ||
        raise ArgumentError.new("#{model_name} has no column `#{name}` (#{file}:#{Translator.line_of(key)})")
      if seen.include?(name)
        raise ArgumentError.new("an `#{what}` of `#{name}` twice (#{file}:#{Translator.line_of(key)})")
      end
      seen = seen + [name]
      v = t.operand(value, false)
      unless v.known
        t.classes(value).each do |k|
          if k == Nil
            raise ArgumentError.new("#{model_name}##{name} cannot be nil (#{file}:#{Translator.line_of(value)})") unless c.null
          elsif k != c.type && !(c.type == Float && k == Int)
            raise ArgumentError.new("#{model_name}##{name} takes #{c.type.name}, not #{k.name} (#{file}:#{Translator.line_of(value)})")
          end
        end
      end
      if v.known
        x = v.value
        if x.nil?
          raise ArgumentError.new("#{model_name}##{name} cannot be nil (#{file}:#{Translator.line_of(value)})") unless c.null
        elsif c.type == Float && x.is_a?(Int)
          v = Binds.to_float(v, x.as(Int))
        elsif !x.is_a?(c.type)
          raise ArgumentError.new("#{model_name}##{name} takes #{c.type.name}, not #{x.class.name} (#{file}:#{Translator.line_of(value)})")
        end
      end
      sets = sets + [Piece::Text.new(", ")] if i > 0
      sets = sets + [Piece::Text.new("#{Dialect.quote(name.to_s)} = ")] + v.pieces
    end
    sets
  end

  # The update of `model`'s row, by its primary key, with the columns
  # assigned since it was loaded or saved (`Rotor::Model#changed`), or nil
  # when there are none.
  def self.update(model: Model) -> Statement?
    t = model.table_info
    changed = model.changed
    return nil if changed.empty?
    values = model.to_h
    pieces: Array[Piece] = [Piece::Text.new("UPDATE #{Dialect.table(t.name, t.schema)} SET ")]
    changed.each_with_index do |name, i|
      pieces = pieces + [Piece::Text.new(", ")] if i > 0
      pieces = pieces + [Piece::Text.new("#{Dialect.quote(name.to_s)} = "), Piece::Param.new(values[name]?)]
    end
    Statement.new(t, pieces + by_key(model), nil)
  end

  # The deletion of `model`'s row, by its primary key.
  def self.delete(model: Model) -> Statement
    t = model.table_info
    Statement.new(t, [Piece::Text.new("DELETE FROM #{Dialect.table(t.name, t.schema)}")] + by_key(model), nil)
  end

  # The statement, returning the given columns of the rows it changes
  # (all of them when none are named).
  def returning(*names: Symbol) -> Statement
    names.each do |n|
      unless @table.columns.any? { |c| c.name == n }
        raise ArgumentError.new("`#{@table.name}` has no column `#{n}`")
      end
    end
    Statement.new(@table, @pieces, names.empty? ? @table.columns.map { |c| c.name } : names)
  end

  # The columns `returning` asked for, or nil.
  def returned -> Array[Symbol]? = @returning

  # The SQL statement and its parameters.
  def to_sql -> [String, Array[Object?]]
    names = @returning
    tail: Array[Piece] = []
    tail = [Piece::Text.new(" RETURNING #{names.map { |n| Dialect.quote(n.to_s) }.join(", ")}")] if names
    Statement.render(@pieces + tail)
  end

  def inspect -> String = "#<Rotor::Statement #{to_sql[0]}>"

  def to_s -> String = inspect

  # The text of `pieces`, its parameters numbered in order, and their
  # values.
  def self.render(pieces: Array[Piece]) -> [String, Array[Object?]]
    params: Array[Object?] = []
    text = String.build do |b|
      pieces.each do |p|
        case p
        in Piece::Text(s) then b << s
        # (Unqualified: a query qualifies its columns in a join.)
        in Piece::Column(_, n) then b << Dialect.quote(n.to_s)
        in Piece::Param(v)
          params = params + [v]
          b << Dialect.param(params.size)
        # (Filled in before: `Rotor::Binds.fill`.)
        in Piece::Bound(_) then raise ArgumentError.new("a parameter not filled in")
        end
      end
    end
    [text, params]
  end

  # :nodoc:
  # ` WHERE` each of the primary key's columns is the model's value
  # (`"id" = $1`, or `"a" = $1 AND "b" = $2` for a composite key).
  # Raises `ArgumentError` for a table without a key and for a model
  # whose key column was assigned (the row it named is not known),
  # `Rotor::MissingAttributeError` for one whose key is not set.
  def self.by_key(model: Model) -> Array[Piece]
    pieces: Array[Piece] = []
    Statement.key_values(model).each_with_index do |kv, i|
      pieces = pieces + [Piece::Text.new("#{i == 0 ? " WHERE " : " AND "}#{Dialect.quote(kv[0].to_s)} = "), Piece::Param.new(kv[1])]
    end
    pieces
  end

  # :nodoc:
  # The model's primary key columns and values, in the key's order,
  # checked as `by_key` says.
  def self.key_values(model: Model) -> Array[[Symbol, Value]]
    t = model.table_info
    values = model.to_h
    t.keys!.map do |key|
      if model.changed.include?(key)
        raise ArgumentError.new("#{model.class.name}##{key}, the primary key, was assigned: the row it named is not known")
      end
      # (`nil?`, not `||`: a `Bool` key may be false.)
      v = values[key]?
      raise MissingAttributeError.new("#{model.class.name}##{key} is not set") if v.nil?
      [key, v.as(Value)]
    end
  end
end

# An INSERT of a model's row (`Rotor::Statement.insert`), and what it
# does when the row conflicts with one the table has (a unique index or
# a constraint): `on_conflict` names which conflict, then `do_nothing`
# or `do_update`, the latter with an optional `where`. Its `to_sql` and
# a repository's `run` are a statement's; `Rotor::Repo#upsert` runs one
# with a conflict clause and gives the row as it is after it, or nil.
#
# ```
# class USensor < Rotor::Model
#   table "sensors" do
#     column :id, Int, primary: true
#     column :serial, String
#     column :name, String
#     column :hits, Int, default: 0
#   end
# end
#
# s = USensor.new(serial: "a1", name: "north")
# Rotor::Statement.insert(s).on_conflict(:serial).do_nothing.to_sql[0]
# # => "INSERT INTO \"sensors\" (\"serial\", \"name\", \"hits\") VALUES ($1, $2, $3) ON CONFLICT (\"serial\") DO NOTHING"
# Rotor::Statement.insert(s).on_conflict(:serial).do_update { |old, new| {name: new.name, hits: old.hits + 1} }.to_sql[0]
# # => "INSERT INTO \"sensors\" (\"serial\", \"name\", \"hits\") VALUES ($1, $2, $3) ON CONFLICT (\"serial\") DO UPDATE SET \"name\" = EXCLUDED.\"name\", \"hits\" = \"sensors\".\"hits\" + 1"
# ```
class Insert[M <: Model] < Statement
  @model: M
  # The conflict clause (none: empty).
  @tail: Array[Piece]
  # Whether it has a conflict clause, and whether that is a `do_update`
  # that may still take a `where`.
  @conflict: Bool
  @open: Bool

  # (Made by `Rotor::Statement.insert` and the methods below.)
  def initialize(@model: M, @tail: Array[Piece], @conflict: Bool, @open: Bool)
    super(@model.table_info, Statement.insert_pieces(@model) + @tail, nil)
  end

  # The model whose row it inserts.
  def model -> M = @model

  # Whether it says what to do on a conflict.
  def conflict? -> Bool = @conflict

  # :nodoc:
  # The same insert of `model`'s row (the repository's, its timestamps
  # set).
  def with_model(model: M) -> Insert[M] = Insert[M].new(model, @tail, @conflict, @open)

  # On a conflict of these columns (`ON CONFLICT ("a", "b")`: the
  # columns of a unique index, or of the primary key), or of any unique
  # index or constraint when none is named (`ON CONFLICT`, for
  # `do_nothing` only). `ArgumentError` for a column the table does not
  # have, and on an insert that already says what to do.
  def on_conflict(*columns: Symbol) -> Conflict[M]
    conflicting!
    t = @model.table_info
    columns.each do |c|
      raise ArgumentError.new("`on_conflict`: `#{t.name}` has no column `#{c}`") unless t.columns.any? { |x| x.name == c }
    end
    target = columns.empty? ? " ON CONFLICT" : " ON CONFLICT (#{columns.map { |c| Dialect.quote(c.to_s) }.join(", ")})"
    Conflict[M].new(@model, target, columns.empty?)
  end

  # On a conflict of the constraint named `constraint` (`ON CONFLICT ON
  # CONSTRAINT "name"`: a unique or exclusion constraint, not an index
  # made without one).
  def on_conflict(*, constraint: String) -> Conflict[M]
    conflicting!
    raise ArgumentError.new("`on_conflict`: an empty constraint name") if constraint.empty?
    Conflict[M].new(@model, " ON CONFLICT ON CONSTRAINT #{Dialect.quote(constraint)}", false)
  end

  # `do_update` only where the block is true, of the table's row (`old`)
  # and the proposed one (`new`, PostgreSQL's EXCLUDED), translated as
  # a query's `where` is: a conflicting row for which it is false is
  # left as it is, and the insert gives no row (`Rotor::Repo#upsert`:
  # nil).
  def where(&cond: Quoted[shareable (M, M) -> Bool] using Compare) -> Insert[M]
    raise ArgumentError.new("`where` of an insert: write it after `do_update`, once, as its condition") unless @open
    t = @model.table_info
    sources = Statement.conflict_rows(@model)
    kept = Cache.fetch(Cache::CONDITIONS, Cache.key(cond.site, sources), cond.captures) do
      tr, e = Translator.of(sources, cond.expr, cond.captures, cond.file)
      [tr.sql(e), tr.guards]
    end
    s = Binds.fill_sql(kept, cond.captures)
    Insert[M].new(@model, @tail + [Piece::Text.new(" WHERE ").as(Piece)] + Statement.conflict_columns(t, s.pieces), true, false)
  end

  private def conflicting! -> Void
    raise ArgumentError.new("`on_conflict` of an insert that already says what to do on a conflict") if @conflict
  end
end

# The conflict an insert names (`Rotor::Insert#on_conflict`): what to do
# about it.
class Conflict[M <: Model]
  include Shareable
  @model: M
  @target: String
  # (No target named: `do_nothing` only.)
  @any: Bool

  # (Made by `Rotor::Insert#on_conflict`.)
  def initialize(@model: M, @target: String, @any: Bool)
  end

  # Nothing: the conflicting row is left as it is, and the insert gives
  # no row (`Rotor::Repo#upsert`: nil). `ON CONFLICT ... DO NOTHING`.
  def do_nothing -> Insert[M] = Insert[M].new(@model, [Piece::Text.new("#{@target} DO NOTHING").as(Piece)], true, false)

  # The conflicting row updated as the block says, a hash literal of
  # columns as `Rotor::Query#update`'s, of the table's row (`old`) and
  # the proposed one (`new`, PostgreSQL's EXCLUDED):
  # `{ |old, new| {name: new.name, hits: old.hits + 1} }`. A timestamp
  # is set only when the block sets it (`updated_at: new.updated_at`).
  # Needs the conflict's columns or constraint (PostgreSQL's rule).
  def do_update(&set: Quoted[shareable (M, M) -> Hash[Symbol, Object]] using Compare) -> Insert[M]
    raise ArgumentError.new("`do_update` of a conflict that names no columns or constraint: name them in `on_conflict`") if @any
    t = @model.table_info
    sources = Statement.conflict_rows(@model)
    name = @model.class.name
    sets = Cache.fetch(Cache::SETS, Cache.key(set.site, sources), set.captures) do
      tr, e = Translator.of(sources, set.expr, set.captures, set.file)
      [Statement.conflict_columns(t, Statement.set_list(tr, e, set.file, t, name, "do_update")), tr.guards]
    end
    Insert[M].new(@model, [Piece::Text.new("#{@target} DO UPDATE SET ").as(Piece)] + Binds.fill(sets, set.captures), true, true)
  end
end
