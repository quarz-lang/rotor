# What a model's `table` block runs on, at compile time: each of its
# calls declares a column or an association. Its `column` takes the
# column's type as a class: `Int`, `Float`, `String`, `Bool`, `Time` or
# `Bytes`, one overload each, so that a default is of the column's type.
#
# - `null: true`: the column admits NULL, and its getter returns `T?`.
# - `default:`: the value a model made with `new` starts with (not for
#   `Time`).
# - `primary: true`: the primary key (at most one; never NULL).
class Schema
  @model: String
  var @columns: Array[Column] = []
  var @associations: Array[Association] = []
  var @created_at: Symbol? = nil
  var @updated_at: Symbol? = nil

  # A schema for the model named `model` (its class name).
  def initialize(@model: String)
  end

  # The columns declared so far, in order.
  def columns -> Array[Column] = @columns

  # The associations declared so far, in order.
  def associations -> Array[Association] = @associations

  # The `timestamps` columns: created at, updated at (nil for none).
  def timestamp_columns -> [Symbol?, Symbol?] = [@created_at, @updated_at]

  # An `Int` column (`bigint`).
  def column(name: Symbol, type: Type[Int], *, null: Bool = false, default: Int? = nil, primary: Bool = false) -> Void
    add(name, "bigint", Int, null, default, primary)
  end

  # A `Float` column (`double precision`).
  def column(name: Symbol, type: Type[Float], *, null: Bool = false, default: Float? = nil, primary: Bool = false) -> Void
    add(name, "double precision", Float, null, default, primary)
  end

  # A `String` column (`text`).
  def column(name: Symbol, type: Type[String], *, null: Bool = false, default: String? = nil, primary: Bool = false) -> Void
    add(name, "text", String, null, default, primary)
  end

  # A `Bool` column (`boolean`).
  def column(name: Symbol, type: Type[Bool], *, null: Bool = false, default: Bool? = nil, primary: Bool = false) -> Void
    add(name, "boolean", Bool, null, default, primary)
  end

  # A `Time` column (`timestamptz`). It takes no default: a time is not
  # a value the compiler can bake into the program.
  def column(name: Symbol, type: Type[Time], *, null: Bool = false, primary: Bool = false) -> Void
    add(name, "timestamptz", Time, null, nil, primary)
  end

  # A `Bytes` column (`bytea`).
  def column(name: Symbol, type: Type[Bytes], *, null: Bool = false, default: Bytes? = nil, primary: Bool = false) -> Void
    add(name, "bytea", Bytes, null, default, primary)
  end

  # `created_at` and `updated_at`, `Time` columns (`timestamptz`) that
  # are not NULL, which a repository sets when it inserts and updates
  # the model. Either is renamed by giving its name, or left out with
  # `false`.
  def timestamps(*, created_at: Symbol | Bool = :created_at, updated_at: Symbol | Bool = :updated_at) -> Void
    [created_at, updated_at].each do |c|
      case c
      in Symbol then add(c, "timestamptz", Time, false, nil, false)
      in Bool then raise ArgumentError.new("`timestamps` takes a column's name or false") if c
      end
    end
    @created_at = created_at.as?(Symbol)
    @updated_at = updated_at.as?(Symbol)
  end

  # The model belongs to `target`: the column `<name>_id` (an `Int`, or
  # `foreign_key:`) holds the target's key. The association's name is
  # the target's in snake_case (`belongs_to Account`: `account`, and
  # the column `account_id`), or `name:`.
  def belongs_to[T <: Model](target: Type[T], *, name: Symbol? = nil, foreign_key: Symbol? = nil, null: Bool = false) -> Void
    n = name || Inflector.underscore(target.name).to_sym
    key = foreign_key || "#{n}_id".to_sym
    if key == n
      raise ArgumentError.new("#{@model}'s association `#{n}` has the name of its key column")
    end
    check_association(n, target)
    add(key, "bigint", Int, null, nil, false)
    associate(:belongs_to, n, target, key)
  end

  # The model has many of `target`, whose `foreign_key:` column (by
  # default this model's name in snake_case with `_id`) holds this
  # one's key. The association's name is the target's in snake_case,
  # plural (`has_many Post` in a model User: `posts`, through
  # `user_id`), or `name:`.
  #
  # ```
  # class DocAuthor < Rotor::Model
  #   table do
  #     column :id, Int, primary: true
  #     has_many DocBook
  #   end
  # end
  #
  # class DocBook < Rotor::Model
  #   table do
  #     column :id, Int, primary: true
  #     belongs_to DocAuthor
  #   end
  # end
  #
  # DocAuthor.associations[0].name         # => :doc_books
  # DocAuthor.associations[0].foreign_key  # => :doc_author_id
  # DocBook.columns.map { |c| c.name }     # => [:id, :doc_author_id]
  # ```
  #
  # With `through:` a join model, the model has many of `target` through
  # it: the join model's `belongs_to` this model and `belongs_to` the
  # target (`source:` names the latter when it has several) pair them;
  # the keys are found when the association is first used, all `table`
  # blocks having run (`Rotor::Through.keys`). `foreign_key:` is the join
  # model's then, not given here.
  #
  # ```
  # class DocArticle < Rotor::Model
  #   table do
  #     column :id, Int, primary: true
  #     has_many DocLabel, through: DocArticleLabel
  #   end
  # end
  #
  # class DocArticleLabel < Rotor::Model
  #   table do
  #     column :id, Int, primary: true
  #     belongs_to DocArticle
  #     belongs_to DocLabel
  #   end
  # end
  #
  # class DocLabel < Rotor::Model
  #   table do
  #     column :id, Int, primary: true
  #   end
  # end
  #
  # DocArticle.load({id: 3}).doc_labels.query.to_sql  # => ["SELECT \"id\" FROM \"doc_labels\" WHERE \"id\" IN (SELECT \"doc_label_id\" FROM \"doc_article_labels\" WHERE \"doc_article_id\" = $1)", [3]]
  # ```
  def has_many[T <: Model](target: Type[T], *, name: Symbol? = nil, foreign_key: Symbol? = nil, through: Type[Model]? = nil, source: Symbol? = nil) -> Void
    n = name || Inflector.pluralize(Inflector.underscore(target.name)).to_sym
    if through && foreign_key
      raise ArgumentError.new("#{@model}'s association `#{n}` goes through #{through.as(Type[Model]).name}, whose `belongs_to`s give the keys: no `foreign_key:`")
    end
    if source && through.nil?
      raise ArgumentError.new("#{@model}'s association `#{n}` names a `source:` without `through:`")
    end
    if through == Model
      raise ArgumentError.new("#{@model}'s association `#{n}` goes through Rotor::Model itself: name the join model")
    end
    key = foreign_key || "#{Inflector.underscore(@model)}_id".to_sym
    check_association(n, target)
    @associations = @associations + [Association.new(:has_many, n, target, key, through, source)]
  end

  private def check_association(name: Symbol, target: Type[Model]) -> Void
    if target == Model
      raise ArgumentError.new("#{@model}'s association `#{name}` names Rotor::Model itself: name a model class")
    end
    if @associations.any? { |a| a.name == name }
      raise ArgumentError.new("#{@model} declares the association `#{name}` twice")
    end
    if RESERVED.include?(name)
      raise ArgumentError.new("#{@model}'s association `#{name}` would replace the model's own `#{name}`")
    end
    if @columns.any? { |c| c.name == name }
      raise ArgumentError.new("#{@model}'s association `#{name}` has the name of a column")
    end
  end

  private def associate(kind: Symbol, name: Symbol, target: Type[Model], key: Symbol) -> Void
    @associations = @associations + [Association.new(kind, name, target, key)]
  end

  # Creates the tables of `models` from their `table` blocks, in one
  # transaction: each column (an `Int` primary key as `GENERATED BY
  # DEFAULT AS IDENTITY`, the columns' defaults as the tables'), and for
  # each `belongs_to` an index on its column and, once every table is
  # made, its foreign key (`ALTER TABLE`, so that models may refer to
  # each other in a cycle). With `if_not_exists: true`, a table that
  # exists is left as it is. For a development database or a test's: a
  # production database's schema goes through migrations
  # (`Rotor::Migration`).
  #
  # ```quarz no_run
  # class SchemaUser < Rotor::Model
  #   table "users" do
  #     column :id, Int, primary: true
  #     column :name, String
  #   end
  # end
  #
  # class SchemaPost < Rotor::Model
  #   table "posts" do
  #     column :id, Int, primary: true
  #     belongs_to SchemaUser, name: :user
  #   end
  # end
  #
  # PG::Pool.open("postgres://app@localhost/shop_test") do |pool|
  #   repo = Rotor::Repo.new(pool: pool)
  #   Rotor::Schema.create(repo, [SchemaUser, SchemaPost])
  #   Rotor::Schema.drop(repo, [SchemaUser, SchemaPost])
  # end
  # ```
  def self.create(repo: Repo, models: Array[Type[Model]], *, if_not_exists: Bool = false) -> Void
    ops = Schema.operations(models)
    repo.transaction do |tx|
      skip: Array[String] = []
      if if_not_exists
        ops.each do |op|
          if op.is_a?(Operation::CreateTable)
            name = op.as(Operation::CreateTable).name
            found = tx.query("SELECT to_regclass($1) IS NOT NULL", [Dialect.quote(name)]) { |r| r.bool(0) }
            skip = skip + [name] if found[0]? == true
          end
        end
      end
      ops.each do |op|
        table = case op
                in Operation::CreateTable(name:) then name
                in Operation::AddForeignKey(table:) then table
                else ""
                end
        Migrator.render(op).each { |sql| tx.exec(sql) } unless skip.include?(table)
      end
      nil
    end
  end

  # Drops the tables of `models`, in one `DROP TABLE` (so that their
  # foreign keys to each other do not stop it; without CASCADE, so
  # that one from another table does). With `if_exists: true`, a
  # missing table is no error.
  def self.drop(repo: Repo, models: Array[Type[Model]], *, if_exists: Bool = false) -> Void
    return if models.empty?
    names = models.map { |m| Dialect.quote(m.table_name) }
    repo.exec("DROP TABLE #{if_exists ? "IF EXISTS " : ""}#{names.join(", ")}")
  end

  # :nodoc:
  # What `create` runs: each table, then the foreign keys.
  def self.operations(models: Array[Type[Model]]) -> Array[Operation]
    tables: Array[Operation] = []
    keys: Array[Operation] = []
    models.each do |m|
      info = m.table_info
      cols = info.columns.map do |c|
        d = c.default
        default: Default? = case d
                            in Int then d
                            in Float then d
                            in String then d
                            in Bool then d
                            in Bytes then d
                            else nil
                            end
        ColumnDef.new(Columns.ident(c.name.to_s), c.sql, c.null, default, c.primary, c.primary && c.type == Int, nil)
      end
      indexes: Array[IndexDef] = []
      info.associations.each do |a|
        next unless a.kind == :belongs_to
        key = a.target.primary_key || raise ArgumentError.new("#{m.name} belongs to #{a.target.name}, which has no primary key")
        fk = Columns.ident(a.foreign_key.to_s)
        indexes = indexes + [Columns.index(info.name, [fk], nil, false, nil, false)]
        keys = keys + [Operation::AddForeignKey.new(info.name, fk, Reference.new(a.target.table_name, key.to_s, nil)).as(Operation)]
      end
      tables = tables + [Operation::CreateTable.new(Columns.ident(info.name), cols, indexes, false).as(Operation)]
    end
    tables + keys
  end

  # The methods of `Rotor::Model` that a column's getter would replace.
  RESERVED = [:to_h, :changed, :changed?, :clear_changes, :keep_changes, :loaded, :table_info, :read, :with, :with_values, :checkpoint, :restore, :inspect, :to_s, :preloaded, :with_preloaded, :nest, :fetched?]

  private def add(name: Symbol, sql: String, type: Type[Object], null: Bool, default: Value?, primary: Bool) -> Void
    if RESERVED.include?(name)
      raise ArgumentError.new("#{@model}'s column `#{name}` would replace the model's own `#{name}`")
    end
    if @columns.any? { |c| c.name == name }
      raise ArgumentError.new("#{@model} declares the column `#{name}` twice")
    end
    if @associations.any? { |a| a.name == name }
      raise ArgumentError.new("#{@model}'s column `#{name}` has the name of an association")
    end
    if primary && null
      raise ArgumentError.new("#{@model}'s primary key `#{name}` cannot be NULL")
    end
    if primary && @columns.any? { |c| c.primary }
      raise ArgumentError.new("#{@model} declares a second primary key, `#{name}`")
    end
    @columns = @columns + [Column.new(name, sql, type, null, primary, default)]
  end
end
