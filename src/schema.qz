# What a model's `table` block runs on, at compile time: each of its
# calls declares a column or an association. Its `column` takes the
# column's type as a class: `Int`, `Float`, `String`, `Bool`, `Time` or
# `Bytes`, one overload each, so that a default is of the column's type;
# or an array of `String`s or `Int`s (`Array[String]`, `text[]`;
# `Array[Int]`, `bigint[]`), its elements non-null unless declared `T?`
# (`Array[String?]`), without a default.
#
# - `null: true`: the column admits NULL, and its getter returns `T?`.
# - `default:`: the value a model made with `new` starts with (not for
#   `Time`).
# - `primary: true`: the primary key, never NULL; on several columns,
#   a composite key of them, in the order declared (a model with one
#   has no `has_many`, and no `belongs_to` or `through` association
#   may target it).
# - `redact: true`: the value is hidden from `inspect` (the model's and
#   a changeset's), for a password or a token.
class Schema
  @model: String
  # The model's class, and the latest of its documents' decoders, which
  # a document column generates (nil for a schema made outside `table`,
  # which has no document column).
  @class_def: Meta::ClassDef[Model]?
  var @decoder: Meta::Method[Model, (Symbol, JSON::Value) -> Object]?
  var @columns: Array[Column] = []
  var @associations: Array[Association] = []
  var @created_at: Symbol? = nil
  var @updated_at: Symbol? = nil

  # A schema for the model named `model` (its class name); `table`
  # gives the model's class and its documents' first decoder too.
  def initialize(@model: String, @class_def: Meta::ClassDef[Model]? = nil, @decoder: Meta::Method[Model, (Symbol, JSON::Value) -> Object]? = nil)
  end

  # :nodoc:
  # The latest of the documents' decoders: `Model#decode_document`
  # calls it.
  def decoder -> Meta::Method[Model, (Symbol, JSON::Value) -> Object]? = @decoder

  # The columns declared so far, in order.
  def columns -> Array[Column] = @columns

  # The associations declared so far, in order.
  def associations -> Array[Association] = @associations

  # The `timestamps` columns: created at, updated at (nil for none).
  def timestamp_columns -> [Symbol?, Symbol?] = [@created_at, @updated_at]

  # An `Int` column (`bigint`).
  def column(name: Symbol, type: Type[Int], *, null: Bool = false, default: Int? = nil, primary: Bool = false, redact: Bool = false) -> Void
    add(name, "bigint", Int, null, default, primary, redact)
  end

  # A `Float` column (`double precision`).
  def column(name: Symbol, type: Type[Float], *, null: Bool = false, default: Float? = nil, primary: Bool = false, redact: Bool = false) -> Void
    add(name, "double precision", Float, null, default, primary, redact)
  end

  # A `String` column (`text`).
  def column(name: Symbol, type: Type[String], *, null: Bool = false, default: String? = nil, primary: Bool = false, redact: Bool = false) -> Void
    add(name, "text", String, null, default, primary, redact)
  end

  # A `Bool` column (`boolean`).
  def column(name: Symbol, type: Type[Bool], *, null: Bool = false, default: Bool? = nil, primary: Bool = false, redact: Bool = false) -> Void
    add(name, "boolean", Bool, null, default, primary, redact)
  end

  # A `Time` column (`timestamptz`). It takes no default: a time is not
  # a value the compiler can bake into the program.
  def column(name: Symbol, type: Type[Time], *, null: Bool = false, primary: Bool = false, redact: Bool = false) -> Void
    add(name, "timestamptz", Time, null, nil, primary, redact)
  end

  # A `Date` column (`date`), a calendar date; without a default, as a
  # `Time` column (a `String` column stays valid for a `date` of a table
  # rotor did not create).
  def column(name: Symbol, type: Type[Date], *, null: Bool = false, primary: Bool = false, redact: Bool = false) -> Void
    add(name, "date", Date, null, nil, primary, redact)
  end

  # A `Decimal` column (`numeric`, or `numeric(precision, scale)` when
  # both are given, which the server then rounds a value to on
  # assignment), exact; without a default (a `Float` column stays valid
  # for a `numeric` of a table rotor did not create).
  def column(name: Symbol, type: Type[Decimal], *, null: Bool = false, primary: Bool = false, redact: Bool = false, precision: Int? = nil, scale: Int? = nil) -> Void
    sql = if (p = precision) && (s = scale)
            raise ArgumentError.new("#{@model}'s column `#{name}`: numeric(#{p}, #{s}) needs 1 <= precision <= 1000 and 0 <= scale <= precision") unless p >= 1 && p <= 1000 && s >= 0 && s <= p
            "numeric(#{p}, #{s})"
          elsif precision || scale
            raise ArgumentError.new("#{@model}'s column `#{name}`: give `precision:` and `scale:` together")
          else
            "numeric"
          end
    add(name, sql, Decimal, null, nil, primary, redact)
  end

  # A `Bytes` column (`bytea`).
  def column(name: Symbol, type: Type[Bytes], *, null: Bool = false, default: Bytes? = nil, primary: Bool = false, redact: Bool = false) -> Void
    add(name, "bytea", Bytes, null, default, primary, redact)
  end

  # A JSON document column (`jsonb`, or a `json` column of a table
  # rotor did not create), read as a `JSON::Value` (parsed from the text
  # the server sends: every row read parses it) and written as its
  # compact text. `null: true` makes it `JSON::Value?`: nil is SQL's
  # NULL, `JSON::Value::Null` the document `null`. A number reads as an
  # `Int`, an exact `Integer` or a `Float`, while `jsonb` keeps any
  # decimal exactly: a fraction read and written back may change (a
  # column that needs the exact text is declared `String`).
  def column(name: Symbol, type: Type[JSON::Value], *, null: Bool = false, redact: Bool = false) -> Void
    add(name, "jsonb", JSON::Value, null, nil, false, redact)
  end

  # A document column (`jsonb`) holding a value of `type`, a `data`
  # type (an `Array` or a `Hash` is a field of one: here a `Type` value
  # carries no type arguments, which `JSON.decode` needs): written as
  # the value's JSON (`JSON.generate`), read with `JSON.decode[T]` on
  # each read of the getter (a decoded value is not kept, until
  # quarz-lang/quarz#890: the cost of a read grows with the document;
  # read it once into a local).
  # A type `JSON.decode` cannot take is an error when the program is
  # compiled (at the `table` block, naming the column's decoder,
  # `__rotor_document_<name>`). A row whose document does not have the
  # type's shape raises `JSON::DecodeError` when it is loaded, naming the
  # table, the column and where; a field with a default takes it for a
  # missing key. `json: true` is what says it (`false` is refused): a
  # mistyped scalar type is not silently a document.
  static def column[T](name: Symbol, type: Type[T], *, json: Bool, null: Bool = false, redact: Bool = false) -> Void
    raise ArgumentError.new("#{@model}'s column `#{name}`: `json: false` declares nothing; leave it out for a scalar column") unless json
    t = type.as(Type[Object])
    if t == Array || t == Hash || t == Set
      raise ArgumentError.new("#{@model}'s document column `#{name}`: its type is a `data` type; wrap the #{t.name} in one (`data Log = (entries: Array[Entry])`)")
    end
    cls = @class_def || raise ArgumentError.new("#{@model}'s document column `#{name}` is declared outside a model's `table`")
    prev = @decoder || raise ArgumentError.new("#{@model}'s document column `#{name}` is declared outside a model's `table`")
    add(name, "jsonb", JSON::Value, null, nil, false, redact, nil, false, type.as(Type[Object]))
    n = name
    # (A link of a chain: this column's document, or the previous
    # link's.)
    cls.doc ":nodoc:"
    @decoder = cls.def_method(:"__rotor_document_#{name}", [:column, :document]) do |column: Symbol, document: JSON::Value| -> Object
      column == n ? JSON.decode[T](document) : prev.bind(self).call(column, document)
    end
    cls.doc "The `#{name}` column's value, decoded from its document."
    # (Decoded on each read: a decoded value cannot be kept typed yet, a
    # generated `initialize` not assigning a generated field that is
    # not `var`, quarz-lang/quarz#890.)
    if null
      cls.def_method(name) do -> T?
        (d = read_nullable(n).as?(JSON::Value)) ? JSON.decode[T](d) : nil
      end
    else
      cls.def_method(name) do -> T
        JSON.decode[T](read_attr(n).as(JSON::Value))
      end
    end
  end

  # An array column of `String`s (`text[]`), its elements never NULL: a
  # NULL element read raises `ArgumentError` (declare `Array[String?]`
  # for one that may hold them).
  def column(name: Symbol, type: Type[Array[String]], *, null: Bool = false, redact: Bool = false) -> Void
    add(name, "text[]", Array, null, nil, false, redact, String, false)
  end

  # An array column of `String`s that may be nil (`text[]`).
  def column(name: Symbol, type: Type[Array[String?]], *, null: Bool = false, redact: Bool = false) -> Void
    add(name, "text[]", Array, null, nil, false, redact, String, true)
  end

  # An array column of `Int`s (`bigint[]`), its elements never NULL, as
  # `Array[String]`'s.
  def column(name: Symbol, type: Type[Array[Int]], *, null: Bool = false, redact: Bool = false) -> Void
    add(name, "bigint[]", Array, null, nil, false, redact, Int, false)
  end

  # An array column of `Int`s that may be nil (`bigint[]`).
  def column(name: Symbol, type: Type[Array[Int?]], *, null: Bool = false, redact: Bool = false) -> Void
    add(name, "bigint[]", Array, null, nil, false, redact, Int, true)
  end

  # `created_at` and `updated_at`, `Time` columns (`timestamptz`) that
  # are not NULL, which a repository sets when it inserts and updates
  # the model. Either is renamed by giving its name, or left out with
  # `false`.
  def timestamps(*, created_at: Symbol | Bool = :created_at, updated_at: Symbol | Bool = :updated_at) -> Void
    [created_at, updated_at].each do |c|
      case c
      in Symbol then add(c, "timestamptz", Time, false, nil, false)
      in Bool then raise ArgumentError.new("`timestamps` takes a column's name or false") if c
      end
    end
    @created_at = created_at.as?(Symbol)
    @updated_at = updated_at.as?(Symbol)
  end

  # The model belongs to `target`: the column `<name>_id` (an `Int`, or
  # `foreign_key:`) holds the target's key. The association's name is
  # the target's in snake_case (`belongs_to Account`: `account`, and
  # the column `account_id`), or `name:`.
  def belongs_to[T <: Model](target: Type[T], *, name: Symbol? = nil, foreign_key: Symbol? = nil, null: Bool = false) -> Void
    n = name || Inflector.underscore(target.name).to_sym
    key = foreign_key || "#{n}_id".to_sym
    if key == n
      raise ArgumentError.new("#{@model}'s association `#{n}` has the name of its key column")
    end
    check_association(n, target)
    add(key, "bigint", Int, null, nil, false)
    associate(:belongs_to, n, target, key)
  end

  # The model has many of `target`, whose `foreign_key:` column (by
  # default this model's name in snake_case with `_id`) holds this
  # one's key. The association's name is the target's in snake_case,
  # plural (`has_many Post` in a model User: `posts`, through
  # `user_id`), or `name:`.
  #
  # ```
  # class DocAuthor < Rotor::Model
  #   table do
  #     column :id, Int, primary: true
  #     has_many DocBook
  #   end
  # end
  #
  # class DocBook < Rotor::Model
  #   table do
  #     column :id, Int, primary: true
  #     belongs_to DocAuthor
  #   end
  # end
  #
  # DocAuthor.associations[0].name         # => :doc_books
  # DocAuthor.associations[0].foreign_key  # => :doc_author_id
  # DocBook.columns.map { |c| c.name }     # => [:id, :doc_author_id]
  # ```
  #
  # With `through:` a join model, the model has many of `target` through
  # it: the join model's `belongs_to` this model and `belongs_to` the
  # target (`source:` names the latter when it has several) pair them;
  # the keys are found when the association is first used, all `table`
  # blocks having run (`Rotor::Through.keys`). `foreign_key:` is the join
  # model's then, not given here.
  #
  # ```
  # class DocArticle < Rotor::Model
  #   table do
  #     column :id, Int, primary: true
  #     has_many DocLabel, through: DocArticleLabel
  #   end
  # end
  #
  # class DocArticleLabel < Rotor::Model
  #   table do
  #     column :id, Int, primary: true
  #     belongs_to DocArticle
  #     belongs_to DocLabel
  #   end
  # end
  #
  # class DocLabel < Rotor::Model
  #   table do
  #     column :id, Int, primary: true
  #   end
  # end
  #
  # DocArticle.load({id: 3}).doc_labels.query.to_sql  # => ["SELECT \"id\" FROM \"doc_labels\" WHERE \"id\" IN (SELECT \"doc_label_id\" FROM \"doc_article_labels\" WHERE \"doc_article_id\" = $1)", [3]]
  # ```
  def has_many[T <: Model](target: Type[T], *, name: Symbol? = nil, foreign_key: Symbol? = nil, through: Type[Model]? = nil, source: Symbol? = nil) -> Void
    n = name || Inflector.pluralize(Inflector.underscore(target.name)).to_sym
    if through && foreign_key
      raise ArgumentError.new("#{@model}'s association `#{n}` goes through #{through.as(Type[Model]).name}, whose `belongs_to`s give the keys: no `foreign_key:`")
    end
    if source && through.nil?
      raise ArgumentError.new("#{@model}'s association `#{n}` names a `source:` without `through:`")
    end
    if through == Model
      raise ArgumentError.new("#{@model}'s association `#{n}` goes through Rotor::Model itself: name the join model")
    end
    key = foreign_key || "#{Inflector.underscore(@model)}_id".to_sym
    check_association(n, target)
    @associations = @associations + [Association.new(:has_many, n, target, key, through, source)]
  end

  private def check_association(name: Symbol, target: Type[Model]) -> Void
    if target == Model
      raise ArgumentError.new("#{@model}'s association `#{name}` names Rotor::Model itself: name a model class")
    end
    if @associations.any? { |a| a.name == name }
      raise ArgumentError.new("#{@model} declares the association `#{name}` twice")
    end
    if RESERVED.include?(name)
      raise ArgumentError.new("#{@model}'s association `#{name}` would replace the model's own `#{name}`")
    end
    if @columns.any? { |c| c.name == name }
      raise ArgumentError.new("#{@model}'s association `#{name}` has the name of a column")
    end
  end

  private def associate(kind: Symbol, name: Symbol, target: Type[Model], key: Symbol) -> Void
    @associations = @associations + [Association.new(kind, name, target, key)]
  end

  # Creates the tables of `models` from their `table` blocks, in one
  # transaction: each column (an `Int` primary key as `GENERATED BY
  # DEFAULT AS IDENTITY`, the columns' defaults as the tables'), and for
  # each `belongs_to` an index on its column and, once every table is
  # made, its foreign key (`ALTER TABLE`, so that models may refer to
  # each other in a cycle). With `if_not_exists: true`, a table that
  # exists is left as it is. For a development database or a test's: a
  # production database's schema goes through migrations
  # (`Rotor::Migration`).
  #
  # ```quarz no_run
  # class SchemaUser < Rotor::Model
  #   table "users" do
  #     column :id, Int, primary: true
  #     column :name, String
  #   end
  # end
  #
  # class SchemaPost < Rotor::Model
  #   table "posts" do
  #     column :id, Int, primary: true
  #     belongs_to SchemaUser, name: :user
  #   end
  # end
  #
  # PG::Pool.open("postgres://app@localhost/shop_test") do |pool|
  #   repo = Rotor::Repo.new(pool: pool)
  #   Rotor::Schema.create(repo, [SchemaUser, SchemaPost])
  #   Rotor::Schema.drop(repo, [SchemaUser, SchemaPost])
  # end
  # ```
  def self.create(repo: Repo, models: Array[Type[Model]], *, if_not_exists: Bool = false) -> Void
    ops = Schema.operations(models)
    repo.transaction do |tx|
      skip: Array[String] = []
      if if_not_exists
        ops.each do |op|
          if op.is_a?(Operation::CreateTable)
            ct = op.as(Operation::CreateTable)
            name = Dialect.table(ct.name, ct.schema)
            found = tx.query("SELECT to_regclass($1) IS NOT NULL", [name]) { |r| r.bool(0) }
            skip = skip + [name] if found[0]? == true
          end
        end
      end
      ops.each do |op|
        table = case op
                in Operation::CreateTable(name:, schema:) then Dialect.table(name, schema)
                in Operation::AddForeignKey(table:, schema:) then Dialect.table(table, schema)
                else ""
                end
        Migrator.render(op).each { |sql| tx.exec(sql) } unless skip.include?(table)
      end
      nil
    end
  end

  # Drops the tables of `models`, in one `DROP TABLE` (so that their
  # foreign keys to each other do not stop it; without CASCADE, so
  # that one from another table does). With `if_exists: true`, a
  # missing table is no error.
  def self.drop(repo: Repo, models: Array[Type[Model]], *, if_exists: Bool = false) -> Void
    return if models.empty?
    names = models.map { |m| Dialect.table(m.table_name, m.table_info.schema) }
    repo.exec("DROP TABLE #{if_exists ? "IF EXISTS " : ""}#{names.join(", ")}")
  end

  # :nodoc:
  # What `create` runs: each table, then the foreign keys.
  def self.operations(models: Array[Type[Model]]) -> Array[Operation]
    tables: Array[Operation] = []
    keys: Array[Operation] = []
    models.each do |m|
      info = m.table_info
      cols = info.columns.map do |c|
        d = c.default
        default: Default? = case d
                            in Int then d
                            in Float then d
                            in String then d
                            in Bool then d
                            in Bytes then d
                            else nil
                            end
        # (An identity for a single `Int` key only.)
        ColumnDef.new(Columns.ident(c.name.to_s), c.sql, c.null, default, c.primary, c.primary && c.type == Int && info.primary_keys.size == 1, nil)
      end
      indexes: Array[IndexDef] = []
      info.associations.each do |a|
        next unless a.kind == :belongs_to
        key = a.target.table_info.single_key(a.target.name, "#{m.name}'s `belongs_to`")
        fk = Columns.ident(a.foreign_key.to_s)
        indexes = indexes + [Columns.index(info.name, [fk], nil, false, nil, false, schema: info.schema)]
        keys = keys + [Operation::AddForeignKey.new(info.name, fk, Reference.new(a.target.table_name, key.to_s, nil, a.target.table_info.schema), info.schema).as(Operation)]
      end
      tables = tables + [Operation::CreateTable.new(Columns.ident(info.name), cols, indexes, false, info.schema).as(Operation)]
    end
    tables + keys
  end

  # The methods of `Rotor::Model` that a column's getter would replace.
  RESERVED = [:to_h, :changed, :changed?, :clear_changes, :keep_changes, :loaded, :table_info, :read, :with, :with_values, :checkpoint, :restore, :inspect, :to_s, :preloaded, :with_preloaded, :nest, :fetched?, :decode_document, :check_document, :no_document]

  private def add(name: Symbol, sql: String, type: Type[Object], null: Bool, default: Value?, primary: Bool, redact: Bool = false, element: Type[Object]? = nil, nils: Bool = false, document: Type[Object]? = nil) -> Void
    if RESERVED.include?(name)
      raise ArgumentError.new("#{@model}'s column `#{name}` would replace the model's own `#{name}`")
    end
    if @columns.any? { |c| c.name == name }
      raise ArgumentError.new("#{@model} declares the column `#{name}` twice")
    end
    if @associations.any? { |a| a.name == name }
      raise ArgumentError.new("#{@model}'s column `#{name}` has the name of an association")
    end
    if primary && null
      raise ArgumentError.new("#{@model}'s primary key `#{name}` cannot be NULL")
    end
    @columns = @columns + [Column.new(name, sql, type, null, primary, default, redact, element, nils, document)]
  end
end
