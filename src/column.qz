# A value a column holds: what `Rotor::Column#default` may be.
type Value = Int | Float | String | Bool | Time | Bytes

# A column of a model's table, as its `table` block declares it.
data Column = (
  # The column's name, which is also its getter's.
  name: Symbol,
  # Its SQL type (`bigint`, `double precision`, `text`, `boolean`,
  # `timestamptz`, `bytea`).
  sql: String,
  # Its Quarz type: `Int`, `Float`, `String`, `Bool`, `Time` or `Bytes`.
  type: Type[Object],
  # Whether it admits NULL: its getter then returns `T?`.
  null: Bool,
  # Whether it is the primary key.
  primary: Bool,
  # The value a model made with `new` starts with, or nil for none.
  default: Value?,
  # Whether its value is hidden from `inspect` (a password, a token):
  # `**redacted**` shows instead.
  redact: Bool = false
)

# An association of a model, as its `table` block declares it: what the
# queries of a later version follow.
data Association = (
  # `:belongs_to` or `:has_many`.
  kind: Symbol,
  # Its name: `:account` for `belongs_to Account`, `:posts` for
  # `has_many Post`.
  name: Symbol,
  # The associated model's class.
  target: Type[Model],
  # The column that holds the key: this model's for `belongs_to`
  # (`account_id`), the other's for `has_many` (`user_id`); for a
  # `has_many` through a join model, the default `has_many` would have,
  # unused (the keys are the join model's, `Rotor::Through.keys`).
  foreign_key: Symbol,
  # The join model of a `has_many ..., through:`, or nil.
  through: Type[Model]? = nil,
  # The join model's `belongs_to` to the target that `source:` names, or
  # nil (the one whose target is the association's class).
  source: Symbol? = nil
)
