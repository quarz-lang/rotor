# A model's values, the columns assigned since it was loaded, the
# columns a query fetched (nil: all), and the associations preloaded
# (by name: the associated models, none or one for a `belongs_to`): what
# a model is made of ([Rotor::Model#checkpoint], [Rotor::Model#restore]).
data Checkpoint = (attrs: Hash[Symbol, Value?], changed: Array[Symbol], loaded: Array[Symbol]?, assocs: Hash[Symbol, Array[Model]] = {})

# The base class of a model: a row of a table, with typed accessors that
# its `table` block generates when the program is compiled.
#
# ```
# class DocUser < Rotor::Model
#   table "users" do
#     column :id, Int, primary: true
#     column :name, String
#     column :email, String, null: true
#     column :age, Int, default: 0
#     timestamps
#   end
# end
#
# u = DocUser.new(name: "Ann")   # DocUser.new(name: 1) does not compile
# u.name     # => "Ann"
# u.email    # => nil
# u.age      # => 0
# u.changed  # => [:name]
# v = u.with(email: "ann@example.com", age: 41)
# v.age      # => 41
# u.age      # => 0
# DocUser.table_name  # => "users"
# DocUser.columns.map { |c| c.name }  # => [:id, :name, :email, :age, :created_at, :updated_at]
# ```
#
# A model is an immutable value, [Shareable]: `with(col: value, ...)`
# gives a new one with those columns changed (each column an optional
# keyword typed by it), which remembers the columns assigned since it
# was made or loaded ([changed]): the columns an update writes. A
# model's `new` takes the columns as `with` does (the same keywords,
# all optional), starting from the columns' defaults, and remembers
# those given as changed; `load(values)` makes one from a row's values,
# unchanged. A model class cannot declare a `var` field (it is
# [Shareable]), and does not write `initialize`: `table` generates its
# constructors.
#
# The columns are declared in one block because a class body's
# statements run independently of each other (Quarz's docs/14 §2): no
# statement sees what another generates, so the one `table` statement
# is what knows every column, for `columns` and `primary_key`.
class Model
  include Shareable

  @attrs: Hash[Symbol, Value?]
  @changed: Array[Symbol]
  # The columns loaded, when a query fetched only some (nil: all).
  @loaded: Array[Symbol]?
  # The associations preloaded, by name (`Rotor::Repo#preload`).
  @assocs: Hash[Symbol, Array[Model]]

  # :nodoc:
  # (A model's constructors are generated by its `table`, and hide these:
  # they are those of a class without one, `Rotor::Model` and a class
  # between it and models, whose `new` without arguments raises
  # `Rotor::SchemaError`, and for which `restore` needs one of a
  # `Checkpoint`.)
  def initialize
    @attrs = {}
    @changed = []
    @loaded = nil
    @assocs = {}
    @attrs = Model.defaults(table_info)
  end

  # :nodoc:
  def initialize(point: Checkpoint)
    @attrs = point.attrs
    @changed = point.changed
    @loaded = point.loaded
    @assocs = point.assocs
  end


  # The columns' defaults.
  def self.defaults(info: TableInfo) -> Hash[Symbol, Value?]
    out: Hash[Symbol, Value?] = {}
    info.columns.each do |c|
      d = c.default
      out = out.put(c.name, d) unless d.nil?
    end
    out
  end

  # Declares the model's table and its columns ([Rotor::Schema]), and
  # generates the typed accessors, the constructors (`new` of the
  # columns as optional keywords, and of a [Checkpoint], which [restore]
  # makes), `with`, and the class's metadata: `columns`,
  # `table_name` (`name`, by default the class's name in snake_case,
  # plural), `primary_key` and `associations`. A class has one `table`
  # block. `schema:` names the PostgreSQL schema the table is in, which
  # qualifies it in every statement (`"archive"."orders"`); without it
  # the connection's `search_path` finds the table. `table_name` is the
  # name alone, as are the names derived from it (a changeset's
  # constraint names, [Rotor::Schema.create]'s indexes), as PostgreSQL
  # names indexes and constraints without the schema.
  static def self.table(name: String? = nil, *, schema: String? = nil, &block: Schema.() -> Void) -> Void
    space = schema
    Columns.ident(space) if space
    # (`table` generates `with`, keywords only, giving the model: an
    # ancestor that has one ran its own `table`. Seen when that ran
    # first: in a cog this one depends on, or before in this cog's
    # order.)
    if methods.any? { |m| m.name == :with && m.result <= Model && m.params.all? { |q| q.kind == Meta::ParamKind::Keyword } }
      raise SchemaError.new("#{self.name} subclasses a model with a table: a model's superclass is Rotor::Model or a class without a `table` (single-table inheritance is not provided)")
    end
    decl = Schema.new(self.name, self, method_ref[(Symbol, JSON::Value) -> Object](:no_document))
    decl.instance_exec(&block)
    cols = decl.columns
    assocs = decl.associations
    table = name || Inflector.pluralize(Inflector.underscore(self.name))
    keys = cols.select { |c| c.primary }.map { |c| c.name }
    key = keys.size == 1 ? keys[0] : nil
    if keys.size > 1 && (many = assocs.find { |a| a.kind == :has_many })
      raise SchemaError.new("#{self.name} has a composite primary key (#{keys.join(", ")}), and its `has_many` `#{many.name}` needs a single one")
    end
    # (First: a second `table` block in the class is refused at it,
    # "already has a class method `table_name`".)
    doc "The table's name: `#{table}`."
    # (The class itself, a value the generated members capture: compared
    # by identity, not by name. Its name, for the message, is its `name`
    # when the program is compiled, as for the default table name.)
    owner = type
    owner_name = self.name
    def_class_method(:table_name) { Model.own_table!(self, owner, owner_name); table }
    doc "The columns of `#{table}`, in order."
    def_class_method(:columns) { Model.own_table!(self, owner, owner_name); cols }
    if keys.size > 1
      doc "Raises [ArgumentError]: the primary key is composite ([primary_keys])."
      def_class_method(:primary_key) do -> Symbol?
        Model.own_table!(self, owner, owner_name)
        raise ArgumentError.new("#{owner_name} has a composite primary key (#{keys.join(", ")}): see `primary_keys`")
      end
    else
      doc "The primary key's column, or nil for none."
      def_class_method(:primary_key) { Model.own_table!(self, owner, owner_name); key }
    end
    doc "The primary key's columns, in order: none, one, or several for a composite key."
    def_class_method(:primary_keys) { Model.own_table!(self, owner, owner_name); keys }
    doc "The associations, in order."
    def_class_method(:associations) { Model.own_table!(self, owner, owner_name); assocs }
    stamps = decl.timestamp_columns
    info = TableInfo.new(table, cols, keys, stamps[0], stamps[1], assocs, space)
    doc "The table's name, columns and primary key."
    def_class_method(:table_info) { Model.own_table!(self, owner, owner_name); info }
    doc "The table's name, columns and primary key, as the class's [table_info]."
    def_method(:table_info) { Model.own_table!(self.class, owner, owner_name); info }
    keywords = cols.map { |c| Model.keyword(c) }
    doc "A copy with the columns given changed (each an optional keyword), which remembers them as changed."
    def_method(:with, keywords: keywords) do |given| -> Self
      with_values(given)
    end
    # (What `restore` makes, by `Self.new(point)`: every model has it,
    # of one signature, as the methods it inherits require.)
    doc ":nodoc:"
    def_initialize(:point) do |point: Checkpoint|
      @attrs = point.attrs
      @changed = point.changed
      @loaded = point.loaded
      @assocs = point.assocs
      Model.own_table!(self.class, owner, owner_name)
    end
    doc "A model with the columns given (each an optional keyword) and the other columns' defaults, which remembers those given as changed."
    def_initialize(keywords: keywords) do |given|
      attrs = Model.defaults(info)
      given.each_pair { |k, v| attrs = attrs.put(k, Model.stored(info, k, v)) }
      @attrs = attrs
      @changed = given.keys
      @loaded = nil
      @assocs = {}
      Model.own_table!(self.class, owner, owner_name)
    end
    # (A document column's getter is its `column`'s: it decodes into
    # the type, which only that call has.)
    cols.each { |c| accessors(c) if c.document.nil? }
    if cols.any? { |c| !c.document.nil? }
      last = decl.decoder || raise ArgumentError.new("#{self.name}: no decoder for its document columns")
      doc ":nodoc:"
      def_method(:decode_document, [:column, :document], override: true) do |column: Symbol, document: JSON::Value| -> Object
        last.bind(self).call(column, document)
      end
    end
    assocs.each { |a| association(a.target, a, key) }
  end

  # The columns, in order (generated by `table`).
  def self.columns -> Array[Column] = raise SchemaError.new(no_table)
  # The table's name (generated by `table`).
  def self.table_name -> String = raise SchemaError.new(no_table)
  # The primary key's column, or nil for none; raises [ArgumentError]
  # for a composite key (generated by `table`).
  def self.primary_key -> Symbol? = raise SchemaError.new(no_table)
  # The primary key's columns, in order (generated by `table`).
  def self.primary_keys -> Array[Symbol] = raise SchemaError.new(no_table)
  # The associations, in order (generated by `table`).
  def self.associations -> Array[Association] = raise SchemaError.new(no_table)
  # The table's name, columns and primary key (generated by `table`).
  def self.table_info -> TableInfo = raise SchemaError.new(no_table)

  # The table's name, columns and primary key, as the class's (generated
  # by `table`).
  def table_info -> TableInfo = raise SchemaError.new(Model.no_table_of(self.class.name))

  # A model of this class made of `point`.
  def restore(point: Checkpoint) -> Self = Self.new(point)

  # A new model of this class: `new`, the columns' defaults set
  # ([Rotor::Changeset.cast] of a class).
  def self.blank -> Self = new

  # Every row, as a query ([Rotor::Query]), to refine.
  def self.query -> Query[Self]
    Query[Self].new([Source.new(table_info, self, [], nil)], [], [], false, nil, nil, Query::Shape::Rows,
                    ->(rows: Array[Array[Fetched]]) { rows.map { |r| r[0].all ? load(r[0].values) : load_partial(r[0].values) } }, [],
                    ModelOps[Self].new(->(m: Self) { m.as(Model) }, ->(m: Self, found: Hash[Symbol, Array[Model]]) { m.with_preloaded(found) }))
  end

  # `query.preload`: every row, with the associations the block names
  # preloaded.
  def self.preload(&spec: Quoted[shareable Self.() -> Object] using Compare) -> Query[Self] = query.preload(&spec)

  # `query.where`: the rows for which the block is true.
  def self.where(&cond: Quoted[shareable Self.() -> Bool] using Compare) -> Query[Self] = query.where(&cond)

  # :ditto:
  def self.where(&cond: Quoted[shareable (Self) -> Bool] using Compare) -> Query[Self] = query.where(&cond)

  # `query.filter`.
  def self.filter(&cond: Quoted[shareable (Self) -> Bool] using Compare) -> Query[Self] = query.filter(&cond)

  # `query.order`.
  def self.order(&key: Quoted[shareable Self.() -> Object] using Compare) -> Query[Self] = query.order(&key)

  # :ditto:
  def self.order(&key: Quoted[shareable (Self) -> Object] using Compare) -> Query[Self] = query.order(&key)

  # `query.select`.
  def self.select[R](&f: Quoted[shareable Self.() -> R] using Compare) -> Query[R] = query.select(&f)

  # :ditto:
  def self.select[R](&f: Quoted[shareable (Self) -> R] using Compare) -> Query[R] = query.select(&f)

  # `query.map`.
  def self.map[R](&f: Quoted[shareable (Self) -> R] using Compare) -> Query[R] = query.map(&f)

  # `query.count`.
  def self.count -> Query[Int] = query.count

  # `query.exists`.
  def self.exists -> Query[Bool] = query.exists

  # `query.first`.
  def self.first -> Query[Self] = query.first

  # `query.limit(n)`.
  def self.limit(n: Int) -> Query[Self] = query.limit(n)

  # The column `name`, or nil for none.
  def self.find_column(name: Symbol) -> Column? = columns.find { |c| c.name == name }

  # A model of this class with the given values, unchanged: as read from
  # a row. Each key must be a column, and each value of the column's type
  # (or nil where the column admits NULL); the columns not given keep
  # their defaults.
  def self.load(values: Hash[Symbol, Object?]) -> Self = new.loaded(values)

  # A model with only the given columns loaded (a `select` fetched
  # them): reading another raises [Rotor::NotLoadedError].
  def self.load_partial(values: Hash[Symbol, Object?]) -> Self = new.loaded(values, partial: true)

  # The value of column `name` (`nil` for one not set that admits it).
  def read(name: Symbol) -> Object?
    c = column_of(name)
    c.null ? read_nullable(name) : read_attr(name)
  end

  # The model's values by column, those set only: a column without a
  # default that was never assigned is left out.
  def to_h -> Hash[Symbol, Value?] = @attrs

  # The columns assigned since the model was made or loaded, in the
  # order of their first assignment (one `with`'s in the columns' order).
  def changed -> Array[Symbol] = @changed

  # Whether a column was assigned since.
  def changed? -> Bool = !@changed.empty?

  # The model with only the assignments of `names` kept (after the
  # others were saved).
  def keep_changes(names: Array[Symbol]) -> Self
    restore(Checkpoint.new(@attrs, @changed.select { |n| names.include?(n) }, @loaded, @assocs))
  end

  # The model with the assignments forgotten: after it was saved.
  def clear_changes -> Self = restore(Checkpoint.new(@attrs, [], @loaded, @assocs))

  # A copy with the columns of `values` set, each checked against its
  # column's type, which remembers them as changed: what `with` does,
  # for code that names the columns at run time (the repository's
  # timestamps).
  def with_values(values: Hash[Symbol, Object?]) -> Self
    attrs = @attrs
    changed = @changed
    loaded = @loaded
    values.each_pair do |k, v|
      c = column_of(k)
      check_value(c, v)
      attrs = attrs.put(k, Model.stored_value(c, v))
      changed = changed + [k] unless changed.include?(k)
      if l = loaded
        loaded = l + [k] unless l.include?(k)
      end
    end
    # (What was preloaded for a key that changes goes: a `belongs_to`'s
    # own key names another row, and the primary key's `has_many` were
    # loaded for the old one.)
    assocs = @assocs
    unless assocs.empty?
      info = table_info
      changes = ->(c: Symbol) { values.key?(c) && @attrs[c]? != Model.value(values[c]?) }
      pk = info.primary_key
      pk_changes = pk ? changes.call(pk.as(Symbol)) : false
      info.associations.each do |a|
        next unless assocs.key?(a.name)
        drop = a.kind == :belongs_to ? changes.call(a.foreign_key) : pk_changes
        assocs = assocs.reject { |k, _| k == a.name } if drop
      end
    end
    restore(Checkpoint.new(attrs, changed, loaded, assocs))
  end

  # The model with the values read from a row (`load`), checked, and no
  # assignment; `partial:` when they are only those a query fetched
  # (`load_partial`), without the defaults.
  def loaded(values: Hash[Symbol, Object?], *, partial: Bool = false) -> Self
    values.each_pair { |k, v| check_value(column_of(k), v) }
    attrs: Hash[Symbol, Value?] = partial ? {} : @attrs
    values.each_pair do |k, v|
      c = column_of(k)
      attrs = attrs.put(k, Model.stored_value(c, v))
    end
    restore(Checkpoint.new(attrs, [], partial ? values.keys : nil, @assocs))
  end

  # What the model is made of.
  def checkpoint -> Checkpoint = Checkpoint.new(@attrs, @changed, @loaded, @assocs)

  # The models preloaded for the association `name`, or nil when it was
  # not ([Rotor::Repo#preload]).
  def preloaded(name: Symbol) -> Array[Model]? = @assocs[name]?

  # The model with the associations of `assocs` preloaded (each by name,
  # the others kept).
  def with_preloaded(assocs: Hash[Symbol, Array[Model]]) -> Self
    return self if assocs.empty?
    all = @assocs
    assocs.each_pair { |k, v| all = all.put(k, v) }
    restore(Checkpoint.new(@attrs, @changed, @loaded, all))
  end

  # A model of this class made of `m`'s values (`m` one of this class):
  # how an association gives its models typed.
  def self.rebuild(m: Model) -> Self = new(m.checkpoint)

  # Preloading names associations: `nest(posts) { comments }` names
  # `posts` and, of each post, `comments` ([Rotor::Repo#preload]). Run
  # outside a preload, it gives nil.
  def nest[T <: Model](association: HasMany[T], &: T.() -> Object) -> Object? = nil

  # :ditto:
  def nest[T <: Model](association: T?, &: T.() -> Object) -> Object? = nil

  # `v` as a column's value (checked against its column before).
  def self.value(v: Object?) -> Value?
    case v
    in nil then nil
    in Int | Float | String | Bool | Time | Date | Decimal | Bytes then v
    in JSON::Value => j then j
    in Array
      if v.is_a?(Array[Int]) then v.as(Array[Int])
      elsif v.is_a?(Array[String]) then v.as(Array[String])
      elsif v.is_a?(Array[Int?]) then v.as(Array[Int?])
      elsif v.is_a?(Array[String?]) then v.as(Array[String?])
      else raise ArgumentError.new("not a column's value: an Array of other than Ints or Strings")
      end
    else raise ArgumentError.new("not a column's value: #{v.class.name}")
    end
  end

  # :nodoc:
  # The keyword `new` and `with` take for the column `c`: its type, `T?`
  # for `null: true`; an array column's in full (`Array[String]`,
  # `Array[Int?]`), its element kept by the column.
  static def self.keyword(c: Column) -> Meta::Keyword
    if d = c.document
      return Meta::Keyword.new(c.name, d, false, nullable: c.null)
    end
    e = c.element
    return Meta::Keyword.new(c.name, c.type, false, nullable: c.null) if e.nil?
    item = Meta::TypeRef.of(e)
    item = Meta::TypeRef.union([item, Meta::TypeRef.of(Nil)]) if c.nils
    ref = Meta::TypeRef.of(Array, [item])
    ref = Meta::TypeRef.union([ref, Meta::TypeRef.of(Nil)]) if c.null
    Meta::Keyword.typed(c.name, ref, false)
  end

  # `#<User id: 1, name: "Ann", password: **redacted**>`: a column
  # declared `redact: true` hidden.
  def inspect -> String
    hidden = table_info.columns.select { |c| c.redact }.map { |c| c.name }
    "#<#{self.class.name} #{@attrs.map { |k, v| "#{k}: #{hidden.include?(k) ? "**redacted**" : v.inspect}" }.join(", ")}>"
  end

  def to_s -> String = inspect


  private def read_attr(name: Symbol) -> Object?
    loaded!(name)
    unless @attrs.key?(name)
      raise MissingAttributeError.new("#{self.class.name}##{name} is not set")
    end
    @attrs[name]
  end

  private def read_nullable(name: Symbol) -> Object?
    loaded!(name)
    @attrs[name]?
  end

  private def loaded!(name: Symbol) -> Void
    if (l = @loaded) && !l.include?(name)
      raise NotLoadedError.new("#{self.class.name}##{name} was not loaded: the query fetched #{l.map { |n| n.to_s }.join(", ")}")
    end
  end

  private def column_of(name: Symbol) -> Column
    table_info.columns.find { |c| c.name == name } ||
      raise ArgumentError.new("#{self.class.name} has no column `#{name}`")
  end

  private def check_value(c: Column, v: Object?) -> Void
    if v.nil?
      return if c.null
      raise ArgumentError.new("#{self.class.name}##{c.name} cannot be nil")
    end
    # (A document column's: decoded by `check_document`.)
    return if c.document
    unless v.is_a?(c.type)
      raise ArgumentError.new("#{self.class.name}##{c.name} takes #{c.type.name}, not #{v.class.name}")
    end
    # (An array's elements: a `Type` value carries no type arguments,
    # the column keeps them.)
    if (e = c.element) && !Model.fits_array?(c, v)
      raise ArgumentError.new("#{self.class.name}##{c.name} takes an Array of #{e.name}#{c.nils ? "?" : ""}, not #{v.inspect}")
    end
  end

  # :nodoc:
  # `v` as the column `c` holds it: a document column's value as its
  # `JSON::Value` (`JSON.generate` of it, parsed; one already a
  # `JSON::Value` as it is), another's as `value` gives it.
  def self.stored_value(c: Column, v: Object?) -> Value?
    return Model.value(v) if c.document.nil? || v.nil? || v.is_a?(JSON::Value)
    JSON.parse(JSON.generate(v.as(Object)))
  end

  # :nodoc:
  # `stored_value` of the column `name` of `info`.
  def self.stored(info: TableInfo, name: Symbol, v: Object?) -> Value?
    c = info.columns.find { |x| x.name == name } || raise ArgumentError.new("#{info.name} has no column `#{name}`")
    stored_value(c, v)
  end

  # :nodoc:
  # Decodes the document `document` of the column `column` into its
  # type (generated by `table` for a model with document columns).
  def decode_document(column: Symbol, document: JSON::Value) -> Object = no_document(column, document)

  # :nodoc:
  # Raises: the model has no document column `column`.
  def no_document(column: Symbol, document: JSON::Value) -> Object
    raise ArgumentError.new("#{self.class.name} has no document column `#{column}`")
  end

  # :nodoc:
  # The value the column `name` holds, as stored (a document column's
  # `JSON::Value`), without the checks of a getter: what a document
  # column's kept field is decoded from.
  private def raw_document(name: Symbol) -> Value? = @attrs[name]?

  # :nodoc:
  # Raises `JSON::DecodeError` unless `d`, the value of column `c`, is
  # nil or a document of the column's type's shape (a document column;
  # nothing for another), naming the table, the column and where.
  def check_document(c: Column, d: Value?) -> Void
    return if c.document.nil?
    return unless d.is_a?(JSON::Value)
    begin
      decode_document(c.name, d.as(JSON::Value))
    rescue JSON::DecodeError => e
      raise JSON::DecodeError.new("#{table_info.name}.#{c.name}: #{e.message}")
    end
  end

  # :nodoc:
  # Whether `v` is an array of the array column `c`'s elements (nils
  # only where it admits them): the one test of it, for a model's values
  # and a changeset's. (`is_a?` of an `Array[T]` does not walk the
  # elements: constant time, measured to a million.)
  def self.fits_array?(c: Column, v: Object) -> Bool
    e = c.element
    if e.nil?
      false
    elsif e == Int
      c.nils ? v.is_a?(Array[Int?]) : v.is_a?(Array[Int])
    else
      c.nils ? v.is_a?(Array[String?]) : v.is_a?(Array[String])
    end
  end

  private def self.no_table -> String = no_table_of(name)

  # Raises unless `klass` is `owner` (named `owner_name`), the class
  # whose `table` generated the member called (the class itself, by
  # [equal?], which no class can redefine, as [==] can be): a subclass
  # that inherits a table is refused at its first use (the members
  # `with` among them are its parent's).
  def self.own_table!(klass: Class, owner: Class, owner_name: String) -> Void
    return if klass.equal?(owner)
    raise SchemaError.new("#{klass.name} has no table: it inherits #{owner_name}'s; a model declares its own; single-table inheritance is not provided")
  end

  # The message for a model without a `table` block.
  def self.no_table_of(model: String) -> String =
    "#{model} has no schema: declare its columns in a `table do ... end` block in its class body"

  # The getter of association `a` of `target`, typed by it: a
  # `Rotor::HasMany[T]`, or the `T?` a `belongs_to` names. `key` is this
  # model's primary key.
  private static def self.association[T <: Model](target: Type[T], a: Association, key: Symbol?) -> Void
    n = a.name
    fk = a.foreign_key
    if (j = a.through) && a.kind == :has_many
      owner = type
      doc "The #{target.name} models #{j.name}'s rows pair with this one: a read-only [Rotor::HasMany], whose elements are there once preloaded ([Rotor::Repo#preload])."
      def_method(n) do -> HasMany[T]
        HasMany[T].new(target, self.class.name, n, fk, key, Model.key_of(self, key), preloaded(n), [owner.as(Type[Object]), a])
      end
    elsif a.kind == :has_many
      doc "The #{target.name} models whose `#{fk}` is this one's key: a [Rotor::HasMany], whose elements are there once preloaded ([Rotor::Repo#preload])."
      def_method(n) do -> HasMany[T]
        HasMany[T].new(target, self.class.name, n, fk, key, Model.key_of(self, key), preloaded(n))
      end
    else
      doc "The #{target.name} model `#{fk}` names, once preloaded ([Rotor::Repo#preload]): nil for a NULL `#{fk}`; [Rotor::NotLoadedError] when not preloaded."
      def_method(n) do -> T?
        Model.belonging(target, self, n, fk)
      end
    end
  end

  # The value of `m`'s column `key` (a key, primary or foreign), nil for
  # none or not set; raises [Rotor::NotLoadedError] when a query did not
  # fetch it.
  def self.key_of(m: Model, key: Symbol?) -> Value?
    return nil unless key
    unless m.fetched?(key)
      raise NotLoadedError.new("#{m.class.name}##{key} was not loaded: an association needs it")
    end
    m.to_h[key]?
  end

  # Whether the column `name` was fetched (all were, but for a model a
  # `select` loaded).
  def fetched?(name: Symbol) -> Bool
    l = @loaded
    l.nil? || l.include?(name)
  end

  # What a `belongs_to` getter gives (`association`).
  def self.belonging[T <: Model](target: Type[T], m: Model, name: Symbol, fk: Symbol) -> T?
    return nil if key_of(m, fk).nil?
    found = m.preloaded(name) || raise NotLoadedError.new("#{m.class.name}##{name} is not loaded: preload it (`repo.preload(model) { #{name} }`)")
    first = found.first?
    first ? target.rebuild(first) : nil
  end

  # The getter of column `c`, typed by its type.
  private static def self.accessors(c: Column) -> Void
    n = c.name
    t = c.type
    if t == Int
      if c.null
        def_method(n) { read_nullable(n).as?(Int) }
      else
        def_method(n) { read_attr(n).as(Int) }
      end
    elsif t == Float
      if c.null
        def_method(n) { read_nullable(n).as?(Float) }
      else
        def_method(n) { read_attr(n).as(Float) }
      end
    elsif t == String
      if c.null
        def_method(n) { read_nullable(n).as?(String) }
      else
        def_method(n) { read_attr(n).as(String) }
      end
    elsif t == Bool
      if c.null
        def_method(n) { read_nullable(n).as?(Bool) }
      else
        def_method(n) { read_attr(n).as(Bool) }
      end
    elsif t == Time
      if c.null
        def_method(n) { read_nullable(n).as?(Time) }
      else
        def_method(n) { read_attr(n).as(Time) }
      end
    elsif t == Date
      if c.null
        def_method(n) { read_nullable(n).as?(Date) }
      else
        def_method(n) { read_attr(n).as(Date) }
      end
    elsif t == Decimal
      if c.null
        def_method(n) { read_nullable(n).as?(Decimal) }
      else
        def_method(n) { read_attr(n).as(Decimal) }
      end
    elsif t == JSON::Value
      if c.null
        def_method(n) { read_nullable(n).as?(JSON::Value) }
      else
        def_method(n) { read_attr(n).as(JSON::Value) }
      end
    elsif t == Array
      e = c.element
      if e == Int && c.nils
        if c.null
          def_method(n) { read_nullable(n).as?(Array[Int?]) }
        else
          def_method(n) { read_attr(n).as(Array[Int?]) }
        end
      elsif e == Int
        if c.null
          def_method(n) { read_nullable(n).as?(Array[Int]) }
        else
          def_method(n) { read_attr(n).as(Array[Int]) }
        end
      elsif c.nils
        if c.null
          def_method(n) { read_nullable(n).as?(Array[String?]) }
        else
          def_method(n) { read_attr(n).as(Array[String?]) }
        end
      else
        if c.null
          def_method(n) { read_nullable(n).as?(Array[String]) }
        else
          def_method(n) { read_attr(n).as(Array[String]) }
        end
      end
    else
      if c.null
        def_method(n) { read_nullable(n).as?(Bytes) }
      else
        def_method(n) { read_attr(n).as(Bytes) }
      end
    end
  end
end
