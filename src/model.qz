# A model's values, the columns assigned since it was loaded, and the
# columns a query fetched (nil: all): what a model is made of
# (`Rotor::Model#checkpoint`, `Rotor::Model#restore`).
data Checkpoint = (attrs: Hash[Symbol, Value?], changed: Array[Symbol], loaded: Array[Symbol]?)

# The base class of a model: a row of a table, with typed accessors that
# its `table` block generates when the program is compiled.
#
# ```
# class DocUser < Rotor::Model
#   table "users" do
#     column :id, Int, primary: true
#     column :name, String
#     column :email, String, null: true
#     column :age, Int, default: 0
#     timestamps
#   end
# end
#
# u = DocUser.new(name: "Ann")   # DocUser.new(name: 1) does not compile
# u.name     # => "Ann"
# u.email    # => nil
# u.age      # => 0
# u.changed  # => [:name]
# v = u.with(email: "ann@example.com", age: 41)
# v.age      # => 41
# u.age      # => 0
# DocUser.table_name  # => "users"
# DocUser.columns.map { |c| c.name }  # => [:id, :name, :email, :age, :created_at, :updated_at]
# ```
#
# A model is an immutable value, `Shareable`: `with(col: value, ...)`
# gives a new one with those columns changed (each column an optional
# keyword typed by it), which remembers the columns assigned since it
# was made or loaded (`changed`): the columns an update writes. A
# model's `new` takes the columns as `with` does (the same keywords,
# all optional), starting from the columns' defaults, and remembers
# those given as changed; `load(values)` makes one from a row's values,
# unchanged. A model class cannot declare a `var` field (it is
# `Shareable`), and does not write `initialize`: `table` generates its
# constructors.
#
# The columns are declared in one block because a class body's
# statements run independently of each other (Quarz's docs/14 §2): no
# statement sees what another generates, so the one `table` statement
# is what knows every column, for `columns` and `primary_key`.
class Model
  include Shareable

  @attrs: Hash[Symbol, Value?]
  @changed: Array[Symbol]
  # The columns loaded, when a query fetched only some (nil: all).
  @loaded: Array[Symbol]?

  # :nodoc:
  # (A model's constructors are generated by its `table`, and hide these:
  # they are those of a class without one, `Rotor::Model` and a class
  # between it and models, whose `new` without arguments raises
  # `Rotor::SchemaError`, and for which `restore` needs one of a
  # `Checkpoint`.)
  def initialize
    @attrs = {}
    @changed = []
    @loaded = nil
    @attrs = Model.defaults(table_info)
  end

  # :nodoc:
  def initialize(point: Checkpoint)
    @attrs = point.attrs
    @changed = point.changed
    @loaded = point.loaded
  end


  # The columns' defaults.
  def self.defaults(info: TableInfo) -> Hash[Symbol, Value?]
    out: Hash[Symbol, Value?] = {}
    info.columns.each do |c|
      d = c.default
      out = out.put(c.name, d) unless d.nil?
    end
    out
  end

  # Declares the model's table and its columns (`Rotor::Schema`), and
  # generates the typed accessors, the constructors (`new` of the
  # columns as optional keywords, and of a `Checkpoint`, which `restore`
  # makes), `with`, and the class's metadata: `columns`,
  # `table_name` (`name`, by default the class's name in snake_case,
  # plural), `primary_key` and `associations`. A class has one `table`
  # block.
  static def self.table(name: String? = nil, &block: Schema.() -> Void) -> Void
    # (`table` generates `with`, keywords only, giving the model: an
    # ancestor that has one ran its own `table`. Seen when that ran
    # first: in a cog this one depends on, or before in this cog's
    # order.)
    if methods.any? { |m| m.name == :with && m.result <= Model && m.params.all? { |q| q.kind == Meta::ParamKind::Keyword } }
      raise SchemaError.new("#{self.name} subclasses a model with a table: a model's superclass is Rotor::Model or a class without a `table` (single-table inheritance is not provided)")
    end
    schema = Schema.new(self.name)
    schema.instance_exec(&block)
    cols = schema.columns
    assocs = schema.associations
    table = name || Inflector.pluralize(Inflector.underscore(self.name))
    key = cols.find { |c| c.primary }&.name
    # (First: a second `table` block in the class is refused at it,
    # "already has a class method `table_name`".)
    doc "The table's name: `#{table}`."
    owner = self.name
    def_class_method(:table_name) { Model.own_table!(self, owner); table }
    doc "The columns of `#{table}`, in order."
    def_class_method(:columns) { Model.own_table!(self, owner); cols }
    doc "The primary key's column, or nil for none."
    def_class_method(:primary_key) { Model.own_table!(self, owner); key }
    doc "The associations, in order."
    def_class_method(:associations) { Model.own_table!(self, owner); assocs }
    stamps = schema.timestamp_columns
    info = TableInfo.new(table, cols, key, stamps[0], stamps[1])
    doc "The table's name, columns and primary key."
    def_class_method(:table_info) { Model.own_table!(self, owner); info }
    doc "The table's name, columns and primary key, as the class's `table_info`."
    def_method(:table_info) { Model.own_table!(self.class, owner); info }
    keywords = cols.map { |c| Meta::Keyword.new(c.name, c.type, false, nullable: c.null) }
    doc "A copy with the columns given changed (each an optional keyword), which remembers them as changed."
    def_method(:with, keywords: keywords) do |given| -> Self
      with_values(given)
    end
    # (What `restore` makes, by `Self.new(point)`: every model has it,
    # of one signature, as the methods it inherits require.)
    doc ":nodoc:"
    def_initialize(:point) do |point: Checkpoint|
      @attrs = point.attrs
      @changed = point.changed
      @loaded = point.loaded
      Model.own_table!(self.class, owner)
    end
    doc "A model with the columns given (each an optional keyword) and the other columns' defaults, which remembers those given as changed."
    def_initialize(keywords: keywords) do |given|
      attrs = Model.defaults(info)
      given.each_pair { |k, v| attrs = attrs.put(k, Model.value(v)) }
      @attrs = attrs
      @changed = given.keys
      @loaded = nil
      Model.own_table!(self.class, owner)
    end
    cols.each { |c| accessors(c) }
  end

  # The columns, in order (generated by `table`).
  def self.columns -> Array[Column] = raise SchemaError.new(no_table)
  # The table's name (generated by `table`).
  def self.table_name -> String = raise SchemaError.new(no_table)
  # The primary key's column, or nil for none (generated by `table`).
  def self.primary_key -> Symbol? = raise SchemaError.new(no_table)
  # The associations, in order (generated by `table`).
  def self.associations -> Array[Association] = raise SchemaError.new(no_table)
  # The table's name, columns and primary key (generated by `table`).
  def self.table_info -> TableInfo = raise SchemaError.new(no_table)

  # The table's name, columns and primary key, as the class's (generated
  # by `table`).
  def table_info -> TableInfo = raise SchemaError.new(Model.no_table_of(self.class.name))

  # A model of this class made of `point`.
  def restore(point: Checkpoint) -> Self = Self.new(point)

  # Every row, as a query (`Rotor::Query`), to refine.
  def self.query -> Query[Self]
    Query[Self].new(table_info, self, [], [], nil, false, nil, nil, Query::Shape::Rows,
                    ->(v: Hash[Symbol, Object?], all: Bool) { all ? load(v) : load_partial(v) })
  end

  # `query.where`: the rows for which the block is true.
  def self.where(&cond: Quoted[shareable Self.() -> Bool]) -> Query[Self] = query.where(&cond)

  # :ditto:
  def self.where(&cond: Quoted[shareable (Self) -> Bool]) -> Query[Self] = query.where(&cond)

  # `query.filter`.
  def self.filter(&cond: Quoted[shareable (Self) -> Bool]) -> Query[Self] = query.filter(&cond)

  # `query.order`.
  def self.order(&key: Quoted[shareable Self.() -> Object]) -> Query[Self] = query.order(&key)

  # :ditto:
  def self.order(&key: Quoted[shareable (Self) -> Object]) -> Query[Self] = query.order(&key)

  # `query.select`.
  def self.select[R](&f: Quoted[shareable Self.() -> R]) -> Query[R] = query.select(&f)

  # :ditto:
  def self.select[R](&f: Quoted[shareable (Self) -> R]) -> Query[R] = query.select(&f)

  # `query.map`.
  def self.map[R](&f: Quoted[shareable (Self) -> R]) -> Query[R] = query.map(&f)

  # `query.count`.
  def self.count -> Query[Int] = query.count

  # `query.exists`.
  def self.exists -> Query[Bool] = query.exists

  # `query.first`.
  def self.first -> Query[Self] = query.first

  # `query.limit(n)`.
  def self.limit(n: Int) -> Query[Self] = query.limit(n)

  # The column `name`, or nil for none.
  def self.find_column(name: Symbol) -> Column? = columns.find { |c| c.name == name }

  # A model of this class with the given values, unchanged: as read from
  # a row. Each key must be a column, and each value of the column's type
  # (or nil where the column admits NULL); the columns not given keep
  # their defaults.
  def self.load(values: Hash[Symbol, Object?]) -> Self = new.loaded(values)

  # A model with only the given columns loaded (a `select` fetched
  # them): reading another raises `Rotor::NotLoadedError`.
  def self.load_partial(values: Hash[Symbol, Object?]) -> Self = new.loaded(values, partial: true)

  # The value of column `name` (`nil` for one not set that admits it).
  def read(name: Symbol) -> Object?
    c = column_of(name)
    c.null ? read_nullable(name) : read_attr(name)
  end

  # The model's values by column, those set only: a column without a
  # default that was never assigned is left out.
  def to_h -> Hash[Symbol, Value?] = @attrs

  # The columns assigned since the model was made or loaded, in the
  # order of their first assignment (one `with`'s in the columns' order).
  def changed -> Array[Symbol] = @changed

  # Whether a column was assigned since.
  def changed? -> Bool = !@changed.empty?

  # The model with only the assignments of `names` kept (after the
  # others were saved).
  def keep_changes(names: Array[Symbol]) -> Self
    restore(Checkpoint.new(@attrs, @changed.select { |n| names.include?(n) }, @loaded))
  end

  # The model with the assignments forgotten: after it was saved.
  def clear_changes -> Self = restore(Checkpoint.new(@attrs, [], @loaded))

  # A copy with the columns of `values` set, each checked against its
  # column's type, which remembers them as changed: what `with` does,
  # for code that names the columns at run time (the repository's
  # timestamps).
  def with_values(values: Hash[Symbol, Object?]) -> Self
    attrs = @attrs
    changed = @changed
    loaded = @loaded
    values.each_pair do |k, v|
      check_value(column_of(k), v)
      attrs = attrs.put(k, Model.value(v))
      changed = changed + [k] unless changed.include?(k)
      if l = loaded
        loaded = l + [k] unless l.include?(k)
      end
    end
    restore(Checkpoint.new(attrs, changed, loaded))
  end

  # The model with the values read from a row (`load`), checked, and no
  # assignment; `partial:` when they are only those a query fetched
  # (`load_partial`), without the defaults.
  def loaded(values: Hash[Symbol, Object?], *, partial: Bool = false) -> Self
    values.each_pair { |k, v| check_value(column_of(k), v) }
    attrs: Hash[Symbol, Value?] = partial ? {} : @attrs
    values.each_pair { |k, v| attrs = attrs.put(k, Model.value(v)) }
    restore(Checkpoint.new(attrs, [], partial ? values.keys : nil))
  end

  # What the model is made of.
  def checkpoint -> Checkpoint = Checkpoint.new(@attrs, @changed, @loaded)

  # `v` as a column's value (checked against its column before).
  def self.value(v: Object?) -> Value?
    case v
    in nil then nil
    in Int | Float | String | Bool | Time | Bytes then v
    else raise ArgumentError.new("not a column's value: #{v.class.name}")
    end
  end

  def inspect -> String
    "#<#{self.class.name} #{@attrs.map { |k, v| "#{k}: #{v.inspect}" }.join(", ")}>"
  end

  def to_s -> String = inspect


  private def read_attr(name: Symbol) -> Object?
    loaded!(name)
    unless @attrs.key?(name)
      raise MissingAttributeError.new("#{self.class.name}##{name} is not set")
    end
    @attrs[name]
  end

  private def read_nullable(name: Symbol) -> Object?
    loaded!(name)
    @attrs[name]?
  end

  private def loaded!(name: Symbol) -> Void
    if (l = @loaded) && !l.include?(name)
      raise NotLoadedError.new("#{self.class.name}##{name} was not loaded: the query fetched #{l.map { |n| n.to_s }.join(", ")}")
    end
  end

  private def column_of(name: Symbol) -> Column
    table_info.columns.find { |c| c.name == name } ||
      raise ArgumentError.new("#{self.class.name} has no column `#{name}`")
  end

  private def check_value(c: Column, v: Object?) -> Void
    if v.nil?
      return if c.null
      raise ArgumentError.new("#{self.class.name}##{c.name} cannot be nil")
    end
    unless v.is_a?(c.type)
      raise ArgumentError.new("#{self.class.name}##{c.name} takes #{c.type.name}, not #{v.class.name}")
    end
  end

  private def self.no_table -> String = no_table_of(name)

  # Raises unless `klass` is `owner` (by name), the class whose `table`
  # generated the member called: a subclass that inherits a table is
  # refused at its first use (the members `with` among them are its
  # parent's).
  def self.own_table!(klass: Class, owner: String) -> Void
    return if klass.name == owner
    raise SchemaError.new("#{klass.name} has no table; a model declares its own; single-table inheritance is not provided")
  end

  # The message for a model without a `table` block.
  def self.no_table_of(model: String) -> String =
    "#{model} has no schema: declare its columns in a `table do ... end` block in its class body"

  # The getter of column `c`, typed by its type.
  private static def self.accessors(c: Column) -> Void
    n = c.name
    t = c.type
    if t == Int
      if c.null
        def_method(n) { read_nullable(n).as?(Int) }
      else
        def_method(n) { read_attr(n).as(Int) }
      end
    elsif t == Float
      if c.null
        def_method(n) { read_nullable(n).as?(Float) }
      else
        def_method(n) { read_attr(n).as(Float) }
      end
    elsif t == String
      if c.null
        def_method(n) { read_nullable(n).as?(String) }
      else
        def_method(n) { read_attr(n).as(String) }
      end
    elsif t == Bool
      if c.null
        def_method(n) { read_nullable(n).as?(Bool) }
      else
        def_method(n) { read_attr(n).as(Bool) }
      end
    elsif t == Time
      if c.null
        def_method(n) { read_nullable(n).as?(Time) }
      else
        def_method(n) { read_attr(n).as(Time) }
      end
    else
      if c.null
        def_method(n) { read_nullable(n).as?(Bytes) }
      else
        def_method(n) { read_attr(n).as(Bytes) }
      end
    end
  end
end
