# What a parameter of a statement may be: the values PostgreSQL is
# given (a symbol as its name).
type Bindable = Int | Float | String | Bool | Time | Bytes | Symbol | Items

# An array parameter: one class's values (pg sends it as one array).
type Items = Array[Int] | Array[Float] | Array[String] | Array[Bool] | Array[Time] | Array[Bytes] | Array[Symbol]

# A piece of SQL: text, a column of one of a query's tables (by the
# table's index among them: qualified by the table's alias in a join),
# or the value of a parameter, numbered (`$n`) when the statement is put
# together. A translation the cache keeps (`Rotor::Cache`) holds
# `Bound` pieces, parameters made from the block's captures, which each
# build fills in with its own (`Rotor::Binds.fill`).
enum Piece
  variant Text(text: String)
  variant Column(source: Int, name: Symbol)
  variant Param(value: Bindable?)
  variant Bound(bind: Bind)
end

# A translated expression: its pieces, its precedence (to parenthesize it
# where it is an operand), and what the translator knows of it: the
# column it is, or the value it has (`known`) when it is a literal or a
# capture, and then (`bind`) the capture it is made from. `nulls` names
# what makes it NULL where Quarz has nil (a nullable column, shown as
# written), `tri` what makes it NULL where Quarz has false: a comparison,
# `include?` or LIKE form of something that can be NULL, three-valued in
# SQL. A `tri` expression is kept where NULL acts as false (a condition,
# an operand of `&&`/`||`, a CASE WHEN's), and refused anywhere else.
# `narrow` marks what PostgreSQL types as an `integer` where Quarz has
# an `Int`: an `Int` literal, or a CASE of them. A column never is:
# rotor does not know the SQL type of a table it did not create, whose
# `integer` columns are left as they are (README, "Parameter types").
#
# `test` names an `&&` or `||` (as written) that tests the truthiness
# of an operand other than a `Bool` (`email IS NOT NULL`): right as a
# condition, but a `Bool` where Quarz has one of the operands, so
# refused as a value as `tri` is.
data Sql = (pieces: Array[Piece], prec: Int, column: Column?, value: Bindable?, known: Bool, bind: Bind? = nil, nulls: String? = nil, tri: String? = nil, narrow: Bool = false, test: String? = nil)

# A block of a query's tree as the translator sees it: its parameters,
# the table (an index among the query's) each one is a row of, or nil,
# and whether it has a receiver and which table's row that is. `known`
# is false for a block given to a call the translator does not know,
# which may or may not have a receiver. `whole` lists the tables of a
# join whose row its one parameter (or its receiver) is as a whole: what
# it reads of each is then all of it.
data Scope = (params: Array[Symbol], rows: Array[Int?], receiver: Bool, row: Int?, known: Bool, whole: Array[Int] = [])

# Translates the tree of a query's block (`Meta::Expr`, Quarz's docs/14
# §6) to SQL, with the values its captures had when the query was built.
# The block's row is its receiver (`where { age > 18 }`) or its
# parameter (`where { |u| u.age > 18 }`), one per table in a join
# (`where { |u, p| p.user_id == u.id }`); a call of a column's getter on
# a row is the column, and on a model the block captured, its value.
class Translator
  # Precedences, loosest first (PostgreSQL's order).
  OR = 1
  AND = 2
  NOT = 3
  IS = 4
  CMP = 5
  LIKE = 6
  OTHER = 7
  ADD = 8
  MUL = 9
  ATOM = 10

  COMPARISONS = {"==": "=", "!=": "<>", "<": "<", "<=": "<=", ">": ">", ">=": ">="}
  ARITHMETIC = {"+": "+", "-": "-", "*": "*", "/": "/", "%": "%"}

  # The overloads whose SQL differs from the operator's: `Int#/(Int)`
  # floors and `Int#%(Int)` takes the divisor's sign; `Int#/(Float)` is
  # a plain `/`.
  INT_DIV = Translator.called { |a: Int, b: Int| a / b }
  INT_MOD = Translator.called { |a: Int, b: Int| a % b }
  INT_BY_FLOAT = Translator.called { |a: Int, b: Float| a / b }

  # The method `q`'s body calls.
  def self.called[A, B, R](&q: Quoted[(A, B) -> R]) -> Meta::MethodRef
    case q.expr
    in Meta::Expr::Block(_, [Meta::Expr::Call(_, m, _, _, _, _)], _) then m
    else raise ArgumentError.new("not a call")
    end
  end

  # What `row_in` gives for what is not a row, and for a `self` that may
  # be any receiver's.
  NONE = -1
  ANY = -2

  # The query's tables, in order.
  @sources: Array[Source]
  @captures: Array[Object]
  @file: String
  # The blocks the expressions translated are in, the innermost last.
  @scopes: Array[Scope]
  # What the translation looked at of the captures (shared with the
  # translators of the blocks inside).
  @guards: Guards
  # The columns (a table's index and a name) known not to be NULL where
  # the expression being translated is: by the left side of a `&&`
  # (`!email.nil? && ...`), of a `||` (`email.nil? || ...`), or by an
  # `if`'s condition.
  var @non_null: Array[[Int, Symbol]]

  def initialize(@sources: Array[Source], @captures: Array[Object], @file: String, @scopes: Array[Scope], @guards: Guards = Guards.new, @non_null: Array[[Int, Symbol]] = [])
  end

  # The kinds of captured values the translation so far holds for: the
  # same tree with captures of these kinds translates the same, up to
  # the values of its `Rotor::Piece::Bound` pieces.
  def guards -> Array[Guard] = @guards.list

  # The translator of a quoted block over the rows of `sources`, and the
  # block's one expression.
  def self.of(sources: Array[Source], expr: Meta::Expr, captures: Array[Object], file: String) -> [Translator, Meta::Expr]
    params, e = Translator.body(expr, file)
    tables: Array[Int] = []
    sources.each_with_index { |_, i| tables = tables + [i] }
    [Translator.new(sources, captures, file, [Translator.scope(params, tables)]), e]
  end

  # A block's parameters and its one expression.
  def self.body(expr: Meta::Expr, file: String) -> [Array[Symbol], Meta::Expr]
    case expr
    in Meta::Expr::Block(params, body, line)
      if body.size != 1
        raise UntranslatableError.new("a block of #{body.size} statements cannot be translated to SQL (#{file}:#{line}): write one expression")
      end
      [params, body[0]]
    else
      raise UntranslatableError.new("not a block (#{file})")
    end
  end

  # The scope of a block over the rows of `tables` (indexes among the
  # query's): its receiver when it has no parameters (the row of a
  # single table), else its parameters, one per table (the first
  # parameter for a single table).
  def self.scope(params: Array[Symbol], tables: Array[Int]) -> Scope
    rows: Array[Int?] = []
    params.each_with_index do |_, i|
      rows = rows + [tables.size == 1 ? (i == 0 ? tables[0] : nil) : (params.size == tables.size ? tables[i] : nil)]
    end
    receiver = params.empty?
    whole: Array[Int] = tables.size > 1 && params.size != tables.size ? tables : []
    Scope.new(params, rows, receiver, receiver && tables.size == 1 ? tables[0] : nil, true, whole)
  end

  # This translator for a block inside the one it translates, whose
  # scope is `scope`, over `sources` (the tables a `for` has joined so
  # far).
  def inner(sources: Array[Source], scope: Scope) -> Translator = Translator.new(sources, @captures, @file, @scopes + [scope], @guards, @non_null)

  # The table whose row `e` is (an index among the query's), `NONE`
  # for none.
  def row_of(e: Meta::Expr) -> Int = row_in(e, @scopes)

  # The file the block is written in.
  def file -> String = @file

  # The line of `e`.
  def self.line_of(e: Meta::Expr) -> Int
    case e
    in Meta::Expr::Lit(_, l) then l
    in Meta::Expr::Capture(_, _, l) then l
    in Meta::Expr::Arg(_, _, l) then l
    in Meta::Expr::SelfRef(_, l) then l
    in Meta::Expr::Call(_, _, _, _, _, l) then l
    in Meta::Expr::And(_, _, l) then l
    in Meta::Expr::Or(_, _, l) then l
    in Meta::Expr::Not(_, _, l) then l
    in Meta::Expr::If(_, _, _, l) then l
    in Meta::Expr::ArrayLit(_, l) then l
    in Meta::Expr::HashLit(_, l) then l
    in Meta::Expr::Interp(_, l) then l
    in Meta::Expr::Block(_, _, l) then l
    end
  end

  # `e` as SQL.
  def sql(e: Meta::Expr) -> Sql
    case e
    in Meta::Expr::Lit(value, line) then literal(value, line)
    in Meta::Expr::Capture(index, name, line)
      b = bound(Bind::Capture.new(index), line)
      b.value.nil? ? Sql.new(b.pieces, b.prec, nil, nil, true, b.bind, name.to_s) : b
    in Meta::Expr::And(l, r, _) then logical(e, l, "AND", r, AND, facts(l, true))
    in Meta::Expr::Or(l, r, _) then logical(e, l, "OR", r, OR, facts(l, false))
    in Meta::Expr::Not(x, ms, line)
      # (A member of a union with a `!` of its own, a class's or an
      # extension's: not SQL's NOT.)
      unless ms.empty?
        m = ms[0]
        ext = m.extension
        untranslatable(ext ? "#{Translator.label(m)} of #{ext.name}" : Translator.label(m), line)
      end
      o = truth(x, sql(x))
      if what = o.tri || o.nulls
        raise UntranslatableError.new(negation_error(x, what, line))
      end
      prefix("NOT", o, NOT)
    in Meta::Expr::If(c, t, f, line)
      # (Its parameters cast, a bare one in the condition and those of
      # the branches: PostgreSQL types a `CASE` of untyped ones as text.)
      cond = sql(c)
      # (A known condition other than a `Bool` is truthy unless nil, which
      # its guard keeps: the branch it takes.)
      if cond.known && !cond.value.is_a?(Bool)
        return assuming(facts(c, true)) { sql(t) } unless cond.value.nil?
        return assuming(facts(c, false)) { sql(f.as(Meta::Expr)) } if f
        return Sql.new([Piece::Text.new("NULL")], ATOM, nil, nil, false, nil, Translator.show(e))
      end
      cond = cast(truth(c, cond))
      # (A branch that is NULL where Quarz has false makes the `if` so,
      # as an operand of `&&` does: kept as a condition, refused as a
      # value.)
      th = cast(assuming(facts(c, true)) { sql(t) })
      pieces = [Piece::Text.new("CASE WHEN ")] + cond.pieces + [Piece::Text.new(" THEN ")] + th.pieces
      el = if f
             x = cast(assuming(facts(c, false)) { sql(f) })
             pieces = pieces + [Piece::Text.new(" ELSE ")] + x.pieces
             x
           end
      nulls = th.nulls || (el ? el.nulls : Translator.show(e))
      # (Nil either way, which the captures' guards keep: NULL, which
      # takes the type of what it meets, where a `CASE` of NULLs is text.
      # Not a known value: as an order key, the same as the `CASE` it
      # stands for.)
      if Translator.null?(th) && (el.nil? || Translator.null?(el.as(Sql)))
        return Sql.new([Piece::Text.new("NULL")], ATOM, nil, nil, false, nil, nulls, th.tri || (el ? el.tri : nil))
      end
      # (`integer` when its branches are, NULL taking their type.)
      narrow = (th.narrow || Translator.null?(th)) && (el.nil? || el.as(Sql).narrow || Translator.null?(el.as(Sql)))
      Sql.new(pieces + [Piece::Text.new(" END")], ATOM, nil, nil, false, nil, nulls, th.tri || (el ? el.tri : nil), narrow, th.test || (el ? el.test : nil))
    in Meta::Expr::Call(recv, m, ms, args, block, line) then call(recv, m, ms, args, block, line)
    in Meta::Expr::SelfRef(_, line) then untranslatable("the row itself", line)
    in Meta::Expr::Arg(name, _, line) then untranslatable("the parameter `#{name}` by itself", line)
    in Meta::Expr::ArrayLit(_, line) then untranslatable("an array literal", line)
    in Meta::Expr::HashLit(_, line) then untranslatable("a hash literal", line)
    in Meta::Expr::Interp(_, line) then untranslatable("an interpolated string", line)
    in Meta::Expr::Block(_, _, line) then untranslatable("a block", line)
    end
  end

  # `e` as SQL where it is a value, not a condition: an `update`'s value,
  # an order's key, an operand. A comparison that can be NULL
  # (`Sql#tri`) is refused: NULL is not false there.
  def operand(e: Meta::Expr) -> Sql
    s = sql(e)
    if what = s.tri
      raise UntranslatableError.new(Translator.value_error(e, what, @file))
    end
    if what = s.test
      raise UntranslatableError.new(Translator.test_error(e, what, @file))
    end
    s
  end

  # The error for `e`, where `what` (an `&&` or `||` of an operand other
  # than a `Bool`) is a value.
  def self.test_error(e: Meta::Expr, what: String, file: String) -> String
    "`#{what}` as a value is one of its operands in Quarz, but a `Bool` in SQL (#{file}:#{line_of(e)}): write an `if`"
  end

  # The error for `e`, which is NULL where `what` is, used as a value.
  def self.value_error(e: Meta::Expr, what: String, file: String) -> String
    advice = column_named?(e, what) ? "compare in Quarz (select the column), or test `#{what}.nil?` explicitly" : nil_advice(what)
    "`#{show(e)}` as a value is NULL, not false, in SQL when `#{what}` is NULL (#{file}:#{line_of(e)}): #{advice}"
  end

  # What to do when what can be NULL is not a column, which `nil?`
  # tells nothing of in SQL: a nil captured or written.
  def self.nil_advice(what: String) -> String
    return "write the case of nil out instead of `nil`" if what == "nil"
    "decide what a nil `#{what}` means in Quarz, before the query is built"
  end

  # Whether `what` is shown in `e` as a call of a getter on a row or
  # `self`: a column (not a capture, nor a captured model's value).
  def self.column_named?(e: Meta::Expr, what: String) -> Bool
    case e
    in Meta::Expr::Call(recv, _, _, args, _, _)
      case recv
      in Meta::Expr::SelfRef(_, _) | Meta::Expr::Arg(_, _, _) then return true if args.empty? && show(e) == what
      else nil
      end
      (recv ? [recv.as(Meta::Expr)] : Array[Meta::Expr].new).concat(args).any? { |x| column_named?(x, what) }
    in Meta::Expr::And(l, r, _) then column_named?(l, what) || column_named?(r, what)
    in Meta::Expr::Or(l, r, _) then column_named?(l, what) || column_named?(r, what)
    in Meta::Expr::Not(x, _, _) then column_named?(x, what)
    in Meta::Expr::If(c, t, f, _) then column_named?(c, what) || column_named?(t, what) || (f ? column_named?(f.as(Meta::Expr), what) : false)
    in Meta::Expr::ArrayLit(xs, _) then xs.any? { |x| column_named?(x, what) }
    else false
    end
  end

  # `e` as Quarz source, for messages (a row's receiver left implicit).
  def self.show(e: Meta::Expr) -> String
    case e
    in Meta::Expr::Lit(value, _) then value.inspect
    in Meta::Expr::Capture(_, name, _) then name.to_s
    in Meta::Expr::Arg(name, _, _) then name.to_s
    in Meta::Expr::SelfRef(_, _) then "self"
    in Meta::Expr::Call(recv, m, _, args, block, _)
      name = m.name.to_s
      tail = block ? " { ... }" : ""
      if recv && args.size == 1 && (COMPARISONS.has_key?(m.name) || ARITHMETIC.has_key?(m.name))
        return "#{shown_operand(recv)} #{name} #{shown_operand(args[0])}"
      end
      return "-#{shown_operand(recv)}" if recv && name == "-@" && args.empty?
      head = if m.singleton
               "#{m.owner.name}.#{name}"
             else
               case recv
               in Meta::Expr::SelfRef(_, _) then name
               in Meta::Expr => x then "#{shown_operand(x)}.#{name}"
               else name
               end
             end
      list = args.empty? ? "" : "(#{args.map { |x| show(x) }.join(", ")})"
      "#{head}#{list}#{tail}"
    in Meta::Expr::And(l, r, _) then "#{shown_operand(l)} && #{shown_operand(r)}"
    in Meta::Expr::Or(l, r, _) then "#{shown_operand(l)} || #{shown_operand(r)}"
    in Meta::Expr::Not(x, _, _) then "!#{shown_operand(x)}"
    in Meta::Expr::If(c, t, f, _)
      f ? "#{shown_operand(c)} ? #{shown_operand(t)} : #{shown_operand(f)}" : "if #{show(c)} then #{show(t)} end"
    in Meta::Expr::ArrayLit(xs, _) then "[#{xs.map { |x| show(x) }.join(", ")}]"
    in Meta::Expr::HashLit(_, _) then "{...}"
    in Meta::Expr::Interp(_, _) then "\"...\""
    in Meta::Expr::Block(_, _, _) then "{ ... }"
    end
  end

  # `show(e)`, parenthesized when it is an operator's.
  def self.shown_operand(e: Meta::Expr) -> String
    text = show(e)
    case e
    in Meta::Expr::And(_, _, _) | Meta::Expr::Or(_, _, _) | Meta::Expr::If(_, _, _, _) then "(#{text})"
    in Meta::Expr::Call(Meta::Expr, m, _, [_], nil, _) if COMPARISONS.has_key?(m.name) || ARITHMETIC.has_key?(m.name) then "(#{text})"
    else text
    end
  end

  # The table and column `e` is (a column's getter called on a row), or
  # nil.
  def column_of(e: Meta::Expr) -> [Int, Column]?
    case e
    in Meta::Expr::Call(Meta::Expr => recv, m, _, [], nil, _) if !m.singleton && m.extension.nil?
      s = row_in(recv, @scopes)
      return nil if s < 0
      src = @sources[s]
      return nil unless src.model <= m.owner
      c = src.table.columns.find { |x| x.name == m.name } || return nil
      [s, c]
    else
      nil
    end
  end

  # The columns `e` reads of each table's row, in the table's order, nil
  # for one whose row it may read more of: it calls another method of the
  # row or passes the row on (its value is computed in Quarz,
  # `Rotor::Query#select`). An association's getter reads the key it
  # needs.
  def reads(e: Meta::Expr) -> Array[Array[Column]?]
    found = collect(e, @scopes)
    @sources.each_with_index.map do |src, i|
      names = found.select { |x| x[0] == i }.map { |x| x[1] }
      if names.any? { |n| n.nil? }
        nil
      else
        src.table.columns.select { |c| names.include?(c.name) }
      end
    end
  end

  # Raises the error for `what` at `line`.
  def untranslatable(what: String, line: Int) -> Nothing
    raise UntranslatableError.new("#{what} cannot be translated to SQL (#{@file}:#{line})")
  end

  # The classes whose operators and methods the translator knows.
  private def primitive?(t: Type[Object]) -> Bool
    t == Int || t == Float || t == String || t == Bool || t == Time || t == Bytes || t == Object || t == Nil || t == Array || t == Comparable
  end

  # The table whose row `e` is in `scopes` (innermost last): an `Arg`
  # naming a parameter that is a row, or a `SelfRef` to a receiver that
  # is one; `NONE` for anything else, `ANY` for a `self` inside a block
  # that may have a receiver of its own (the tree does not say).
  private def row_in(e: Meta::Expr, scopes: Array[Scope]) -> Int
    case e
    in Meta::Expr::Arg(name, depth, _)
      return NONE if depth >= scopes.size
      s = scopes[scopes.size - 1 - depth]
      i = s.params.find_index(name) || return NONE
      s.rows[i] || NONE
    in Meta::Expr::SelfRef(depth, _)
      seen = 0
      i = scopes.size - 1
      while i >= 0
        s = scopes[i]
        return ANY unless s.known
        if s.receiver
          return s.row || NONE if seen == depth
          seen += 1
        end
        i -= 1
      end
      NONE
    else
      NONE
    end
  end

  # What `e` reads of the rows in `scopes`: pairs of a table and a column,
  # or of a table and nil for its whole row. A block given to a call
  # inside the quoted one is a scope of its own, not known.
  private def collect(e: Meta::Expr, scopes: Array[Scope]) -> Array[[Int, Symbol?]]
    case e
    in Meta::Expr::Call(Meta::Expr => recv, m, _, [], nil, _) if !m.singleton && m.extension.nil?
      s = row_in(recv, scopes)
      if s >= 0 && @sources[s].model <= m.owner
        t = @sources[s].table
        if c = t.columns.find { |x| x.name == m.name }
          return read(s, c.name)
        end
        if a = t.associations.find { |x| x.name == m.name }
          k = a.kind == :has_many ? t.primary_key : a.foreign_key
          return k ? read(s, k) : none
        end
      end
    else
      nil
    end
    case e
    in Meta::Expr::SelfRef(_, _) then row_reads(e, scopes)
    in Meta::Expr::Arg(_, _, _) then row_reads(e, scopes)
    in Meta::Expr::Lit(_, _) then none
    in Meta::Expr::Capture(_, _, _) then none
    in Meta::Expr::Call(recv, _, _, args, block, _)
      xs = args
      xs = xs + [recv] if recv
      found = all(xs, scopes)
      block ? found + collect(block, scopes) : found
    in Meta::Expr::And(l, r, _) then all([l, r], scopes)
    in Meta::Expr::Or(l, r, _) then all([l, r], scopes)
    in Meta::Expr::Not(x, _, _) then all([x], scopes)
    in Meta::Expr::If(c, t, f, _)
      xs = [c, t]
      xs = xs + [f] if f
      all(xs, scopes)
    in Meta::Expr::ArrayLit(xs, _) then all(xs, scopes)
    in Meta::Expr::HashLit(ps, _) then all(ps.flat_map { |p| [p[0], p[1]] }, scopes)
    in Meta::Expr::Interp(xs, _) then all(xs, scopes)
    in Meta::Expr::Block(params, body, _)
      rows: Array[Int?] = []
      params.each { |_| rows = rows + [nil] }
      all(body, scopes + [Scope.new(params, rows, false, nil, false)])
    end
  end

  # The whole row `e` is, if it is one (`row_in`).
  private def row_reads(e: Meta::Expr, scopes: Array[Scope]) -> Array[[Int, Symbol?]]
    s = row_in(e, scopes)
    return read(s, nil) if s >= 0
    # (A join's row as one parameter or a receiver: all of each table.)
    if (sc = scope_of(e, scopes)) && !sc.whole.empty?
      out = none
      sc.whole.each { |t| out = out + read(t, nil) }
      return out
    end
    return none unless s == ANY
    out = none
    scopes.each do |sc|
      if sc.known && sc.receiver
        if r = sc.row
          out = out + read(r, nil)
        end
        sc.whole.each { |t| out = out + read(t, nil) }
      end
    end
    out
  end

  # The scope of the parameter `e` names or the receiver it is, if
  # known.
  private def scope_of(e: Meta::Expr, scopes: Array[Scope]) -> Scope?
    case e
    in Meta::Expr::Arg(name, depth, _)
      return nil if depth >= scopes.size
      sc = scopes[scopes.size - 1 - depth]
      sc.params.include?(name) ? sc : nil
    in Meta::Expr::SelfRef(depth, _)
      seen = 0
      i = scopes.size - 1
      while i >= 0
        sc = scopes[i]
        return nil unless sc.known
        if sc.receiver
          return sc if seen == depth
          seen += 1
        end
        i -= 1
      end
      nil
    else
      nil
    end
  end

  private def read(s: Int, name: Symbol?) -> Array[[Int, Symbol?]] = [[s, name]]

  private def none -> Array[[Int, Symbol?]]
    out: Array[[Int, Symbol?]] = []
    out
  end

  private def all(es: Array[Meta::Expr], scopes: Array[Scope]) -> Array[[Int, Symbol?]]
    out = none
    es.each { |x| out = out + collect(x, scopes) }
    out
  end

  # `l && r` or `l || r`, `r` translated where `known` holds (what `l`
  # being true, or false, tells of the columns). NULL where either side
  # is: as false, under `&&` and `||` alike (a nullable `Bool` column's
  # nil, falsy in Quarz, as well).
  private def logical(e: Meta::Expr, l: Meta::Expr, op: String, r: Meta::Expr, prec: Int, known: Array[[Int, Symbol]]) -> Sql
    sa = sql(l)
    sb = assuming(known) { sql(r) }
    a = truth(l, sa)
    b = assuming(known) { truth(r, sb) }
    out = three(binary(a, op, b, prec, true), a.tri || b.tri || a.nulls || b.nulls)
    tested = a.pieces != sa.pieces || b.pieces != sb.pieces ? Translator.show(e) : a.test || b.test
    Sql.new(out.pieces, out.prec, out.column, out.value, out.known, out.bind, out.nulls, out.tri, false, tested)
  end

  # The block's value, translated with the columns of `known` taken for
  # non-null as well.
  private def assuming[R](known: Array[[Int, Symbol]], &f: () -> R) -> R
    return f.call if known.empty?
    saved = @non_null
    @non_null = @non_null + known
    begin
      f.call
    ensure
      @non_null = saved
    end
  end

  # The columns `e` being `truth` makes non-null: `!c.nil?`, `c != nil`
  # and `&&` of them when true, `c.nil?`, `c == nil` and `||` of them
  # when false.
  private def facts(e: Meta::Expr, truth: Bool) -> Array[[Int, Symbol]]
    out: Array[[Int, Symbol]] = []
    case e
    in Meta::Expr::Not(x, _, _) then return facts(x, !truth)
    in Meta::Expr::And(l, r, _) then return truth ? facts(l, true) + facts(r, true) : out
    in Meta::Expr::Or(l, r, _) then return truth ? out : facts(l, false) + facts(r, false)
    in Meta::Expr::Call(Meta::Expr => recv, m, _, [], nil, _) if m.name == :nil? && !m.singleton
      return truth ? out : nullable_column(recv)
    in Meta::Expr::Call(Meta::Expr => recv, m, _, [arg], nil, _) if (m.name == :== || m.name == :!=) && !m.singleton
      return out unless (m.name == :!=) == truth
      return nullable_column(recv) if nil_literal?(arg)
      return nullable_column(arg) if nil_literal?(recv)
      out
    else
      out
    end
  end

  # The table and name of the column `e` is, if it is one.
  private def nullable_column(e: Meta::Expr) -> Array[[Int, Symbol]]
    out: Array[[Int, Symbol]] = []
    if found = column_of(e)
      out = out + [[found[0], found[1].name]]
    end
    out
  end

  private def nil_literal?(e: Meta::Expr) -> Bool
    case e
    in Meta::Expr::Lit(nil, _) then true
    else false
    end
  end

  # `s`, three-valued (`Sql#tri`) when `what` is not nil.
  private def three(s: Sql, what: String?) -> Sql = Sql.new(s.pieces, s.prec, s.column, s.value, s.known, s.bind, s.nulls, what, s.narrow, s.test)

  # `s`, NULL where one of `operands` is.
  private def with_nulls(s: Sql, operands: Array[Sql]) -> Sql
    what = operands.find { |x| x.nulls }&.nulls
    Sql.new(s.pieces, s.prec, s.column, s.value, s.known, s.bind, what, s.tri, s.narrow, s.test)
  end

  # The error for `!x`, where `what` can be NULL.
  private def negation_error(x: Meta::Expr, what: String, line: Int) -> String
    column = Translator.column_named?(x, what)
    test = column ? "test `#{what}.nil?` explicitly" : Translator.nil_advice(what)
    advice = case x
             in Meta::Expr::Call(Meta::Expr => l, m, _, [r], nil, _) if m.name == :== && !m.singleton
               "write `#{Translator.shown_operand(l)} != #{Translator.shown_operand(r)}` (Quarz's meaning, `IS DISTINCT FROM`), or #{test}"
             in Meta::Expr::Call(Meta::Expr => l, m, _, [r], nil, _) if m.name == :!= && !m.singleton
               "write `#{Translator.shown_operand(l)} == #{Translator.shown_operand(r)}`, or #{test}"
             else
               column ? "#{test} (`#{what}.nil? || !#{Translator.shown_operand(x)}`)" : test
             end
    "`!#{Translator.shown_operand(x)}` is three-valued in SQL when `#{what}` can be NULL (#{@file}:#{line}): #{advice}"
  end

  private def node(pieces: Array[Piece], prec: Int) -> Sql = Sql.new(pieces, prec, nil, nil, false)

  private def text(s: String, prec: Int) -> Sql = node([Piece::Text.new(s)], prec)

  private def literal(value: Object, line: Int) -> Sql
    case value
    in nil then Sql.new([Piece::Text.new("NULL")], ATOM, nil, nil, true, nil, "nil")
    in true then Sql.new([Piece::Text.new("TRUE")], ATOM, nil, true, true)
    in false then Sql.new([Piece::Text.new("FALSE")], ATOM, nil, false, true)
    # (Beyond an `integer`'s range PostgreSQL types it as a bigint.)
    in Int => i then Sql.new([Piece::Text.new(i.to_s)], ATOM, nil, i, true, nil, nil, nil, i >= -2147483648 && i <= 2147483647)
    in Float | String | Time | Bytes | Symbol then param(value, line)
    else untranslatable("the literal #{value.inspect}", line)
    end
  end

  private def param(value: Object?, line: Int) -> Sql
    v = bindable(value, line)
    Sql.new([Piece::Param.new(v)], ATOM, nil, v, true)
  end

  # The parameter made from the captures by `bind`, its value this
  # build's: a `Bound` piece, and a guard on the value's kind.
  private def bound(bind: Bind, line: Int) -> Sql
    v = bindable(look(bind), line)
    Sql.new([Piece::Bound.new(bind)], ATOM, nil, v, true, bind)
  end

  # The captured value `bind` reads, noted as looked at.
  private def look(bind: Bind) -> Object?
    v = Binds.value(bind, @captures)
    @guards.add(Guard.new(bind, Binds.kind(v)))
    v
  end

  # `value` as a statement's parameter.
  private def bindable(value: Object?, line: Int) -> Bindable?
    case value
    in nil then nil
    in Int => x then x
    in Float => x then x
    in String => x then x
    in Bool => x then x
    in Time => x then x
    in Bytes => x then x
    in Symbol => x then x
    else untranslatable("a value of class #{value.class.name}", line)
    end
  end

  private def wrap(s: Sql, min: Int) -> Array[Piece]
    if s.prec < min
      [Piece::Text.new("(")] + s.pieces + [Piece::Text.new(")")]
    else
      s.pieces
    end
  end

  # `l op r`: left-associative when `assoc`, else both sides tighter.
  private def binary(l: Sql, op: String, r: Sql, prec: Int, assoc: Bool) -> Sql
    left = wrap(l, assoc ? prec : prec + 1)
    right = wrap(r, prec + 1)
    node(left + [Piece::Text.new(" #{op} ")] + right, prec)
  end

  private def prefix(op: String, x: Sql, prec: Int) -> Sql = node([Piece::Text.new("#{op} ")] + wrap(x, prec), prec)

  private def postfix(x: Sql, op: String, prec: Int) -> Sql = node(wrap(x, prec + 1) + [Piece::Text.new(" #{op}")], prec)

  # `m` for messages: `` `Int#>` ``, `` `Rotor::SQL.lower` ``.
  def self.label(m: Meta::MethodRef) -> String = "`#{m.owner.name}#{m.singleton ? "." : "#"}#{m.name}`"

  private def call(recv: Meta::Expr?, m: Meta::MethodRef, ms: Array[Meta::MethodRef], args: Array[Meta::Expr], block: Meta::Expr?, line: Int) -> Sql
    name = m.name.to_s
    label = Translator.label(m)
    if recv.nil?
      untranslatable("the function #{label}", line)
    end
    r = recv.as(Meta::Expr)
    whole = Meta::Expr::Call.new(r, m, ms, args, block, line)
    if found = column_of(whole)
      c = found[1]
      if c.null && @non_null.any? { |x| x[0] == found[0] && x[1] == c.name }
        c = Column.new(c.name, c.sql, c.type, false, c.primary, c.default)
      end
      return Sql.new([Piece::Column.new(found[0], c.name)], ATOM, c, nil, false, nil, c.null ? Translator.show(whole) : nil)
    end
    if v = captured(r, m, args, block, line)
      return v
    end
    untranslatable("the block given to #{label}", line) if block
    if m.singleton && m.owner == SQL
      ms.each { |x| untranslatable(Translator.label(x), line) unless x.singleton && x.owner == SQL }
      return function(name, args, label, line)
    end
    # Every method the call may run, one for each member of a union
    # receiver (`Int#>` and `Nil#>` for an `Int?`'s `>`), is one the
    # translator knows: a primitive's own, or `Rotor::Compare`'s, a
    # comparison taking nil (another extension's is the user's).
    ([m] + ms).each do |x|
      untranslatable(Translator.label(x), line) unless !x.singleton && primitive?(x.owner)
      if ext = x.extension
        untranslatable("#{Translator.label(x)} of #{ext.name}", line) unless ext == Compare
      end
    end
    if args.size == 0
      case name
      in "nil?" then return is_null(operand(r), "IS NULL")
      in "-@"
        # (`- $1` is ambiguous to PostgreSQL: the parameter cast.)
        # (Of an `integer`, a bigint: `-(-2147483648)` would overflow.)
        x = bigint(cast(operand(r)))
        return with_nulls(prefix("-", x, MUL + 1), [x])
      else untranslatable(label, line)
      end
    end
    untranslatable(label, line) unless args.size == 1
    a = args[0]
    if name == "include?" && m.owner == Array
      return in_list(r, a, line)
    end
    if m.owner == String && (name == "include?" || name == "start_with?" || name == "end_with?")
      return like(operand(r), a, name, label, line)
    end
    if sym = COMPARISONS[m.name]?
      if arr = ms.find { |x| x.owner == Array }
        untranslatable(Translator.label(arr), line)
      end
      # (`Rotor::Compare` gives nil an order, false either way: with a
      # literal nil the comparison is always false, which is not what
      # was meant. `== nil` is `IS NULL`.)
      if name != "==" && name != "!=" && (nil_literal?(r) || nil_literal?(a))
        raise UntranslatableError.new("`#{Translator.show(r)} #{name} #{Translator.show(a)}` is always false (#{@file}:#{line}): compare with a value, or use `nil?`")
      end
      return compare(r, sym, a)
    end
    if op = ARITHMETIC[m.name]?
      l = operand(r)
      rr = operand(a)
      # (A `Float` is double precision also against a `Float` column:
      # `r + 0.5` on a `real` one computes as Quarz does on the value
      # read.)
      l, rr = typed(l, rr, true), typed(rr, l, true)
      return with_nulls(binary(l, "||", rr, OTHER, true), [l, rr]) if name == "+" && m.owner == String
      untranslatable(label, line) unless m.owner == Int || m.owner == Float
      # (Two `integer`s, as `Int` literals are, would overflow where
      # Quarz's `Int` does not: the left one a bigint, and so the
      # operation. `/` floors in numeric.)
      l = bigint(l) if rr.narrow && name != "/"
      # (On a union receiver, `Int#/(Int)` floors and `Float#/` does not:
      # the SQL would be one of them for every row. `+`, `-` and `*`, and
      # `/` by a `Float`, are the same for both.)
      if other = ms.find { |x| x != m && ((name == "/" && (x == INT_DIV || m == INT_DIV)) || name == "%" || !(x.owner == Int || x.owner == Float)) }
        untranslatable("#{label} and #{Translator.label(other)} together (on a union receiver)", line)
      end
      if m.owner == Int && name == "/" && m != INT_DIV
        untranslatable(label, line) unless m == INT_BY_FLOAT
        return with_nulls(binary(l, "/", rr, MUL, true), [l, rr])
      end
      if m.owner == Int && name == "/"
        # Quarz's `Int#/` floors; PostgreSQL's truncates.
        return with_nulls(node([Piece::Text.new("floor(")] + wrap(l, ATOM) + [Piece::Text.new("::numeric / ")] + wrap(rr, MUL + 1) + [Piece::Text.new(")::bigint")], ATOM), [l, rr])
      end
      if name == "%"
        untranslatable(label, line) unless m == INT_MOD
        # Quarz's `Int#%` takes the divisor's sign; PostgreSQL's the
        # dividend's.
        inner = binary(binary(l, "%", rr, MUL, true), "+", rr, ADD, true)
        return with_nulls(binary(inner, "%", rr, MUL, true), [l, rr])
      end
      prec = name == "+" || name == "-" ? ADD : MUL
      return with_nulls(binary(l, op, rr, prec, true), [l, rr])
    end
    untranslatable(label, line)
  end

  # A column's getter called on a model the block captured
  # (`where { user_id == u.id }`): the column's value, read when the query
  # is built (`Rotor::NotLoadedError` when the model was loaded without
  # it). Nil for any other call.
  private def captured(recv: Meta::Expr, m: Meta::MethodRef, args: Array[Meta::Expr], block: Meta::Expr?, line: Int) -> Sql?
    return nil unless args.empty? && block.nil? && !m.singleton && m.extension.nil?
    case recv
    in Meta::Expr::Capture(index, _, _)
      case v = look(Bind::Capture.new(index))
      in Model => model
        return nil unless model.class <= m.owner
        return nil unless model.table_info.columns.any? { |c| c.name == m.name }
        b = bound(Bind::Read.new(index, m.name), line)
        b.value.nil? ? Sql.new(b.pieces, b.prec, nil, nil, true, b.bind, Translator.show(Meta::Expr::Call.new(recv, m, [m], args, block, line))) : b
      else
        nil
      end
    else
      nil
    end
  end

  # `a == b` and the others. Against a value, equality is decided by it:
  # `IS NULL` for nil, `=` otherwise (which an index serves); between
  # columns or expressions, one of which admits NULL, `IS NOT DISTINCT
  # FROM`, as Quarz's `==` takes nil for equal to nil.
  private def compare(le: Meta::Expr, op: String, re: Meta::Expr) -> Sql
    l = operand(le)
    r = operand(re)
    l = coerce(l, r.column)
    r = coerce(r, l.column)
    l, r = typed(l, r), typed(r, l)
    if op == "=" || op == "<>"
      eq = op == "="
      if l.known && l.value.nil?
        return is_null(r, eq ? "IS NULL" : "IS NOT NULL")
      end
      if r.known && r.value.nil?
        return is_null(l, eq ? "IS NULL" : "IS NOT NULL")
      end
      # (`<>` uses no index either: Quarz's meaning, nil differing from
      # a value.)
      # (Not only a column: an `if` can be NULL as well.)
      if !eq && (l.nulls || r.nulls)
        return binary(l, "IS DISTINCT FROM", r, IS, false)
      end
      if !l.known && !r.known && (nullable?(l) || nullable?(r))
        return binary(l, eq ? "IS NOT DISTINCT FROM" : "IS DISTINCT FROM", r, IS, false)
      end
    end
    three(binary(l, op, r, CMP, false), l.nulls || r.nulls)
  end

  # Whether `s` is nil: a known nil, or an `if` nil either way.
  def self.null?(s: Sql) -> Bool = (s.known && s.value.nil?) || s.pieces == [Piece::Text.new("NULL")]

  # `s` as an order key: an `if` nil either way (NULL, a constant
  # PostgreSQL refuses there) typed.
  def self.order_key(s: Sql) -> Sql
    return s unless s.pieces == [Piece::Text.new("NULL")]
    Sql.new([Piece::Text.new("NULL::text")], s.prec, s.column, s.value, s.known, s.bind, s.nulls, s.tri, s.narrow, s.test)
  end

  # The classes `e` may have in Quarz, as translated: a column's class,
  # a known value's (`Nil` for nil: a literal, a capture, a captured
  # model's column, an `if` without `else`), a comparison's `Bool`,
  # arithmetic's by its operands' (`Int` only from two `Int`s). An `if`
  # gives its branches' (only the one a known condition takes, as `sql`
  # does). A nullable column gives its class alone: a NULL there is
  # PostgreSQL's to refuse where the column admits none. For an `update`
  # to check its value against the column, and a condition to be tested
  # for its truthiness: PostgreSQL would convert another class on
  # assignment (round a double precision into a bigint, write a number
  # as text) and refuses one as a condition. (Read as a translation
  # does, guarded.)
  #
  # `l && r` and `l || r` are a `Bool` in SQL (as a value, one of other
  # operands is refused: `Sql#test`).
  def classes(e: Meta::Expr) -> Array[Type[Object]]
    out: Array[Type[Object]] = []
    case e
    in Meta::Expr::If(c, t, f, _)
      cond = sql(c)
      folded = cond.known && !cond.value.is_a?(Bool)
      if !folded || !cond.value.nil?
        out = Translator.union(out, assuming(facts(c, true)) { classes(t) })
      end
      if !folded || cond.value.nil?
        if x = f
          out = Translator.union(out, assuming(facts(c, false)) { classes(x) })
        else
          out = Translator.union(out, [Nil])
        end
      end
      out
    in Meta::Expr::And(l, r, _) then logical_classes(l, r, facts(l, true))
    in Meta::Expr::Or(l, r, _) then logical_classes(l, r, facts(l, false))
    in Meta::Expr::Not(_, _, _) then [Bool]
    in Meta::Expr::Call(_, m, _, [a], nil, _) if m.singleton && m.owner == SQL && m.name == :not_nil
      classes(a).reject { |k| k == Nil }
    in Meta::Expr::Call(_, m, _, _, nil, _) if m.singleton && m.owner == SQL && (m.name == :lower || m.name == :upper)
      [String]
    in Meta::Expr::Call(_, m, _, _, nil, _) if m.singleton && m.owner == SQL
      [Bool]
    in Meta::Expr::Call(Meta::Expr => recv, m, _, [a], nil, _) if !m.singleton && ARITHMETIC.has_key?(m.name) && column_of(e).nil?
      return [String] if m.name == :+ && m.owner == String
      ls = classes(recv)
      rs = classes(a)
      ls.each do |l|
        rs.each do |r|
          k: Type[Object] = l == Nil || r == Nil ? Nil : (l == Int && r == Int ? Int : Float)
          out = Translator.union(out, [k])
        end
      end
      out
    in Meta::Expr::Call(Meta::Expr => recv, m, _, [], nil, _) if !m.singleton && m.name == :"-@" && column_of(e).nil?
      classes(recv)
    in Meta::Expr::Call(Meta::Expr, m, _, _, nil, _) if !m.singleton && (COMPARISONS.has_key?(m.name) || [:nil?, :include?, :start_with?, :end_with?].include?(m.name)) && column_of(e).nil?
      [Bool]
    else
      s = sql(e)
      if s.known
        v = s.value
        [v.nil? ? Nil : v.class]
      elsif c = s.column
        [c.type]
      else
        [Object]
      end
    end
  end

  # `xs` and the classes of `ys` not in it.
  def self.union(xs: Array[Type[Object]], ys: Array[Type[Object]]) -> Array[Type[Object]]
    out = xs
    ys.each { |y| out = out + [y] unless out.include?(y) }
    out
  end

  # The classes of `l && r` (`l || r`) in SQL: a `Bool`, and nil where
  # an operand may be.
  private def logical_classes(l: Meta::Expr, r: Meta::Expr, known: Array[[Int, Symbol]]) -> Array[Type[Object]]
    ks = Translator.union(classes(l), assuming(known) { classes(r) })
    ks.include?(Nil) ? [Bool, Nil] : [Bool]
  end

  # The condition `s`, translated from `e`, tested for its truthiness
  # in Quarz: a value other than a `Bool` is true unless nil (`IS NOT
  # NULL`), which a `Bool`'s test in SQL is not. `&&`, `||` and `!`
  # test their operands so already. A value that may be a `Bool` or
  # another class is refused: the test would depend on the row.
  private def truth(e: Meta::Expr, s: Sql) -> Sql
    case e
    in Meta::Expr::And(_, _, _) | Meta::Expr::Or(_, _, _) | Meta::Expr::Not(_, _, _) then return s
    else nil
    end
    ks = classes(e)
    return s unless ks.any? { |k| k != Bool && k != Nil }
    if ks.include?(Bool)
      untranslatable("`#{Translator.show(e)}`, a `Bool` or another value, as a condition", Translator.line_of(e))
    end
    is_null(s, "IS NOT NULL")
  end

  # A parameter, cast (`cast`) where PostgreSQL, which types an untyped
  # one by what it meets, would take another type: a `Float` where it
  # meets what is not a `Float` column itself (`"age" > $1` would read
  # 25.5 as a bigint), an `Int` where it meets what is not a column (an
  # `Int` literal is an `integer`: `$1 + 1` would not hold 3000000000),
  # any where it meets another parameter (`$1 < $2` compares as text: 10
  # before 9). Against a `Float` column it takes
  # the column's type, which may be `real` or `numeric` (`r == 0.1`
  # finds the `real` 0.1); against an expression, such as one over a
  # `real` column, a `Float` is double precision, where PostgreSQL
  # computes it as Quarz does on the values read (`r + 0.0 == 0.1` finds
  # none, as in Quarz). Beside an `integer` column of a table rotor did
  # not create, an untyped `Int` is an `integer` and one cast compares
  # through the cross-type operators, an index still serving it
  # (README, "Parameter types").
  private def typed(s: Sql, other: Sql?, arithmetic: Bool = false) -> Sql
    o = other || return s
    return cast(s) if param?(o)
    if s.value.is_a?(Int)
      # (In arithmetic, against a `real` column too: `r + $1` would be
      # computed in `real`.)
      c = o.column
      return c && (!arithmetic || c.type == Int) ? s : cast(s)
    end
    return s unless s.value.is_a?(Float)
    if c = o.column
      return s if c.type == Float && !arithmetic
    end
    cast(s)
  end

  # Whether `s` is a parameter by itself.
  private def param?(s: Sql) -> Bool
    return false unless s.known && s.pieces.size == 1
    case s.pieces[0]
    in Piece::Param(_) | Piece::Bound(_) then true
    else false
    end
  end

  # `s` as a bigint when it is an `integer` (`Sql#narrow`).
  private def bigint(s: Sql) -> Sql
    return s unless s.narrow
    pieces = s.prec == ATOM ? s.pieces : [Piece::Text.new("(")] + s.pieces + [Piece::Text.new(")")]
    Sql.new(pieces + [Piece::Text.new("::bigint")], ATOM, s.column, s.value, s.known, s.bind, s.nulls, s.tri)
  end

  # `s IS NULL` (`op`), a parameter cast: PostgreSQL cannot type one
  # there.
  private def is_null(s: Sql, op: String) -> Sql = postfix(cast(s, "text"), op, IS)

  # `s`, when it is a parameter, cast to its value's class's type:
  # `$1::bigint`. A nil is cast to `nil_type` if given, else left to take
  # the type of what it meets. (A `Time` is a `timestamptz`: against a
  # `timestamp` column PostgreSQL reads the column's values in the
  # session's time zone; README, "Parameter types".)
  private def cast(s: Sql, nil_type: String? = nil) -> Sql
    return s unless param?(s)
    type = case s.value
           in nil then nil_type || return s
           in Int then "bigint"
           in Float then "double precision"
           in String | Symbol then "text"
           in Bool then "boolean"
           in Time then "timestamptz"
           in Bytes then "bytea"
           else return s
           end
    Sql.new(s.pieces + [Piece::Text.new("::#{type}")], ATOM, s.column, s.value, s.known, s.bind, s.nulls, s.tri)
  end

  # A value compared with a `Float` column, as a `Float`.
  private def coerce(s: Sql, other: Column?) -> Sql
    case [s.value, other]
    in [Int => i, Column => c] if s.known && c.type == Float
      Binds.to_float(s, i)
    else
      s
    end
  end

  private def nullable?(s: Sql) -> Bool
    c = s.column
    c.nil? || c.null
  end

  # `xs.include?(x)`: `x = ANY($n)`, the array one parameter (a literal
  # of literals or a captured array).
  private def in_list(arr: Meta::Expr, x: Meta::Expr, line: Int) -> Sql
    # (A captured array, or a literal one of literals: one parameter.)
    case arr
    in Meta::Expr::Capture(index, _, l)
      case v = look(Bind::Capture.new(index))
      in Array => xs
        k = Binds.kind(xs)
        b = Bind::Items.new(index, k.item == Float)
        return any(x, Piece::Bound.new(b), k.item, k.nils, l)
      else untranslatable("`include?` on a #{v.class.name}", l)
      end
    in Meta::Expr::ArrayLit(es, l) if es.all? { |e| e.is_a?(Meta::Expr::Lit) }
      vs: Array[Object?] = []
      es.each do |e|
        case e
        in Meta::Expr::Lit(v, _) then vs = vs.push(v)
        else nil
        end
      end
      item = Binds.item_class(vs)
      vs = Binds.value(Bind::Items.new(0, item == Float), [vs.as(Object)]).as(Array[Object?])
      return any(x, Piece::Param.new(Binds.items(vs)), item, vs.size < es.size, l) unless item == Object
    else nil
    end
    in_items(arr, x, line)
  end

  # `x = ANY(array)`, `array` the parameter of an array of `item`s (nil:
  # none, or nils only), its nils removed (`nils`: there were some, so
  # `OR x IS NULL`; `= ANY` never finds a NULL); the empty array is
  # `{}`, false for every row.
  private def any(x: Meta::Expr, array: Piece, item: Type[Object]?, nils: Bool, line: Int) -> Sql
    untranslatable("`include?` on an array of mixed classes", line) if item == Object
    if k = item
      unless k == Int || k == Float || k == String || k == Bool || k == Time || k == Bytes || k == Symbol
        untranslatable("`include?` on an array of #{k.name}", line)
      end
    end
    target = operand(x)
    # (A nil target: found where an item is nil.)
    if target.known && target.value.nil?
      return text(nils ? "TRUE" : "FALSE", ATOM)
    end
    # (Nils only: `IS NULL`.)
    return is_null(target, "IS NULL") if item.nil? && nils
    target = cast(target)
    # (Typed by pg: `Int`s, `Bool`s, `Bytes`. Cast: `Float`s beside what
    # is not a `Float` column. Else what the array meets decides, a
    # parameter cast by its class included.)
    type = if item.nil? then nil
           elsif item == Int then "bigint"
           elsif item == Float then "double precision"
           elsif item == String || item == Symbol then "text"
           elsif item == Bool then "boolean"
           elsif item == Time then "timestamptz"
           else "bytea"
           end
    c = target.column
    cast_it = type && item == Float && !(c && c.type == Float)
    pieces = wrap(target, CMP + 1) + [Piece::Text.new(" = ANY("), array, Piece::Text.new(cast_it ? "::#{type}[])" : ")")]
    # (NULL for a NULL target, but in an empty array: not found.)
    maybe = nils || item.nil? ? nil : target.nulls
    found = three(node(pieces, CMP), maybe)
    return found unless nils
    three(binary(found, "OR", is_null(target, "IS NULL"), OR, true), maybe)
  end

  # `xs.include?(x)` for an array literal with other than literals:
  # `x IN (...)`.
  private def in_items(arr: Meta::Expr, x: Meta::Expr, line: Int) -> Sql
    items = case arr
            in Meta::Expr::ArrayLit(es, _) then es.map { |e| operand(e) }
            else untranslatable("`Array#include?` on an array SQL does not have", line)
            end
    # (A nil among them is `IS NULL`: `IN` never finds a NULL.)
    has_nil = items.any? { |s| s.known && s.value.nil? }
    items = items.reject { |s| s.known && s.value.nil? }
    target = operand(x)
    unless items.empty?
      t = target
      target = typed(target, items[0])
      items = items.map { |s| typed(s, t) }
    end
    # (A nil target: found where an item is nil.)
    if target.known && target.value.nil?
      return text("TRUE", ATOM) if has_nil
      nils = items.select { |s| !s.known && s.nulls }
      return text("FALSE", ATOM) if nils.empty?
      out = is_null(nils[0], "IS NULL")
      nils.drop(1).each { |s| out = binary(out, "OR", is_null(s, "IS NULL"), OR, true) }
      return out
    end
    # (A target and an item that can both be NULL: equal when both are,
    # which `IN` does not find.)
    if target.nulls && items.any? { |s| !s.known && s.nulls }
      out = binary(target, "IS NOT DISTINCT FROM", items[0], IS, false)
      items.drop(1).each { |s| out = binary(out, "OR", binary(target, "IS NOT DISTINCT FROM", s, IS, false), OR, true) }
      return has_nil ? binary(out, "OR", is_null(target, "IS NULL"), OR, true) : out
    end
    # (NULL where neither is nil: a NULL target, or a NULL item the
    # target is not found among.)
    maybe = items.find { |s| s.nulls }&.nulls
    maybe = target.nulls || maybe unless has_nil
    return has_nil ? is_null(target, "IS NULL") : text("FALSE", ATOM) if items.empty?
    pieces = wrap(target, LIKE + 1) + [Piece::Text.new(" IN (")]
    items.each_with_index do |s, i|
      pieces = pieces + [Piece::Text.new(", ")] if i > 0
      pieces = pieces + s.pieces
    end
    found = three(node(pieces + [Piece::Text.new(")")], LIKE), maybe)
    return found unless has_nil
    three(binary(found, "OR", is_null(target, "IS NULL"), OR, true), maybe)
  end

  # `s.include?(v)`, `start_with?`, `end_with?`: `LIKE` with `v` escaped.
  private def like(s: Sql, arg: Meta::Expr, name: String, label: String, line: Int) -> Sql
    a = sql(arg)
    v = a.value
    unless a.known && v.is_a?(String)
      untranslatable("#{label} of something other than a string value", line)
    end
    pattern = Binds.pattern(v.as(String), name)
    piece = if b = a.bind
              Piece::Bound.new(Bind::Like.new(b, name))
            else
              Piece::Param.new(pattern)
            end
    three(binary(s, "LIKE", Sql.new([piece], ATOM, nil, pattern, true), LIKE, false), s.nulls)
  end

  # `Rotor::SQL.like(s, pattern)` and the others.
  private def function(name: String, args: Array[Meta::Expr], label: String, line: Int) -> Sql
    case [name, args.size]
    in ["like", 2] | ["ilike", 2]
      a = operand(args[0])
      b = operand(args[1])
      three(binary(a, name.upcase, b, LIKE, false), a.nulls || b.nulls)
    in ["not_nil", 1]
      a = operand(args[0])
      if a.known && a.value.nil?
        raise ArgumentError.new("Rotor::SQL.not_nil of nil (#{@file}:#{line})")
      end
      if what = a.nulls
        raise UntranslatableError.new("`Rotor::SQL.not_nil(#{Translator.show(args[0])})` where `#{what}` can be NULL (#{@file}:#{line}): write `!#{what}.nil? &&` before it")
      end
      a
    in ["lower", 1] | ["upper", 1]
      a = operand(args[0])
      with_nulls(node([Piece::Text.new("#{name}(")] + a.pieces + [Piece::Text.new(")")], ATOM), [a])
    else untranslatable(label, line)
    end
  end
end
