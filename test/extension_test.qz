require "test"

# A user's extension: a method of it in a query block is not the
# translator's to know, even named as an operator it translates.
module Loose
  extension Int
    def >(other: String) -> Bool = to_s > other
  end
  # nil's, for a nullable receiver: in a query block, where
  # `Rotor::Compare`'s is in scope too, this one is taken for an `Int`.
  extension Nil
    def >(other: Int) -> Bool = true
    def ==(other: Int) -> Bool = true
    def ! -> Bool = false
  end
end

# A getter of its own, named as a column.
module Shadow
  extension Tally
    def n -> Int = 100
  end
end

using Loose
using Shadow

class Tally < Rotor::Model
  table "tallies" do
    column :id, Int, primary: true
    column :n, Int
    column :m, Int
    column :k, Int, null: true
  end
end

# A class of its own `!`.
class Flag
  include Shareable
  @on: Bool

  def initialize(@on: Bool)
  end

  def ! -> Bool = @on
end

class ExtensionTest < Test::Case
  def test_a_negation_of_its_own_is_refused
    f = Flag.new(true)
    e = assert_raise(Rotor::UntranslatableError) { Tally.where { |_t| !f } }
    assert_match(/\A`Flag#!` cannot be translated to SQL/, e.message)
    # A union with such a member: not SQL's NOT either.
    fs: Array[Bool | Flag] = [true, f]
    b = fs[0]
    e = assert_raise(Rotor::UntranslatableError) { Tally.where { |_t| !b } }
    assert_match(/\A`Flag#!` cannot be translated to SQL/, e.message)
    # Under `&&` too, and an extension's `!` on a nullable member.
    e = assert_raise(Rotor::UntranslatableError) { Tally.where { m > 3 && !b } }
    assert_match(/\A`Flag#!` cannot be translated to SQL/, e.message)
    xs: Array[Bool?] = [true]
    x = xs[0]
    e = assert_raise(Rotor::UntranslatableError) { Tally.where { |_t| !x } }
    assert_match(/\A`Nil#!` of Loose cannot be translated to SQL/, e.message)
    # Bool's own is NOT.
    assert_equal(["SELECT \"id\", \"n\", \"m\", \"k\" FROM \"tallies\" WHERE NOT \"m\" > 3", Array[Object?].new], Tally.where { !(m > 3) }.to_sql)
  end

  def test_another_extension_is_refused
    e = assert_raise(Rotor::UntranslatableError) { Tally.where { n > "3" } }
    assert_match(/\A`Int#>` of Loose cannot be translated to SQL/, e.message)
    # (The class's own still is.)
    assert_equal(["SELECT \"id\", \"n\", \"m\", \"k\" FROM \"tallies\" WHERE \"m\" > 3", Array[Object?].new], Tally.where { m > 3 }.to_sql)
  end

  def test_another_extension_on_a_nullable_receiver_is_refused
    # Each member's method counts: `Int#>` is the class's own, `Nil#>`
    # Loose's.
    e = assert_raise(Rotor::UntranslatableError) { Tally.where { k > 3 } }
    assert_match(/\A`Nil#>` of Loose cannot be translated to SQL/, e.message)
    # Loose's `Int#>` on the `Int` member.
    e = assert_raise(Rotor::UntranslatableError) { Tally.where { k > "3" } }
    assert_match(/\A`Int#>` of Loose cannot be translated to SQL/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Tally.where { k == 3 } }
    assert_match(/\A`Nil#==` of Loose cannot be translated to SQL/, e.message)
    # Compare's are still taken where Loose has none.
    assert_equal(["SELECT \"id\", \"n\", \"m\", \"k\" FROM \"tallies\" WHERE \"k\" < 3", Array[Object?].new], Tally.where { k < 3 }.to_sql)
    assert_equal(["SELECT \"id\", \"n\", \"m\", \"k\" FROM \"tallies\" WHERE \"k\" IS NULL", Array[Object?].new], Tally.where { k == nil }.to_sql)
  end

  def test_an_extension_getter_is_not_the_column
    e = assert_raise(Rotor::UntranslatableError) { Tally.where { n == 3 } }
    assert_match(/\A`Tally#n` cannot be translated to SQL/, e.message)
    t = Tally.load({id: 1, n: 5})
    e = assert_raise(Rotor::UntranslatableError) { Tally.where { id == t.n } }
    assert_match(/\A`Tally#n` cannot be translated to SQL/, e.message)
  end
end
