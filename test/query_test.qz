require "test"

data Summary = (id: Int, name: String)

class Person < Rotor::Model
  table "people" do
    column :id, Int, primary: true
    column :name, String
    column :email, String, null: true
    column :age, Int
    column :score, Float
    column :admin, Bool
    column :born, Time, null: true
    column :joined, Time
  end
end

class Flagged < Rotor::Model
  table "flagged" do
    column :id, Int, primary: true
    column :vip, Bool, null: true
  end
end

# Nullable columns of each comparable class (`Rotor::Compare`).
class Gauge < Rotor::Model
  table "gauges" do
    column :id, Int, primary: true
    column :level, Int, null: true
    column :cap, Int, null: true
    column :ratio, Float, null: true
    column :label, String, null: true
    column :at, Time, null: true
    column :on, Bool
  end
end

class QueryTest < Test::Case
  GS = "SELECT \"id\", \"level\", \"cap\", \"ratio\", \"label\", \"at\", \"on\" FROM \"gauges\""

  COLS = "SELECT \"id\", \"name\", \"email\", \"age\", \"score\", \"admin\", \"born\", \"joined\" FROM \"people\""

  def check[T](q: Rotor::Query[T], text: String, params: Array[Object?]) -> Void
    assert_equal([text, params], q.to_sql)
  end

  def test_all
    check(Person.query, COLS, [])
  end

  def test_comparisons
    min = 18
    check(Person.where { age > 18 }, "#{COLS} WHERE \"age\" > 18", [])
    check(Person.where { age >= min }, "#{COLS} WHERE \"age\" >= $1", [18])
    check(Person.where { |p| p.age < min && p.name == "Ann" }, "#{COLS} WHERE \"age\" < $1 AND \"name\" = $2", [18, "Ann"])
    check(Person.where { name != "x" || admin }, "#{COLS} WHERE \"name\" <> $1 OR \"admin\"", ["x"])
    check(Person.where { !admin }, "#{COLS} WHERE NOT \"admin\"", [])
    check(Person.where { score <= 1.5 }, "#{COLS} WHERE \"score\" <= $1", [1.5])
    check(Person.where { score > min }, "#{COLS} WHERE \"score\" > $1", [18.0])
    check(Person.where { admin == true }, "#{COLS} WHERE \"admin\" = TRUE", [])
  end

  def test_precedence
    check(
      Person.where { (age > 1 || age < 0) && admin },
      "#{COLS} WHERE (\"age\" > 1 OR \"age\" < 0) AND \"admin\"", []
    )
    check(Person.where { !(admin && age > 1) }, "#{COLS} WHERE NOT (\"admin\" AND \"age\" > 1)", [])
    check(Person.where { age + 1 > age * 2 - 3 }, "#{COLS} WHERE \"age\" + 1 > \"age\" * 2 - 3", [])
    check(Person.where { (age + 1) * 2 == 4 }, "#{COLS} WHERE (\"age\" + 1) * 2 = 4", [])
    # Quarz's `Int#/` floors and its `%` takes the divisor's sign.
    check(Person.where { age / 2 == 1 }, "#{COLS} WHERE floor(\"age\"::numeric / 2)::bigint = 1", [])
    check(Person.where { age % 3 == 1 }, "#{COLS} WHERE (\"age\" % 3 + 3) % 3 = 1", [])
    check(Person.where { score / 2.0 > 1.0 }, "#{COLS} WHERE \"score\" / $1::double precision > $2::double precision", [2.0, 1.0])
    # `Int#/(Float)` is a Float's division, not floored.
    check(Person.where { age / 2.0 > 1.0 }, "#{COLS} WHERE \"age\" / $1::double precision > $2::double precision", [2.0, 1.0])
    check(Person.where { name + "!" == "a!" }, "#{COLS} WHERE \"name\" || $1 = $2", ["!", "a!"])
    # Two `where`s are joined with AND; an OR is parenthesized there.
    check(
      Person.where { admin || age > 1 }.where { name == "x" },
      "#{COLS} WHERE (\"admin\" OR \"age\" > 1) AND \"name\" = $1", ["x"]
    )
  end

  def test_nil
    e: String? = nil
    f: String? = "a@b"
    check(Person.where { email.nil? }, "#{COLS} WHERE \"email\" IS NULL", [])
    check(Person.where { email == nil }, "#{COLS} WHERE \"email\" IS NULL", [])
    check(Person.where { email != nil }, "#{COLS} WHERE \"email\" IS NOT NULL", [])
    # By the value captured: the text differs.
    check(Person.where { email == e }, "#{COLS} WHERE \"email\" IS NULL", [])
    check(Person.where { email == f }, "#{COLS} WHERE \"email\" = $1", ["a@b"])
    check(Person.where { email != e }, "#{COLS} WHERE \"email\" IS NOT NULL", [])
    # `!=` of a nullable column and a value: nil differs from it.
    check(Person.where { email != f }, "#{COLS} WHERE \"email\" IS DISTINCT FROM $1", ["a@b"])
    check(Person.where { name != "x" }, "#{COLS} WHERE \"name\" <> $1", ["x"])
    some = [nil, "a"]
    check(Person.where { some.include?(email) }, "#{COLS} WHERE \"email\" = ANY($1) OR \"email\" IS NULL", [["a"]])
    only_nil: Array[String?] = [nil]
    check(Person.where { only_nil.include?(email) }, "#{COLS} WHERE \"email\" IS NULL", [])
    # Two columns, one nullable: Quarz's `==` takes nil for equal to nil.
    check(Person.where { email == name }, "#{COLS} WHERE \"email\" IS NOT DISTINCT FROM \"name\"", [])
    check(Person.where { email != name }, "#{COLS} WHERE \"email\" IS DISTINCT FROM \"name\"", [])
    check(Person.where { name == name }, "#{COLS} WHERE \"name\" = \"name\"", [])
  end

  # Every form translated keeps Quarz's meaning: a comparison that can be
  # NULL (where Quarz has false) is kept where NULL acts as false, and
  # refused elsewhere.
  def test_three_valued_shapes_are_refused
    f: String? = "a@b"
    some = ["a", "b"]
    x = assert_raise(Rotor::UntranslatableError) { Person.where { !(email == f) } }
    assert_match(/\A`!\(email == f\)` is three-valued in SQL when `email` can be NULL \(.*query_test\.qz:\d+\): write `email != f` \(Quarz's meaning, `IS DISTINCT FROM`\), or test `email.nil\?` explicitly\z/, x.message)
    x = assert_raise(Rotor::UntranslatableError) { Person.where { |p| !(p.email == f) || p.admin } }
    assert_match(/\A`!\(p.email == f\)` is three-valued in SQL when `p.email` can be NULL/, x.message)
    x = assert_raise(Rotor::UntranslatableError) { Person.where { !some.include?(email) } }
    assert_match(/\A`!some.include\?\(email\)` is three-valued in SQL when `email` can be NULL \(.*\): test `email.nil\?` explicitly \(`email.nil\? \|\| !some.include\?\(email\)`\)\z/, x.message)
    x = assert_raise(Rotor::UntranslatableError) { Person.where { admin && !(age > 1 && email == f) } }
    assert_match(/\A`!\(\(age > 1\) && \(email == f\)\)` is three-valued/, x.message)
    # As a value: an order's key, an `update`'s value, an operand.
    x = assert_raise(Rotor::UntranslatableError) { Person.order { email == f } }
    assert_match(/\A`email == f` as a value is NULL, not false, in SQL when `email` is NULL \(.*query_test\.qz:\d+\): compare in Quarz \(select the column\), or test `email.nil\?` explicitly\z/, x.message)
    x = assert_raise(Rotor::UntranslatableError) { Person.query.update { {admin: email == f} } }
    assert_match(/\A`email == f` as a value is NULL/, x.message)
    x = assert_raise(Rotor::UntranslatableError) { Person.where { (email == f) == false } }
    assert_match(/\A`email == f` as a value is NULL/, x.message)
    x = assert_raise(Rotor::UntranslatableError) { Person.where { (email == f).nil? } }
    assert_match(/\A`email == f` as a value/, x.message)
    # An `if` whose branch can be NULL where Quarz has false: as a value.
    x = assert_raise(Rotor::UntranslatableError) { Person.where { !(admin ? some.include?(email) : true) } }
    assert_match(/\A`!\(admin \? some.include\?\(email\) : true\)` is three-valued in SQL when `email` can be NULL/, x.message)
    x = assert_raise(Rotor::UntranslatableError) { Person.order { admin ? email == f : false } }
    assert_match(/\A`admin \? \(email == f\) : false` as a value is NULL/, x.message)
  end

  def test_two_valued_shapes_are_kept
    e: String? = nil
    f: String? = "a@b"
    # Nothing NULL under the `!`.
    check(Person.where { !(name == "x") }, "#{COLS} WHERE NOT \"name\" = $1", ["x"])
    check(Person.where { !(email == e) }, "#{COLS} WHERE NOT \"email\" IS NULL", [])
    # (`!=` of a nullable column is `IS DISTINCT FROM`, never NULL.)
    check(Person.where { !(email != f) }, "#{COLS} WHERE NOT \"email\" IS DISTINCT FROM $1", ["a@b"])
    check(Person.where { !(email == name) }, "#{COLS} WHERE NOT \"email\" IS NOT DISTINCT FROM \"name\"", [])
    # As a condition, NULL is false: kept.
    check(Person.where { admin || email == f }, "#{COLS} WHERE \"admin\" OR \"email\" = $1", ["a@b"])
    check(Person.where { email == f ? admin : age > 1 }, "#{COLS} WHERE CASE WHEN \"email\" = $1 THEN \"admin\" ELSE \"age\" > 1 END", ["a@b"])
    check(Person.where { admin ? email == f : false }, "#{COLS} WHERE CASE WHEN \"admin\" THEN \"email\" = $1 ELSE FALSE END", ["a@b"])
    check(Person.order { name == "x" }, "#{COLS} ORDER BY \"name\" = $1", ["x"])
    assert_equal(["UPDATE \"people\" SET \"admin\" = \"email\" IS NULL", Array[Object?].new], Person.query.update { {admin: email == e} }.to_sql)
    # What the left side of `&&`/`||` says: `email` is not NULL after it.
    check(Person.where { !email.nil? && email != f }, "#{COLS} WHERE NOT \"email\" IS NULL AND \"email\" <> $1", ["a@b"])
    check(Person.where { email != nil && !(email == f) }, "#{COLS} WHERE \"email\" IS NOT NULL AND NOT \"email\" = $1", ["a@b"])
    check(Person.where { email.nil? || !(email == f) }, "#{COLS} WHERE \"email\" IS NULL OR NOT \"email\" = $1", ["a@b"])
    check(Person.where { |p| p.email.nil? ? true : !(p.email == f) }, "#{COLS} WHERE CASE WHEN \"email\" IS NULL THEN TRUE ELSE NOT \"email\" = $1 END", ["a@b"])
    # An `if` that can be NULL, compared: as a column is.
    check(Person.where { (admin ? name : email) != "a" }, "#{COLS} WHERE CASE WHEN \"admin\" THEN \"name\" ELSE \"email\" END IS DISTINCT FROM $1", ["a"])
    x = assert_raise(Rotor::UntranslatableError) { Person.where { !((admin ? nil : 1) == 1) } }
    assert_match(/three-valued in SQL when `nil` can be NULL \(.*\): write `\(admin \? nil : 1\) != 1` \(.*\), or write the case of nil out instead of `nil`\z/, x.message)
    x = assert_raise(Rotor::UntranslatableError) { Person.where { !((admin ? e : name) == "a") } }
    assert_match(/three-valued in SQL when `e` can be NULL \(.*\): write `\(admin \? e : name\) != "a"` \(Quarz's meaning, `IS DISTINCT FROM`\), or decide what a nil `e` means in Quarz, before the query is built\z/, x.message)
    b: Bool? = nil
    x = assert_raise(Rotor::UntranslatableError) { Person.where { !(admin && b) } }
    assert_match(/when `b` can be NULL \(.*\): decide what a nil `b` means in Quarz, before the query is built\z/, x.message)
    # `include?` of what can be NULL among what can be NULL: nil is nil.
    check(Person.where { [email, name].include?(email) }, "#{COLS} WHERE \"email\" IS NOT DISTINCT FROM \"email\" OR \"email\" IS NOT DISTINCT FROM \"name\"", [])
    check(Person.where { !([email].include?(email)) }, "#{COLS} WHERE NOT \"email\" IS NOT DISTINCT FROM \"email\"", [])
    # A nil `include?`d: found where an item is nil.
    check(Person.where { !([name].include?(e)) }, "#{COLS} WHERE NOT FALSE", [])
    check(Person.where { [name, email].include?(nil) }, "#{COLS} WHERE \"email\" IS NULL", [])
    check(Person.where { [nil, name].include?(e) }, "#{COLS} WHERE TRUE", [])
    # Not past the `&&`.
    x = assert_raise(Rotor::UntranslatableError) { Person.where { (!email.nil? && admin) || !(email == f) } }
    assert_match(/\A`!\(email == f\)` is three-valued/, x.message)
  end

  def test_not_nil
    t = Time.at(0)
    check(Person.where { !born.nil? && Rotor::SQL.not_nil(born) > t }, "#{COLS} WHERE NOT \"born\" IS NULL AND \"born\" > $1", [t])
    check(Person.where { born.nil? || Rotor::SQL.not_nil(born) < t }, "#{COLS} WHERE \"born\" IS NULL OR \"born\" < $1", [t])
    check(Person.where { |p| p.born.nil? ? false : Rotor::SQL.not_nil(p.born) > t }, "#{COLS} WHERE CASE WHEN \"born\" IS NULL THEN FALSE ELSE \"born\" > $1 END", [t])
    x = assert_raise(Rotor::UntranslatableError) { Person.where { Rotor::SQL.not_nil(born) > t } }
    assert_match(/\A`Rotor::SQL.not_nil\(born\)` where `born` can be NULL \(.*query_test\.qz:\d+\): write `!born.nil\? &&` before it\z/, x.message)
    x = assert_raise(Rotor::UntranslatableError) { Person.where { born.nil? && Rotor::SQL.not_nil(born) > t } }
    assert_match(/where `born` can be NULL/, x.message)
    three: Int? = 3
    assert_equal(3, Rotor::SQL.not_nil(three))
    n: Time? = nil
    x = assert_raise(ArgumentError) { Person.where { Rotor::SQL.not_nil(n) == born } }
    assert_match(/\ARotor::SQL.not_nil of nil \(.*query_test\.qz:\d+\)\z/, x.message)
    born: Time? = nil
    x = assert_raise(ArgumentError) { Rotor::SQL.not_nil(born) }
    assert_equal("Rotor::SQL.not_nil of nil", x.message)
  end

  # `Rotor::Compare`: a nullable column compared with `<` and the others,
  # three-valued, so kept as a condition and refused where NULL and
  # false differ.
  def test_comparing_a_nullable_column
    n: Int? = 5
    t = Time.at(0)
    check(Gauge.where { level > 18 }, "#{GS} WHERE \"level\" > 18", [])
    check(Gauge.where { level >= n }, "#{GS} WHERE \"level\" >= $1", [5])
    check(Gauge.where { level < cap }, "#{GS} WHERE \"level\" < \"cap\"", [])
    check(Gauge.where { 3 <= level }, "#{GS} WHERE 3 <= \"level\"", [])
    check(Gauge.where { |g| g.ratio > 1.5 && g.label < "m" || g.at >= t }, "#{GS} WHERE \"ratio\" > $1 AND \"label\" < $2 OR \"at\" >= $3", [1.5, "m", t])
    check(Gauge.where { ratio > 1 }, "#{GS} WHERE \"ratio\" > $1", [1.0])
    # A nil declared `Int?` (an unset filter): one method takes it.
    none: Int? = nil
    check(Gauge.where { level > none }, "#{GS} WHERE \"level\" > $1", [nil])
    check(Gauge.where { |g| g.ratio <= none }, "#{GS} WHERE \"ratio\" <= $1", [nil])
    # Int and Float mixed, either way.
    f = 1.5
    check(Gauge.where { 1.5 < level }, "#{GS} WHERE $1::double precision < \"level\"", [1.5])
    check(Gauge.where { f <= level && ratio > level }, "#{GS} WHERE $1::double precision <= \"level\" AND \"ratio\" > \"level\"", [1.5])
    check(Gauge.where { level >= ratio }, "#{GS} WHERE \"level\" >= \"ratio\"", [])
    check(Gauge.where { on ? level > 1 : false }, "#{GS} WHERE CASE WHEN \"on\" THEN \"level\" > 1 ELSE FALSE END", [])
    # The explicit forms: not NULL past the nil test.
    check(Gauge.where { level.nil? || !(level > 18) }, "#{GS} WHERE \"level\" IS NULL OR NOT \"level\" > 18", [])
    check(Gauge.order { !level.nil? && level > 18 }, "#{GS} ORDER BY NOT \"level\" IS NULL AND \"level\" > 18", [])
    check(Gauge.where { !level.nil? && Rotor::SQL.not_nil(level) + 1 > 18 }, "#{GS} WHERE NOT \"level\" IS NULL AND \"level\" + 1 > 18", [])
    # Refused where NULL is not false.
    e = assert_raise(Rotor::UntranslatableError) { Gauge.where { !(level > 18) } }
    assert_match(/\A`!\(level > 18\)` is three-valued in SQL when `level` can be NULL \(.*\): test `level.nil\?` explicitly \(`level.nil\? \|\| !\(level > 18\)`\)\z/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Gauge.order { level > 18 } }
    assert_match(/\A`level > 18` as a value is NULL, not false/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Gauge.query.update { {on: level > cap} } }
    assert_match(/\A`level > cap` as a value is NULL/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Gauge.where { (level > 18) == on } }
    assert_match(/\A`level > 18` as a value is NULL/, e.message)
    # Ordered against a literal nil: always false, refused; `==` and
    # `!=` nil are `IS NULL`.
    e = assert_raise(Rotor::UntranslatableError) { Gauge.where { level > nil } }
    assert_match(/\A`level > nil` is always false \(.*query_test\.qz:\d+\): compare with a value, or use `nil\?`\z/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Gauge.where { level < nil } }
    assert_match(/\A`level < nil` is always false/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Gauge.where { |g| g.ratio >= nil } }
    assert_match(/\A`g.ratio >= nil` is always false/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Gauge.where { nil <= label } }
    assert_match(/\A`nil <= label` is always false/, e.message)
    flag = true
    e = assert_raise(Rotor::UntranslatableError) { Gauge.where { (flag ? level : cap) > (if flag then nil end) } }
    assert_match(/\A`\(flag \? level : cap\) > \(if flag then nil end\)` is always false/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Gauge.where { level >= (unless flag then nil end) } }
    assert_match(/always false/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Gauge.where { level < (flag ? nil : (on ? nil : nil)) } }
    assert_match(/always false/, e.message)
    # A captured nil is an unset value, as above, inside an `if` too:
    # what is refused does not depend on what was captured.
    check(Gauge.where { level > none }, "#{GS} WHERE \"level\" > $1", [nil])
    check(Gauge.where { level > (if flag then none end) }, "#{GS} WHERE \"level\" > NULL", [])
    lo: Int? = nil
    check(Gauge.where { level > (lo ? lo : nil) }, "#{GS} WHERE \"level\" > NULL", [])
    lo = 5
    check(Gauge.where { level > (lo ? lo : nil) }, "#{GS} WHERE \"level\" > $1", [5])
    check(Gauge.where { level == nil }, "#{GS} WHERE \"level\" IS NULL", [])
    check(Gauge.where { level != nil }, "#{GS} WHERE \"level\" IS NOT NULL", [])
  end

  # Outside query blocks `Int? > Int` is still a type error.
  def test_compare_is_in_scope_in_query_blocks_only
    out = Process.sh("cd test/fixtures/compare_out_of_scope && exec \"${QUARZ:-quarz}\" check")
    assert(!out.success?)
    assert_match(/main\.qz:12:3: error: undefined method `>` for Nil/, out.stderr)
    assert_match(/main\.qz:13:3: error: no overload of `<` on Int matches \(Int\?\)/, out.stderr)
    assert_match(/main\.qz:15:3: error: no overload of `select` on Array\[Member\]/, out.stderr)
    refute_match(/main\.qz:9:/, out.stderr)
  end

  def test_in_list_and_like
    ids = [1, 2, 3]
    none: Array[Int] = []
    # One array parameter, whatever the length (a literal of literals
    # too); the empty array is `{}`, which `= ANY` finds nothing in.
    check(Person.where { ids.include?(id) }, "#{COLS} WHERE \"id\" = ANY($1)", [[1, 2, 3]])
    check(Person.where { [4, 5].include?(id) }, "#{COLS} WHERE \"id\" = ANY($1)", [[4, 5]])
    check(Person.where { none.include?(id) }, "#{COLS} WHERE \"id\" = ANY($1)", [Array[Int].new])
    check(Person.where { !none.include?(id) }, "#{COLS} WHERE NOT \"id\" = ANY($1)", [Array[Int].new])
    # A nil item is removed, and `IS NULL` asked (`= ANY` finds no NULL).
    ns: Array[String?] = ["a", nil, "b"]
    check(Person.where { ns.include?(email) }, "#{COLS} WHERE \"email\" = ANY($1) OR \"email\" IS NULL", [["a", "b"]])
    only: Array[String?] = [nil]
    check(Person.where { only.include?(email) }, "#{COLS} WHERE \"email\" IS NULL", [])
    # Floats beside a column that is not a `Float`'s: cast; `Int`s and
    # `Float`s together: `Float`s.
    fs = [1.5, 2.5]
    check(Person.where { fs.include?(age) }, "#{COLS} WHERE \"age\" = ANY($1::double precision[])", [[1.5, 2.5]])
    check(Person.where { fs.include?(score) }, "#{COLS} WHERE \"score\" = ANY($1)", [[1.5, 2.5]])
    mixed: Array[Int | Float] = [1, 2.5]
    check(Person.where { mixed.include?(score) }, "#{COLS} WHERE \"score\" = ANY($1)", [[1.0, 2.5]])
    # `!` over the empty array is two-valued: found nowhere, NULL or not.
    nos: Array[String] = []
    check(Person.where { !nos.include?(email) }, "#{COLS} WHERE NOT \"email\" = ANY($1)", [Array[Int].new])
    # An array of a class no parameter is.
    objs: Array[Int | Summary] = [Summary.new(1, "a")]
    e = assert_raise(Rotor::UntranslatableError) { Person.where { objs.include?(id) } }
    assert_match(/\A`include\?` on an array of Summary cannot be translated to SQL/, e.message)
    # A literal with other than literals: an `IN` list.
    check(Person.where { [age, 3].include?(id) }, "#{COLS} WHERE \"id\" IN (\"age\", 3)", [])
    check(Person.where { name.start_with?("A_") }, "#{COLS} WHERE \"name\" LIKE $1", ["A\\_%"])
    check(Person.where { name.end_with?("%") }, "#{COLS} WHERE \"name\" LIKE $1", ["%\\%"])
    check(Person.where { name.start_with?("a\\") }, "#{COLS} WHERE \"name\" LIKE $1", ["a\\\\%"])
    assert(Rotor::SQL.like("a\\b", Rotor::SQL.escape_like("a\\b")))
    assert(!Rotor::SQL.like("a%b", Rotor::SQL.escape_like("a\\b")))
    w = "nn"
    check(Person.where { name.include?(w) }, "#{COLS} WHERE \"name\" LIKE $1", ["%nn%"])
    check(Person.where { Rotor::SQL.like(name, "A%") }, "#{COLS} WHERE \"name\" LIKE $1", ["A%"])
    check(Person.where { Rotor::SQL.ilike(name, "a%") }, "#{COLS} WHERE \"name\" ILIKE $1", ["a%"])
    check(Person.where { Rotor::SQL.lower(name) == "ann" }, "#{COLS} WHERE lower(\"name\") = $1", ["ann"])
    check(Person.where { Rotor::SQL.upper(name) == "ANN" }, "#{COLS} WHERE upper(\"name\") = $1", ["ANN"])
  end

  def test_if_and_time
    t = Time.utc(2026, 1, 2, 3, 4, 5)
    check(Person.where { born.nil? || joined < t }, "#{COLS} WHERE \"born\" IS NULL OR \"joined\" < $1", [t])
    check(Person.where { (admin ? 1 : 0) == 1 }, "#{COLS} WHERE CASE WHEN \"admin\" THEN 1 ELSE 0 END = 1", [])
  end

  # Parameters PostgreSQL could not type by what they meet are cast by
  # their value's class.
  def test_parameters_are_typed
    d = "double precision"
    # In a `CASE`: its branches, and a bare condition (a nil is left
    # untyped: it takes the other branch's type).
    check(Person.where { age > (admin ? 25.5 : 35.5) }, "#{COLS} WHERE \"age\" > CASE WHEN \"admin\" THEN $1::#{d} ELSE $2::#{d} END", [25.5, 35.5])
    n = 30
    check(Person.where { age > (admin ? n : 40) }, "#{COLS} WHERE \"age\" > CASE WHEN \"admin\" THEN $1::bigint ELSE 40 END", [30])
    s: String? = nil
    check(Person.where { name == (admin ? "a" : s) }, "#{COLS} WHERE \"name\" IS NOT DISTINCT FROM CASE WHEN \"admin\" THEN $1::text ELSE $2 END", ["a", nil])
    t = Time.utc(2026, 1, 2, 3, 4, 5)
    t2 = t + 1.day
    check(Person.where { joined < (admin ? t : t2) }, "#{COLS} WHERE \"joined\" < CASE WHEN \"admin\" THEN $1::timestamptz ELSE $2::timestamptz END", [t, t2])
    f = true
    check(Person.where { (f ? age : 0) > 1 }, "#{COLS} WHERE CASE WHEN $1::boolean THEN \"age\" ELSE 0 END > 1", [true])
    # The operand of a unary minus.
    x = 25.5
    check(Person.where { age > -x }, "#{COLS} WHERE \"age\" > - $1::#{d}", [25.5])
    check(Person.where { age > -n }, "#{COLS} WHERE \"age\" > - $1::bigint", [30])
    # Two parameters (as text, 10 would be before 9).
    lo = 10
    hi = 9
    check(Person.where { |_p| lo < hi }, "#{COLS} WHERE $1::bigint < $2::bigint", [10, 9])
    check(Person.where { |_p| [hi].include?(lo) }, "#{COLS} WHERE $1::bigint IN ($2::bigint)", [10, 9])
    his = [hi]
    check(Person.where { |_p| his.include?(lo) }, "#{COLS} WHERE $1::bigint = ANY($2)", [10, [9]])
    # Under `IS NULL` (a nil as text).
    xi: Int? = 3
    xn: Int? = nil
    check(Person.where { |_p| xi.nil? }, "#{COLS} WHERE $1::bigint IS NULL", [3])
    check(Person.where { |_p| xn.nil? }, "#{COLS} WHERE $1::text IS NULL", [nil])
    # An `Int` beside an `Int` literal, which is an `integer`.
    big = 3000000000
    check(Person.where { age < big + 1 }, "#{COLS} WHERE \"age\" < $1::bigint + 1", [big])
    check(Person.where { |_p| [1, 2].include?(big) }, "#{COLS} WHERE $1::bigint = ANY($2)", [big, [1, 2]])
    # `Int` literals alone in arithmetic, or CASEs of them (`integer`s
    # in SQL, which would overflow): the left one cast to a bigint.
    check(Person.where { age < 2000000000 * 2 }, "#{COLS} WHERE \"age\" < 2000000000::bigint * 2", [])
    check(Person.where { age < 1 + 2000000000 * 2 }, "#{COLS} WHERE \"age\" < 1 + 2000000000::bigint * 2", [])
    check(Person.where { age < -(2000000000 * 2) }, "#{COLS} WHERE \"age\" < - (2000000000::bigint * 2)", [])
    check(Person.where { age < (admin ? 2000000000 : 1) * 2 }, "#{COLS} WHERE \"age\" < CASE WHEN \"admin\" THEN 2000000000 ELSE 1 END::bigint * 2", [])
    check(Person.where { age < (admin ? age : 1) * 2 }, "#{COLS} WHERE \"age\" < CASE WHEN \"admin\" THEN \"age\" ELSE 1 END * 2", [])
    check(Person.where { age < (admin ? age : score) * 2 }, "#{COLS} WHERE \"age\" < CASE WHEN \"admin\" THEN \"age\" ELSE \"score\" END * 2", [])
    check(Person.where { age % 3 == 2000000000 % 3 }, "#{COLS} WHERE (\"age\" % 3 + 3) % 3 IS NOT DISTINCT FROM (2000000000::bigint % 3 + 3) % 3", [])
    check(Person.where { age < 2000000000 / 2 * 3 }, "#{COLS} WHERE \"age\" < floor(2000000000::numeric / 2)::bigint * 3", [])
    check(Person.where { age < (admin ? 2000000000 : 1) + (admin ? 2 : 1) }, "#{COLS} WHERE \"age\" < CASE WHEN \"admin\" THEN 2000000000 ELSE 1 END::bigint + CASE WHEN \"admin\" THEN 2 ELSE 1 END", [])
    check(Person.where { age < -(admin ? 2000000000 : 1) - 1 }, "#{COLS} WHERE \"age\" < - CASE WHEN \"admin\" THEN 2000000000 ELSE 1 END::bigint - 1", [])
    check(Person.where { age < -2000000000 * 2 }, "#{COLS} WHERE \"age\" < -2000000000::bigint * 2", [])
    # (Beyond an `integer`'s range a literal is a bigint already.)
    check(Person.where { age < -9223372036854775808 + 1 }, "#{COLS} WHERE \"age\" < -9223372036854775808 + 1", [])
    assert_equal(["UPDATE \"people\" SET \"age\" = 2000000000::bigint * 2", Array[Object?].new], Person.query.update { |_p| {age: 2000000000 * 2} }.to_sql)
    # An `if` nil either way is NULL (a `CASE` of NULLs would be text),
    # not a known nil: an order by it is the `CASE`'s, and a message
    # names the capture.
    check(Person.where { age == (admin ? xn : nil) }, "#{COLS} WHERE \"age\" IS NOT DISTINCT FROM NULL", [])
    check(Person.where { age == (admin ? (age > 5 ? xn : nil) : nil) }, "#{COLS} WHERE \"age\" IS NOT DISTINCT FROM NULL", [])
    assert_match(/ ORDER BY NULL::text, "id"\z/, Person.order { admin ? xn : nil }.order { id }.to_sql[0])
    xb: Bool? = nil
    e = assert_raise(Rotor::UntranslatableError) { Person.where { !(admin ? xb : nil) } }
    assert_match(/when `xb` can be NULL/, e.message)
    # A known condition other than a `Bool`: the branch it takes.
    so: String? = "x"
    sn: String? = nil
    check(Person.where { (so ? age : 0) > 1 }, "#{COLS} WHERE \"age\" > 1", [])
    check(Person.where { (sn ? age : 0) > 1 }, "#{COLS} WHERE 0 > 1", [])
    # A condition other than a `Bool` is tested for its truthiness, as
    # in Quarz: true unless nil.
    check(Person.where { (email ? age : 0) > 1 }, "#{COLS} WHERE CASE WHEN \"email\" IS NOT NULL THEN \"age\" ELSE 0 END > 1", [])
    check(Person.where { (name ? 1 : 0) == 1 }, "#{COLS} WHERE CASE WHEN \"name\" IS NOT NULL THEN 1 ELSE 0 END = 1", [])
    check(Person.where { (age + 1 ? score : 0.0) > 1.0 }, "#{COLS} WHERE CASE WHEN \"age\" + 1 IS NOT NULL THEN \"score\" ELSE $1::double precision END > $2::double precision", [0.0, 1.0])
    check(Person.where { (email && admin ? 1 : 0) == 1 }, "#{COLS} WHERE CASE WHEN \"email\" IS NOT NULL AND \"admin\" THEN 1 ELSE 0 END = 1", [])
    check(Person.where { (admin || Rotor::SQL.lower(name) ? 1 : 0) == 1 }, "#{COLS} WHERE CASE WHEN \"admin\" OR lower(\"name\") IS NOT NULL THEN 1 ELSE 0 END = 1", [])
    check(Person.where { admin && !email }, "#{COLS} WHERE \"admin\" AND NOT \"email\" IS NOT NULL", [])
    check(Person.where { !email }, "#{COLS} WHERE NOT \"email\" IS NOT NULL", [])
    check(Person.where { (if born then 1 end) == 1 }, "#{COLS} WHERE CASE WHEN \"born\" IS NOT NULL THEN 1 END = 1", [])
    sx: String? = "x"
    check(Person.where { (sx && admin ? 1 : 0) == 1 }, "#{COLS} WHERE CASE WHEN $1::text IS NOT NULL AND \"admin\" THEN 1 ELSE 0 END = 1", ["x"])
    # (A nullable `Bool` is SQL's own test: NULL as false.)
    assert_equal("SELECT \"id\", \"vip\" FROM \"flagged\" WHERE CASE WHEN \"vip\" THEN 1 ELSE 0 END = 1", Flagged.where { (vip ? 1 : 0) == 1 }.to_sql[0])
    # An `&&` or `||` of such a test is one of its operands in Quarz, a
    # `Bool` in SQL: refused as a value, kept as a condition.
    e = assert_raise(Rotor::UntranslatableError) { Person.where { (email || name) == true } }
    assert_match(/\A`email \|\| name` as a value is one of its operands in Quarz, but a `Bool` in SQL \(.*query_test\.qz:\d+\): write an `if`\z/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Person.where { (email && name) != nil } }
    assert_match(/\A`email && name` as a value/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Person.where { (admin ? (email && name) : name) == "x" } }
    assert_match(/\A`email && name` as a value/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Person.order { email || name } }
    assert_match(/\A`email \|\| name` as a value/, e.message)
    check(Person.where { ((if admin then email || name end) ? 1 : 0) == 1 }, "#{COLS} WHERE CASE WHEN CASE WHEN \"admin\" THEN \"email\" IS NOT NULL OR \"name\" IS NOT NULL END THEN 1 ELSE 0 END = 1", [])
    check(Person.where { !(email && admin) }, "#{COLS} WHERE NOT (\"email\" IS NOT NULL AND \"admin\")", [])
    e = assert_raise(Rotor::UntranslatableError) { Person.where { (if (admin ? email : admin) then age else 0 end) > 1 } }
    assert_match(/\A`admin \? email : admin`, a `Bool` or another value, as a condition cannot be translated to SQL/, e.message)
    # Against a column, untyped as before.
    check(Person.where { age > n && name == "a" }, "#{COLS} WHERE \"age\" > $1 AND \"name\" = $2", [30, "a"])
  end

  def test_order_limit_offset
    check(Person.order { name }, "#{COLS} ORDER BY \"name\"", [])
    check(Person.order { name }.desc.order { |p| p.id }, "#{COLS} ORDER BY \"name\" DESC, \"id\"", [])
    check(Person.where { admin }.order { age }.limit(10).offset(20), "#{COLS} WHERE \"admin\" ORDER BY \"age\" LIMIT 10 OFFSET 20", [])
    check(Person.first, "#{COLS} LIMIT 1", [])
    check(Person.query.offset(5), "#{COLS} OFFSET 5", [])
    e = assert_raise(ArgumentError) { Person.query.desc }
    assert_equal("`desc` without an `order` before it", e.message)
    e = assert_raise(ArgumentError) { Person.limit(-1) }
    assert_equal("a negative limit: -1", e.message)
  end

  def test_select
    check(Person.select { name }, "SELECT \"name\" FROM \"people\"", [])
    # The columns the block reads; its value is computed in Quarz.
    q = Person.select { |p| p.age + 1 }.limit(2)
    check(q, "SELECT \"age\" FROM \"people\" LIMIT 2", [])
    assert_equal(41, q.load({age: 40}))
    s = Person.where { admin }.select { Summary.new(id, name) }
    check(s, "SELECT \"id\", \"name\" FROM \"people\" WHERE \"admin\"", [])
    assert_equal(Summary.new(1, "Ann"), s.load({id: 1, name: "Ann"}))
    check(Person.query.map { |p| p.id }, "SELECT \"id\" FROM \"people\"", [])
    # Both branches of an `if`, and a method SQL has no word for.
    check(Person.select { admin ? name : email }, "SELECT \"name\", \"email\", \"admin\" FROM \"people\"", [])
    n = Person.select { name.size }
    check(n, "SELECT \"name\" FROM \"people\"", [])
    assert_equal(3, n.load({name: "Ann"}))
    # Inside a nested block, the row is the outer block's parameter.
    check(Person.select { |p| [1, 2].map { |i| p.age + i } }, "SELECT \"age\" FROM \"people\"", [])
    # A `self` inside a nested block may be another block's receiver:
    # every column.
    check(Person.select { [1].map { |i| age + i } }, COLS, [])
    # The row passed on, or another method of it: every column.
    check(Person.select { |p| p.inspect }, COLS, [])
    # A column the block did not read is not loaded.
    part = Person.load_partial({id: 1})
    e = assert_raise(Rotor::NotLoadedError) { part.name }
    assert_equal("Person#name was not loaded: the query fetched id", e.message)
    # No defaults for what was not fetched; an assigned column reads.
    h: Hash[Symbol, Object?] = {id: 1}
    assert_equal(h, part.to_h)
    assert_equal(5, part.with(age: 5).age)
    e = assert_raise(ArgumentError) { Person.select { name }.where { |n| n == "x" } }
    assert_equal("`where` after `select`, `count` or `exists`: write it before", e.message)
  end

  def test_count_and_exists
    check(Person.count, "SELECT count(*) FROM \"people\"", [])
    check(Person.where { age > 1 }.order { name }.count, "SELECT count(*) FROM \"people\" WHERE \"age\" > 1", [])
    check(Person.query.limit(5).count, "SELECT count(*) FROM (SELECT 1 FROM \"people\" LIMIT 5) AS \"q\"", [])
    check(Person.where { admin }.exists, "SELECT EXISTS (SELECT 1 FROM \"people\" WHERE \"admin\")", [])
    e = assert_raise(ArgumentError) { Person.count.offset(1) }
    assert_equal("`offset` after `count` or `exists`: write it before", e.message)
  end

  def test_immutable
    q = Person.where { admin }
    q2 = q.where { age > 1 }
    check(q, "#{COLS} WHERE \"admin\"", [])
    check(q2, "#{COLS} WHERE \"admin\" AND \"age\" > 1", [])
  end

  def test_untranslatable
    e = assert_raise(Rotor::UntranslatableError) { Person.where { name.size > 3 } }
    assert_match(/\A`String#size` cannot be translated to SQL \(.*query_test\.qz:\d+\)\z/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Person.where { "#{name}!" == "x" } }
    assert_match(/\Aan interpolated string cannot be translated to SQL/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Person.where { [1].any? { |x| x == age } } }
    assert_match(/\Athe block given to `Enumerable#any\?` cannot be translated to SQL/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Person.where { |p| p == p } }
    assert_match(/\Athe parameter `p` by itself cannot be translated to SQL/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Person.where { name * 2 == "aa" } }
    assert_match(/\A`String#\*` cannot be translated to SQL/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Person.where { score % 2.0 > 1.0 } }
    assert_match(/\A`Float#%` cannot be translated to SQL/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Person.where { age % 2.0 > 1.0 } }
    assert_match(/\A`Int#%` cannot be translated to SQL/, e.message)
    # An `Int | Float` receiver's `/` is two operations: which one the
    # SQL does would depend on the row.
    e = assert_raise(Rotor::UntranslatableError) { Person.where { (if admin then age else score end) / 2 > 1 } }
    assert_match(/\A`Int#\/` and `Float#\/` together \(on a union receiver\) cannot be translated to SQL/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Person.where { (if admin then score else age end) / 2 > 1 } }
    assert_match(/\A`Float#\/` and `Int#\/` together \(on a union receiver\) cannot be translated to SQL/, e.message)
    # (In double precision, as SQL's `CASE` of a bigint and a double
    # precision is: an `Int` row differs from Quarz beyond 2**53.)
    # `+`, `-` and `*` are one operation in SQL for both, and so is `/`
    # by a `Float`.
    check(Person.where { (if admin then age else score end) / 2.0 > 1 }, "#{COLS} WHERE CASE WHEN \"admin\" THEN \"age\" ELSE \"score\" END / $1::double precision > 1", [2.0])
    check(Person.where { (if admin then age else score end) + 1 > 2 }, "#{COLS} WHERE CASE WHEN \"admin\" THEN \"age\" ELSE \"score\" END + 1 > 2", [])
    d = 3.seconds
    e = assert_raise(Rotor::UntranslatableError) { Person.where { |p| d > d } }
    assert_match(/\Aa value of class Duration cannot be translated to SQL/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Person.order { |p| 1 } }
    assert_match(/\Aan order by a constant cannot be translated to SQL/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Person.where { name.start_with?(name) } }
    assert_match(/\A`String#start_with\?` of something other than a string value cannot be translated to SQL/, e.message)
  end
end
