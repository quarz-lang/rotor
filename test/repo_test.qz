require "test"

data Brief = (id: Int, name: String)

class Member < Rotor::Model
  table "members" do
    column :id, Int, primary: true
    column :name, String
    column :email, String, null: true
    column :age, Int, default: 0
    column :score, Float, default: 0.0
    column :admin, Bool, default: false
    column :avatar, Bytes, null: true
    column :vip, Bool, null: true
    timestamps
  end
end

class Note < Rotor::Model
  table "notes" do
    column :id, Int, primary: true
    column :body, String
    column :seen, Time, null: true
  end
end

class Author < Rotor::Model
  table "authors" do
    column :id, Int, primary: true
    column :name, String
    has_many Volume
  end
end

class Volume < Rotor::Model
  table "volumes" do
    column :id, Int, primary: true
    column :title, String
    belongs_to Author, null: true
    has_many Remark
    has_many Genre, through: VolumeGenre
  end
end

# A join model with a column of its own.
class VolumeGenre < Rotor::Model
  table "volume_genres" do
    column :id, Int, primary: true
    belongs_to Volume
    belongs_to Genre
    column :position, Int, default: 0
  end
end

class Genre < Rotor::Model
  table "genres" do
    column :id, Int, primary: true
    column :name, String
    has_many Volume, through: VolumeGenre
  end
end

# `Float` columns that are not `double precision`.
class Reading < Rotor::Model
  table "readings" do
    column :id, Int, primary: true
    column :r, Float
    column :n, Float
  end
end

# A table rotor did not create, with `integer` columns.
class Legacy < Rotor::Model
  table "legacy" do
    column :id, Int, primary: true
    column :n, Int
  end
end

class Remark < Rotor::Model
  table "remarks" do
    column :id, Int, primary: true
    column :stars, Int
    belongs_to Volume
  end
end

# An adapter that counts the statements it runs.
class Counting < Rotor::Adapter
  @inner: Rotor::Adapter
  @count: Atom[Int]
  @sqls: Atom[Array[String]]

  def initialize(@inner: Rotor::Adapter)
    @count = Atom[Int].new(0)
    @sqls = Atom[Array[String]].new([])
  end

  def count -> Int = @count.get

  # The statements run, in order.
  def sqls -> Array[String] = @sqls.get

  def query(sql: String, params: Array[Object?]) -> Rotor::Rows
    @count.update { |n| n + 1 }
    @sqls.update { |xs| xs + [sql] }
    @inner.query(sql, params)
  end

  def transaction(&: (Rotor::Adapter) -> Object?) -> Object? = @inner.transaction { |a| yield a }
end

# Against a real server (PG::Testing): the repository's statements.
class RepoTest < Test::Case
  SERVER = Atom[PG::Testing::Server | String].new("not started")

  # (Dropped first: PG_TEST_URL's server outlives a run, and CI runs the
  # tests twice, interpreted and compiled.)
  SCHEMA = <<~SQL
    DROP TABLE IF EXISTS members, notes, authors, volumes, remarks, readings, genres, volume_genres, legacy;
    CREATE TABLE members (
      id bigserial PRIMARY KEY,
      name text NOT NULL,
      email text,
      age bigint NOT NULL DEFAULT 0,
      score double precision NOT NULL DEFAULT 0,
      admin boolean NOT NULL DEFAULT false,
      avatar bytea,
      vip boolean,
      created_at timestamptz NOT NULL,
      updated_at timestamptz NOT NULL
    );
    CREATE TABLE notes (id bigserial PRIMARY KEY, body text NOT NULL DEFAULT 'empty', seen timestamptz);
    CREATE TABLE authors (id bigserial PRIMARY KEY, name text NOT NULL);
    CREATE TABLE volumes (id bigserial PRIMARY KEY, title text NOT NULL, author_id bigint REFERENCES authors);
    CREATE TABLE remarks (id bigserial PRIMARY KEY, stars bigint NOT NULL, volume_id bigint NOT NULL REFERENCES volumes);
    CREATE TABLE readings (id bigserial PRIMARY KEY, r real NOT NULL, n numeric NOT NULL);
    CREATE TABLE genres (id bigserial PRIMARY KEY, name text NOT NULL);
    CREATE TABLE volume_genres (id bigserial PRIMARY KEY, volume_id bigint NOT NULL REFERENCES volumes, genre_id bigint NOT NULL REFERENCES genres, position bigint NOT NULL DEFAULT 0);
    CREATE TABLE legacy (id integer PRIMARY KEY, n integer NOT NULL);
    CREATE INDEX legacy_n ON legacy (n)
  SQL

  def self.startup
    server = PG::Testing.start_or_reason
    if server.is_a?(PG::Testing::Server)
      c = PG.connect(server.url)
      begin
        c.exec_all(SCHEMA)
      ensure
        c.close
      end
    end
    SERVER.set(server)
  end

  def self.shutdown
    case SERVER.get
    in PG::Testing::Server => s then s.stop
    else nil
    end
  end

  def url -> String
    case SERVER.get
    in PG::Testing::Server => s then s.url
    in String => why then omit(why)
    end
  end

  # A repository over one connection, on empty tables.
  def with_repo(&: (Rotor::Repo) -> Void) -> Void
    c = PG.connect(url)
    begin
      c.exec("TRUNCATE members, notes, authors, volumes, remarks, readings, genres, volume_genres, legacy RESTART IDENTITY")
      yield Rotor::Repo.new(connection: c)
    ensure
      c.close
    end
  end

  # Authors 1 (Ann: volumes 1 "a" and 2 "b"), 2 (Bob: none), 3 (Cy: volume
  # 3 "c"), and volume 4 "d" without an author; remarks of volumes 1 (5, 3)
  # and 3 (4).
  def library(repo: Rotor::Repo) -> Void
    ["Ann", "Bob", "Cy"].each { |n| repo.insert(Author.new(name: n)) }
    [["a", 1], ["b", 1], ["c", 3]].each { |t| repo.insert(Volume.new(title: t[0].as(String), author_id: t[1].as(Int))) }
    repo.insert(Volume.new(title: "d"))
    [[5, 1], [3, 1], [4, 3]].each { |r| repo.insert(Remark.new(stars: r[0], volume_id: r[1])) }
  end

  # A repository that counts its statements, over `repo`'s adapter.
  def counting(repo: Rotor::Repo) -> [Rotor::Repo, Counting]
    c = Counting.new(repo.adapter)
    [Rotor::Repo.new(c), c]
  end

  def member(name: String, age: Int = 30) -> Member
    Member.new(name: name, age: age)
  end

  def test_insert_sets_the_key_and_timestamps
    with_repo do |repo|
      before = Time.now
      m = repo.insert(member("Ann"))
      assert_equal(1, m.id)
      assert(!m.changed?)
      assert(m.created_at.utc?)
      assert_equal(0, m.created_at.nsec % 1000)
      assert_equal(m.created_at, m.updated_at)
      assert(m.created_at >= before - 1.second)
      # Read back, the same values to the microsecond.
      got = repo.get(Member, 1)
      assert(got)
      g = got.as(Member)
      assert_equal(m.created_at, g.created_at)
      assert_equal("Ann", g.name)
      assert_nil(g.email)
      # A creation time the model has is kept.
      t = Time.utc(2020, 1, 2, 3, 4, 5)
      n = repo.insert(member("Bob").with(created_at: t))
      assert_equal(t, n.created_at)
      assert(n.updated_at > t)
      # The database's defaults come back.
      note = repo.insert(Note.new)
      assert_equal("empty", note.body)
      assert_nil(note.seen)
    end
  end

  def test_types_round_trip
    with_repo do |repo|
      repo.insert(member("Typed").with(email: "t@example.com", score: 2.5, admin: true, avatar: b"\x00\xff"))
      g = repo.one!(Member.where { admin })
      assert_equal("t@example.com", g.email)
      assert_equal(2.5, g.score)
      assert(g.admin)
      assert_equal(b"\x00\xff", g.avatar)
      t = Time.utc(2026, 11, 3, 12, 0, 0) + 1.ms * 0.123
      repo.insert(Note.new(body: "b", seen: t))
      assert_equal(t, repo.one!(Note.query).seen)
    end
  end

  def test_queries
    with_repo do |repo|
      ["Ann", "Bob", "Cy"].each_with_index { |n, i| repo.insert(member(n, 20 + i * 10)) }
      min = 25
      assert_equal(["Bob", "Cy"], repo.all(Member.where { age >= min }.order { name }).map { |m| m.name })
      assert_equal(["Cy", "Bob", "Ann"], repo.all(Member.order { age }.desc).map { |m| m.name })
      assert_equal("Ann", repo.first(Member.order { name }).as(Member).name)
      assert_equal(2, repo.count(Member.where { age > 20 }))
      assert(repo.exists?(Member.where { name == "Cy" }))
      assert(!repo.exists?(Member.where { name == "Dee" }))
      assert_nil(repo.get(Member, 99))
      assert_nil(repo.one(Member.where { name == "Dee" }))
      assert_raise(Rotor::MultipleResultsError) { repo.one(Member.where { age > 0 }) }
      assert_raise(Rotor::NoResultsError) { repo.one!(Member.where { age > 100 }) }
      # A projection is the block's value on rows loaded with the
      # columns it reads.
      assert_equal([Brief.new(1, "Ann"), Brief.new(2, "Bob")], repo.all(Member.where { age < 40 }.order { id }.select { Brief.new(id, name) }))
      assert_equal([21, 31, 41], repo.all(Member.order { id }.select { |m| m.age + 1 }))
      assert_equal([3, 3, 2], repo.all(Member.order { id }.select { name.size }))
      # nil, by value.
      e: String? = nil
      assert_equal(3, repo.count(Member.where { email == e }))
      assert_equal(3, repo.count(Member.where { email != "x" }))
      # An `Int` column with a `Float`: Quarz's mixed arithmetic, the
      # parameter a double precision; `Int#/(Int)` floors.
      assert_equal(2, repo.count(Member.where { age / 8.0 > 3.0 }))
      assert_equal(1, repo.count(Member.where { age / 8 > 3 }))
      assert_equal(2, repo.count(Member.where { age * 0.5 > 12.5 }))
      assert_equal(2, repo.count(Member.where { age > 25.5 }))
      x = 25.5
      assert_equal(1, repo.count(Member.where { age - x < 0 }))
      assert_equal(2, repo.count(Member.where { score + age > 25.0 }))
      # A `Float` parameter takes the type of the `Float` column it
      # meets: `real` and `numeric` are not read as double precision.
      x = 0.30000000000000004
      repo.insert(Reading.new(r: 0.1, n: x))
      assert_equal(1, repo.count(Reading.where { r == 0.1 }))
      assert_equal(1, repo.count(Reading.where { n == x }))
      assert_equal([x], repo.all(Reading.order { id }.select { n }))
      # Parameters typed by their class where nothing types them: in a
      # `CASE` (ages 20, 30, 40, none an admin), under a unary minus,
      # beside another parameter.
      assert_equal(1, repo.count(Member.where { age > (admin ? 25.5 : 35.5) }))
      n = 35
      assert_equal(1, repo.count(Member.where { age > (admin ? 0 : n) }))
      y = -25.5
      assert_equal(2, repo.count(Member.where { age > -y }))
      ni = -25
      assert_equal(2, repo.count(Member.where { age > -ni }))
      lo = 10
      hi = 9
      assert_equal(0, repo.count(Member.where { |_m| lo < hi }))
      assert_equal(0, repo.count(Member.where { |_m| [hi].include?(lo) }))
      no: String? = nil
      some: String? = "a"
      assert_equal(3, repo.count(Member.where { |_m| no.nil? }))
      assert_equal(0, repo.count(Member.where { |_m| some.nil? }))
      assert_equal(3, repo.count(Member.where { |_m| [no, "b"].include?(no) }))
      assert_equal(3, repo.count(Member.where { email == (admin ? "a" : no) }))
      # `include?` as `= ANY($1)`, one array parameter whatever its
      # length; nil items (`IS NULL`) and the empty array.
      ids = (1..70000).to_a
      assert_equal(3, repo.count(Member.where { ids.include?(id) }))
      none: Array[Int] = []
      assert_equal(0, repo.count(Member.where { none.include?(id) }))
      assert_equal(3, repo.count(Member.where { !none.include?(id) }))
      es: Array[String?] = [nil, "x"]
      assert_equal(3, repo.count(Member.where { es.include?(email) }))
      xs: Array[String?] = ["x"]
      assert_equal(0, repo.count(Member.where { xs.include?(email) }))
      fs = [20.0, 30.5]
      assert_equal(1, repo.count(Member.where { fs.include?(age) }))
      mixed: Array[Int | Float] = [30, 0.5]
      assert_equal(1, repo.count(Member.where { mixed.include?(age) }))
      assert_equal(2, repo.count(Member.where { [20, 40].include?(age) }))
      nos: Array[String] = []
      assert_equal(3, repo.count(Member.where { !nos.include?(email) }))
      # An array is not a key.
      assert_raise(ArgumentError) { repo.get(Member, [1, 2]) }
      names = ["Ann", "Cy"]
      assert_equal(["Ann", "Cy"], repo.all(Member.where { names.include?(name) }.order { id }).map { |m| m.name })
      big = 3000000000
      mid = 2000000000
      assert_equal(3, repo.count(Member.where { age < big + 1 }))
      assert_equal(3, repo.count(Member.where { age < mid * 2 }))
      # `Int` literals alone (`integer`s in SQL, which would overflow).
      assert_equal(3, repo.count(Member.where { age < 2000000000 * 2 }))
      assert_equal(3, repo.count(Member.where { age < (age > 0 ? 2000000000 : 1) * 2 + 2000000000 }))
      assert_equal(3, repo.count(Member.where { age < (age > 0 ? 2000000000 : 1) + (age > 0 ? 2000000000 : 1) }))
      assert_equal(0, repo.count(Member.where { age < -(age > 0 ? 2000000000 : 1) - (age > 0 ? 2000000000 : 1) }))
      assert_equal(3, repo.count(Member.where { age < (age > 0 ? 2147483646 : 0) % (age > 0 ? 2147483647 : 1) }))
      assert_equal(3, repo.count(Member.where { age > -9223372036854775808 * 1 }))
      assert_equal(3, repo.count(Member.where { age > -(2000000000 * 2) }))
      assert_equal(3, repo.count(Member.where { age % 3 != 2000000000 * 2 % 3 + 5 }))
      assert_equal(0, repo.count(Member.where { |_m| [1, 2].include?(big) }))
      xn: Int? = nil
      assert_equal(0, repo.count(Member.where { age == (admin ? xn : nil) }))
      assert_equal(0, repo.count(Member.where { age > (admin ? 1 : (age > 5 ? xn : nil)) }))
      # One site, built with a nil and then not (translated again).
      [nil, 20].each do |v|
        assert_equal(v.nil? ? 0 : 1, repo.count(Member.where { age == (admin ? nil : v) }))
      end
      # An order by an `if` nil either way.
      assert_equal(["Ann", "Bob", "Cy"], repo.all(Member.order { admin ? xn : nil }.order { id }).map { |m| m.name })
      # A `Float` added to a `real` column: in double precision, as
      # Quarz adds it to the value read (16777216.0 + 0.1 in `real` is
      # 16777216.0).
      repo.insert(Reading.new(r: 16777216.0, n: 1.0))
      k = 0.1
      assert_equal(1, repo.count(Reading.where { r + k > 16777216.05 }))
      ki = 1
      assert_equal(1, repo.count(Reading.where { r + ki > 16777216.5 }))
      assert_equal(0, repo.count(Member.where { age == (admin ? (age > 5 ? xn : nil) : nil) }))
      # A `real` column against a `CASE`: double precision, where 0.1
      # read as a `real` is not 0.1 (in Quarz neither); against 0.1
      # itself, the column's type, as before.
      assert_equal(0, repo.count(Reading.where { r == (id > 0 ? 0.1 : 0.2) }))
      assert_equal(1, repo.count(Reading.where { r == 0.1 }))
    end
  end

  # `integer` columns of a table rotor did not create (README, "Parameter
  # types"): a parameter beside one is an `integer`, one cast `::bigint`
  # elsewhere compares through PostgreSQL's cross-type operators, and an
  # index on the column serves both, `= ANY` included.
  def test_integer_columns_of_a_foreign_table
    with_repo do |repo|
      repo.exec("INSERT INTO legacy SELECT i, i % 100 FROM generate_series(1, 1000) i")
      repo.exec("ANALYZE legacy")
      # (So that the plans below take the index wherever it can serve:
      # on so few rows a seq scan may be cheaper.)
      repo.exec("SET enable_seqscan = off")
      x = 42
      y = 0
      flag = true
      big = 3000000000
      xs = [5, 7, big]
      eq = Legacy.where { n == x }
      branch = Legacy.where { n > (flag ? 97 : y) }
      any = Legacy.where { xs.include?(n) }
      assert_equal("SELECT \"id\", \"n\" FROM \"legacy\" WHERE \"n\" > CASE WHEN $1::boolean THEN 97 ELSE $2::bigint END", branch.to_sql[0])
      assert_equal(10, repo.count(eq))
      assert_equal(20, repo.count(branch))
      assert_equal(20, repo.count(any))
      assert_equal(0, repo.count(Legacy.where { n > (flag ? big : y) }))
      # `==` with a CASE that cannot be NULL is `=`: the same rows, and
      # an index serves it (rotor#38).
      same = Legacy.where { n == (flag ? x : y) }
      assert_equal("SELECT \"id\", \"n\" FROM \"legacy\" WHERE \"n\" = CASE WHEN $1::boolean THEN $2::bigint ELSE $3::bigint END", same.to_sql[0])
      ids = repo.all(eq.order { id }).map { |l| l.id }
      assert_equal(10, ids.size)
      assert_equal(ids, repo.all(same.order { id }).map { |l| l.id })
      [eq, branch, any, same].each do |q|
        sql, params = q.to_sql
        plan = repo.query("EXPLAIN " + sql, params) { |r| r.string(0) }.join("\n")
        # (An Index Scan, or a Bitmap Index Scan, whose condition is
        # the comparison: not a Filter.)
        assert(plan.include?(" on legacy_n") || plan.include?(" using legacy_n"), plan)
        assert(plan.include?("Index Cond: "), plan)
      end
      # Beside the column, a value beyond an `integer`'s range is an
      # error, and so is arithmetic that overflows an `integer`.
      assert_raise(PG::ServerError) { repo.count(Legacy.where { n == big }) }
      assert_raise(PG::ServerError) { repo.count(Legacy.where { n * 100000000 > 0 }) }
    end
  end

  # rotor#36: `&&`, `||` and `!` of other values than `Bool`s, with
  # NULL and non-NULL rows, and nil captures in each position.
  def test_truthiness_forms
    with_repo do |repo|
      repo.insert(member("ann").with(email: "a@x", admin: true, vip: true))
      repo.insert(member("bob"))
      repo.insert(member("cy").with(email: "c@x"))
      repo.exec("UPDATE members SET vip = false WHERE name = 'cy'")
      names = ->(q: Rotor::Query[Member]) { repo.all(q.order { id }).map { |m| m.name } }
      # A truthy column on the left of `&&`: not NULL on its right.
      x = "a@x"
      assert_equal(["bob", "cy"], names.call(Member.where { !(email && email == x) }))
      # As a value, one of the operands.
      assert_equal(["bob"], names.call(Member.where { (email || name) == "bob" }))
      assert_equal(["cy"], names.call(Member.where { (email && name) == "cy" }))
      assert_equal(["ann", "bob", "cy"], repo.all(Member.order { email || name }).map { |m| m.name })
      assert_equal(["ann", "bob", "cy"], names.call(Member.where { (admin ? (email || name) : "x") ? true : false }))
      # A known left operand, and `!` of a known value.
      s: String? = "s"
      sn: String? = nil
      assert_equal(1, repo.update_all(Member.where { name == "ann" }) { {admin: s && admin} })
      assert_equal(["ann"], names.call(Member.where { admin }))
      assert_equal(Array[String].new, names.call(Member.where { (sn && admin) ? true : false }))
      assert_equal(["ann"], names.call(Member.where { (sn || admin) ? true : false }))
      assert_equal(Array[String].new, names.call(Member.where { admin && sn ? true : false }))
      assert_equal(["ann", "bob", "cy"], names.call(Member.where { |_m| !sn }))
      assert_equal(Array[String].new, names.call(Member.where { |_m| !s }))
      assert_equal(["ann"], names.call(Member.where { (email || sn) == "a@x" }))
      # Two `Bool`s, one of them NULL: Quarz's nil kept.
      f = false
      t = true
      repo.update_all(Member.query) { {vip: vip && f} }
      vs: Array[Bool?] = [false, nil, false]
      assert_equal(vs, repo.all(Member.order { id }).map { |m| m.vip })
      repo.exec("UPDATE members SET vip = NULL WHERE name = 'bob'")
      repo.update_all(Member.query) { {vip: vip || t} }
      ts: Array[Bool?] = [true, true, true]
      assert_equal(ts, repo.all(Member.order { id }).map { |m| m.vip })
      # Two other values: `COALESCE`.
      repo.update_all(Member.query) { {name: email || name} }
      assert_equal(["a@x", "bob", "c@x"], repo.all(Member.order { id }).map { |m| m.name })
    end
  end

  # Rows with NULLs: what `!=` (`IS DISTINCT FROM`) and the explicit
  # form (`!email.nil? && email != e`, `<>`) each find.
  def test_null_semantics
    with_repo do |repo|
      repo.insert(member("Ann").with(email: "a@x"))
      repo.insert(member("Bob").with(email: "b@x"))
      repo.insert(member("Cy"))
      e: String? = "a@x"
      names = ->(q: Rotor::Query[Member]) { repo.all(q.order { name }).map { |m| m.name } }
      # Quarz's `!=`: nil differs from "a@x".
      assert_equal(["Bob", "Cy"], names.call(Member.where { email != e }))
      # SQL's `<>`, written out: the NULL row is left out by the nil test.
      assert_equal(["Bob"], names.call(Member.where { !email.nil? && email != e }))
      assert_equal(["Cy"], names.call(Member.where { email.nil? || !(email == e) }.where { email != "b@x" }))
      assert_equal(["Ann"], names.call(Member.where { email == e }))
      # A condition other than a `Bool`: true unless nil, as in Quarz.
      assert_equal(["Ann", "Bob"], names.call(Member.where { (email ? 1 : 0) == 1 }))
      assert_equal(["Ann", "Bob"], names.call(Member.where { (email && age > 0 ? 1 : 0) == 1 }))
      assert_equal(["Cy"], names.call(Member.where { !email }))
      assert_equal(["Ann", "Bob", "Cy"], names.call(Member.where { (email || name ? 1 : 0) == 1 }))
      assert_equal(3, repo.update_all(Member.query) { {score: email ? 1.5 : age} })
      assert_equal([1.5, 1.5, 30.0], repo.all(Member.order { name }.select { score }))
      # nil `include?`d among nils: found, as in Quarz.
      assert_equal(["Ann", "Bob", "Cy"], names.call(Member.where { [email].include?(email) }))
      assert_equal(["Bob", "Cy"], names.call(Member.where { (admin ? name : email) != e }))
      # An `if` as a condition: its NULL is false, as Quarz's false.
      assert_equal(["Ann"], names.call(Member.where { admin ? false : email == e }))
      # `select`'s block runs in Quarz: false, not NULL, for Cy.
      assert_equal([true, false, false], repo.all(Member.order { name }.select { email == e }))
      # An ordering comparison of a nullable column, past the nil test.
      repo.insert(Note.new(body: "old", seen: Time.utc(2020, 1, 1)))
      repo.insert(Note.new(body: "new", seen: Time.utc(2026, 1, 1)))
      repo.insert(Note.new(body: "never"))
      t = Time.utc(2025, 1, 1)
      assert_equal(["new"], repo.all(Note.where { !seen.nil? && Rotor::SQL.not_nil(seen) > t }).map { |n| n.body })
      # `Rotor::Compare`: the plain form, NULL rows left out as in Quarz.
      assert_equal(["new"], repo.all(Note.where { seen > t }).map { |n| n.body })
      assert_equal(["never", "old"], repo.all(Note.where { seen.nil? || !(seen > t) }.order { body }).map { |n| n.body })
      # `select` runs it in Quarz: false, not NULL, for "never".
      assert_equal([false, true, false], repo.all(Note.order { body }.select { seen > t }))
      assert_equal(["never", "old"], repo.all(Note.where { seen.nil? || Rotor::SQL.not_nil(seen) < t }.order { body }).map { |n| n.body })
    end
  end

  def test_update_and_touch
    with_repo do |repo|
      m = repo.insert(member("Ann"))
      stamp = m.updated_at
      # Nothing changed: no UPDATE, the time stays.
      assert_equal(stamp, repo.update(m).updated_at)
      changed = m.with(age: 31)
      m = repo.update(changed)
      assert(!m.changed?)
      assert(m.updated_at >= stamp)
      # The model given is left as it was.
      assert_equal([:age], changed.changed)
      assert_equal(stamp, changed.updated_at)
      g = repo.get(Member, m.id).as(Member)
      assert_equal(31, g.age)
      assert_equal(m.updated_at, g.updated_at)
      # `touch` writes the update time alone; other assignments stay.
      m = repo.touch(m.with(name: "Pending"))
      assert_equal([:name], m.changed)
      g = repo.get(Member, m.id).as(Member)
      assert_equal("Ann", g.name)
      assert_equal(m.updated_at, g.updated_at)
    end
  end

  def test_failed_saves_leave_the_model_as_it_was
    with_repo do |repo|
      m = repo.insert(member("Ann"))
      a = repo.get(Member, m.id).as(Member).with(id: 2)
      e = assert_raise(ArgumentError) { repo.touch(a) }
      assert_match(/the primary key, was assigned/, e.message)
      assert_equal([:id], a.changed)
      # A statement the server refuses: the model given is as it was.
      n = member("Dup").with(id: m.id)
      assert_raise(PG::ServerError) { repo.insert(n) }
      assert_equal([:name, :age, :id], n.changed)
      assert_nil(n.to_h[:created_at]?)
      s = repo.insert(Note.new(body: "x")).with(body: "y")
      assert_raise(ArgumentError) { repo.touch(s, :seen, :id) }
      assert_equal([:body], s.changed)
      assert_nil(s.seen)
    end
  end

  def test_deletes_and_bulk_updates
    with_repo do |repo|
      ["Ann", "Bob", "Cy"].each { |n| repo.insert(member(n)) }
      assert_equal(2, repo.update_all(Member.where { name != "Cy" }) { {age: age + 1} })
      assert_equal([31, 31, 30], repo.all(Member.order { id }.select { age }))
      assert_equal(1, repo.update_all(Member.where { name == "Cy" }) { |_m| {age: 2000000000 * 2} })
      assert_equal([31, 31, 4000000000], repo.all(Member.order { id }.select { age }))
      assert_equal(1, repo.update_all(Member.where { name == "Cy" }) { |_m| {age: 30} })
      # A column of another class is refused (PostgreSQL would write 31
      # as "31", round 1.5 into 2); an `Int` into a `Float` is a `Float`.
      assert_raise(ArgumentError) { repo.update_all(Member.query) { {name: age} } }
      assert_raise(ArgumentError) { repo.update_all(Member.query) { {age: score + 1.5} } }
      # (A `Bool` or a `String`: no SQL type holds both.)
      assert_raise(Rotor::UntranslatableError) { repo.update_all(Member.query) { {name: admin && name} } }
      assert_equal(3, repo.update_all(Member.query) { {score: age} })
      assert_equal([31.0, 31.0, 30.0], repo.all(Member.order { id }.select { score }))
      m = repo.get(Member, 1).as(Member)
      assert_equal(m, repo.delete(m))
      e = assert_raise(Rotor::StaleError) { repo.delete(m) }
      assert_equal("Member id: 1: its row no longer exists", e.message)
      assert_raise(Rotor::StaleError) { repo.update(m.with(age: 1)) }
      assert_raise(Rotor::StaleError) { repo.touch(m) }
      assert_equal(1, repo.delete_all(Member.where { name == "Bob" }))
      assert_equal(["Cy"], repo.all(Member.query.select { name }))
    end
  end

  def test_transactions
    with_repo do |repo|
      n = repo.transaction do |tx|
        tx.insert(member("Kept"))
        tx.count(Member.query)
      end
      assert_equal(1, n)
      assert_raise(RuntimeError) do
        repo.transaction do |tx|
          tx.insert(member("Gone"))
          raise "undo"
        end
      end
      assert_equal(["Kept"], repo.all(Member.query.select { name }))
    end
  end

  def test_raw_sql
    with_repo do |repo|
      repo.insert(member("Ann", 40))
      assert_equal(1, repo.exec("UPDATE members SET age = age + $1", [2]))
      ms = repo.query(Member, "SELECT * FROM members WHERE age > $1", [41])
      assert_equal([42], ms.map { |m| m.age })
      # Columns the result does not give are not loaded.
      part = repo.query(Member, "SELECT id, name FROM members")
      assert_equal("Ann", part[0].name)
      assert_raise(Rotor::NotLoadedError) { part[0].age }
      briefs = repo.query("SELECT id, name FROM members") { |r| Brief.new(r.int(0), r.string(1)) }
      assert_equal([Brief.new(1, "Ann")], briefs)
    end
  end

  def test_over_a_pool
    omit_if(url.empty?, "no server")
    PG::Pool.open(url, size: 2) do |pool|
      repo = Rotor::Repo.new(pool: pool)
      repo.exec("TRUNCATE members RESTART IDENTITY")
      repo.insert(member("Pooled"))
      assert_equal(["Pooled"], repo.all(Member.query.select { name }))
      repo.transaction { |tx| tx.update_all(Member.query) { |m| {age: 1} } }
      assert_equal([1], repo.all(Member.query.select { age }))
    end
  end

  def test_preload_has_many_and_belongs_to
    with_repo do |repo|
      library(repo)
      authors = repo.all(Author.order { id })
      r, c = counting(repo)
      loaded = r.preload(authors) { volumes }
      assert_equal(1, c.count)
      assert_equal([["a", "b"], Array[String].new, ["c"]], loaded.map { |w| w.volumes.map { |b| b.title } })
      assert(!authors[0].volumes.loaded?)
      # Already preloaded: not loaded again.
      again = r.preload(loaded) { volumes }
      assert_equal(1, c.count)
      assert_equal(2, again[0].volumes.size)
      volumes = repo.all(Volume.order { id })
      with_writers = r.preload(volumes) { author }
      assert_equal(2, c.count)
      assert_equal(Array[String?].new + ["Ann", "Ann", "Cy", nil], with_writers.map { |b| b.author&.name })
      one = r.preload(volumes[2]) { [author, remarks] }
      assert_equal(4, c.count)
      assert_equal("Cy", one.author&.name)
      assert_equal([4], one.remarks.map { |v| v.stars })
    end
  end

  def test_nested_preload_and_a_query_option
    with_repo do |repo|
      library(repo)
      r, c = counting(repo)
      authors = r.all(Author.order { id }.preload { nest(volumes) { [remarks, author] } })
      # The authors, their volumes, the volumes' remarks and authors.
      assert_equal(4, c.count)
      assert_equal([[[5, 3], Array[Int].new], Array[Array[Int]].new, [[4]]], authors.map { |w| w.volumes.map { |b| b.remarks.map { |v| v.stars } } })
      assert_equal("Ann", authors[0].volumes.first&.author&.name)
      rs = r.all(Remark.order { id }.preload { nest(volume) { author } })
      assert_equal(Array[String?].new + ["Ann", "Ann", "Cy"], rs.map { |v| v.volume&.author&.name })
      # Named twice, one preload: the nested one kept.
      both = r.preload(authors) { [nest(volumes) { remarks }, volumes] }
      assert(both[0].volumes.first&.remarks&.loaded? == true)
      # Children in the order of their key, whatever the table's.
      r.update(Volume.load({id: 1, title: "a"}).with(title: "a2"))
      again = r.preload(r.all(Author.order { id })) { volumes }
      assert_equal(["a2", "b"], again[0].volumes.map { |b| b.title })
      # The association's query, run.
      assert_equal(["a2", "b"], r.all(authors[0].volumes.query.order { title }).map { |b| b.title })
      assert_equal(["b"], r.all(authors[0].volumes.query.where { title == "b" }).map { |b| b.title })
    end
  end

  def test_joins
    with_repo do |repo|
      library(repo)
      r, c = counting(repo)
      # A `for` over two queries: one statement.
      pairs = r.all(for a in Author.order { id }, v in Volume.order { id } when v.author_id == a.id do "#{a.name}:#{v.title}" end)
      assert_equal(1, c.count)
      assert_equal(["Ann:a", "Ann:b", "Cy:c"], pairs)
      # Through an association, with a condition, as models.
      rows = r.all(for a in Author.order { id }, v in a.volumes.query when v.title != "b" do [a, v] end)
      assert_equal([["Ann", "a"], ["Cy", "c"]], rows.map { |x| [x[0].name, x[1].title] })
      # Three tables.
      stars = r.all(for a in Author.order { id }, v in a.volumes.query.order { id }, m in v.remarks.query.order { id } do [a.name, m.stars] end)
      assert_equal([["Ann", 5], ["Ann", 3], ["Cy", 4]], stars)
      # The explicit forms, pairs of models.
      joined = r.all(Author.query.join { volumes }.order { |a, v| v.id })
      assert_equal([["Ann", "a"], ["Ann", "b"], ["Cy", "c"]], joined.map { |x| [x[0].name, x[1].title] })
      named = r.all(Author.query.join { volumes }.where { |a, v| v.title != "a" }.order { |a, v| v.id }.select { |a, v| "#{a.name}/#{v.title}" })
      assert_equal(["Ann/b", "Cy/c"], named)
      by = r.all(Volume.query.join(Author) { |v, a| v.author_id == a.id && a.name == "Cy" })
      assert_equal([["c", "Cy"]], by.map { |x| [x[0].title, x[1].name] })
      assert_equal(3, r.count(Author.query.join { volumes }))
      assert_equal(2, r.all(for a in Author.query, v in a.volumes.query do v.id end.limit(2)).size)
    end
  end

  # Volumes 1 "a" (genres 2 "y", then 1 "x", the pair 1-1 twice), 2 "b"
  # (none), 3 "c" (genre 1 "x").
  def shelves(repo: Rotor::Repo) -> Void
    library(repo)
    ["x", "y", "z"].each { |n| repo.insert(Genre.new(name: n)) }
    [[1, 2, 0], [1, 1, 1], [1, 1, 2], [3, 1, 0]].each { |p| repo.insert(VolumeGenre.new(volume_id: p[0], genre_id: p[1], position: p[2])) }
  end

  def test_has_many_through
    with_repo do |repo|
      shelves(repo)
      vs = repo.all(Volume.order { id }.limit(3))
      # Each genre once, however many join rows pair them, in the order
      # of its key.
      assert_equal(["x", "y"], repo.all(vs[0].genres.query.order { id }).map { |g| g.name })
      assert_equal(["y"], repo.all(vs[0].genres.query.where { name > "x" }).map { |g| g.name })
      r, c = counting(repo)
      loaded = r.preload(vs) { genres }
      assert_equal(1, c.count)
      assert_equal([["x", "y"], Array[String].new, ["x"]], loaded.map { |v| v.genres.map { |g| g.name } })
      # The join rows are a model's: written as any, seen by a fresh
      # preload.
      repo.insert(VolumeGenre.new(volume_id: 2, genre_id: 3))
      repo.delete_all(VolumeGenre.where { volume_id == 1 && genre_id == 2 })
      again = repo.preload(vs) { genres }
      assert_equal([["x"], ["z"], ["x"]], again.map { |v| v.genres.map { |g| g.name } })
      assert_equal([1, 2], repo.all(VolumeGenre.where { volume_id == 1 }.order { position }).map { |j| j.position })
      # Nested, as any level.
      authors = r.preload(repo.all(Author.order { id })) { nest(volumes) { genres } }
      assert_equal(3, c.count)
      assert_equal([["x"], ["z"]], authors[0].volumes.map { |v| v.genres.map { |g| g.name } })
      assert_equal([["x"]], authors[2].volumes.map { |v| v.genres.map { |g| g.name } })
    end
  end

  # `nest` inside `nest`, at any depth: one query per association and
  # level.
  def test_nested_nests
    with_repo do |repo|
      shelves(repo)
      r, c = counting(repo)
      authors = r.preload(repo.all(Author.order { id })) { nest(volumes) { nest(remarks) { volume } } }
      assert_equal([
        "SELECT \"id\", \"title\", \"author_id\" FROM \"volumes\" WHERE \"author_id\" = ANY($1) ORDER BY \"id\"",
        "SELECT \"id\", \"stars\", \"volume_id\" FROM \"remarks\" WHERE \"volume_id\" = ANY($1) ORDER BY \"id\"",
        "SELECT \"id\", \"title\", \"author_id\" FROM \"volumes\" WHERE \"id\" = ANY($1) ORDER BY \"id\"",
      ], c.sqls)
      assert_equal([["a", "a"], Array[String].new], authors[0].volumes.map { |v| v.remarks.map { |x| x.volume.as(Volume).title } })
      assert_equal([5, 3], authors[0].volumes.to_a[0].remarks.map { |x| x.stars })
      # Through a `through` association, and back.
      r, c = counting(repo)
      authors = r.preload(repo.all(Author.order { id })) { [nest(volumes) { nest(genres) { volumes } }, volumes] }
      assert_equal(3, c.count)
      assert_equal("SELECT \"g0\".\"id\", \"g0\".\"name\", \"v1\".\"volume_id\" FROM \"genres\" AS \"g0\" INNER JOIN \"volume_genres\" AS \"v1\" ON \"v1\".\"genre_id\" = \"g0\".\"id\" WHERE \"v1\".\"volume_id\" = ANY($1) ORDER BY \"g0\".\"id\"", c.sqls[1])
      assert_equal("SELECT \"v0\".\"id\", \"v0\".\"title\", \"v0\".\"author_id\", \"v1\".\"genre_id\" FROM \"volumes\" AS \"v0\" INNER JOIN \"volume_genres\" AS \"v1\" ON \"v1\".\"volume_id\" = \"v0\".\"id\" WHERE \"v1\".\"genre_id\" = ANY($1) ORDER BY \"v0\".\"id\"", c.sqls[2])
      assert_equal([["x:a+c", "y:a"], Array[String].new], authors[0].volumes.map { |v| v.genres.map { |g| "#{g.name}:#{g.volumes.map { |w| w.title }.join("+")}" } })
      # Across both `nest`s (a `belongs_to`'s, a `has_many`'s), from
      # `Repo#preload`.
      rs = repo.preload(repo.all(Remark.order { id })) { nest(volume) { nest(genres) { volumes } } }
      assert_equal(["x:a+c,y:a", "x:a+c,y:a", "x:a+c"], rs.map { |x| x.volume.as(Volume).genres.map { |g| "#{g.name}:#{g.volumes.map { |w| w.title }.join("+")}" }.join(",") })
      # Four levels.
      r, c = counting(repo)
      deep = r.preload(repo.all(Author.order { id })) { nest(volumes) { nest(genres) { nest(volumes) { remarks } } } }
      assert_equal(4, c.count)
      assert_equal([5, 3], deep[0].volumes.to_a[0].genres.to_a[0].volumes.to_a[0].remarks.map { |x| x.stars })
    end
  end

  def test_nested_nests_refused_naming_the_level
    e = assert_raise(Rotor::UntranslatableError) { Author.query.preload { nest(volumes) { nest(remarks) { stars } } } }
    assert_match(/`stars` is not an association of Remark/, e.message)
    # (A name of an outer level's model, which Quarz finds there: not
    # this level's.)
    e = assert_raise(Rotor::UntranslatableError) { Author.query.preload { nest(volumes) { nest(remarks) { volumes } } } }
    assert_match(/`volumes` is not an association of Remark/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Remark.query.preload { nest(volume) { nest(author) { stars } } } }
    assert_match(/`stars` is not an association of Author/, e.message)
    e = assert_raise(Rotor::UntranslatableError) { Author.query.preload { nest(volumes) { nest(remarks) { volume.nil? } } } }
    assert_match(/\Aa preload names associations of the model/, e.message)
  end
end
