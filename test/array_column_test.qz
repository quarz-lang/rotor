require "test"

# Array columns (rotor#66): `text[]` and `bigint[]`, elements non-null
# unless declared `T?`.
class Tagged < Rotor::Model
  table "tagged" do
    column :id, Int, primary: true
    column :tags, Array[String]
    column :scores, Array[Int?], null: true
  end
end

class ArrayColumnTextTest < Test::Case
  def test_columns
    assert_equal(["bigint", "text[]", "bigint[]"], Tagged.columns.map { |c| c.sql })
    tags = Tagged.columns[1]
    assert(tags.element == String && !tags.nils)
    scores = Tagged.columns[2]
    assert(scores.element == Int && scores.nils && scores.null)
  end

  def test_values
    t = Tagged.new(tags: ["a", "b"])
    expected: Array[String] = ["a", "b"]
    assert_equal(expected, t.tags)
    assert_nil(t.scores)
    s = t.with(scores: [1, nil])
    ints: Array[Int?] = [1, nil]
    assert_equal(ints, s.scores)
    sql, params = Rotor::Statement.insert(s).to_sql
    assert_equal("INSERT INTO \"tagged\" (\"tags\", \"scores\") VALUES ($1, $2)", sql)
    assert_equal(2, params.size)
    # A loaded row is checked by the column's element.
    e = assert_raise(ArgumentError) { Tagged.load({id: 1, tags: ["a", nil], scores: nil}) }
    assert_match(/Tagged#tags takes an Array of String, not/, e.message)
  end

  def test_query_blocks
    # Not yet translated (element tests are a later issue): refused.
    xs = ["a"]
    e = assert_raise(Rotor::UntranslatableError) { Tagged.where { |t| t.tags == xs } }
    assert_match(/cannot be translated to SQL/, e.message)
  end

  def test_schema
    models: Array[Type[Rotor::Model]] = [Tagged]
    sql = Rotor::Schema.operations(models).flat_map { |op| Rotor::Migrator.render(op) }
    assert_equal(["CREATE TABLE \"tagged\" (\"id\" bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, \"tags\" text[] NOT NULL, \"scores\" bigint[])"], sql)
  end

  def test_wrong_types_do_not_compile
    # (Checked by `quarz` on the PATH, or by $QUARZ.)
    out = Process.sh("cd test/fixtures/array_wrong_type && exec \"${QUARZ:-quarz}\" check")
    assert(!out.success?)
    assert_match(/main\.qz:9:\d+: error/, out.stderr)
    assert_match(/main\.qz:10:\d+: error/, out.stderr)
    assert_match(/main\.qz:11:\d+: error/, out.stderr)
    refute_match(/main\.qz:1[23]:\d+: error/, out.stderr)
  end
end

# Against a real server.
class ArrayColumnTest < Test::Case
  SERVER = Atom[PG::Testing::Server | String].new("not started")

  def self.startup
    server = PG::Testing.start_or_reason
    if server.is_a?(PG::Testing::Server)
      c = PG.connect(server.url)
      begin
        # (Dropped first: PG_TEST_URL's server outlives a run.)
        c.exec("DROP TABLE IF EXISTS tagged")
        models: Array[Type[Rotor::Model]] = [Tagged]
        Rotor::Schema.create(Rotor::Repo.new(connection: c), models)
      ensure
        c.close
      end
    end
    SERVER.set(server)
  end

  def self.shutdown
    case SERVER.get
    in PG::Testing::Server => s then s.stop
    else nil
    end
  end

  def url -> String
    case SERVER.get
    in PG::Testing::Server => s then s.url
    in String => why then omit(why)
    end
  end

  def test_round_trip
    c = PG.connect(url)
    begin
      repo = Rotor::Repo.new(connection: c)
      c.exec("TRUNCATE tagged RESTART IDENTITY")
      t = repo.insert(Tagged.new(tags: ["a", "b c", ""], scores: [3, nil]))
      got = repo.get(Tagged, t.id) || raise "not found"
      tags: Array[String] = ["a", "b c", ""]
      scores: Array[Int?] = [3, nil]
      assert_equal(tags, got.tags)
      assert_equal(scores, got.scores)
      u = repo.update(got.with(tags: Array[String].new, scores: nil))
      again = repo.get(Tagged, u.id) || raise "not found"
      assert_equal(Array[String].new, again.tags)
      assert_nil(again.scores)
      # A NULL element in a column whose elements are not nilable.
      c.exec("UPDATE tagged SET tags = ARRAY['x', NULL]")
      e = assert_raise(ArgumentError) { repo.get(Tagged, t.id) }
      assert_equal("column `tags` holds a NULL element: declare it Array[String?]", e.message)
    ensure
      c.close
    end
  end
end
