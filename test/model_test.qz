require "test"
require_relative "models/library"

class User < Rotor::Model
  table "users" do
    column :id, Int, primary: true
    column :name, String
    column :email, String, null: true
    column :age, Int, default: 0
    column :score, Float, null: true
    column :admin, Bool, default: false
    column :avatar, Bytes, null: true
    column :born, Time, null: true
    timestamps
    belongs_to Account
    has_many Post
  end
end

class Account < Rotor::Model
  table do
    column :id, Int, primary: true
    has_many User
  end
end

class Post < Rotor::Model
  table do
    column :id, Int, primary: true
    belongs_to User
  end
end

class BlogPost < Rotor::Model
  table do
    column :id, Int, primary: true
    column :title, String, default: "untitled"
    timestamps updated_at: false, created_at: :posted_at
    belongs_to User, name: :author, foreign_key: :user_id, null: true
  end
end

class Category < Rotor::Model
  table do
    column :name, String
  end
end

class Bare < Rotor::Model
end

class Book < Rotor::Model
  table do
    column :id, Int, primary: true
    belongs_to Shelf
  end
end

# A class between a model and Rotor::Model, without a table.
class Record < Rotor::Model
  def label -> String = "record #{table_info.name}"
end

class Admin < Record
  table "admins" do
    column :id, Int, primary: true
    column :email, String
    column :level, Int, default: 1
  end
end

# Inherits `User`'s table: refused at its first use.
class Guest < User
end

class ModelTest < Test::Case
  def test_typed_accessors
    u = User.new.with(name: "Ann")
    assert_equal("Ann", u.name)
    assert_nil(u.email)
    v = u.with(email: "ann@example.com")
    assert_equal("ann@example.com", v.email)
    assert_nil(u.email)
    # A nullable column given nil is set to NULL; one left out keeps.
    w = v.with(email: nil, age: 41)
    assert_nil(w.email)
    assert_equal(41, w.age)
    assert_equal(0, u.age)
    assert_equal(false, u.admin)
    t = Time.utc(2026, 11, 3, 12, 0, 0)
    x = u.with(score: 1.5, avatar: b"\x01", born: t, account_id: 7)
    assert_equal(1.5, x.score)
    assert_equal(b"\x01", x.avatar)
    assert_equal(t, x.born)
    assert_equal(7, x.account_id)
    assert_equal("Ann", x.name)
  end

  def test_unset_column
    e = assert_raise(Rotor::MissingAttributeError) { User.new.name }
    assert_equal("User#name is not set", e.message)
  end

  def test_change_tracking
    u = User.new
    assert(!u.changed?)
    v = u.with(name: "Ann", age: 3).with(name: "Bob")
    assert_equal([:name, :age], v.changed)
    assert(v.changed?)
    assert(!u.changed?)
    assert(v.clear_changes.changed.empty?)
    assert_equal("Bob", v.clear_changes.name)
  end

  def test_models_are_shareable
    u = User.load({id: 1, name: "Ann"})
    # Read in another task, through a channel, held by an atom.
    assert_equal("Ann", Task.spawn { u.name }.await)
    ch = Channel[User].new(1)
    Task.spawn { ch.send(User.load({id: 2, name: "Bob"})) }.await
    assert_equal("Bob", ch.receive.name)
    a = Atom[User].new(u)
    a.update { |m| m.with(age: 5) }
    assert_equal(5, a.get.age)
    assert_equal(0, u.age)
  end

  def test_with_refuses_a_wrong_type_at_compile_time
    # (Checked by `quarz` on the PATH, or by $QUARZ.)
    out = Process.sh("cd test/fixtures/with_wrong_type && exec \"${QUARZ:-quarz}\" check")
    assert(!out.success?)
    assert_match(/argument `name` of with\(.*\) -> Pen expects String but found Int/, out.stderr)
    assert_match(/argument `name` of with\(.*\) -> Pen expects String but found Nil/, out.stderr)
    assert_match(/has no parameter `colour`/, out.stderr)
    # `note: nil` (line 12), a nullable column's NULL, is not refused.
    refute_match(/main\.qz:12:/, out.stderr)
  end

  def test_metadata
    assert_equal("users", User.table_name)
    assert_equal(:id, User.primary_key)
    assert_equal(
      [:id, :name, :email, :age, :score, :admin, :avatar, :born, :created_at, :updated_at, :account_id],
      User.columns.map { |c| c.name }
    )
    email = User.find_column(:email)
    assert_equal(Rotor::Column.new(:email, "text", String, true, false, nil), email)
    assert_equal(Rotor::Column.new(:age, "bigint", Int, false, false, 0), User.find_column(:age))
    assert_equal(Rotor::Column.new(:created_at, "timestamptz", Time, false, false, nil), User.find_column(:created_at))
    assert_nil(User.find_column(:nope))
    assert_equal(
      [
        Rotor::Association.new(:belongs_to, :account, Account, :account_id),
        Rotor::Association.new(:has_many, :posts, Post, :user_id),
      ],
      User.associations
    )
  end

  def test_default_names
    assert_equal("blog_posts", BlogPost.table_name)
    assert_equal("categories", Category.table_name)
    assert_nil(Category.primary_key)
    assert_equal([:id, :title, :posted_at, :user_id], BlogPost.columns.map { |c| c.name })
    assert_equal(Rotor::Association.new(:belongs_to, :author, User, :user_id), BlogPost.associations[0])
    p = BlogPost.new
    assert_equal("untitled", p.title)
    assert_nil(p.user_id)
  end

  def test_load_and_to_h
    u = User.load({id: 1, name: "Ann", email: nil})
    assert_equal(1, u.id)
    assert_equal("Ann", u.name)
    assert_nil(u.email)
    assert(!u.changed?)
    h: Hash[Symbol, Object?] = {age: 0, admin: false, id: 1, name: "Ann", email: nil}
    assert_equal(h, u.to_h)
    e = assert_raise(ArgumentError) { User.load({nope: 1}) }
    assert_equal("User has no column `nope`", e.message)
    e = assert_raise(ArgumentError) { User.load({name: 1}) }
    assert_equal("User#name takes String, not Int", e.message)
    e = assert_raise(ArgumentError) { User.load({name: nil}) }
    assert_equal("User#name cannot be nil", e.message)
  end

  def test_associations_both_ways
    # In one file: `User has_many Post`, `Post belongs_to User`.
    assert_equal([Rotor::Association.new(:belongs_to, :user, User, :user_id)], Post.associations)
    assert_equal([Rotor::Association.new(:has_many, :users, User, :account_id)], Account.associations)
    assert_equal([:id, :user_id], Post.columns.map { |c| c.name })
    # Across two files (models/library.qz): `Shelf has_many Book` there,
    # `Book belongs_to Shelf` here, each naming the other's class.
    assert_equal([Rotor::Association.new(:has_many, :books, Book, :shelf_id)], Shelf.associations)
    assert_equal([Rotor::Association.new(:belongs_to, :shelf, Shelf, :shelf_id)], Book.associations)
    b = Book.new.with(shelf_id: 3)
    assert_equal(3, b.shelf_id)
    assert(Book.associations[0].target == Shelf)
  end

  def test_a_model_under_a_class_without_a_table
    a = Admin.new
    assert_equal(1, a.level)
    assert_equal("record admins", a.label)
    b: Admin = a.with(id: 1, email: "a@example.com", level: 2)
    assert_equal(2, b.level)
    assert_equal("Admin", b.class.name)
    e = assert_raise(ArgumentError) { a.with_values({name: "x"}) }
    assert_equal("Admin has no column `name`", e.message)
    e = assert_raise(ArgumentError) { a.with_values({email: nil}) }
    assert_equal("Admin#email cannot be nil", e.message)
    assert(!a.changed?)
  end

  def test_a_subclass_that_inherits_a_table
    message = "Guest has no table; a model declares its own; single-table inheritance is not provided"
    e = assert_raise(Rotor::SchemaError) { Guest.new }
    assert_equal(message, e.message)
    e = assert_raise(Rotor::SchemaError) { Guest.load({id: 1, name: "x"}) }
    assert_equal(message, e.message)
    e = assert_raise(Rotor::SchemaError) { Guest.table_name }
    assert_equal(message, e.message)
    e = assert_raise(Rotor::SchemaError) { Guest.where { name == "x" } }
    assert_equal(message, e.message)
  end

  def test_a_model_of_a_model_does_not_compile
    out = Process.sh("cd test/fixtures/model_of_model && exec \"${QUARZ:-quarz}\" check")
    assert(!out.success?)
    assert_match(/Pencil subclasses a model with a table: a model's superclass is Rotor::Model or a class without a `table`/, out.stderr)
  end

  def test_columns_cross_tasks
    assert_equal(User.columns, Task.spawn { User.columns }.await)
  end

  def test_a_model_without_a_table
    e = assert_raise(Rotor::SchemaError) { Bare.new }
    assert_equal("Bare has no schema: declare its columns in a `table do ... end` block in its class body", e.message)
    e = assert_raise(Rotor::SchemaError) { Bare.columns }
    assert_equal("Bare has no schema: declare its columns in a `table do ... end` block in its class body", e.message)
  end
end
