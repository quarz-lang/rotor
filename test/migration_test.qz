require "test"

# Every operation of the DSL, for the SQL they render.
class EveryOp < Rotor::Migration
  version 1

  def change
    create_table :m_users do |t|
      t.column :email, String
      t.column :name, String, null: true
      t.column :age, Int, default: 0
      t.column :score, Float, default: 1.5
      t.column :admin, Bool, default: false
      t.column :avatar, Bytes, null: true, default: Bytes[0xDE, 0xAD]
      t.column :seen, Time, default: Rotor::SQL.raw("now()")
      t.column :price, sql: "numeric(12,2)", null: true
      t.timestamps
    end
    create_table :m_posts, primary_key: :pid, if_not_exists: true do |t|
      t.references :m_user, to_table: :m_users, on_delete: :cascade
      t.column :title, String, default: "it's"
      t.index [:title], unique: true, where: "title <> ''"
    end
    create_table :m_tags, primary_key: false do |t|
      t.column :code, String, primary: true
    end
    rename_table :m_tags, :m_labels
    add_column :m_posts, :views, Int, default: 0
    add_column :m_posts, :ratio, sql: "real", null: true
    rename_column :m_posts, :title, :heading
    change_column :m_posts, :views, null: true, default: Rotor::Migration::NO_DEFAULT, from: Rotor::Was.new(null: false, default: 0)
    add_reference :m_posts, :editor, to_table: :m_users, null: true, on_delete: :set_null
    create_index :m_posts, [:views, :ratio], name: :m_posts_by_views
    execute "UPDATE m_posts SET views = 1", down: "UPDATE m_posts SET views = 0"
  end
end

class TextTest < Test::Case
  def rendered(direction: Symbol) -> Array[String] = EveryOp.plan(direction).flat_map { |op| Rotor::Migrator.render(op) }

  def test_up
    assert_equal([
      "CREATE TABLE \"m_users\" (\"id\" bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, \"email\" text NOT NULL, \"name\" text, \"age\" bigint NOT NULL DEFAULT 0, " +
        "\"score\" double precision NOT NULL DEFAULT 1.5, \"admin\" boolean NOT NULL DEFAULT FALSE, \"avatar\" bytea DEFAULT '\\xdead'::bytea, " +
        "\"seen\" timestamptz NOT NULL DEFAULT now(), \"price\" numeric(12,2), \"created_at\" timestamptz NOT NULL, \"updated_at\" timestamptz NOT NULL)",
      "CREATE TABLE IF NOT EXISTS \"m_posts\" (\"pid\" bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
        "\"m_user_id\" bigint NOT NULL REFERENCES \"m_users\" (\"id\") ON DELETE CASCADE, \"title\" text NOT NULL DEFAULT 'it''s')",
      "CREATE INDEX IF NOT EXISTS \"m_posts_m_user_id_index\" ON \"m_posts\" (\"m_user_id\")",
      "CREATE UNIQUE INDEX IF NOT EXISTS \"m_posts_title_index\" ON \"m_posts\" (\"title\") WHERE title <> ''",
      "CREATE TABLE \"m_tags\" (\"code\" text PRIMARY KEY)",
      "ALTER TABLE \"m_tags\" RENAME TO \"m_labels\"",
      "ALTER TABLE \"m_posts\" ADD COLUMN \"views\" bigint NOT NULL DEFAULT 0",
      "ALTER TABLE \"m_posts\" ADD COLUMN \"ratio\" real",
      "ALTER TABLE \"m_posts\" RENAME COLUMN \"title\" TO \"heading\"",
      "ALTER TABLE \"m_posts\" ALTER COLUMN \"views\" DROP NOT NULL, ALTER COLUMN \"views\" DROP DEFAULT",
      "ALTER TABLE \"m_posts\" ADD COLUMN \"editor_id\" bigint REFERENCES \"m_users\" (\"id\") ON DELETE SET NULL",
      "CREATE INDEX \"m_posts_editor_id_index\" ON \"m_posts\" (\"editor_id\")",
      "CREATE INDEX \"m_posts_by_views\" ON \"m_posts\" (\"views\", \"ratio\")",
      "UPDATE m_posts SET views = 1",
    ], rendered(:up))
  end

  def test_down_reverses_in_reverse_order
    assert_equal([
      "UPDATE m_posts SET views = 0",
      "DROP INDEX \"m_posts_by_views\"",
      "DROP INDEX \"m_posts_editor_id_index\"",
      "ALTER TABLE \"m_posts\" DROP COLUMN \"editor_id\"",
      "ALTER TABLE \"m_posts\" ALTER COLUMN \"views\" SET NOT NULL, ALTER COLUMN \"views\" SET DEFAULT 0",
      "ALTER TABLE \"m_posts\" RENAME COLUMN \"heading\" TO \"title\"",
      "ALTER TABLE \"m_posts\" DROP COLUMN \"ratio\"",
      "ALTER TABLE \"m_posts\" DROP COLUMN \"views\"",
      "ALTER TABLE \"m_labels\" RENAME TO \"m_tags\"",
      "DROP TABLE \"m_tags\"",
      "DROP TABLE IF EXISTS \"m_posts\"",
      "DROP TABLE \"m_users\"",
    ], rendered(:down))
  end

  def test_literals
    assert_equal("'a''b\\c'", Rotor::Migrator.literal("a'b\\c"))
    assert_equal("-3", Rotor::Migrator.literal(-3))
    assert_equal("'NaN'::double precision", Rotor::Migrator.literal(0.0 / 0.0))
    assert_equal("'-Infinity'::double precision", Rotor::Migrator.literal(-1.0 / 0.0))
    assert_equal("TRUE", Rotor::Migrator.literal(true))
    assert_raise(ArgumentError) { Rotor::Migrator.literal("a\0b") }
  end

  def test_names
    assert_raise(ArgumentError) { Rotor::Columns.ident("") }
    assert_raise(ArgumentError) { Rotor::Columns.ident("a\0") }
    assert_raise(ArgumentError) { Rotor::Columns.ident("x" * 64) }
    assert_equal("x" * 63, Rotor::Columns.ident("x" * 63))
    assert_equal("q\"uote", Rotor::Columns.ident("q\"uote"))
    assert_equal(["ALTER TABLE \"q\"\"uote\" RENAME TO \"b\""], Rotor::Migrator.render(Rotor::Operation::RenameTable.new("q\"uote", "b")))
    e = assert_raise(ArgumentError) { Rotor::Columns.index("t" * 40, ["c" * 20], nil, false, nil, false) }
    assert_match(/give `name:`/, e.message)
    assert_raise(ArgumentError) { Rotor::Columns.reference(:user, nil, :delete_all, false) }
    assert_raise(ArgumentError) { Rotor::Columns.type_name("int; DROP TABLE x") }
  end

  def test_change_column_must_change_something
    e = assert_raise(ArgumentError) { NoChange.plan(:up) }
    assert_match(/changes nothing/, e.message)
  end
end

class NoChange < Rotor::Migration
  version 2
  def change
    change_column :t, :c
  end
end

# The operations `change` cannot reverse, one each.
class DropBare < Rotor::Migration
  version 3
  def change
    drop_table :t
  end
end

class RemoveBare < Rotor::Migration
  version 4
  def change
    remove_column :t, :c
  end
end

class ExecuteBare < Rotor::Migration
  version 5
  def change
    execute "SELECT 1"
  end
end

class ChangeBare < Rotor::Migration
  version 6
  def change
    change_column :t, :c, null: true
  end
end

class ChangeHalf < Rotor::Migration
  version 7
  def change
    change_column :t, :c, null: true, default: 1, from: Rotor::Was.new(null: false)
  end
end

class DropIndexBare < Rotor::Migration
  version 8
  def change
    drop_index :t, name: :t_c_index
  end
end

# The reversible forms of the same.
class Reversibles < Rotor::Migration
  version 9
  def change
    drop_table :t do |t|
      t.column :c, String
    end
    remove_column :u, :c, Int, default: 2
    remove_column :u, :d, sql: "numeric", null: true
    drop_index :u, columns: [:c], unique: true
    remove_reference :u, :user
  end
end

class ShapeTest < Test::Case
  def test_version_checks_the_class_at_compile_time
    # (Checked by `quarz` on the PATH, or by $QUARZ.)
    out = Process.sh("cd test/fixtures/migration_shape && exec \"${QUARZ:-quarz}\" check")
    assert(!out.success?)
    assert_match(/main\.qz:2:3: error: `version` raised ArgumentError: Both defines `change` and `up`\/`down`/, out.stderr)
    assert_match(/main\.qz:12:3: error: `version` raised ArgumentError: UpAlone defines neither `change` nor `up` and `down`/, out.stderr)
    assert_match(/main\.qz:19:3: error: `version` raised ArgumentError: Zero's version must be positive, not 0/, out.stderr)
    refute_match(/main\.qz:2[5-9]:|main\.qz:3\d:/, out.stderr)
  end
end

# A primary key named twice, which `drop_table` refuses as
# `create_table` does.
class DropTwoKeys < Rotor::Migration
  version 10
  def change
    drop_table :zz, primary_key: :uid do |t|
      t.column :code, String, primary: true
    end
  end
end

# `if_exists: true` reverses with `IF NOT EXISTS`.
class DropIfExists < Rotor::Migration
  version 11
  def change
    drop_table :zz, if_exists: true do |t|
      t.column :c, String
      t.index [:c]
    end
  end
end

class ReversalTest < Test::Case
  def test_drop_table_if_exists_reverses_if_not_exists
    assert_equal(["DROP TABLE IF EXISTS \"zz\""], DropIfExists.plan(:up).flat_map { |op| Rotor::Migrator.render(op) })
    assert_equal(["CREATE TABLE IF NOT EXISTS \"zz\" (\"id\" bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, \"c\" text NOT NULL)",
                  "CREATE INDEX IF NOT EXISTS \"zz_c_index\" ON \"zz\" (\"c\")"], DropIfExists.plan(:down).flat_map { |op| Rotor::Migrator.render(op) })
  end

  def test_drop_table_checks_its_key
    e = assert_raise(ArgumentError) { DropTwoKeys.plan(:up) }
    assert_match(/names its key uid and declares a primary column/, e.message)
  end

  def test_irreversible
    [DropBare, RemoveBare, ExecuteBare, ChangeBare, ChangeHalf, DropIndexBare].each do |m|
      assert_equal(1, m.plan(:up).size)
      assert_raise(Rotor::IrreversibleMigration) { m.plan(:down) }
    end
    e = assert_raise(Rotor::IrreversibleMigration) { ExecuteBare.plan(:down) }
    assert_equal("execute \"SELECT 1\" cannot be reversed: give `down:`", e.message)
  end

  def test_reversible_forms
    assert_equal([
      "ALTER TABLE \"u\" ADD COLUMN \"user_id\" bigint NOT NULL REFERENCES \"users\" (\"id\")",
      "CREATE INDEX \"u_user_id_index\" ON \"u\" (\"user_id\")",
      "CREATE UNIQUE INDEX \"u_c_index\" ON \"u\" (\"c\")",
      "ALTER TABLE \"u\" ADD COLUMN \"d\" numeric",
      "ALTER TABLE \"u\" ADD COLUMN \"c\" bigint NOT NULL DEFAULT 2",
      "CREATE TABLE \"t\" (\"id\" bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, \"c\" text NOT NULL)",
    ], Reversibles.plan(:down).flat_map { |op| Rotor::Migrator.render(op) })
  end
end

# Migrations against a server, each on tables of its own.
class MkWidgets < Rotor::Migration
  version 20261101000000
  def change
    create_table :widgets do |t|
      t.column :name, String
      t.timestamps
    end
    create_index :widgets, [:name], unique: true
  end
end

class AddWidgetSize < Rotor::Migration
  version 20261102000000
  def change
    add_column :widgets, :size, Int, default: 1
  end
end

class MkGadgets < Rotor::Migration
  version 20261103000000
  def up
    execute "CREATE TABLE gadgets (id bigint PRIMARY KEY)"
  end

  def down
    execute "DROP TABLE gadgets"
  end
end

# Fails after a step that its transaction rolls back.
class Broken < Rotor::Migration
  version 20261104000000
  def change
    create_table :broken_half do |t|
      t.column :x, Int
    end
    execute "SELECT * FROM no_such_table"
  end
end

class ConcurrentIndex < Rotor::Migration
  version 20261105000000
  disable_transaction!
  def change
    create_index :widgets, [:size], concurrently: true
  end
end

# A data migration through `repo`, after the column it fills.
class FillSize < Rotor::Migration
  version 20261106000000
  def change
    add_column :widgets, :double, Int, null: true
    repo.exec("UPDATE widgets SET double = size * 2")
  end
end

# Leaves a transaction open, failed, without the migrator's.
class LeavesItOpen < Rotor::Migration
  version 20261108000000
  disable_transaction!
  def up
    execute "SET statement_timeout = 1234"
    execute "BEGIN"
    execute "SELECT 1 / 0"
  end

  def down
  end
end

# Sets a session setting and succeeds.
class SetsATimeout < Rotor::Migration
  version 20261108100000
  def up
    execute "SET statement_timeout = 4321"
  end

  def down
    execute "SELECT 1 / 0"
  end
end

# Opens a transaction it does not commit, and would succeed.
class Uncommitted < Rotor::Migration
  version 20261108300000
  disable_transaction!
  def up
    execute "BEGIN"
    execute "CREATE TABLE late (id int)"
  end

  def down
  end
end

# Fails part way, outside a transaction.
class HalfDone < Rotor::Migration
  version 20261108200000
  disable_transaction!
  def change
    create_table :broken_half do |t|
      t.column :x, Int
    end
    execute "SELECT * FROM no_such_table", down: "SELECT 1"
  end
end

# Late, older than those applied.
class Late < Rotor::Migration
  version 20261101120000
  def change
    execute "CREATE TABLE late (id int)", down: "DROP TABLE late"
  end
end

# Sleeps holding nothing but the migrator's lock.
class Slow < Rotor::Migration
  version 20261107000000
  def change
    execute "SELECT pg_sleep(0.5)", down: "SELECT 1"
  end
end

class SUserModel < Rotor::Model
  table "s_users" do
    column :id, Int, primary: true
    column :name, String, default: "anon"
    has_many SPostModel
  end
end

class SPostModel < Rotor::Model
  table "s_posts" do
    column :id, Int, primary: true
    column :title, String
    column :score, Float, null: true
    belongs_to SUserModel
  end
end

class MigratorTest < Test::Case
  SERVER = Atom[PG::Testing::Server | String].new("not started")
  TABLES = "widgets, gadgets, broken_half, late, s_posts, s_users, schema_migrations, other_migrations"

  # The advisory locks held on the server.
  def locks(repo: Rotor::Repo) -> Int = repo.query("SELECT count(*) FROM pg_locks WHERE locktype = 'advisory'") { |r| r.int(0) }[0]

  def self.startup
    SERVER.set(PG::Testing.start_or_reason)
  end

  def self.shutdown
    case SERVER.get
    in PG::Testing::Server => s then s.stop
    else nil
    end
  end

  def url -> String
    case SERVER.get
    in PG::Testing::Server => s then s.url
    in String => why then omit(why)
    end
  end

  # A repository over one connection, none of the tests' tables there.
  def with_repo(&: (Rotor::Repo) -> Void) -> Void
    c = PG.connect(url)
    begin
      c.exec("DROP TABLE IF EXISTS #{TABLES}")
      yield Rotor::Repo.new(connection: c)
    ensure
      c.close
    end
  end

  def tables(repo: Rotor::Repo) -> Array[String]
    repo.query("SELECT tablename FROM pg_tables WHERE schemaname = 'public' AND tablename IN ('widgets', 'gadgets', 'broken_half', 'late', 'other_migrations') ORDER BY 1") { |r| r.string(0) }
  end

  def columns(repo: Rotor::Repo, table: String) -> Array[String]
    repo.query("SELECT column_name FROM information_schema.columns WHERE table_name = $1 ORDER BY ordinal_position", [table]) { |r| r.string(0) }
  end

  def test_migrate_status_and_rollback
    with_repo do |repo|
      lines = Atom[Array[String]].new([])
      m = Rotor::Migrator.new(repo, [MkGadgets, AddWidgetSize, MkWidgets], log: ->(l: String) { lines.update { |xs| xs + [l] }; nil })
      assert_equal([], m.applied)
      assert_equal([20261101000000, 20261102000000, 20261103000000], m.pending)
      assert_equal([20261101000000, 20261102000000], m.migrate(to: 20261102000000))
      assert_equal(["id", "name", "created_at", "updated_at", "size"], columns(repo, "widgets"))
      assert_equal([[20261101000000, "MkWidgets", :up], [20261102000000, "AddWidgetSize", :up], [20261103000000, "MkGadgets", :pending]], m.status)
      assert_equal([20261103000000], m.migrate)
      assert_equal([], m.migrate)
      assert_equal(["gadgets", "widgets"], tables(repo))
      assert_equal("== 20261101000000 MkWidgets: migrating", lines.get[0])
      assert_match(/\A== 20261101000000 MkWidgets: migrated \(\d+\.\d+s\)\z/, lines.get[1])
      # Down.
      assert_equal([20261103000000], m.rollback)
      assert_equal(["widgets"], tables(repo))
      assert_equal([20261102000000], m.rollback(steps: 1))
      assert_equal(["id", "name", "created_at", "updated_at"], columns(repo, "widgets"))
      assert_equal([20261102000000, 20261103000000], m.pending)
      m.migrate
      assert_equal([20261103000000, 20261102000000], m.rollback(to: 20261101000000))
      assert_equal([20261101000000], m.applied)
      assert_equal([20261101000000], m.rollback(steps: 5))
      assert_equal([], tables(repo))
      assert_equal([], m.rollback)
    end
  end

  def test_a_failure_keeps_the_earlier_ones
    with_repo do |repo|
      m = Rotor::Migrator.new(repo, [MkWidgets, Broken])
      e = assert_raise(Rotor::MigrationError) { m.migrate }.as(Rotor::MigrationError)
      assert_equal(20261104000000, e.version)
      assert_equal("Broken", e.name)
      assert(e.cause.is_a?(PG::ServerError))
      assert_match(/\A20261104000000 Broken: PG::ServerError: .*no_such_table/, e.message)
      assert_equal([20261101000000], m.applied)
      assert_equal(["widgets"], tables(repo))
    end
  end

  def test_without_a_transaction
    with_repo do |repo|
      m = Rotor::Migrator.new(repo, [MkWidgets, AddWidgetSize, ConcurrentIndex])
      m.migrate
      found = repo.query("SELECT indexname FROM pg_indexes WHERE tablename = 'widgets' ORDER BY 1") { |r| r.string(0) }
      assert_equal(["widgets_name_index", "widgets_pkey", "widgets_size_index"], found)
      m.rollback
      found = repo.query("SELECT indexname FROM pg_indexes WHERE tablename = 'widgets' ORDER BY 1") { |r| r.string(0) }
      assert_equal(["widgets_name_index", "widgets_pkey"], found)
    end
  end

  def test_data_migration_through_repo
    with_repo do |repo|
      m = Rotor::Migrator.new(repo, [MkWidgets, AddWidgetSize, FillSize])
      m.migrate(to: 20261102000000)
      repo.exec("INSERT INTO widgets (name, size, created_at, updated_at) VALUES ('a', 3, now(), now())")
      m.migrate
      assert_equal([6], repo.query("SELECT double FROM widgets") { |r| r.int(0) })
      e = assert_raise(Rotor::MigrationError) { m.rollback }
      assert_match(/IrreversibleMigration: FillSize uses `repo`/, e.message)
      assert_equal([20261101000000, 20261102000000, 20261106000000], m.applied)
    end
  end

  def test_out_of_order
    with_repo do |repo|
      Rotor::Migrator.new(repo, [MkWidgets, AddWidgetSize]).migrate
      m = Rotor::Migrator.new(repo, [MkWidgets, AddWidgetSize, Late])
      e = assert_raise(Rotor::MigrationError) { m.migrate }.as(Rotor::MigrationError)
      assert_equal(20261101120000, e.version)
      assert_match(/older than 20261102000000/, e.message)
      assert(e.cause.nil?)
      assert_equal([20261101120000], m.pending)
      assert_equal([20261101120000], Rotor::Migrator.new(repo, [MkWidgets, AddWidgetSize, Late], allow_out_of_order: true).migrate)
      assert_equal(["late", "widgets"], tables(repo))
    end
  end

  def test_unknown_versions_and_another_table
    with_repo do |repo|
      Rotor::Migrator.new(repo, [MkWidgets, MkGadgets], table: "other_migrations").migrate
      m = Rotor::Migrator.new(repo, [MkWidgets], table: "other_migrations")
      assert_equal([[20261101000000, "MkWidgets", :up], [20261103000000, "", :unknown]], m.status)
      e = assert_raise(Rotor::MigrationError) { m.rollback }
      assert_match(/none of the migrations given has this version/, e.message)
      assert_equal([], Rotor::Migrator.new(repo, [MkWidgets]).applied)
    end
  end

  def test_versions_checked
    with_repo do |repo|
      e = assert_raise(ArgumentError) { Rotor::Migrator.new(repo, [MkWidgets, MkWidgets]) }
      assert_match(/same version/, e.message)
      e = assert_raise(ArgumentError) { Rotor::Migrator.new(repo, [Rotor::Migration]) }
      assert_match(/has no `version`/, e.message)
    end
  end

  def test_two_migrators_at_once
    with_repo do |repo|
      done = Atom[Array[Array[Int]]].new([])
      u = url
      Task.scope do |scope|
        2.times do
          scope.spawn do
            c = PG.connect(u)
            begin
              ran = Rotor::Migrator.new(Rotor::Repo.new(connection: c), [MkWidgets, Slow]).migrate
              done.update { |xs| xs + [ran] }
            ensure
              c.close
            end
            nil
          end
        end
      end
      assert_equal([[], [20261101000000, 20261107000000]], done.get.sort_by { |xs| xs.size })
    end
  end

  def test_the_connection_is_left_as_taken
    url
    PG::Pool.open(url, size: 1) do |pool|
      repo = Rotor::Repo.new(pool: pool)
      repo.exec("DROP TABLE IF EXISTS #{TABLES}")
      # A failure with a transaction left open: the migration's error,
      # the lock released, the setting reset.
      e = assert_raise(Rotor::MigrationError) { Rotor::Migrator.new(repo, [LeavesItOpen]).migrate }.as(Rotor::MigrationError)
      assert_equal(20261108000000, e.version)
      assert(e.cause.is_a?(PG::ServerError))
      assert_match(/division by zero/, e.message)
      assert_equal(0, locks(repo))
      assert_equal(["0"], repo.query("SHOW statement_timeout") { |r| r.string(0) })
      # A success that sets one.
      m = Rotor::Migrator.new(repo, [SetsATimeout])
      m.migrate
      assert_equal(["0"], repo.query("SHOW statement_timeout") { |r| r.string(0) })
      # A failure going down keeps the version.
      assert_raise(Rotor::MigrationError) { m.rollback }
      assert_equal([20261108100000], m.applied)
      assert_equal(0, locks(repo))
    end
  end

  def test_a_transaction_left_open_fails
    with_repo do |repo|
      m = Rotor::Migrator.new(repo, [Uncommitted])
      e = assert_raise(Rotor::MigrationError) { m.migrate }
      assert_equal("20261108300000 Uncommitted: it left a transaction open (outside the migrator's, with `disable_transaction!`): commit it in the migration", e.message)
      assert_equal([], m.applied)
      assert_equal([], tables(repo))
      assert_equal(0, locks(repo))
    end
  end

  def test_not_inside_a_transaction
    with_repo do |repo|
      repo.exec("CREATE TABLE late (id int)")
      e = assert_raise(ArgumentError) do
        repo.transaction do |tx|
          tx.exec("INSERT INTO late VALUES (1)")
          Rotor::Migrator.new(tx, [MkWidgets]).migrate
        end
      end
      assert_match(/must not be inside a transaction/, e.message)
      # A repository over one connection keeps its settings.
      repo.exec("SET statement_timeout = 5000")
      repo.exec("SET lock_timeout = 7000")
      Rotor::Migrator.new(repo, [MkWidgets], lock_timeout: 100.ms).migrate
      assert_equal(["5s"], repo.query("SHOW statement_timeout") { |r| r.string(0) })
      assert_equal(["7s"], repo.query("SHOW lock_timeout") { |r| r.string(0) })
    end
  end

  def test_a_failure_without_a_transaction_leaves_what_it_did
    with_repo do |repo|
      m = Rotor::Migrator.new(repo, [HalfDone])
      assert_raise(Rotor::MigrationError) { m.migrate }
      assert_equal([], m.applied)
      assert_equal(["broken_half"], tables(repo))
    end
  end

  def test_lock_timeout_is_a_millisecond_at_least
    with_repo do |repo|
      assert_raise(ArgumentError) { Rotor::Migrator.new(repo, [MkWidgets], lock_timeout: 0.ms) }
      assert_raise(ArgumentError) { Rotor::Migrator.new(repo, [MkWidgets], lock_timeout: 0.5.ms) }
      assert_raise(ArgumentError) { Rotor::Migrator.new(repo, [MkWidgets], lock_timeout: 30.days) }
    end
  end

  def test_lock_timeout
    with_repo do |repo|
      holder = PG.connect(url)
      begin
        holder.query("SELECT pg_advisory_lock($1)", [Rotor::Migrator.lock_key("schema_migrations")])
        repo.exec("SET lock_timeout = 7000")
        m = Rotor::Migrator.new(repo, [MkWidgets], lock_timeout: 100.ms)
        e = assert_raise(PG::ServerError) { m.migrate }
        assert_match(/lock timeout/, e.message)
        # The session's own setting was restored.
        assert_equal(["7s"], repo.query("SHOW lock_timeout") { |r| r.string(0) })
        repo.exec("RESET lock_timeout")
      ensure
        holder.close
      end
      assert_equal([20261101000000], Rotor::Migrator.new(repo, [MkWidgets]).migrate)
    end
  end

  def test_over_a_pool
    url
    PG::Pool.open(url, size: 2) do |pool|
      repo = Rotor::Repo.new(pool: pool)
      repo.exec("DROP TABLE IF EXISTS #{TABLES}")
      m = Rotor::Migrator.new(repo, [MkWidgets, AddWidgetSize])
      assert_equal([20261101000000, 20261102000000], m.migrate)
      assert_equal([20261102000000, 20261101000000], m.rollback(steps: 2))
    end
  end

  def test_every_operation_up_and_down
    with_repo do |repo|
      repo.exec("DROP TABLE IF EXISTS m_posts, m_labels, m_tags, m_users")
      m = Rotor::Migrator.new(repo, [EveryOp])
      m.migrate
      assert_equal(["pid", "m_user_id", "heading", "views", "ratio", "editor_id"], columns(repo, "m_posts"))
      m.rollback
      left = repo.query("SELECT count(*) FROM pg_tables WHERE tablename IN ('m_posts', 'm_labels', 'm_tags', 'm_users')") { |r| r.int(0) }
      assert_equal([0], left)
    end
  end

  def test_schema_create_and_drop
    with_repo do |repo|
      Rotor::Schema.create(repo, [SPostModel, SUserModel])
      u = repo.insert(SUserModel.new)
      assert_equal("anon", u.name)
      p = repo.insert(SPostModel.new(title: "hi", s_user_model_id: u.id))
      assert_equal(["hi"], repo.all(SPostModel.where { s_user_model_id == 1 }).map { |x| x.title })
      assert(p.id > 0)
      e = assert_raise(PG::ServerError) { repo.insert(SPostModel.new(title: "x", s_user_model_id: 99)) }
      assert_match(/foreign key/, e.message)
      # Again, leaving them.
      Rotor::Schema.create(repo, [SPostModel, SUserModel], if_not_exists: true)
      assert_equal(1, repo.count(SPostModel.query))
      Rotor::Schema.drop(repo, [SUserModel, SPostModel])
      Rotor::Schema.drop(repo, [SUserModel, SPostModel], if_exists: true)
      assert_raise(PG::ServerError) { Rotor::Schema.drop(repo, [SUserModel]) }
    end
  end
end
