require "test"

# `Date` columns (rotor#98): `date`, in a composite key too.
class DayStat < Rotor::Model
  table "day_stats" do
    column :site, String, primary: true
    column :day, Date, primary: true
    column :hits, Int
    column :ends, Date, null: true
    column :seen_at, Time, null: true
  end
end

# A function of the built-in's name and another signature (rotor#114):
# not `Kernel`'s, so a block refuses it as any function.
def Date(day: Int) -> Date = Date.new(2026, 1, day)

# Constants a block names: baked into it (quarz-lang/quarz#897).
DATE_SINCE = Date.new(2026, 1, 1)
class DateConsts
  SINCE = Date.new(2026, 1, 1)
end

class DateColumnTextTest < Test::Case
  COLS = "SELECT \"site\", \"day\", \"hits\", \"ends\", \"seen_at\" FROM \"day_stats\""

  def refusal(&f: () -> Object) -> String
    begin
      f.call
      "translated"
    rescue => e
      e.message.sub(/ \([^()]*date_column_test\.qz:\d+\)/, "")
    end
  end

  def test_columns
    assert_equal(["text", "date", "bigint", "date", "timestamptz"], DayStat.columns.map { |c| c.sql })
    assert_equal([:site, :day], DayStat.primary_keys)
    s = DayStat.new(site: "a", day: Date.new(2026, 11, 20), hits: 3)
    assert_equal(Date.new(2026, 11, 20), s.day)
    assert_nil(s.ends)
    e = assert_raise(ArgumentError) { DayStat.load({site: "a", day: "2026-11-20", hits: 1, ends: nil, seen_at: nil}) }
    assert_equal("DayStat#day takes Date, not String", e.message)
  end

  def test_query_blocks
    d = Date.new(2026, 11, 20)
    sql, params = DayStat.where { |s| s.day == d }.to_sql
    assert_equal("#{COLS} WHERE \"day\" = $1", sql)
    expected: Array[Object?] = [d]
    assert_equal(expected, params)
    assert_equal("#{COLS} WHERE \"day\" >= $1", DayStat.where { |s| s.day >= d }.to_sql[0])
    # A nullable column: Quarz's nil.
    assert_equal("#{COLS} WHERE \"ends\" IS DISTINCT FROM $1", DayStat.where { |s| s.ends != d }.to_sql[0])
    # (In a condition a NULL is not true, as Quarz's comparison with nil
    # is false.)
    assert_equal("#{COLS} WHERE \"ends\" < $1", DayStat.where { |s| s.ends < d }.to_sql[0])
    assert_equal("#{COLS} WHERE \"ends\" IS NULL", DayStat.where { |s| s.ends.nil? }.to_sql[0])
    # A range written in the block (quarz#653): its bounds compared as
    # any `Date` (`Date + Int` a `date + integer`).
    assert_equal("#{COLS} WHERE \"day\" >= $1 AND \"day\" < $2::date + 7", DayStat.where { |s| (d...d + 7).include?(s.day) }.to_sql[0])
    assert_equal("#{COLS} WHERE \"ends\" >= \"day\" AND \"ends\" <= $1", DayStat.where { |s| (s.day..d).include?(s.ends) }.to_sql[0])
    assert_equal("#{COLS} WHERE \"day\" >= $1 AND \"day\" <= $2::date + 7", DayStat.where { |s| s.day.between?(d, d + 7) }.to_sql[0])
    # `include?` of a captured array.
    days = [d, d + 1]
    sql, params = DayStat.where { |s| days.include?(s.day) }.to_sql
    assert_equal("#{COLS} WHERE \"day\" = ANY($1)", sql)
    # An order key, and an update's value.
    assert_equal("#{COLS} ORDER BY \"day\"", DayStat.query.order { |s| s.day }.to_sql[0])
    assert_equal("UPDATE \"day_stats\" SET \"ends\" = $1 WHERE \"day\" = $2", DayStat.where { |s| s.day == d }.update { |s| {ends: d} }.to_sql[0])
    # Arithmetic: `date + integer`, `date - integer`, `date - date`.
    assert_equal("#{COLS} WHERE \"ends\" > \"day\" + 7", DayStat.where { |s| s.ends > s.day + 7 }.to_sql[0])
    assert_equal("#{COLS} WHERE \"day\" - 7 < $1", DayStat.where { |s| s.day - 7 < d }.to_sql[0])
    assert_equal("#{COLS} WHERE NOT \"ends\" IS NULL AND \"ends\" - \"day\" > 30", DayStat.where { |s| !s.ends.nil? && Rotor::SQL.not_nil(s.ends) - s.day > 30 }.to_sql[0])
    n = 3
    assert_equal("#{COLS} WHERE \"day\" + $1::integer = $2", DayStat.where { |s| s.day + n == d }.to_sql[0])
    assert_equal("#{COLS} WHERE \"day\" + \"hits\"::integer > $1", DayStat.where { |s| s.day + s.hits > d }.to_sql[0])
    assert_equal("#{COLS} WHERE $1::date - \"day\" < 7", DayStat.where { |s| d - s.day < 7 }.to_sql[0])
    assert_equal("UPDATE \"day_stats\" SET \"ends\" = \"day\" + 30", DayStat.query.update { |s| {ends: s.day + 30} }.to_sql[0])
  end

  def test_refused
    d = Date.new(2026, 11, 20)
    t = Time.utc(2026, 11, 20)
    s = "2026-11-20"
    # A `Time` and a `Date`, a `String` and a `Date`: never equal.
    assert_equal("`x.seen_at == x.day` is always false: a `Time` and a `Date` are never equal", refusal { DayStat.where { |x| x.seen_at == x.day } })
    assert_equal("`x.day == t` is always false: a `Date` and a `Time` are never equal", refusal { DayStat.where { |x| x.day == t } })
    assert_equal("`x.day == s` is always false: a `Date` and a `String` are never equal", refusal { DayStat.where { |x| x.day == s } })
    # The parts and the calendar methods: later.
    assert_equal("`Date#year` cannot be translated to SQL", refusal { DayStat.where { |x| x.day.year == 2026 } })
    assert_equal("`Date#next_month` cannot be translated to SQL", refusal { DayStat.where { |x| x.day.next_month == d } })
    assert_equal("`Date#wday` cannot be translated to SQL", refusal { DayStat.where { |x| x.day.wday == 1 } })
    assert_equal("`Date#strftime` cannot be translated to SQL", refusal { DayStat.where { |x| x.day.strftime("%Y") == s } })
    # A date built in the block from no column: refused, saying what to
    # write (rotor#101); one built from a column keeps the general
    # message.
    assert_equal("`Date.new(2026, 1, 1)` does not read the row: write `Date(\"2026-01-01\")`, read when the query is built, or build it before the block and capture the variable (`value = Date.new(2026, 1, 1)`, then `value` in the block), or name a constant (`SINCE = Date.new(2026, 1, 1)`)", refusal { DayStat.where { |x| x.day >= Date.new(2026, 1, 1) }.to_sql[0] })
    assert_equal("`Date.parse(\"2026-01-01\")` does not read the row: write `Date(\"2026-01-01\")`, read when the query is built, or build it before the block and capture the variable (`value = Date.parse(\"2026-01-01\")`, then `value` in the block), or name a constant (`SINCE = Date.parse(\"2026-01-01\")`)", refusal { DayStat.where { |x| x.day >= Date.parse("2026-01-01") }.to_sql[0] })
    assert_equal("`Time.utc(2026, 1, 1)` does not read the row: build it before the block and capture the variable (`value = Time.utc(2026, 1, 1)`, then `value` in the block), or name a constant (`SINCE = Time.utc(2026, 1, 1)`)", refusal { DayStat.where { |x| x.seen_at.nil? || Rotor::SQL.not_nil(x.seen_at) >= Time.utc(2026, 1, 1) }.to_sql[0] })
    y = 2026
    # (Of a captured variable: no constant offered, which could not name
    # it.)
    assert_equal("`Date.new(y, 1, 1)` does not read the row: build it before the block and capture the variable (`value = Date.new(y, 1, 1)`, then `value` in the block)", refusal { DayStat.where { |x| x.day >= Date.new(y, 1, 1) }.to_sql[0] })
    assert_equal("`Date.new` cannot be translated to SQL", refusal { DayStat.where { |x| x.day >= Date.new(x.hits, 1, 1) }.to_sql[0] })
    # A constant: a `Date` baked into the block (a `Lit`), a parameter.
    assert_equal("#{COLS} WHERE \"day\" >= $1", DayStat.where { |x| x.day >= DATE_SINCE }.to_sql[0])
    expected: Array[Object?] = [Date.new(2026, 1, 1)]
    assert_equal(expected, DayStat.where { |x| x.day >= DateConsts::SINCE }.to_sql[1])
  end

  # A date of a captured text, from one call site.
  def since(text: String) -> Rotor::Query[DayStat] = DayStat.where { |x| x.day >= Date(text) }

  # rotor#114: `Date(text)` and `Time(text)` (quarz-lang/quarz#932) in a
  # block: the value read from a literal or a captured `String` when the
  # query is built, a parameter; `Date.parse`'s or `Time.parse`'s error
  # then. A column's text is refused.
  def test_conversion_functions
    sql, params = DayStat.where { |x| x.day >= Date("2026-01-01") }.to_sql
    assert_equal("#{COLS} WHERE \"day\" >= $1", sql)
    expected: Array[Object?] = [Date.new(2026, 1, 1)]
    assert_equal(expected, params)
    t = "2026-01-02T03:04:05Z"
    sql, params = DayStat.where { |x| x.seen_at.nil? || Rotor::SQL.not_nil(x.seen_at) >= Time(t) }.to_sql
    assert_equal("#{COLS} WHERE \"seen_at\" IS NULL OR \"seen_at\" >= $1", sql)
    times: Array[Object?] = [Time.parse(t)]
    assert_equal(times, params)
    # A value, and an `update`'s.
    assert_equal("#{COLS} ORDER BY \"day\" - $1::date", DayStat.query.order { |x| x.day - Date("2026-01-01") }.to_sql[0])
    assert_equal("UPDATE \"day_stats\" SET \"ends\" = $1", DayStat.query.update { |x| {ends: Date("2026-12-31")} }.to_sql[0])
    # One call site, two texts: the translation keeps the capture, not
    # the date it read (and a text that is not a date raises when the
    # query is built, leaving the next build to read its own).
    first: Array[Object?] = [Date.new(2026, 1, 1)]
    second: Array[Object?] = [Date.new(2027, 6, 30)]
    assert_equal(first, since("2026-01-01").to_sql[1])
    assert_equal(second, since("2027-06-30").to_sql[1])
    e = assert_raise(ArgumentError) { since("2026-02-30") }
    assert_equal("\"2026-02-30\" is not a date written YYYY-MM-DD", e.message)
    assert_equal(first, since("2026-01-01").to_sql[1])
    e = assert_raise(ArgumentError) { DayStat.where { |x| x.day >= Date("2026-13-01") } }
    assert_equal("\"2026-13-01\" is not a date written YYYY-MM-DD", e.message)
    e = assert_raise(ArgumentError) { DayStat.where { |x| x.seen_at.nil? || Rotor::SQL.not_nil(x.seen_at) >= Time("yesterday") } }
    assert_equal("no time information in \"yesterday\"", e.message)
    # A column's text: refused, saying why and what to do.
    assert_equal("`Date(x.site)` reads a column's text, which SQL would read by rules of its own, not `Date.parse`'s: compare in Quarz (select the column), or keep the value in a `date` column", refusal { DayStat.where { |x| x.day >= Date(x.site) }.to_sql[0] })
    # Another function of the name, the file's own: refused.
    assert_equal("the function `main#Date` cannot be translated to SQL", refusal { DayStat.where { |x| x.day >= Date(3) }.to_sql[0] })
    # Another text built in the block: as any call that reads no column.
    y = "2026"
    assert_equal("`Date(y + \"-01-01\")` does not read the row: build it before the block and capture the variable (`value = Date(y + \"-01-01\")`, then `value` in the block)", refusal { DayStat.where { |x| x.day >= Date(y + "-01-01") }.to_sql[0] })
  end

  # `static(...)` of a dependency's `static def` giving a `Date`: baked
  # into the block, a parameter (quarz-lang/quarz#897).
  def test_a_static_date_is_a_parameter
    # (Run by `quarz` on the PATH, or by $QUARZ.)
    out = Process.sh("cd test/fixtures/static_date && exec \"${QUARZ:-quarz}\" run")
    assert(out.success?, out.stderr)
    assert_equal("SELECT \"id\", \"day\" FROM \"visits\" WHERE \"day\" >= $1\n[2026-01-01]\n", out.stdout)
  end

  def test_wrong_types_do_not_compile
    # (Checked by `quarz` on the PATH, or by $QUARZ.)
    out = Process.sh("cd test/fixtures/date_wrong_type && exec \"${QUARZ:-quarz}\" check")
    assert(!out.success?)
    # A `String` for a `Date`; a `Time` ordered against a `Date` either
    # way; a `Date` plus a `Float`.
    [9, 10, 11, 12].each { |n| assert_match(/main\.qz:#{n}:\d+: error/, out.stderr) }
    refute_match(/main\.qz:1[34]:\d+: error/, out.stderr)
  end

  def test_changeset
    a = DayStat.load({site: "a", day: Date.new(2026, 11, 20), hits: 1, ends: nil, seen_at: nil})
    params: Hash[String, Object?] = {"ends" => "2026-12-01"}
    c = Rotor::Changeset.cast(a, params, [:ends])
    assert(c.valid?)
    assert(c.changes[:ends]? == Date.new(2026, 12, 1))
    ["2026-13-01", "2026-02-30", "12/01/2026", "2026-12-01T00:00:00Z"].each do |text|
      bad: Hash[String, Object?] = {"ends" => text}
      assert(Rotor::Changeset.cast(a, bad, [:ends]).errors.any? { |x| x.field == :ends }, text)
    end
    blank: Hash[String, Object?] = {"ends" => ""}
    assert_nil(Rotor::Changeset.cast(a, blank, [:ends]).changes[:ends]?)
    Rotor::Changeset.change(a).put_change(:ends, Date.new(2026, 1, 1))
    e = assert_raise(ArgumentError) { Rotor::Changeset.change(a).put_change(:ends, Time.utc(2026, 1, 1)) }
    assert_equal("2026-01-01 00:00:00 UTC is not a value of DayStat#ends", e.message)
  end

  def test_schema
    models: Array[Type[Rotor::Model]] = [DayStat]
    sql = Rotor::Schema.operations(models).flat_map { |op| Rotor::Migrator.render(op) }
    assert_equal(["CREATE TABLE \"day_stats\" (\"site\" text NOT NULL, \"day\" date NOT NULL, \"hits\" bigint NOT NULL, \"ends\" date, \"seen_at\" timestamptz, PRIMARY KEY (\"site\", \"day\"))"], sql)
  end
end

# Against a real server.
class DateColumnTest < Test::Case
  SERVER = Atom[PG::Testing::Server | String].new("not started")

  def self.startup
    server = PG::Testing.start_or_reason
    if server.is_a?(PG::Testing::Server)
      c = PG.connect(server.url)
      begin
        # (Dropped first: PG_TEST_URL's server outlives a run.)
        c.exec("DROP TABLE IF EXISTS day_stats")
        models: Array[Type[Rotor::Model]] = [DayStat]
        Rotor::Schema.create(Rotor::Repo.new(connection: c), models)
      ensure
        c.close
      end
    end
    SERVER.set(server)
  end

  def self.shutdown
    case SERVER.get
    in PG::Testing::Server => s then s.stop
    else nil
    end
  end

  def url -> String
    case SERVER.get
    in PG::Testing::Server => s then s.url
    in String => why then omit(why)
    end
  end

  def test_round_trip
    c = PG.connect(url)
    begin
      repo = Rotor::Repo.new(connection: c)
      c.exec("TRUNCATE day_stats")
      d = Date.new(2026, 11, 20)
      repo.insert(DayStat.new(site: "a", day: d, hits: 1, ends: Date.new(2027, 1, 31)))
      repo.insert_all([DayStat.new(site: "a", day: d + 1, hits: 2), DayStat.new(site: "b", day: d, hits: 3, ends: Date.new(1, 1, 1))])
      # The composite key, a date in it.
      got = repo.get(DayStat, {site: "a", day: d}) || raise "not found"
      assert_equal(Date.new(2027, 1, 31), got.ends)
      assert_equal(Date.new(1, 1, 1), (repo.get(DayStat, {site: "b", day: d}) || raise "not found").ends)
      assert_equal([2], repo.all(DayStat.where { |x| x.day > d }).map { |x| x.hits })
      assert_equal([1, 3], repo.all(DayStat.where { |x| x.day == d }.order { |x| x.hits }).map { |x| x.hits })
      days = [d + 1, d + 5]
      assert_equal([2], repo.all(DayStat.where { |x| days.include?(x.day) }).map { |x| x.hits })
      # Arithmetic, on the server.
      assert_equal([1], repo.all(DayStat.where { |x| !x.ends.nil? && Rotor::SQL.not_nil(x.ends) - x.day > 30 }).map { |x| x.hits })
      n = 1
      assert_equal([2], repo.all(DayStat.where { |x| x.day - n == d }).map { |x| x.hits })
      assert_equal([2, 3], repo.all(DayStat.where { |x| x.day + x.hits == d + 3 }).map { |x| x.hits }.sort)
      repo.run(DayStat.where { |x| x.hits == 2 }.update { |x| {ends: x.day + 30} })
      assert_equal(d + 31, (repo.get(DayStat, {site: "a", day: d + 1}) || raise "not found").ends)
      # An update of the model, and an upsert keyed by the date.
      # Where SQL and Quarz part: PostgreSQL's `date + integer` goes on
      # past the year 9999 (where Quarz's `Date` raises), and `::integer`
      # raises past 2**31. A huge `n` is an error from the server; an
      # update can write a date beyond 9999, which the model then cannot
      # read.
      huge = 3_000_000_000
      e = assert_raise(PG::ServerError) { repo.all(DayStat.where { |x| x.day + huge > d }) }
      assert_match(/ERROR 22003: value "3000000000" is out of range for type integer/, e.message)
      repo.run(DayStat.where { |x| x.site == "b" }.update { |x| {ends: x.day + 3_000_000} })
      far = assert_raise(ArgumentError) { repo.get(DayStat, {site: "b", day: d}) }
      assert_match(/\A10240-\d\d-\d\d: a Date holds the years 1 to 9999/, far.message)
      repo.run(DayStat.where { |x| x.site == "b" }.update { |x| {ends: nil} })
      u = repo.update(got.with(ends: nil))
      assert_nil((repo.get(DayStat, {site: "a", day: d}) || raise "not found").ends)
      up = repo.upsert(Rotor::Statement.insert(DayStat.new(site: "a", day: d, hits: 9)).on_conflict(:site, :day).do_update { |old, new| {hits: new.hits} }) || raise "skipped"
      assert_equal(9, up.hits)
      assert_equal(u.day, up.day)
    ensure
      c.close
    end
  end
end
